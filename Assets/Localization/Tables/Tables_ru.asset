  - m_Id: 87000000000000008
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0435 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0435
      \u043F\u043E\u043B\u044F \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F
      \u0438 \u0443\u0445\u043E\u0434\u044F\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0448\u043B\u044F\u043F\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u043D\u0435 \u043A\u0440\u0443\u0433\u043B\u043E\u0439, \u0430 \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u043E\u0439
      \u0438 \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439.
      \u0423 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0442\u0443\u043B\u044C\u0438
      \u043B\u0435\u0436\u0438\u0442 \u0448\u0438\u0440\u043E\u043A\u0430\u044F \u043E\u0445\u0440\u0438\u0441\u0442\u0430\u044F
      \u043B\u0435\u043D\u0442\u0430, \u0438\u0437-\u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u0432\u0438\u0434\u043D\u0435\u0435\u0442\u0441\u044F \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435
      \u0430\u043B\u043E\u0435 \u043F\u0435\u0440\u043E. \u041D\u0435\u0440\u043E\u0432\u043D\u044B\u0439
      \u0441\u0438\u043B\u0443\u044D\u0442 \u043D\u0435 \u0441\u043B\u0443\u0447\u0430\u0435\u043D:
      \u043E\u043D \u0434\u0435\u043B\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0439
      \u0443\u0431\u043E\u0440 \u0443\u0437\u043D\u0430\u0432\u0430\u0435\u043C\u044B\u043C,
      \u043D\u0435 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0430\u044F \u0435\u0433\u043E
      \u043D\u0438 \u0437\u043D\u0430\u043A\u0430\u043C\u0438, \u043D\u0438 \u0431\u043B\u0435\u0441\u043A\u043E\u043C."
