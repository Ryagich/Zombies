    m_Localized: "\u0422\u0451\u043C\u043D\u0430\u044F \u043B\u0438\u0446\u0435\u0432\u0430\u044F
      \u043C\u0430\u0441\u043A\u0430 \u0441\u043E\u0431\u0440\u0430\u043D\u0430 \u0432
      \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u044B\u0439 \u043A\u043B\u0438\u043D;
      \u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439
      \u0432\u044B\u0441\u0442\u0443\u043F \u0443\u0445\u043E\u0434\u0438\u0442 \u043D\u0438\u0436\u0435
      \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043A\u0430. \u0428\u0435\u0441\u0442\u0438\u0433\u0440\u0430\u043D\u043D\u044B\u0435
      \u0441\u0432\u0435\u0442\u043B\u044B\u0435 \u043E\u043A\u0430\u043D\u0442\u043E\u0432\u043A\u0438
      \u043E\u0431\u0440\u0430\u043C\u043B\u044F\u044E\u0442 \u043F\u0440\u043E\u0440\u0435\u0437\u0438
      \u0434\u043B\u044F \u0433\u043B\u0430\u0437, \u0430 \u0431\u043E\u043A\u043E\u0432\u044B\u0435
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u044B \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0442
      \u0441\u043A\u0443\u043B\u044B. \u0412\u0435\u0449\u044C \u043D\u0435 \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C \u043F\u0440\u0438\u0432\u0435\u0442\u043B\u0438\u0432\u043E
      \u2014 \u0435\u0451 \u0441\u0438\u043B\u0443\u044D\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043B\u0435\u0433\u043A\u043E \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 85000000000000003
    m_Localized: "\u041A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u0430\u044F \u043B\u0438\u0446\u0435\u0432\u0430\u044F
      \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 85000000000000004
    m_Localized: "\u0413\u0440\u0430\u043D\u0451\u043D\u0430\u044F \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u0430\u044F
      \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043B\u043E\u0431, \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0446\u0443,
      \u0449\u0451\u043A\u0438 \u0438 \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043E\u043A,
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443
      \u043B\u0438\u0446\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439.
      \u0412\u044B\u0442\u044F\u043D\u0443\u0442\u044B\u0435 \u0431\u043E\u043A\u043E\u0432\u044B\u0435
      \u0447\u0430\u0441\u0442\u0438 \u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F
      \u043A \u043D\u0438\u0436\u043D\u0435\u0439 \u0442\u043E\u0447\u043A\u0435,
      \u0430 \u0440\u0451\u0431\u0440\u0430 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442
      \u0435\u0451 \u0441\u0442\u0440\u043E\u0433\u0443\u044E \u0444\u043E\u0440\u043C\u0443.
      \u0421\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u0434\u043B\u044F
      \u0442\u043E\u0433\u043E, \u043A\u043E\u043C\u0443 \u043D\u0443\u0436\u043D\u043E
      \u0432\u0438\u0434\u0435\u0442\u044C \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C,
      \u043D\u0435 \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u043B\u0438\u0446\u043E
      \u043F\u0435\u0440\u0432\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 85000000000000005
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u0430\u044F \u043B\u0438\u0446\u0435\u0432\u0430\u044F
      \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 85000000000000006
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u0430\u044F \u043B\u0438\u0446\u0435\u0432\u0430\u044F
      \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430 \u0441\u043E \u0441\u0432\u0435\u0442\u043B\u044B\u043C\u0438
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0430\u043C\u0438 \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C
      \u0441\u0435\u0440\u044B\u043C \u043A\u0440\u0430\u0435\u043C. \u041E\u0441\u0442\u0440\u044B\u0439
      \u0432\u044B\u0441\u0442\u0443\u043F \u043D\u0430\u0434 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0446\u0435\u0439,
      \u0432\u044B\u0441\u043E\u043A\u0438\u0435 \u0441\u043A\u0443\u043B\u044B \u0438
      \u0440\u0430\u0437\u0440\u0435\u0437 \u0443 \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043A\u0430
      \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442 \u043B\u0438\u0446\u043E \u0432
      \u0441\u0442\u0440\u043E\u0433\u0438\u0439 \u0441\u0438\u043B\u0443\u044D\u0442.
      \u041E\u043D\u0430 \u043B\u0443\u0447\u0448\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0441\u044F
      \u0440\u044F\u0434\u043E\u043C \u0441 \u0440\u043E\u0432\u043D\u043E \u043F\u0440\u0438\u0433\u043D\u0430\u043D\u043D\u044B\u043C
      \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435\u043C, \u0447\u0435\u043C
      \u0441 \u043D\u0430\u0440\u044F\u0434\u043D\u043E\u0439 \u043E\u0434\u0435\u0436\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 85000000000000007
    m_Localized: "\u0422\u0451\u043C\u043D\u0430\u044F \u0433\u043B\u0443\u0445\u0430\u044F
      \u043C\u0430\u0441\u043A\u0430"
