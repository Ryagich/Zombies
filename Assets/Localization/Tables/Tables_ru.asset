  - m_Id: 87000000000000004
    m_Localized: "\u0428\u0438\u0440\u043E\u043A\u0438\u0435 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0435
      \u043F\u043E\u043B\u044F \u043B\u0435\u0436\u0430\u0442 \u043D\u0438\u0437\u043A\u043E
      \u0438 \u043F\u043B\u043E\u0442\u043D\u043E \u043E\u0431\u0432\u043E\u0434\u044F\u0442
      \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u0442\u0443\u043B\u044C\u044E;
      \u0432\u043E\u043A\u0440\u0443\u0433 \u043D\u0435\u0451 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u043F\u0440\u0438\u0433\u043B\u0443\u0448\u0451\u043D\u043D\u0430\u044F \u043E\u0445\u0440\u0438\u0441\u0442\u0430\u044F
      \u043B\u0435\u043D\u0442\u0430. \u0418\u0437-\u0437\u0430 \u0442\u0443\u043B\u044C\u0438
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0430\u043B\u043E\u0435
      \u043F\u0435\u0440\u043E, \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044F
      \u0442\u0451\u043C\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439
      \u0432\u0435\u0449\u0438 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u044F\u0440\u043A\u0438\u0439 \u0448\u0442\u0440\u0438\u0445. \u0422\u0430\u043A\u0430\u044F
      \u0448\u043B\u044F\u043F\u0430 \u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u0438\u043B\u0443\u044D\u0442
      \u0434\u0430\u0436\u0435 \u0442\u043E\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430
      \u0432\u0441\u0451 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u043D\u0430
      \u0445\u043E\u0437\u044F\u0438\u043D\u0435 \u0434\u0430\u0432\u043D\u043E \u043F\u0440\u0438\u043F\u043E\u0440\u043E\u0448\u0435\u043D\u043E
      \u043F\u044B\u043B\u044C\u044E."
