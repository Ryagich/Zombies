      \u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u0435\u0451 \u0434\u0435\u0440\u0436\u0438\u0442
      \u0433\u0440\u0430\u043D\u0451\u043D\u0430\u044F \u0431\u043B\u0435\u0434\u043D\u043E-\u0437\u0435\u043B\u0451\u043D\u0430\u044F
      \u0431\u0440\u043E\u0448\u044C \u0441 \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0449\u0438\u043C\u0438\u0441\u044F
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0430\u043C\u0438, \u0430 \u0441\u0431\u043E\u043A\u0443
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0434\u043B\u0438\u043D\u043D\u043E\u0435
      \u0442\u0451\u043C\u043D\u043E\u0435 \u043F\u0435\u0440\u043E. \u041E\u0442\u0442\u0435\u043D\u043A\u0438
      \u043D\u0435\u0431\u0440\u043E\u0441\u043A\u0438\u0435, \u043D\u043E \u043E\u0442\u0434\u0435\u043B\u043A\u0430
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F
      \u043A \u043A\u0430\u0436\u0434\u043E\u0439 \u0434\u0435\u0442\u0430\u043B\u0438
      \u2014 \u044D\u0442\u043E \u0443\u0436\u0435 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u0449\u0438\u0442\u0430 \u0433\u043E\u043B\u043E\u0432\u044B \u043E\u0442
      \u043D\u0435\u043F\u043E\u0433\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 88000000000000001
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044B\u0439 \u043A\u0430\u043F\u044E\u0448\u043E\u043D
      \u0441 \u0431\u0435\u043B\u043E\u0439 \u043F\u043E\u0432\u044F\u0437\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 88000000000000002
    m_Localized: "\u0413\u043E\u043B\u043E\u0432\u0443 \u0438 \u043B\u0438\u0446\u043E
      \u043E\u0431\u0432\u043E\u0434\u0438\u0442 \u0432\u044B\u0441\u043E\u043A\u0438\u0439
      \u043F\u0435\u0441\u043E\u0447\u043D\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0439
      \u043A\u0430\u043F\u044E\u0448\u043E\u043D, \u0441\u0445\u043E\u0434\u044F\u0449\u0438\u0439\u0441\u044F
      \u043A\u043D\u0438\u0437\u0443 \u0432 \u0442\u044F\u0436\u0451\u043B\u0443\u044E
      \u0433\u0440\u0430\u043D\u0451\u043D\u0443\u044E \u043F\u0435\u0440\u0435\u0434\u043D\u044E\u044E
      \u0447\u0430\u0441\u0442\u044C. \u041D\u0430\u0434 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
      \u043B\u0435\u0436\u0438\u0442 \u0442\u0451\u043C\u043D\u043E-\u0441\u0438\u043D\u044F\u044F
      \u0432\u0441\u0442\u0430\u0432\u043A\u0430, \u043F\u043E\u0432\u0435\u0440\u0445
      \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0430\u0442\u044F\u043D\u0443\u0442\u0430
      \u0440\u043E\u0432\u043D\u0430\u044F \u0431\u0435\u043B\u0430\u044F \u043F\u043E\u0432\u044F\u0437\u043A\u0430.
      \u0423\u0431\u043E\u0440 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430 \u043F\u043E\u0447\u0442\u0438
      \u0446\u0435\u043B\u0438\u043A\u043E\u043C, \u043D\u043E \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u044B\u0445, \u0445\u043E\u0440\u043E\u0448\u043E
      \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u043C\u044B\u0445 \u043B\u0438\u043D\u0438\u044F\u0445,
      \u0431\u0435\u0437 \u043D\u0430\u0440\u043E\u0447\u0438\u0442\u043E\u0439 \u043D\u0430\u0440\u044F\u0434\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 88000000000000003
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u044B\u0439 \u0448\u043B\u0435\u043C
