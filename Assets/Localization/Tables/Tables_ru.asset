  - m_Id: 93000000000000004
    m_Localized: "\u041F\u043E \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u0441\u0432\u0435\u0442\u043B\u043E\u0433\u043E
      \u0448\u043B\u0435\u043C\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0448\u0438\u0440\u043E\u043A\u0430\u044F \u0442\u0451\u043C\u043D\u0430\u044F
      \u043F\u043B\u0430\u043D\u043A\u0430 \u2014 \u043E\u0442 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0438
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0446\u0443
      \u043A \u043D\u0438\u0436\u043D\u0435\u0439 \u043A\u0440\u043E\u043C\u043A\u0435
      \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043A\u0430. \u0415\u0451
      \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0435\u0442 \u0442\u0451\u043C\u043D\u044B\u0439
      \u043F\u043E\u044F\u0441 \u0433\u043B\u0430\u0437\u043D\u044B\u0445 \u0449\u0435\u043B\u0435\u0439,
      \u0430 \u043F\u043E \u0431\u043E\u043A\u0430\u043C \u043E\u0442 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u0438
      \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u0434\u0432\u0435 \u0434\u043B\u0438\u043D\u043D\u044B\u0435
      \u043F\u0440\u043E\u0440\u0435\u0437\u0438 \u0432 \u043D\u0438\u0436\u043D\u0435\u0439
      \u0447\u0430\u0441\u0442\u0438 \u043B\u0438\u0446\u0430. \u0422\u0430\u043A\u0430\u044F
      \u0440\u0430\u0437\u043C\u0435\u0442\u043A\u0430 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442
      \u0433\u043B\u0430\u0434\u043A\u0438\u0435 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u044B
      \u0432 \u0441\u0442\u0440\u043E\u0433\u0438\u0439 \u0438 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439
      \u0440\u0438\u0441\u0443\u043D\u043E\u043A."
