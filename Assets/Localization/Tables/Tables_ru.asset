  - m_Id: 93000000000000002
    m_Localized: "\u041D\u0438\u0437\u043A\u0430\u044F \u0441\u0432\u0435\u0442\u043B\u0430\u044F
      \u0432\u0435\u0440\u0445\u0443\u0448\u043A\u0430 \u0448\u043B\u0435\u043C\u0430
      \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0430 \u043E\u0442 \u043B\u0438\u0446\u0435\u0432\u043E\u0439
      \u0447\u0430\u0441\u0442\u0438 \u0443\u0437\u043A\u043E\u0439 \u0442\u0451\u043C\u043D\u043E\u0439
      \u0449\u0435\u043B\u044C\u044E, \u043E\u0442\u0447\u0435\u0433\u043E \u0432\u0435\u0441\u044C
      \u0443\u0431\u043E\u0440 \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u043C
      \u0438\u0437 \u0434\u0432\u0443\u0445 \u0442\u044F\u0436\u0451\u043B\u044B\u0445
      \u044F\u0440\u0443\u0441\u043E\u0432. \u0428\u0438\u0440\u043E\u043A\u0430\u044F
      \u0432\u0435\u0440\u0445\u043D\u044F\u044F \u043A\u0440\u043E\u043C\u043A\u0430
      \u043B\u0438\u0446\u0435\u0432\u043E\u0439 \u043F\u0430\u043D\u0435\u043B\u0438
      \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u044B,
      \u0437\u0430\u0442\u0435\u043C \u0441\u0443\u0436\u0430\u0435\u0442\u0441\u044F
      \u043A \u0434\u043B\u0438\u043D\u043D\u043E\u043C\u0443 \u0437\u0430\u043E\u0441\u0442\u0440\u0451\u043D\u043D\u043E\u043C\u0443
      \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043A\u0443. \u0421\u0434\u0435\u0440\u0436\u0430\u043D\u043D\u0430\u044F
      \u0444\u043E\u0440\u043C\u0430 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u044D\u0442\u043E\u043C \u0440\u0430\u0437\u044A\u0451\u043C\u0435:
      \u043E\u043D \u043D\u0435 \u0443\u043A\u0440\u0430\u0448\u0430\u0435\u0442
      \u0448\u043B\u0435\u043C, \u043D\u043E \u0434\u0435\u043B\u0430\u0435\u0442
      \u0435\u0433\u043E \u0441\u0438\u043B\u0443\u044D\u0442 \u043B\u0435\u0433\u043A\u043E
      \u0443\u0437\u043D\u0430\u0432\u0430\u0435\u043C\u044B\u043C."
