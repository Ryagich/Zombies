  - m_Id: 86000000000000008
    m_Localized: "\u041D\u0438\u0437\u043A\u0430\u044F \u0441\u0432\u0435\u0442\u043B\u0430\u044F
      \u043A\u043E\u0440\u043E\u043D\u0430 \u0441 \u043F\u0440\u044F\u043C\u044B\u043C\u0438
      \u0437\u0443\u0431\u0446\u0430\u043C\u0438, \u0430\u0436\u0443\u0440\u043D\u044B\u043C\u0438
      \u0431\u043E\u043A\u043E\u0432\u044B\u043C\u0438 \u043F\u0440\u043E\u0440\u0435\u0437\u044F\u043C\u0438
      \u0438 \u0442\u0451\u043C\u043D\u043E-\u043A\u0440\u0430\u0441\u043D\u044B\u043C
      \u043A\u0430\u043C\u043D\u0435\u043C \u043D\u0430\u0434 \u043B\u0431\u043E\u043C.
      \u0421\u0432\u0435\u0442\u043B\u044B\u0435 \u0433\u0440\u0430\u043D\u0438 \u0441\u043E\u0431\u0440\u0430\u043D\u044B
      \u0432\u043E\u043A\u0440\u0443\u0433 \u0448\u0438\u0440\u043E\u043A\u043E\u0439
      \u043E\u0445\u0440\u0438\u0441\u0442\u043E\u0439 \u043E\u0441\u043D\u043E\u0432\u044B,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432\u0435\u0449\u044C \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u043D\u0430\u0440\u044F\u0434\u043D\u043E, \u043D\u043E \u043D\u0435 \u0445\u0440\u0443\u043F\u043A\u043E.
      \u0415\u0451 \u043D\u043E\u0441\u044F\u0442 \u043E\u0442\u043A\u0440\u044B\u0442\u043E:
      \u0442\u0430\u043A\u043E\u0439 \u0437\u043D\u0430\u043A \u043D\u0435 \u043F\u0440\u044F\u0447\u0443\u0442
      \u043F\u043E\u0434 \u043A\u0430\u043F\u044E\u0448\u043E\u043D\u043E\u043C."
