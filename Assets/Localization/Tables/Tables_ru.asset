      \u043B\u0438\u0446\u0435\u0432\u0430\u044F \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0430
      \u0443\u0441\u0435\u044F\u043D\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438
      \u0443\u0433\u043B\u043E\u0432\u044B\u043C\u0438 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F\u043C\u0438,
      \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u043C\u0438
      \u043F\u0430\u0440\u0430\u043C\u0438 \u043E\u0442 \u0432\u0438\u0441\u043A\u043E\u0432
      \u0434\u043E \u043D\u0438\u0436\u043D\u0435\u0439 \u043A\u0440\u043E\u043C\u043A\u0438.
      \u041D\u0430\u0434 \u043D\u0435\u0439 \u0432\u043E\u0437\u0432\u044B\u0448\u0430\u0435\u0442\u0441\u044F
      \u043D\u0438\u0437\u043A\u0430\u044F \u0442\u0451\u043C\u043D\u0430\u044F \u0432\u0435\u0440\u0445\u0443\u0448\u043A\u0430,
      \u0430 \u0441\u043D\u0438\u0437\u0443 \u043E\u0431\u044A\u0451\u043C \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u0433\u0440\u0430\u043D\u0451\u043D\u044B\u0439
      \u0432\u043E\u0440\u043E\u0442. \u041C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
      \u043F\u0440\u043E\u0451\u043C\u043E\u0432 \u043D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0444\u043E\u0440\u043C\u0443 \u0432 \u0443\u0437\u043E\u0440: \u043E\u043D\u0438
      \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B \u0440\u0435\u0434\u043A\u0438\u043C\u0438,
      \u0442\u0451\u043C\u043D\u044B\u043C\u0438 \u0442\u043E\u0447\u043A\u0430\u043C\u0438
      \u043D\u0430 \u0440\u043E\u0432\u043D\u043E\u0439 \u0441\u0432\u0435\u0442\u043B\u043E\u0439
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000019
    m_Localized: "\u0411\u0430\u0433\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000020
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0439 \u0445\u0440\u0443\u0441\u0442\u044F\u0449\u0438\u0439
      \u0445\u043B\u0435\u0431, \u0438\u0441\u043F\u0435\u0447\u0451\u043D\u043D\u044B\u0439
      \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430 \u0438 \u0437\u0430\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0439
      \u0432 \u0431\u0443\u043C\u0430\u0433\u0443. \u041F\u0440\u043E\u0441\u0442\u0430\u044F
      \u0434\u043E\u0440\u043E\u0436\u043D\u0430\u044F \u0435\u0434\u0430, \u043D\u043E
      \u0441\u0443\u0445\u0430\u044F \u043A\u043E\u0440\u043E\u0447\u043A\u0430 \u0438
      \u0442\u0451\u043F\u043B\u044B\u0439 \u043C\u044F\u043A\u0438\u0448 \u0434\u0435\u043B\u0430\u044E\u0442
      \u0441\u043A\u0443\u0434\u043D\u0443\u044E \u0442\u0440\u0430\u043F\u0435\u0437\u0443
      \u0447\u0443\u0442\u044C \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000021
    m_Localized: "\u0411\u0443\u0442\u044B\u043B\u043A\u0430 \u0432\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000022
    m_Localized: "\u0427\u0438\u0441\u0442\u0430\u044F \u0432\u043E\u0434\u0430 \u0432
      \u0431\u0443\u0442\u044B\u043B\u043A\u0435 \u0441 \u043F\u0440\u043E\u0431\u043A\u043E\u0439.
      \u0412 \u043D\u0435\u0439 \u043D\u0435\u0442 \u0432\u043A\u0443\u0441\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u0442\u043E\u0438\u043B\u043E
      \u0431\u044B \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C,
      \u2014 \u0438\u043C\u0435\u043D\u043D\u043E \u044D\u0442\u043E\u0433\u043E
      \u0438 \u0436\u0434\u0451\u0442 \u043E\u0442 \u043D\u0435\u0451 \u043F\u0443\u0442\u043D\u0438\u043A,
      \u043C\u0443\u0447\u0438\u043C\u044B\u0439 \u0436\u0430\u0436\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000023
    m_Localized: "\u0411\u0443\u0442\u044B\u043B\u043A\u0430 \u0432\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000024
    m_Localized: "\u0422\u0451\u043C\u043D\u043E-\u043A\u0440\u0430\u0441\u043D\u043E\u0435
      \u0432\u0438\u043D\u043E \u0441 \u0440\u0435\u0437\u043A\u0438\u043C \u0444\u0440\u0443\u043A\u0442\u043E\u0432\u044B\u043C
      \u0437\u0430\u043F\u0430\u0445\u043E\u043C. \u041E\u043D\u043E \u0441\u043E\u0433\u0440\u0435\u0432\u0430\u0435\u0442
      \u0433\u043E\u0440\u043B\u043E \u0438 \u0440\u0430\u0437\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442
      \u044F\u0437\u044B\u043A, \u0445\u043E\u0442\u044F \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u043C
      \u0431\u044B\u0432\u0430\u0435\u0442 \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043D\u0438 \u0442\u043E \u043D\u0438 \u0434\u0440\u0443\u0433\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000025
    m_Localized: "\u041A\u0440\u0443\u0433\u043B\u044B\u0439 \u0445\u043B\u0435\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000026
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043A\u0440\u0443\u0433\u043B\u0430\u044F
      \u0431\u0443\u0445\u0430\u043D\u043A\u0430 \u0441 \u043A\u0440\u0435\u043F\u043A\u043E\u0439
      \u043A\u043E\u0440\u043A\u043E\u0439. \u041E\u043D\u0430 \u0445\u043E\u0440\u043E\u0448\u043E
      \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442 \u0434\u043E\u0440\u043E\u0433\u0443
      \u0438 \u0434\u0430\u0436\u0435 \u043F\u043E\u0441\u043B\u0435 \u0434\u043D\u044F
      \u0432 \u0441\u0443\u043C\u043A\u0435 \u0435\u0451 \u043C\u043E\u0436\u043D\u043E
      \u0440\u0430\u0437\u043B\u043E\u043C\u0438\u0442\u044C \u0438 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C
      \u0441 \u043A\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000027
    m_Localized: "\u0416\u0430\u0440\u0435\u043D\u0430\u044F \u0438\u043D\u0434\u0435\u0439\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000028
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E \u043F\u0440\u043E\u0436\u0430\u0440\u0435\u043D\u043D\u044B\u0439
      \u043A\u0443\u0441\u043E\u043A \u0438\u043D\u0434\u0435\u0439\u043A\u0438,
      \u0441\u043E\u0447\u043D\u044B\u0439 \u043E\u0442 \u0436\u0438\u0440\u0430
      \u0438 \u043F\u0430\u0445\u043D\u0443\u0449\u0438\u0439 \u0434\u044B\u043C\u043E\u043C.
      \u0414\u043B\u044F \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u043A\u0443\u0441\u0430
      \u0442\u044F\u0436\u0435\u043B\u043E\u0432\u0430\u0442, \u0437\u0430\u0442\u043E
      \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D \u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u0441\u0438\u043B\u044B \u043F\u0440\u043E\u0433\u043E\u043B\u043E\u0434\u0430\u0432\u0448\u0435\u043C\u0443\u0441\u044F
      \u043F\u0443\u0442\u043D\u0438\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000029
    m_Localized: "\u041B\u0435\u0447\u0435\u0431\u043D\u043E\u0435 \u0437\u0435\u043B\u044C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000030
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0444\u043B\u0430\u043A\u043E\u043D
      \u0433\u043E\u0440\u044C\u043A\u043E\u0439 \u043A\u0440\u0430\u0441\u043D\u043E\u0439
      \u043D\u0430\u0441\u0442\u043E\u0439\u043A\u0438. \u041E\u043D\u0430 \u043E\u0431\u0436\u0438\u0433\u0430\u0435\u0442
      \u044F\u0437\u044B\u043A, \u043D\u043E \u0437\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u0440\u0430\u043D\u044B \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043C
      \u0431\u0438\u043D\u0442 \u0438 \u0442\u0438\u0445\u0430\u044F \u043D\u043E\u0447\u044C
      \u0443 \u043E\u0433\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000031
    m_Localized: "\u0413\u043E\u0440\u0448\u043E\u0447\u0435\u043A \u043C\u0451\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000032
    m_Localized: "\u0413\u0443\u0441\u0442\u043E\u0439 \u043C\u0451\u0434 \u0438\u0437
      \u0443\u043B\u044C\u0435\u0432 \u0437\u0430 \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u0441\u043A\u0438\u043C\u0438
      \u0438\u0437\u0433\u043E\u0440\u043E\u0434\u044F\u043C\u0438. \u0421\u043B\u0430\u0434\u043A\u0438\u0439,
      \u043B\u0438\u043F\u043A\u0438\u0439 \u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0446\u0435\u043D\u043D\u044B\u0439, \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
      \u0435\u0433\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0434\u0435\u0442\u044C\u043C\u0438 \u0438\u043B\u0438 \u043C\u0443\u0440\u0430\u0432\u044C\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000033
    m_Localized: "\u041A\u0440\u0443\u0436\u043A\u0430 \u043F\u0438\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000034
    m_Localized: "\u041A\u0440\u0443\u0436\u043A\u0430 \u0441\u0432\u0435\u0442\u043B\u043E\u0433\u043E
      \u043F\u0438\u0432\u0430 \u0441 \u043F\u0435\u043D\u043E\u0439, \u0435\u0449\u0451
      \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u043E\u0433\u043E \u043F\u043E\u0441\u043B\u0435
      \u043F\u043E\u0433\u0440\u0435\u0431\u0430. \u0422\u044F\u0436\u0451\u043B\u044B\u0439
      \u0434\u0435\u043D\u044C \u043E\u043D\u0430 \u043D\u0435 \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442,
      \u043D\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E \u043D\u0451\u043C
      \u0441\u0442\u0430\u043D\u0435\u0442 \u043B\u0435\u0433\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000035
    m_Localized: "\u041A\u0443\u0441\u043E\u043A \u0441\u044B\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000036
    m_Localized: "\u041A\u0443\u0441\u043E\u043A \u0442\u0432\u0451\u0440\u0434\u043E\u0433\u043E
      \u0441\u044B\u0440\u0430 \u0441 \u043E\u0440\u0435\u0445\u043E\u0432\u044B\u043C
      \u0437\u0430\u043F\u0430\u0445\u043E\u043C. \u0421\u043E\u043B\u0451\u043D\u044B\u0439,
      \u0441\u044B\u0442\u043D\u044B\u0439 \u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0441\u0442\u043E\u0439\u043A\u0438\u0439, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u044C \u0431\u043E\u043B\u0435\u0435
      \u043D\u0435\u0436\u043D\u044B\u0435 \u043F\u0440\u0438\u043F\u0430\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000037
    m_Localized: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0449\u0438\u0439
      \u043E\u0442\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000038
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u044B\u0439 \u043E\u0442\u0432\u0430\u0440
      \u0441 \u0440\u0435\u0437\u043A\u0438\u043C \u0442\u0440\u0430\u0432\u044F\u043D\u044B\u043C
      \u0432\u043A\u0443\u0441\u043E\u043C. \u041E\u043D \u0431\u0443\u0434\u0438\u0442
      \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u0435 \u043C\u044B\u0448\u0446\u044B,
      \u0445\u043E\u0442\u044F \u043F\u043E\u0441\u043B\u0435\u0432\u043A\u0443\u0441\u0438\u0435
      \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442 \u043B\u044E\u0431\u043E\u0433\u043E
      \u043F\u043E\u0442\u044F\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0432\u043E\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000039
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u043E\u0435 \u043A\u043E\u043B\u044C\u0446\u043E
      \u0441 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u043E\u0439 \u043E\u043F\u0440\u0430\u0432\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000040
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u043E\u0435 \u0437\u043E\u043B\u043E\u0442\u043E\u0435
      \u043A\u043E\u043B\u044C\u0446\u043E \u0441 \u0448\u0438\u0440\u043E\u043A\u043E\u0439
      \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u043E\u0439 \u043E\u043F\u0440\u0430\u0432\u043E\u0439.
      \u041C\u0435\u0442\u0430\u043B\u043B \u043E\u0442\u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D
      \u0434\u043E \u0433\u043B\u0430\u0434\u043A\u043E\u0441\u0442\u0438, \u0438
      \u043F\u043E\u0442\u043E\u043C\u0443 \u043F\u0443\u0441\u0442\u043E\u0435 \u0433\u043D\u0435\u0437\u0434\u043E
      \u0441\u0440\u0430\u0437\u0443 \u043F\u0440\u0438\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u0432\u0437\u0433\u043B\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000041
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E\u0435 \u0437\u043E\u043B\u043E\u0442\u043E\u0435
      \u043A\u043E\u043B\u044C\u0446\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000042
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u0437\u043E\u043B\u043E\u0442\u043E\u0439
      \u043E\u0431\u043E\u0434\u043E\u043A \u0441 \u0440\u043E\u0432\u043D\u043E\u0439
      \u0442\u043E\u043B\u0441\u0442\u043E\u0439 \u0448\u0438\u043D\u043A\u043E\u0439.
      \u041A\u043B\u0435\u0439\u043C\u0430 \u043C\u0430\u0441\u0442\u0435\u0440\u0430
      \u043D\u0435 \u0432\u0438\u0434\u043D\u043E; \u043B\u0438\u0448\u044C \u0432\u0435\u0441
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u0447\u0442\u043E
      \u0432\u0435\u0449\u044C \u0431\u044B\u043B\u0430 \u043D\u0435 \u0434\u043B\u044F
      \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000043
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u043E\u0435 \u043A\u043E\u043B\u044C\u0446\u043E
      \u0441 \u0433\u043E\u043B\u0443\u0431\u044B\u043C \u043A\u0430\u043C\u043D\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000044
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u043E\u0439 \u043E\u0431\u043E\u0434\u043E\u043A
      \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0431\u043B\u0435\u0434\u043D\u043E-\u0433\u043E\u043B\u0443\u0431\u043E\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C. \u0415\u0433\u043E \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439
      \u0431\u043B\u0435\u0441\u043A \u0437\u0430\u043C\u0435\u0442\u0435\u043D \u0434\u0430\u0436\u0435
      \u0432 \u0441\u043A\u0443\u0434\u043D\u043E\u043C \u0441\u0432\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000045
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0439 \u043E\u0431\u043E\u0434\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000046
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0439
      \u043E\u0431\u043E\u0434\u043E\u043A: \u043F\u043E \u043A\u0440\u0430\u044F\u043C
      \u0441\u0432\u0435\u0442\u043B\u044B\u0439, \u0432 \u0443\u0433\u043B\u0443\u0431\u043B\u0435\u043D\u0438\u044F\u0445
      \u0442\u0435\u043C\u043D\u0435\u0435. \u0420\u0430\u0431\u043E\u0442\u0430
      \u0441\u043A\u0440\u043E\u043C\u043D\u0430\u044F, \u043D\u043E \u0432\u0435\u0449\u044C
      \u044F\u0432\u043D\u043E \u0447\u0438\u0441\u0442\u044F\u0442 \u0431\u0435\u0440\u0435\u0436\u043D\u043E
      \u0438 \u0447\u0430\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000047
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u0435 \u043A\u043E\u043B\u044C\u0446\u043E
      \u0441 \u0440\u043E\u0437\u043E\u0432\u044B\u043C \u043A\u0430\u043C\u043D\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000048
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u0435 \u043A\u043E\u043B\u044C\u0446\u043E
      \u0441 \u043A\u0430\u043C\u043D\u0435\u043C \u0440\u043E\u0437\u043E\u0432\u043E\u0433\u043E
      \u043E\u0442\u0442\u0435\u043D\u043A\u0430. \u041E\u0433\u0440\u0430\u043D\u043A\u0430
      \u043F\u0440\u043E\u0441\u0442\u0430, \u043D\u043E \u043A\u0430\u043C\u0435\u043D\u044C
      \u043F\u0440\u0438\u0434\u0430\u0451\u0442 \u0441\u0434\u0435\u0440\u0436\u0430\u043D\u043D\u043E\u0439
      \u043E\u043F\u0440\u0430\u0432\u0435 \u043E\u0442\u0442\u0435\u043D\u043E\u043A
      \u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000049
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u0435 \u043A\u043E\u043B\u044C\u0446\u043E
      \u0441 \u043A\u0440\u0430\u0441\u043D\u044B\u043C \u043A\u0430\u043C\u043D\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000050
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0439 \u043E\u0431\u043E\u0434\u043E\u043A
      \u0441 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C \u043A\u0440\u0430\u0441\u043D\u044B\u043C
      \u043A\u0430\u043C\u043D\u0435\u043C, \u043F\u043E\u0434\u043D\u044F\u0442\u044B\u043C
      \u043D\u0430\u0434 \u0448\u0438\u043D\u043A\u043E\u0439. \u042F\u0440\u043A\u0438\u0439
      \u0446\u0432\u0435\u0442 \u0434\u0435\u043B\u0430\u0435\u0442 \u043F\u0440\u043E\u0441\u0442\u043E\u0439
      \u043C\u0435\u0442\u0430\u043B\u043B \u0442\u0435\u043F\u043B\u0435\u0435 \u043D\u0430
      \u0432\u0438\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000051
    m_Localized: "\u0422\u043E\u043B\u0441\u0442\u043E\u0435 \u0437\u043E\u043B\u043E\u0442\u043E\u0435
      \u043A\u043E\u043B\u044C\u0446\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000052
    m_Localized: "\u0428\u0438\u0440\u043E\u043A\u0438\u0439 \u0437\u043E\u043B\u043E\u0442\u043E\u0439
      \u043E\u0431\u043E\u0434\u043E\u043A \u0431\u0435\u0437 \u043A\u0430\u043C\u043D\u044F
      \u0438 \u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u043A\u0438. \u0415\u0433\u043E
      \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0432\u0438\u0434\u043D\u0430
      \u0441\u0440\u0430\u0437\u0443, \u0430 \u0437\u043D\u0430\u0447\u0438\u0442,
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0435 \u043B\u0443\u0447\u0448\u0435
      \u043D\u0435 \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0442\u0430\u043A\u0443\u044E
      \u0432\u0435\u0449\u044C \u043D\u0430\u043F\u043E\u043A\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000053
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u043E\u0435 \u043A\u043E\u043B\u044C\u0446\u043E
      \u0441 \u043F\u043B\u043E\u0441\u043A\u043E\u0439 \u043F\u0435\u0447\u0430\u0442\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000054
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u043E\u0435 \u043A\u043E\u043B\u044C\u0446\u043E
      \u0441 \u043F\u043B\u043E\u0441\u043A\u043E\u0439 \u0443\u0433\u043B\u043E\u0432\u0430\u0442\u043E\u0439
      \u043F\u0435\u0447\u0430\u0442\u043A\u043E\u0439, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0441\u043B\u0443\u0436\u0438\u0432\u0448\u0435\u0439
      \u0434\u043B\u044F \u043E\u0442\u0442\u0438\u0441\u043A\u0430. \u041D\u0430
      \u0441\u0442\u0451\u0440\u0442\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
      \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0438
      \u0433\u0435\u0440\u0431\u0430, \u043D\u0438 \u0437\u043D\u0430\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000055
    m_Localized: "\u041A\u043E\u043B\u044C\u0446\u043E \u0438\u0437 \u0447\u0451\u0440\u043D\u043E\u0433\u043E
      \u0436\u0435\u043B\u0435\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000056
    m_Localized: "\u0422\u0451\u043C\u043D\u043E\u0435 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0435
      \u043A\u043E\u043B\u044C\u0446\u043E \u0441 \u0442\u0443\u0441\u043A\u043B\u043E\u0439,
      \u043F\u043E\u0447\u0442\u0438 \u0447\u0451\u0440\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C\u044E.
      \u0412 \u043D\u0451\u043C \u043D\u0435\u0442 \u0431\u043B\u0435\u0441\u043A\u0430
      \u0438 \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0439, \u043D\u043E
      \u043E\u0431\u043E\u0434\u043E\u043A \u0432\u044B\u043A\u043E\u0432\u0430\u043D
      \u043D\u0430 \u0441\u043E\u0432\u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000057
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u043E\u0435 \u043A\u043E\u043B\u044C\u0446\u043E-\u043F\u0435\u0447\u0430\u0442\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000058
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u043E\u0435 \u043A\u043E\u043B\u044C\u0446\u043E
      \u0441 \u0432\u044B\u043F\u0443\u043A\u043B\u043E\u0439 \u0433\u0440\u0430\u043D\u0451\u043D\u043E\u0439
      \u043F\u0435\u0447\u0430\u0442\u043A\u043E\u0439. \u041D\u0430 \u0435\u0451
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043D\u0435
      \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C \u0437\u043D\u0430\u043A\u0430
      \u2014 \u0442\u043E \u043B\u0438 \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u0442\u043E \u043B\u0438 \u043F\u043E\u0442\u043E\u043C\u0443, \u0447\u0442\u043E
      \u0435\u0433\u043E \u0441\u0442\u0451\u0440\u043B\u0438 \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E."
