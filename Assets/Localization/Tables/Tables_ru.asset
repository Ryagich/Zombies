      m_Items: []
  - m_Id: 85000000000000010
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u0430\u044F \u043C\u0430\u0441\u043A\u0430
      \u0442\u0451\u043F\u043B\u043E\u0433\u043E \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u0433\u043E
      \u0442\u043E\u043D\u0430, \u0441\u043E \u0441\u0433\u043B\u0430\u0436\u0435\u043D\u043D\u044B\u043C
      \u0432\u0435\u0440\u0445\u043D\u0438\u043C \u043A\u0440\u0430\u0435\u043C \u0438
      \u0442\u044F\u0436\u0451\u043B\u043E\u0439 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
      \u043F\u0430\u043D\u0435\u043B\u044C\u044E. \u0411\u043E\u043A\u043E\u0432\u044B\u0435
      \u0433\u0440\u0430\u043D\u0438 \u0441\u0443\u0436\u0430\u044E\u0442 \u0435\u0451
      \u043A \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043A\u0443, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0432\u0435\u0449\u044C \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0441\u044F
      \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u043E, \u0430 \u043D\u0435 \u0433\u0440\u043E\u043C\u043E\u0437\u0434\u043A\u043E.
      \u0420\u0430\u0431\u043E\u0442\u0430 \u0431\u0435\u0437 \u0431\u043B\u0435\u0441\u043A\u0430
      \u0438 \u0440\u0435\u0437\u044C\u0431\u044B: \u0446\u0435\u043D\u043D\u0430
      \u0442\u0435\u043C, \u0447\u0442\u043E \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0442\u044C, \u0437\u0430\u0447\u0435\u043C
      \u0435\u0451 \u043D\u0430\u0434\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 86000000000000001
    m_Localized: "\u041F\u0451\u0441\u0442\u0440\u0430\u044F \u0448\u0430\u043F\u043A\u0430
      \u0441 \u043B\u0435\u043D\u0442\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 86000000000000002
    m_Localized: "\u041D\u0438\u0437\u043A\u0430\u044F \u043F\u0451\u0441\u0442\u0440\u0430\u044F
      \u0448\u0430\u043F\u043A\u0430 \u0441\u043B\u043E\u0436\u0435\u043D\u0430 \u0438\u0437
      \u0448\u0438\u0440\u043E\u043A\u0438\u0445 \u043F\u043E\u043B\u043E\u0441 \u0442\u0451\u043C\u043D\u043E\u0433\u043E,
      \u043E\u0445\u0440\u0438\u0441\u0442\u043E\u0433\u043E \u0438 \u0441\u0432\u0435\u0442\u043B\u043E\u0433\u043E
      \u0446\u0432\u0435\u0442\u0430; \u0441 \u043E\u0431\u043E\u0434\u0430 \u0441\u043F\u0430\u0434\u0430\u044E\u0442
      \u0434\u043B\u0438\u043D\u043D\u044B\u0435 \u043B\u0435\u043D\u0442\u044B \u0441
      \u043D\u0435\u0440\u043E\u0432\u043D\u044B\u043C\u0438 \u043A\u043E\u043D\u0446\u0430\u043C\u0438.
      \u0418\u0437\u0434\u0430\u043B\u0438 \u043E\u043D\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u043F\u043E\u0447\u0442\u0438 \u0432\u0435\u0441\u0435\u043B\u043E, \u043D\u043E
      \u0444\u043E\u0440\u043C\u0430 \u043D\u0435 \u043D\u0430\u0440\u044F\u0434\u043D\u0430\u044F
      \u2014 \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u043E\u0445\u043E\u0436\u0430
      \u043D\u0430 \u0432\u0435\u0449\u044C, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u043D\u043E\u0441\u044F\u0442, \u043F\u043E\u043A\u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0443\u0436\u0435 \u0434\u0430\u0432\u043D\u043E \u0438\u0437\u043D\u043E\u0441\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 86000000000000003
    m_Localized: "\u0428\u0438\u0440\u043E\u043A\u043E\u043F\u043E\u043B\u0430\u044F
      \u0434\u043E\u0440\u043E\u0436\u043D\u0430\u044F \u0448\u043B\u044F\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 86000000000000004
    m_Localized: "\u0428\u0438\u0440\u043E\u043A\u0438\u0435, \u043F\u043E\u0447\u0442\u0438
      \u043F\u043B\u043E\u0441\u043A\u0438\u0435 \u043F\u043E\u043B\u044F \u0443\u0445\u043E\u0434\u044F\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0440\u043E\u0432\u043D\u044B\u043C
      \u043A\u0440\u0443\u0433\u043E\u043C, \u0430 \u043D\u0430\u0434 \u043D\u0438\u043C\u0438
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0432\u044B\u0441\u043E\u043A\u0430\u044F
      \u0442\u0443\u043B\u044C\u044F \u0441 \u0442\u0451\u043C\u043D\u043E\u0439
      \u043B\u0435\u043D\u0442\u043E\u0439. \u0421\u0435\u0440\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0435
      \u0433\u0440\u0430\u043D\u0438 \u043D\u0435 \u0441\u043F\u043E\u0440\u044F\u0442
      \u0441 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u043F\u044B\u043B\u044C\u044E
      \u0438 \u043D\u0435 \u0431\u0440\u043E\u0441\u0430\u044E\u0442\u0441\u044F
      \u0432 \u0433\u043B\u0430\u0437\u0430. \u0422\u0430\u043A\u0443\u044E \u0448\u043B\u044F\u043F\u0443
      \u043B\u0435\u0433\u043A\u043E \u0443\u0437\u043D\u0430\u0442\u044C \u043D\u0430
      \u0440\u044B\u043D\u043A\u0435, \u043D\u043E \u0442\u0440\u0443\u0434\u043D\u043E
      \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 86000000000000005
