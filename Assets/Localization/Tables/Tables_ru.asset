      \u0438 \u0440\u0435\u043C\u0435\u043D\u044C \u0441\u0431\u043E\u043A\u0443
      \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442 \u0435\u0439 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u0438,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u0431\u044B\u0447\u043D\u043E
      \u043D\u0435 \u0436\u0434\u0451\u0448\u044C \u043E\u0442 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439
      \u043E\u0434\u0435\u0436\u0434\u044B."
