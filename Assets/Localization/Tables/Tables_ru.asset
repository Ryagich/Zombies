  - m_Id: 93000000000000006
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u0430\u044F \u043B\u0438\u0446\u0435\u0432\u0430\u044F
      \u0447\u0430\u0441\u0442\u044C \u0440\u0430\u0441\u0441\u0435\u0447\u0435\u043D\u0430
      \u0448\u0438\u0440\u043E\u043A\u0438\u043C\u0438 \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u0432\u0441\u0442\u0430\u0432\u043A\u0430\u043C\u0438 \u0442\u0451\u043F\u043B\u043E\u0433\u043E
      \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u0433\u043E \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E
      \u0441\u0435\u0440\u043E\u0433\u043E \u043E\u0442\u0442\u0435\u043D\u043A\u0430.
      \u0422\u0435 \u0436\u0435 \u043A\u043E\u0441\u044B\u0435 \u043B\u0438\u043D\u0438\u0438
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044E\u0442\u0441\u044F \u043D\u0430
      \u043A\u0443\u043F\u043E\u043B\u044C\u043D\u043E\u0439 \u0432\u0435\u0440\u0445\u0443\u0448\u043A\u0435
      \u0438 \u0448\u0438\u0440\u043E\u043A\u043E\u043C \u043D\u0438\u0436\u043D\u0435\u043C
      \u0432\u043E\u0440\u043E\u0442\u0435, \u043D\u0435 \u0440\u0430\u0441\u043F\u0430\u0434\u0430\u044F\u0441\u044C
      \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0435 \u043F\u044F\u0442\u043D\u0430.
      \u041C\u0435\u0436\u0434\u0443 \u0432\u0435\u0440\u0445\u043E\u043C \u0438
      \u043B\u0438\u0446\u043E\u043C \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0443\u0437\u043A\u0430\u044F \u0442\u0451\u043C\u043D\u0430\u044F \u0449\u0435\u043B\u044C,
      \u0430 \u0447\u0435\u0442\u044B\u0440\u0435 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435
      \u043F\u0440\u043E\u0440\u0435\u0437\u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
      \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439 \u043F\u0430\u043D\u0435\u043B\u0438
      \u0435\u0451 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u0439 \u0441\u0442\u0440\u043E\u0433\u0438\u0439
      \u0440\u0438\u0442\u043C."
