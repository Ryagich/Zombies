  - m_Id: 89000000000000010
    m_Localized: "\u0421\u0435\u0440\u0430\u044F \u043C\u0430\u0441\u043A\u0430 \u0441\u043E\u0431\u0440\u0430\u043D\u0430
      \u0432 \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u0443\u044E \u0432\u043E\u043B\u0447\u044C\u044E
      \u043C\u043E\u0440\u0434\u0443 \u0441 \u0432\u044B\u0441\u043E\u043A\u0438\u043C\u0438
      \u0443\u0448\u0430\u043C\u0438, \u0443\u0437\u043A\u0438\u043C\u0438 \u0433\u043B\u0430\u0437\u043D\u0438\u0446\u0430\u043C\u0438
      \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0439 \u0441\u0438\u043D\u0435\u0439
      \u043C\u043E\u0447\u043A\u043E\u0439 \u043D\u043E\u0441\u0430. \u0420\u044F\u0434
      \u0441\u0432\u0435\u0442\u043B\u044B\u0445 \u0437\u0443\u0431\u043E\u0432 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0432\u0438\u0434\u0435\u043D \u043F\u043E\u0434 \u043F\u0440\u0438\u043F\u043E\u0434\u043D\u044F\u0442\u043E\u0439
      \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0433\u0443\u0431\u043E\u0439,
      \u0430 \u043D\u0438\u0436\u043D\u0438\u0435 \u0447\u0430\u0441\u0442\u0438
      \u043C\u0430\u0441\u043A\u0438 \u043E\u0431\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443 \u0438 \u0448\u0435\u044E \u0448\u0438\u0440\u043E\u043A\u0438\u043C\u0438
      \u0441\u043A\u043B\u0430\u0434\u043A\u0430\u043C\u0438. \u0427\u0451\u0442\u043A\u0438\u0435
      \u0441\u0435\u0440\u044B\u0435 \u0433\u0440\u0430\u043D\u0438 \u0434\u0435\u043B\u0430\u044E\u0442
      \u0437\u0432\u0435\u0440\u0438\u043D\u044B\u0439 \u043E\u0431\u0440\u0430\u0437
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0438
      \u0437\u043B\u044B\u043C, \u0431\u0435\u0437 \u0438\u0437\u043B\u0438\u0448\u043D\u0435\u0439
      \u0442\u0435\u0430\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 90000000000000001
    m_Localized: "\u0422\u0451\u043C\u043D\u044B\u0439 \u0443\u0437\u043E\u0440\u0447\u0430\u0442\u044B\u0439
      \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0439 \u0443\u0431\u043E\u0440"
    m_Metadata:
