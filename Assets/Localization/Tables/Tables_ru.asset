  - m_Id: 80000000000000032
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u044B\u0439 \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u043A
      \u0441 \u0442\u0451\u043C\u043D\u044B\u043C \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C
      \u0440\u0438\u0441\u0443\u043D\u043A\u043E\u043C \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0431\u0451\u0434\u0435\u0440, \u0430 \u0448\u0438\u0440\u043E\u043A\u0438\u0435
      \u0431\u043E\u043A\u043E\u0432\u044B\u0435 \u043F\u043E\u043B\u044B \u0443\u0445\u043E\u0434\u044F\u0442
      \u043D\u0430\u0437\u0430\u0434. \u0412\u0435\u0449\u044C \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0441\u044F
      \u0441\u043B\u043E\u0436\u043D\u0435\u0435 \u043F\u0440\u043E\u0441\u0442\u043E\u0439
      \u044E\u0431\u043A\u0438, \u043E\u0434\u043D\u0430\u043A\u043E \u0448\u0432\u044B
      \u0438 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F
