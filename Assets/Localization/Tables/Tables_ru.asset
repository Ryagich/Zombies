      m_Items: []
  - m_Id: 85000000000000008
    m_Localized: "\u0422\u0451\u043C\u043D\u0430\u044F \u043C\u0430\u0441\u043A\u0430
      \u0441 \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0432\u0435\u0440\u0445\u043D\u0435\u0439
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043E\u0439 \u0438 \u0440\u043E\u0432\u043D\u043E\u0439
      \u0433\u0440\u0430\u043D\u0451\u043D\u043E\u0439 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439
      \u0447\u0430\u0441\u0442\u044C\u044E; \u043A \u043D\u0438\u0437\u0443 \u043E\u043D\u0430
      \u0441\u0443\u0436\u0430\u0435\u0442\u0441\u044F \u0442\u044F\u0436\u0451\u043B\u044B\u043C
      \u043A\u043B\u0438\u043D\u043E\u043C. \u0418\u0437\u0434\u0430\u043B\u0435\u043A\u0430
      \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441\u043B\u043E\u0438 \u0444\u043E\u0440\u043C\u044B \u0438 \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u044B\u0439
      \u0441\u0438\u043B\u0443\u044D\u0442, \u0431\u0435\u0437 \u0431\u043B\u0435\u0441\u043A\u0430
      \u0438 \u043B\u0438\u0448\u043D\u0438\u0445 \u0437\u043D\u0430\u043A\u043E\u0432.
      \u0412 \u043D\u0435\u0439 \u043D\u0435\u0442 \u043F\u043E\u043A\u0430\u0437\u043D\u043E\u0439
      \u0443\u0433\u0440\u043E\u0437\u044B \u2014 \u043E\u0442\u0442\u043E\u0433\u043E
      \u043E\u043D\u0430 \u0438 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 85000000000000009
    m_Localized: "\u041A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u0430\u044F \u0433\u043B\u0443\u0445\u0430\u044F
      \u043C\u0430\u0441\u043A\u0430"
