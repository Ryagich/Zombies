    m_Localized: "\u0428\u0438\u0440\u043E\u043A\u043E\u0435 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u0435
      \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449\u0435 \u0441 \u0431\u0435\u043B\u043E\u0439
      \u043A\u0430\u0439\u043C\u043E\u0439 \u0441\u0432\u0438\u0441\u0430\u0435\u0442
      \u043E\u0442 \u043F\u043E\u044F\u0441\u0430 \u043F\u043E\u0447\u0442\u0438
      \u0434\u043E \u043A\u043E\u043B\u0435\u043D. \u041E\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E\u0435
      \u043F\u043E \u0444\u043E\u0440\u043C\u0435, \u043D\u043E \u0437\u0430\u043C\u0435\u0442\u043D\u043E
      \u0432\u044B\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0441\u0438\u043B\u0443\u044D\u0442
      \u0438 \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0448\u0442\u0430\u043D\u044B \u043E\u0442 \u0431\u0440\u044B\u0437\u0433,
      \u043F\u044B\u043B\u0438 \u0438 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0433\u043E
      \u0442\u0440\u0435\u043D\u0438\u044F."
