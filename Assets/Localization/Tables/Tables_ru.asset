  - m_Id: 83000000000000018
    m_Localized: "\u0421\u0442\u0440\u043E\u0439\u043D\u044B\u0439 \u043B\u044E\u043F\u0438\u043D
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0436\u0451\u043B\u0442\u044B\u0435
      \u0446\u0432\u0435\u0442\u043A\u0438 \u043E\u0434\u0438\u043D \u043D\u0430\u0434
      \u0434\u0440\u0443\u0433\u0438\u043C \u043D\u0430\u0434 \u0448\u0438\u0440\u043E\u043A\u0438\u043C\u0438
      \u043B\u0438\u0441\u0442\u044C\u044F\u043C\u0438. \u0410\u043F\u0442\u0435\u043A\u0430\u0440\u0438
      \u0446\u0435\u043D\u044F\u0442 \u0435\u0433\u043E \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u0441\u043B\u0435 \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438: \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
      \u0441\u0434\u0435\u043B\u0430\u043D\u043D\u0430\u044F \u0432\u044B\u0442\u044F\u0436\u043A\u0430
      \u0438\u0434\u0451\u0442 \u0432 \u043A\u0440\u0435\u043F\u043A\u0438\u0435
      \u043D\u0430\u0440\u0443\u0436\u043D\u044B\u0435 \u0441\u043E\u0441\u0442\u0430\u0432\u044B
      \u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442, \u043F\u043E\u0447\u0435\u043C\u0443
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0435 \u0437\u0430\u043C\u0435\u0442\u043D\u043E
      \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F.
      \u0421\u044B\u0440\u044B\u043C \u043B\u044E\u043F\u0438\u043D \u043D\u0435
      \u0435\u0434\u044F\u0442 \u0438 \u043D\u0435 \u0437\u0430\u0432\u0430\u0440\u0438\u0432\u0430\u044E\u0442
      \u2014 \u0435\u0433\u043E \u0433\u043E\u0440\u0435\u0447\u044C \u0441\u043B\u0443\u0436\u0438\u0442
      \u043D\u0435 \u0432\u043A\u0443\u0441\u043E\u043C, \u0430 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435\u043C."
