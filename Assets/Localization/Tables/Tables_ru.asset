      m_Items: []
  - m_Id: 80000000000000047
    m_Localized: "\u041F\u043E\u043B\u043E\u0441\u0430\u0442\u0430\u044F \u043F\u043E\u044F\u0441\u043D\u0430\u044F
      \u044E\u0431\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 80000000000000048
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u0430\u044F \u043F\u043E\u044F\u0441\u043D\u0430\u044F
      \u044E\u0431\u043A\u0430 \u0441\u043E\u0431\u0440\u0430\u043D\u0430 \u0438\u0437
      \u0448\u0438\u0440\u043E\u043A\u0438\u0445 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0445
      \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449 \u0438 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0447\u0435\u043D\u0430
      \u0434\u0432\u0443\u043C\u044F \u0442\u0451\u043C\u043D\u044B\u043C\u0438 \u0440\u0435\u043C\u043D\u044F\u043C\u0438.
      \u0420\u043E\u0432\u043D\u044B\u0435 \u043F\u043E\u043B\u043E\u0441\u044B \u0442\u043A\u0430\u043D\u0438
      \u0434\u0435\u0440\u0436\u0430\u0442 \u0444\u043E\u0440\u043C\u0443, \u0430
      \u0440\u0435\u043C\u043D\u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442
      \u043F\u043E\u0434\u043E\u0433\u043D\u0430\u0442\u044C \u0432\u0435\u0449\u044C
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0436\u043D\u043E\u0439 \u0448\u043D\u0443\u0440\u043E\u0432\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 80000000000000049
    m_Localized: "\u041D\u0430\u043A\u0438\u0434\u043A\u0430 \u0441 \u0442\u0451\u043C\u043D\u043E\u0439
      \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439 \u0432\u0441\u0442\u0430\u0432\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 80000000000000050
    m_Localized: "\u041A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u0430\u044F \u043D\u0430\u043A\u0438\u0434\u043A\u0430
      \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043F\u043E \u0431\u043E\u043A\u0430\u043C
      \u043E\u0442 \u0441\u0432\u0435\u0442\u043B\u043E\u0439 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439
      \u0432\u0441\u0442\u0430\u0432\u043A\u0438 \u0441 \u0442\u0451\u043C\u043D\u043E\u0439
      \u043E\u043A\u0430\u043D\u0442\u043E\u0432\u043A\u043E\u0439. \u041A\u043E\u0440\u043E\u0442\u043A\u0438\u0435
      \u0440\u0430\u0437\u0440\u0435\u0437\u044B \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
      \u043A\u043E\u043B\u0435\u043D\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u043C\u0438,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432\u0435\u0449\u044C \u0433\u043E\u0434\u0438\u0442\u0441\u044F
      \u0434\u043B\u044F \u0445\u043E\u0434\u044C\u0431\u044B, \u0430 \u043D\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0433\u043E
      \u0441\u0442\u043E\u044F\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 80000000000000051
    m_Localized: "\u041F\u043E\u043B\u043E\u0441\u0430\u0442\u0430\u044F \u043D\u0430\u043A\u0438\u0434\u043A\u0430
      \u0441 \u043F\u043E\u0434\u0432\u0435\u0441\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 80000000000000052
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0435 \u0441\u0432\u0435\u0442\u043B\u044B\u0435
      \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449\u0430 \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u044B
      \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u043C\u0438 \u043F\u043E\u043B\u043E\u0441\u0430\u043C\u0438,
      \u0430 \u043D\u0430\u0434 \u0448\u0442\u0430\u043D\u0430\u043C\u0438 \u0432\u0438\u0441\u044F\u0442
      \u0442\u0440\u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043F\u043E\u0434\u0432\u0435\u0441\u043A\u0438.
      \u041E\u043D\u0438 \u043E\u0436\u0438\u0432\u043B\u044F\u044E\u0442 \u043F\u043E\u044F\u0441,
      \u043D\u043E \u043D\u0435 \u043C\u0435\u0448\u0430\u044E\u0442 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044E
      \u0438 \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u044E\u0442 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0442\u044C
      \u0432\u0441\u044E \u0432\u0435\u0449\u044C \u0432 \u0442\u044F\u0436\u0451\u043B\u043E\u0435
      \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 80000000000000053
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u0430\u044F \u043D\u0430\u043A\u0438\u0434\u043A\u0430
      \u0441 \u0442\u0440\u043E\u0439\u043D\u043E\u0439 \u0431\u0430\u0445\u0440\u043E\u043C\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 80000000000000054
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0435 \u043F\u043E\u043B\u043E\u0441\u0430\u0442\u044B\u0435
      \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449\u0430 \u043E\u0431\u0440\u0430\u043C\u043B\u044F\u044E\u0442
      \u0431\u0451\u0434\u0440\u0430, \u0430 \u043D\u0430\u0434 \u0448\u0442\u0430\u043D\u0430\u043C\u0438
      \u0432\u0438\u0441\u044F\u0442 \u0442\u0440\u0438 \u0437\u0430\u043E\u0441\u0442\u0440\u0451\u043D\u043D\u044B\u0435
      \u043F\u043E\u0434\u0432\u0435\u0441\u043A\u0438. \u0411\u0430\u0445\u0440\u043E\u043C\u0430
      \u0437\u0430\u043C\u0435\u0442\u043D\u0430 \u043F\u0440\u0438 \u0445\u043E\u0434\u044C\u0431\u0435,
      \u043D\u043E \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0432\u044B\u0448\u0435
      \u043A\u043E\u043B\u0435\u043D \u0438 \u043D\u0435 \u043C\u0435\u0448\u0430\u0435\u0442
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 81000000000000001
    m_Localized: "\u041C\u0430\u0441\u0441\u043E\u0432\u044B\u0439 \u043C\u0435\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 81000000000000002
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u043C\u0435\u0447 \u0441\u0435\u0440\u0438\u0439\u043D\u043E\u0439
      \u043A\u043E\u0432\u043A\u0438 \u0441 \u043F\u0440\u044F\u043C\u044B\u043C
      \u043A\u043B\u0438\u043D\u043A\u043E\u043C, \u0440\u0430\u0437\u0432\u0438\u0442\u043E\u0439
      \u043A\u0440\u0435\u0441\u0442\u043E\u0432\u0438\u043D\u043E\u0439 \u0438 \u043A\u043E\u0436\u0430\u043D\u043E\u0439
      \u0440\u0443\u043A\u043E\u044F\u0442\u044C\u044E. \u0415\u0433\u043E \u0434\u0435\u043B\u0430\u044E\u0442
      \u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438 \u043F\u0430\u0440\u0442\u0438\u044F\u043C\u0438
      \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u043E\u0431\u0440\u0430\u0437\u0446\u0443,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0446\u0435\u043D\u0430 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0439 \u2014 \u0437\u0430
      \u0441\u0432\u043E\u0438 \u0434\u0435\u043D\u044C\u0433\u0438 \u044D\u0442\u043E
      \u0447\u0435\u0441\u0442\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440.
      \u0421\u0442\u0430\u043B\u044C \u0437\u0434\u0435\u0441\u044C \u0431\u0435\u0437
      \u0437\u0430\u043F\u0430\u0441\u0430 \u043D\u0430 \u0442\u043E\u043D\u043A\u0443\u044E
      \u0440\u0430\u0431\u043E\u0442\u0443, \u0430 \u0431\u0430\u043B\u0430\u043D\u0441
      \u043D\u0435 \u043F\u043E\u0440\u0430\u0434\u0443\u0435\u0442 \u0438\u0441\u043A\u0443\u0448\u0451\u043D\u043D\u043E\u0433\u043E
      \u0444\u0435\u0445\u0442\u043E\u0432\u0430\u043B\u044C\u0449\u0438\u043A\u0430:
      \u0432 \u0434\u043E\u043B\u0433\u043E\u043C \u0431\u043E\u044E \u0440\u0443\u043A\u0430
      \u0443\u0441\u0442\u0430\u043D\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435.
      \u041D\u043E \u043A\u043B\u0438\u043D\u043E\u043A \u0441\u043E\u0431\u0440\u0430\u043D
      \u0434\u043E\u0431\u0440\u043E\u0442\u043D\u043E, \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E
      \u0442\u043E\u0447\u0438\u0442\u0441\u044F \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442
      \u0442\u043E, \u0440\u0430\u0434\u0438 \u0447\u0435\u0433\u043E \u0435\u0433\u043E
      \u043F\u043E\u043A\u0443\u043F\u0430\u044E\u0442. \u0422\u0430\u043A\u043E\u0439
      \u043C\u0435\u0447 \u0431\u0435\u0440\u0443\u0442 \u0442\u0435, \u043A\u043E\u043C\u0443
      \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
      \u043E\u0440\u0443\u0436\u0438\u0435 \u0441\u0435\u0439\u0447\u0430\u0441,
      \u0430 \u043D\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      \u0433\u043E\u0434\u0430\u043C\u0438 \u043A\u043E\u043F\u0438\u0442\u044C \u043D\u0430
      \u0440\u0430\u0431\u043E\u0442\u0443 \u043C\u0430\u0441\u0442\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 82000000000000001
    m_Localized: "\u041D\u0430\u0440\u0443\u0447\u0438 \u0441 \u0440\u043E\u043C\u0431\u043E\u0432\u0438\u0434\u043D\u044B\u043C\u0438
      \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 82000000000000002
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u044B\u0435 \u043C\u043D\u043E\u0433\u043E\u0441\u043B\u043E\u0439\u043D\u044B\u0435
      \u043D\u0430\u0440\u0443\u0447\u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u044F, \u0430 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0435
      \u043A\u043E\u0436\u0430\u043D\u044B\u0435 \u0447\u0430\u0441\u0442\u0438 \u0441\u0442\u044F\u043D\u0443\u0442\u044B
      \u0440\u0435\u043C\u043D\u044F\u043C\u0438 \u0438 \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u044B
      \u0440\u043E\u043C\u0431\u043E\u0432\u0438\u0434\u043D\u044B\u043C\u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430\u043C\u0438.
      \u0421\u0431\u043E\u0440\u043D\u044B\u0439 \u043A\u0440\u043E\u0439 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043B\u043E\u043A\u0442\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u043C\u0438
      \u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C
      \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D\u043D\u044B\u0439 \u0440\u0435\u043C\u0435\u043D\u044C,
      \u043D\u0435 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044F \u0432\u0441\u044E
      \u0432\u0435\u0449\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 82000000000000003
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0435 \u0442\u0451\u043C\u043D\u044B\u0435
      \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 82000000000000004
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0435 \u0442\u0451\u043C\u043D\u044B\u0435
      \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u043A\u0438\u0441\u0442\u044C \u0438 \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u044F,
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u043F\u0430\u043B\u044C\u0446\u0430\u043C
      \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0443\u044E \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0441\u0442\u044C.
      \u0422\u0430\u043A\u043E\u0439 \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u043F\u043E\u043A\u0440\u043E\u0439
      \u0431\u0435\u0440\u0435\u0436\u0451\u0442 \u0440\u0443\u043A\u0438 \u043E\u0442
      \u0433\u0440\u044F\u0437\u0438, \u0440\u0435\u043C\u043D\u0435\u0439 \u0438
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E \u0436\u0435\u043B\u0435\u0437\u0430,
      \u043D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0443
      \u0441 \u043C\u0435\u043B\u043E\u0447\u044C\u044E \u0432 \u043C\u0443\u0447\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 82000000000000005
    m_Localized: "\u041A\u043E\u0436\u0430\u043D\u044B\u0435 \u0440\u0443\u043A\u0430\u0432\u0438\u0446\u044B
      \u0441 \u0431\u0435\u043B\u043E\u0439 \u043E\u0431\u043C\u043E\u0442\u043A\u043E\u0439"
