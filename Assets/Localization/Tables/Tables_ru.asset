  - m_Id: 90000000000000004
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0439
      \u043A\u0430\u043F\u044E\u0448\u043E\u043D \u0441\u043E\u0431\u0440\u0430\u043D
      \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043E\u043A\u0440\u0443\u0433\u043B\u043E\u0439
      \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0447\u0430\u0441\u0442\u044C\u044E
      \u0438 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u043C \u0432\u044B\u0440\u0435\u0437\u043E\u043C
      \u0434\u043B\u044F \u043B\u0438\u0446\u0430. \u041E\u0442 \u0432\u0438\u0441\u043A\u043E\u0432
      \u0438 \u0437\u0430\u0442\u044B\u043B\u043A\u0430 \u0432\u043D\u0438\u0437
      \u0441\u0432\u0438\u0441\u0430\u044E\u0442 \u0434\u043B\u0438\u043D\u043D\u044B\u0435
      \u043F\u0440\u044F\u043C\u044B\u0435 \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449\u0430,
      \u043F\u043E\u0447\u0442\u0438 \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u044E\u0449\u0438\u0435
      \u043F\u043B\u0435\u0447; \u0438\u0445 \u0440\u043E\u0432\u043D\u044B\u0435
      \u043A\u0440\u0430\u044F \u0434\u0435\u043B\u0430\u044E\u0442 \u0441\u0438\u043B\u0443\u044D\u0442
      \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u044B\u043C \u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u043C.
      \u0423\u0431\u043E\u0440 \u043D\u0438\u0447\u0435\u043C \u043D\u0435 \u0443\u043A\u0440\u0430\u0448\u0435\u043D,
      \u0437\u0430\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u043A\u0430\u043A \u0446\u0435\u043B\u044C\u043D\u0430\u044F \u0432\u0435\u0449\u044C,
      \u0430 \u043D\u0435 \u043A\u0430\u043A \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E
      \u043D\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u0430\u044F \u043D\u0430
      \u0433\u043E\u043B\u043E\u0432\u0443 \u043D\u0430\u043A\u0438\u0434\u043A\u0430."
