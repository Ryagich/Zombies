  - m_Id: 80000000000000022
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u044B\u0435 \u0431\u043E\u043A\u043E\u0432\u044B\u0435
      \u043F\u043E\u043B\u044B \u043B\u0435\u0436\u0430\u0442 \u043F\u043E\u0432\u0435\u0440\u0445
      \u0448\u0438\u0440\u043E\u043A\u0438\u0445 \u0442\u0451\u043C\u043D\u044B\u0445
      \u0448\u0442\u0430\u043D\u043E\u0432 \u0438 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0432\u044B\u0448\u0435 \u043A\u043E\u043B\u0435\u043D\u0430. \u041E\u043D\u0438
      \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442 \u0441\u043B\u043E\u0451\u0432
      \u0432 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443,
      \u043D\u043E \u043D\u0435 \u043C\u0435\u0448\u0430\u044E\u0442 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u0434\u043B\u0438\u043D\u043D\u0430\u044F
      \u044E\u0431\u043A\u0430 \u0446\u0435\u043F\u043B\u044F\u043B\u0430\u0441\u044C
      \u0431\u044B \u0437\u0430 \u0437\u0435\u043C\u043B\u044E."
