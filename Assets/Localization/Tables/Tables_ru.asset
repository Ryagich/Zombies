  - m_Id: 88000000000000004
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u0430\u044F \u043A\u0443\u043F\u043E\u043B\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u0430\u044F
      \u0432\u0435\u0440\u0445\u043D\u044F\u044F \u0447\u0430\u0441\u0442\u044C \u043D\u0430\u0432\u0438\u0441\u0430\u0435\u0442
      \u043D\u0430\u0434 \u0442\u0451\u043C\u043D\u043E\u0439 \u043B\u0438\u0446\u0435\u0432\u043E\u0439
      \u043F\u0430\u043D\u0435\u043B\u044C\u044E \u0438 \u0448\u0438\u0440\u043E\u043A\u0438\u043C
      \u043D\u0438\u0436\u043D\u0438\u043C \u043E\u0431\u0440\u0430\u043C\u043B\u0435\u043D\u0438\u0435\u043C
      \u0441 \u043D\u0435\u0440\u043E\u0432\u043D\u044B\u043C \u0443\u0437\u043E\u0440\u043E\u043C.
      \u041E\u0442 \u043A\u0440\u0430\u044F \u0441\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043F\u0440\u044F\u043C\u043E\u0439
      \u044F\u0437\u044B\u0447\u043E\u043A, \u0434\u0435\u043B\u044F \u043F\u0435\u0440\u0435\u0434\u043D\u044E\u044E
      \u0447\u0430\u0441\u0442\u044C \u043D\u0430\u0434\u0432\u043E\u0435. \u041A\u043E\u043D\u0442\u0440\u0430\u0441\u0442
      \u0441\u0432\u0435\u0442\u043B\u043E\u0433\u043E \u0432\u0435\u0440\u0445\u0430
      \u0438 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0433\u043E \u0441\u0438\u043D\u0435\u0433\u043E
      \u043B\u0438\u0446\u0430 \u0434\u0435\u043B\u0430\u0435\u0442 \u0441\u0438\u043B\u0443\u044D\u0442
      \u0441\u0442\u0440\u043E\u0433\u0438\u043C \u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C,
      \u0434\u0430\u0436\u0435 \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0439."
