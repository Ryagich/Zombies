  - m_Id: 89000000000000008
    m_Localized: "\u0413\u0440\u0443\u0431\u0430\u044F \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u0430\u044F
      \u043C\u0430\u0441\u043A\u0430 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442
      \u0442\u044F\u0436\u0451\u043B\u0443\u044E \u0433\u043E\u043B\u043E\u0432\u0443
      \u043C\u0435\u0434\u0432\u0435\u0434\u044F: \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435
      \u0443\u0448\u0438 \u0441\u0442\u043E\u044F\u0442 \u043D\u0430\u0434 \u0448\u0438\u0440\u043E\u043A\u0438\u043C
      \u043B\u0431\u043E\u043C, \u0447\u0451\u0440\u043D\u044B\u0439 \u043D\u043E\u0441
      \u0432\u044B\u0434\u0432\u0438\u043D\u0443\u0442 \u0434\u0430\u043B\u0435\u043A\u043E
      \u0432\u043F\u0435\u0440\u0451\u0434, \u0430 \u0438\u0437 \u043F\u0440\u0438\u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439
      \u043F\u0430\u0441\u0442\u0438 \u0432\u0438\u0434\u043D\u044B \u0441\u0432\u0435\u0442\u043B\u044B\u0435
      \u0437\u0443\u0431\u044B. \u041E\u0442 \u0433\u043E\u043B\u043E\u0432\u044B
      \u0432\u043D\u0438\u0437 \u0441\u0432\u0438\u0441\u0430\u044E\u0442 \u0434\u043B\u0438\u043D\u043D\u044B\u0435
      \u0431\u043E\u043A\u043E\u0432\u044B\u0435 \u0447\u0430\u0441\u0442\u0438,
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0449\u0438\u0435 \u0432 \u043A\u0430\u043F\u044E\u0448\u043E\u043D.
      \u0412\u0435\u0449\u044C \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u043D\u0435
      \u043D\u0430 \u043A\u0440\u0430\u0441\u043E\u0442\u0435, \u0430 \u043D\u0430
      \u0443\u0437\u043D\u0430\u0432\u0430\u0435\u043C\u043E\u043C \u0437\u0432\u0435\u0440\u0438\u043D\u043E\u043C
      \u0441\u0438\u043B\u0443\u044D\u0442\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0442\u0440\u0443\u0434\u043D\u043E \u043F\u0440\u0438\u043D\u044F\u0442\u044C
      \u0437\u0430 \u0447\u0442\u043E-\u0442\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0435."
