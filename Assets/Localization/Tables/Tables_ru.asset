  - m_Id: 91000000000000008
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u0430\u044F \u0441\u0432\u0435\u0442\u043B\u0430\u044F
      \u0432\u0435\u0440\u0448\u0438\u043D\u0430 \u0448\u043B\u0435\u043C\u0430 \u043E\u0431\u0440\u0430\u043C\u043B\u0435\u043D\u0430
      \u0442\u0451\u043C\u043D\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u043E\u0439
      \u0438 \u043C\u044F\u0433\u043A\u043E \u0441\u0445\u043E\u0434\u0438\u0442
      \u043A \u0443\u0437\u043A\u043E\u0439 \u043B\u0438\u0446\u0435\u0432\u043E\u0439
      \u0447\u0430\u0441\u0442\u0438. \u041F\u043E \u0431\u043E\u043A\u0430\u043C
      \u043E\u0442 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u044B \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B
      \u0447\u0435\u0442\u044B\u0440\u0435 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435
      \u0441\u043C\u043E\u0442\u0440\u043E\u0432\u044B\u0435 \u043F\u0440\u043E\u0440\u0435\u0437\u0438,
      \u0430 \u043D\u0438\u0436\u0435 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F
      \u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u0433\u0440\u0430\u043D\u0451\u043D\u044B\u0439
      \u0432\u043E\u0440\u043E\u0442. \u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435
      \u043E\u0442 \u0433\u0440\u0435\u0431\u0435\u043D\u0447\u0430\u0442\u043E\u0433\u043E
      \u0448\u043B\u0435\u043C\u0430, \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u0442
      \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u044E\u0449\u0435\u0433\u043E \u0440\u0435\u0431\u0440\u0430:
      \u0444\u043E\u0440\u043C\u0443 \u0434\u0435\u0440\u0436\u0438\u0442 \u0447\u0438\u0441\u0442\u0430\u044F
      \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u0430\u044F \u043B\u0438\u043D\u0438\u044F
      \u043E\u0442 \u043C\u0430\u043A\u0443\u0448\u043A\u0438 \u0434\u043E \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043A\u0430."
