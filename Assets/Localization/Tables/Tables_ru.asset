  - m_Id: 88000000000000008
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u044B\u0439 \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0439
      \u0443\u0431\u043E\u0440 \u0441\u043E\u0431\u0440\u0430\u043D \u0438\u0437
      \u043E\u0441\u0442\u0440\u044B\u0445 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u044E\u0449\u0438\u0445\u0441\u044F
      \u0441\u043A\u043B\u0430\u0434\u043E\u043A: \u043E\u0434\u043D\u0430 \u0434\u043B\u0438\u043D\u043D\u0430\u044F
      \u043F\u043E\u043B\u043E\u0441\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430\u0434 \u043C\u0430\u043A\u0443\u0448\u043A\u043E\u0439, \u0434\u0440\u0443\u0433\u0438\u0435
      \u0443\u0445\u043E\u0434\u044F\u0442 \u043F\u043E \u0431\u043E\u043A\u0430\u043C
      \u043D\u0438\u0436\u0435 \u043F\u043B\u0435\u0447. \u041F\u0435\u0440\u0435\u0434\u043D\u044F\u044F
      \u0447\u0430\u0441\u0442\u044C \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442
      \u0443\u0437\u043A\u0438\u0439 \u043A\u043E\u0441\u043E\u0439 \u0432\u044B\u0440\u0435\u0437,
      \u0430 \u0442\u0451\u043C\u043D\u0430\u044F \u043E\u043A\u0430\u043D\u0442\u043E\u0432\u043A\u0430
      \u043F\u043E\u0434\u0447\u0451\u0440\u043A\u0438\u0432\u0430\u0435\u0442 \u043A\u0440\u043E\u043C\u043A\u0438
      \u0438 \u043A\u043E\u043D\u0446\u044B. \u0412\u0435\u0449\u044C \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0441\u043B\u043E\u0436\u043D\u043E\u0439 \u043D\u0435 \u0438\u0437-\u0437\u0430
      \u043F\u044B\u0448\u043D\u043E\u0441\u0442\u0438, \u0430 \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u043A\u0430\u0436\u0434\u0430\u044F \u0435\u0451 \u0441\u043A\u043B\u0430\u0434\u043A\u0430
      \u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435."
