  - m_Id: 88000000000000006
    m_Localized: "\u0428\u0438\u0440\u043E\u043A\u0438\u0435 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0435
      \u043F\u043E\u043B\u044F \u0440\u0435\u0437\u043A\u043E \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u044E\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0438 \u0441\u043B\u0435\u0433\u043A\u0430
      \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F \u043F\u043E \u043A\u0440\u0430\u044F\u043C,
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u043D\u0430\u0434 \u043B\u0438\u0446\u043E\u043C
      \u0433\u043B\u0443\u0431\u043E\u043A\u0443\u044E \u0442\u0435\u043D\u044C.
      \u041F\u043E\u0434 \u043D\u0438\u043C\u0438 \u0432\u0438\u0434\u043D\u0430
      \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0442\u0443\u043B\u044C\u044F \u0438
      \u043D\u0438\u0441\u043F\u0430\u0434\u0430\u044E\u0449\u0438\u0435 \u0431\u043E\u043A\u043E\u0432\u044B\u0435
      \u0447\u0430\u0441\u0442\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442 \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0439
      \u0443\u0431\u043E\u0440 \u0432\u043E\u043A\u0440\u0443\u0433 \u0449\u0451\u043A
      \u0438 \u0448\u0435\u0438. \u041F\u0440\u043E\u0441\u0442\u0430\u044F \u0433\u0430\u043C\u043C\u0430
      \u0438 \u0442\u044F\u0436\u0451\u043B\u044B\u0435 \u0441\u043A\u043B\u0430\u0434\u043A\u0438
      \u0434\u0435\u043B\u0430\u044E\u0442 \u0435\u0433\u043E \u043F\u043E\u0445\u043E\u0436\u0438\u043C
      \u043D\u0430 \u0432\u0435\u0449\u044C, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442 \u0437\u0430 \u0443\u043A\u0440\u044B\u0442\u0438\u0435,
      \u0430 \u043D\u0435 \u0437\u0430 \u043F\u0430\u0440\u0430\u0434\u043D\u044B\u0439
      \u0432\u0438\u0434."
