  - m_Id: 82000000000000006
    m_Localized: "\u041A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0435 \u043A\u043E\u0436\u0430\u043D\u044B\u0435
      \u0440\u0443\u043A\u0430\u0432\u0438\u0446\u044B \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u044B
      \u0441\u0432\u0435\u0442\u043B\u043E\u0439 \u043E\u0431\u043C\u043E\u0442\u043A\u043E\u0439
      \u0443 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F \u0438 \u0434\u0432\u0443\u043C\u044F
      \u0440\u043E\u043C\u0431\u043E\u0432\u0438\u0434\u043D\u044B\u043C\u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430\u043C\u0438
      \u043D\u0430 \u0442\u044B\u043B\u044C\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435.
      \u041E\u043D\u0438 \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u043F\u0440\u043E\u0447\u043D\u0435\u0435
      \u043E\u0431\u044B\u0447\u043D\u044B\u0445 \u043F\u0435\u0440\u0447\u0430\u0442\u043E\u043A
      \u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F \u043D\u0430 \u0440\u0443\u043A\u0435
      \u0434\u0430\u0436\u0435 \u0442\u0430\u043C, \u0433\u0434\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0447\u0430\u0441\u0442\u043E \u0442\u044F\u043D\u0443\u0442\u044C \u0437\u0430
      \u0440\u0435\u043C\u0435\u043D\u044C \u0438\u043B\u0438 \u0440\u0443\u043A\u043E\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 82000000000000007
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u0438\u0435 \u043F\u043E\u043D\u043E\u0436\u0438
      \u0441\u043E \u0441\u0432\u0435\u0442\u043B\u044B\u043C\u0438 \u0449\u0438\u0442\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 82000000000000008
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u0438\u0435 \u043F\u043E\u043D\u043E\u0436\u0438
      \u0441\u043E\u0431\u0440\u0430\u043D\u044B \u0438\u0437 \u0442\u0451\u043C\u043D\u043E\u0439
      \u043E\u0441\u043D\u043E\u0432\u044B, \u0441\u0432\u0435\u0442\u043B\u044B\u0445
      \u043D\u0430\u043A\u043B\u0430\u0434\u043E\u043A \u043D\u0430 \u0433\u043E\u043B\u0435\u043D\u0438
      \u0438 \u043F\u043B\u043E\u0442\u043D\u044B\u0445 \u0441\u0442\u0443\u043F\u043D\u0435\u0439.
      \u0417\u0430\u043E\u0441\u0442\u0440\u0451\u043D\u043D\u044B\u0439 \u043A\u0440\u0430\u0439
      \u0449\u0438\u0442\u043A\u0430 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043F\u0435\u0440\u0435\u0434 \u043D\u043E\u0433\u0438, \u0430 \u043F\u0440\u043E\u0441\u0442\u043E\u0439
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434 \u043A \u043E\u0431\u0443\u0432\u0438
      \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0439
      \u0441\u043B\u043E\u0436\u043D\u043E\u0439 \u0437\u0430\u0441\u0442\u0451\u0436\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000001
    m_Localized: "\u041A\u0440\u0430\u0441\u043D\u043E\u0435 \u044F\u0431\u043B\u043E\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000002
    m_Localized: "\u041A\u0440\u0443\u043F\u043D\u043E\u0435 \u044F\u0431\u043B\u043E\u043A\u043E
      \u0441 \u043F\u043B\u043E\u0442\u043D\u043E\u0439 \u043A\u043E\u0436\u0438\u0446\u0435\u0439
      \u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439 \u043F\u043B\u043E\u0434\u043E\u043D\u043E\u0436\u043A\u043E\u0439.
      \u0415\u0433\u043E \u0446\u0435\u043D\u044F\u0442 \u043D\u0435 \u0437\u0430
      \u0438\u0437\u044B\u0441\u043A\u0430\u043D\u043D\u043E\u0441\u0442\u044C, \u0430
      \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u043E\u043D\u043E \u0434\u0430\u0451\u0442
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u043B\u0430\u0434\u043A\u043E\u0439
      \u0432\u043B\u0430\u0433\u0438 \u0438 \u0431\u043E\u0434\u0440\u043E\u0441\u0442\u0438
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0435; \u0441\u0430\u0434\u043E\u0432\u043D\u0438\u043A\u0438
      \u0433\u043E\u0432\u043E\u0440\u044F\u0442, \u0447\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u0435\u0435
      \u044F\u0431\u043B\u043E\u043A\u043E \u0434\u043E\u043B\u0436\u043D\u043E \u0445\u0440\u0443\u0441\u0442\u043D\u0443\u0442\u044C
      \u0440\u0430\u043D\u044C\u0448\u0435, \u0447\u0435\u043C \u043F\u0443\u0442\u043D\u0438\u043A
      \u0443\u0441\u043F\u0435\u0435\u0442 \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043F\u0443\u0442\u044C. \u0412 \u043C\u0435\u0448\u043A\u0435
      \u0435\u0433\u043E \u0434\u0435\u0440\u0436\u0430\u0442 \u0441\u0432\u0435\u0440\u0445\u0443:
      \u043E\u0442 \u0443\u0434\u0430\u0440\u0430 \u043E\u043D\u043E \u0442\u0435\u043C\u043D\u0435\u0435\u0442
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043C \u043F\u043E\u0440\u0442\u0438\u0442\u0441\u044F
      \u043D\u0430 \u0432\u043A\u0443\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000003
    m_Localized: "\u0421\u0432\u0451\u043A\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000004
    m_Localized: "\u0422\u0451\u043C\u043D\u043E-\u043A\u0440\u0430\u0441\u043D\u044B\u0439
      \u043A\u043E\u0440\u043D\u0435\u043F\u043B\u043E\u0434, \u0432\u044B\u0442\u0430\u0449\u0435\u043D\u043D\u044B\u0439
      \u0438\u0437 \u0437\u0435\u043C\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u0433\u0440\u0443\u0431\u043E\u0439 \u0431\u043E\u0442\u0432\u043E\u0439.
      \u041E\u043D \u043D\u0435 \u0443\u0442\u043E\u043B\u0438\u0442 \u0436\u0430\u0436\u0434\u0443
      \u0442\u0430\u043A \u0449\u0435\u0434\u0440\u043E, \u043A\u0430\u043A \u0441\u0432\u0435\u0436\u0438\u0439
      \u043F\u043B\u043E\u0434, \u0437\u0430\u0442\u043E \u0434\u043E\u043B\u0433\u043E
      \u043B\u0435\u0436\u0438\u0442 \u0432 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u0435
      \u0438 \u043F\u0440\u0438\u0434\u0430\u0451\u0442 \u0441\u0438\u043B \u043F\u043E\u0441\u043B\u0435
      \u0441\u043A\u0443\u0434\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438.
      \u041D\u0430 \u043A\u0443\u0445\u043D\u044F\u0445 \u0441\u0432\u0451\u043A\u043B\u0443
      \u043B\u044E\u0431\u044F\u0442 \u0437\u0430 \u0441\u043B\u0430\u0434\u043A\u043E\u0432\u0430\u0442\u0443\u044E
      \u043F\u043B\u043E\u0442\u044C, \u0430 \u043F\u0440\u0430\u0447\u043A\u0438
      \u043D\u0435\u0434\u043E\u043B\u044E\u0431\u043B\u0438\u0432\u0430\u044E\u0442
      \u0437\u0430 \u0441\u043E\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0432\u044A\u0435\u0434\u0430\u0435\u0442\u0441\u044F \u0432 \u043F\u0430\u043B\u044C\u0446\u044B
      \u0438 \u0442\u043A\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000005
    m_Localized: "\u0411\u0440\u043E\u043A\u043A\u043E\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000006
    m_Localized: "\u041F\u043B\u043E\u0442\u043D\u0430\u044F \u0437\u0435\u043B\u0451\u043D\u0430\u044F
      \u0433\u043E\u043B\u043E\u0432\u043A\u0430 \u043D\u0430 \u0441\u0432\u0435\u0442\u043B\u043E\u043C
      \u0441\u0442\u0435\u0431\u043B\u0435, \u0441\u0440\u0435\u0437\u0430\u043D\u043D\u0430\u044F
      \u0434\u043E \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0438\u044F \u043C\u0435\u043B\u043A\u0438\u0445
      \u0431\u0443\u0442\u043E\u043D\u043E\u0432. \u0421\u0440\u0435\u0434\u0438
      \u043F\u043E\u0445\u043E\u0434\u043D\u044B\u0445 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u043E\u043D\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043D\u0435\u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E,
      \u0437\u0430\u0442\u043E \u043D\u0435 \u0432\u044F\u043D\u0435\u0442 \u0432
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0436\u0435 \u0434\u0435\u043D\u044C
      \u0438 \u0434\u0430\u0451\u0442 \u0442\u0435\u043B\u0443 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043E\u0431\u0435\u0449\u0430\u0435\u0442 \u0435\u0451
      \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u0439 \u0432\u043A\u0443\u0441.
      \u0421\u0442\u0430\u0440\u044B\u0435 \u043E\u0433\u043E\u0440\u043E\u0434\u043D\u0438\u043A\u0438
      \u0441\u0430\u0436\u0430\u044E\u0442 \u0435\u0451 \u0443 \u043A\u0440\u0430\u044F
      \u0433\u0440\u044F\u0434\u043A\u0438: \u0433\u043E\u0432\u043E\u0440\u044F\u0442,
      \u0447\u0435\u043C \u0445\u043E\u043B\u043E\u0434\u043D\u0435\u0435 \u043D\u043E\u0447\u044C,
      \u0442\u0435\u043C \u0447\u0435\u0441\u0442\u043D\u0435\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0435\u0451 \u0433\u043E\u0440\u0435\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000007
    m_Localized: "\u041C\u043E\u0440\u043A\u043E\u0432\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000008
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0439 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u0439
      \u043A\u043E\u0440\u043D\u0435\u043F\u043B\u043E\u0434 \u0441 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439
      \u0437\u0435\u043B\u0451\u043D\u043E\u0439 \u0431\u043E\u0442\u0432\u043E\u0439
      \u0438 \u0441\u043B\u0435\u0434\u043E\u043C \u0437\u0435\u043C\u043B\u0438
      \u0443 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F. \u041C\u043E\u0440\u043A\u043E\u0432\u044C
      \u043D\u0435 \u0442\u0435\u0447\u0451\u0442 \u0432 \u0441\u0443\u043C\u043A\u0435,
      \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043E\u0433\u043D\u044F
      \u0438 \u0442\u0435\u0440\u043F\u0438\u0442 \u0434\u043E\u0440\u043E\u0433\u0443
      \u043B\u0443\u0447\u0448\u0435 \u043D\u0435\u0436\u043D\u044B\u0445 \u043F\u043B\u043E\u0434\u043E\u0432;
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0435\u0451 \u0447\u0430\u0441\u0442\u043E
      \u0441\u0443\u044E\u0442 \u0432 \u043A\u0430\u0440\u043C\u0430\u043D \u043F\u0435\u0440\u0435\u0434
      \u0432\u044B\u0445\u043E\u0434\u043E\u043C, \u043D\u0435 \u0440\u0430\u0437\u0434\u0443\u043C\u044B\u0432\u0430\u044F.
      \u0427\u0435\u043C \u0441\u043B\u0430\u0449\u0435 \u043A\u043E\u0440\u0435\u043D\u044C,
      \u0442\u0435\u043C \u0441\u0442\u0430\u0440\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435
      \u0435\u0433\u043E \u043F\u0440\u044F\u0447\u0443\u0442 \u043E\u0442 \u043B\u043E\u0448\u0430\u0434\u0435\u0439
      \u0438 \u0434\u0435\u0442\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000009
    m_Localized: "\u041A\u0440\u0430\u0441\u043D\u044B\u0439 \u0442\u043E\u043C\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000010
    m_Localized: "\u0421\u043F\u0435\u043B\u044B\u0439 \u0442\u043E\u043C\u0430\u0442,
      \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u043E\u0442 \u0441\u043E\u043A\u0430
      \u0438 \u0435\u0449\u0451 \u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0439\u0441\u044F
      \u0437\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0443\u044E \u0437\u0435\u043B\u0451\u043D\u0443\u044E
      \u043F\u043B\u043E\u0434\u043E\u043D\u043E\u0436\u043A\u0443. \u041E\u043D
      \u0431\u044B\u0441\u0442\u0440\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0432\u043B\u0430\u0433\u0443 \u0443\u0441\u0442\u0430\u0432\u0448\u0435\u043C\u0443
      \u043F\u0443\u0442\u043D\u0438\u043A\u0443, \u043D\u043E \u043F\u043B\u043E\u0445\u043E
      \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442 \u0433\u0440\u0443\u0431\u043E\u0435
      \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435: \u043F\u043E\u043B\u043E\u0436\u0438\u0448\u044C
      \u0435\u0433\u043E \u043D\u0430 \u0434\u043D\u043E \u0441\u0443\u043C\u043A\u0438
      \u2014 \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C \u043A\u0440\u0430\u0441\u043D\u043E\u0435
      \u043F\u044F\u0442\u043D\u043E \u0432\u043C\u0435\u0441\u0442\u043E \u043F\u0440\u0438\u043F\u0430\u0441\u0430.
      \u041D\u0430 \u0440\u044B\u043D\u043A\u0430\u0445 \u0438\u0445 \u043F\u0440\u043E\u0434\u0430\u044E\u0442
      \u0440\u0430\u043D\u043D\u0438\u043C \u0443\u0442\u0440\u043E\u043C, \u043F\u043E\u043A\u0430
      \u0441\u043E\u043B\u043D\u0446\u0435 \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u043E
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043A\u043E\u0436\u0438\u0446\u0443
      \u0432\u044F\u043B\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000011
    m_Localized: "\u0420\u043E\u043C\u0430\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000012
    m_Localized: "\u0411\u0435\u043B\u044B\u0435 \u0433\u043E\u043B\u043E\u0432\u043A\u0438
      \u0440\u043E\u043C\u0430\u0448\u043A\u0438 \u0441 \u0436\u0451\u043B\u0442\u044B\u043C\u0438
      \u0441\u0435\u0440\u0434\u0446\u0435\u0432\u0438\u043D\u0430\u043C\u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442
      \u0432 \u0441\u0443\u0445\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443,
      \u043F\u043E\u043A\u0430 \u043B\u0435\u043F\u0435\u0441\u0442\u043A\u0438 \u043D\u0435
      \u043F\u043E\u0431\u0443\u0440\u0435\u043B\u0438. \u041F\u043E\u043B\u0435\u0432\u044B\u0435
      \u0442\u0440\u0430\u0432\u043D\u0438\u043A\u0438 \u0441\u0443\u0448\u0430\u0442
      \u0446\u0432\u0435\u0442\u043A\u0438 \u0434\u043B\u044F \u043C\u044F\u0433\u043A\u043E\u0433\u043E
      \u043D\u0430\u0441\u0442\u043E\u044F \u0438 \u0441\u0447\u0438\u0442\u0430\u044E\u0442
      \u0435\u0433\u043E \u043F\u0435\u0440\u0432\u043E\u0439 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u043F\u0440\u0438 \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u0438,
      \u0442\u0440\u0435\u0432\u043E\u0433\u0435 \u0438 \u043C\u0435\u043B\u043A\u0438\u0445
      \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0445 \u043D\u0435\u0434\u0443\u0433\u0430\u0445;
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0440\u043E\u043C\u0430\u0448\u043A\u0430
      \u043F\u043E\u043D\u0435\u043C\u043D\u043E\u0433\u0443 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0441\u0438\u043B\u044B, \u0430 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u043B\u0435\u0447\u0435\u043D\u0438\u0435.
      \u0412 \u0441\u0442\u0430\u0440\u044B\u0445 \u0437\u0430\u043F\u0438\u0441\u044F\u0445
      \u0435\u0451 \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0442\u0438\u0445\u043E\u0439
      \u0442\u0440\u0430\u0432\u043E\u0439: \u043E\u043D\u0430 \u043D\u0435 \u0442\u0432\u043E\u0440\u0438\u0442
      \u0447\u0443\u0434\u0435\u0441, \u043D\u043E \u0440\u0435\u0434\u043A\u043E
      \u0431\u044B\u0432\u0430\u0435\u0442 \u043B\u0438\u0448\u043D\u0435\u0439 \u0432
      \u0441\u0443\u043C\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000013
    m_Localized: "\u041A\u0440\u0430\u0441\u043D\u044B\u0435 \u0445\u0440\u0438\u0437\u0430\u043D\u0442\u0435\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000014
    m_Localized: "\u0413\u0443\u0441\u0442\u044B\u0435 \u043A\u0440\u0430\u0441\u043D\u043E\u0432\u0430\u0442\u044B\u0435
      \u0433\u043E\u043B\u043E\u0432\u043A\u0438 \u0445\u0440\u0438\u0437\u0430\u043D\u0442\u0435\u043C
      \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F \u043D\u0430 \u0441\u0442\u0435\u0431\u043B\u0435
      \u0434\u043E\u043B\u044C\u0448\u0435 \u043C\u043D\u043E\u0433\u0438\u0445 \u043F\u043E\u043B\u0435\u0432\u044B\u0445
      \u0446\u0432\u0435\u0442\u043E\u0432. \u0418\u0445 \u0440\u0435\u0437\u043A\u0438\u0439
      \u0437\u0430\u043F\u0430\u0445 \u043E\u0442\u043F\u0443\u0433\u0438\u0432\u0430\u0435\u0442
      \u0447\u0430\u0441\u0442\u044C \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u0445,
      \u0430 \u0440\u0430\u0441\u0442\u0451\u0440\u0442\u044B\u0435 \u043B\u0435\u043F\u0435\u0441\u0442\u043A\u0438
      \u0432\u0445\u043E\u0434\u044F\u0442 \u0432 \u043F\u043E\u0445\u043E\u0434\u043D\u044B\u0435
      \u043F\u0440\u0438\u043F\u0430\u0440\u043A\u0438 \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043B\u043E\u0439
      \u043A\u043E\u0436\u0438 \u0438 \u043D\u0435\u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0445
      \u0441\u0441\u0430\u0434\u0438\u043D; \u044D\u0442\u0438\u043C \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u044E\u0442
      \u0437\u0430\u043C\u0435\u0442\u043D\u044B\u0439 \u043B\u0435\u0447\u0435\u0431\u043D\u044B\u0439
      \u044D\u0444\u0444\u0435\u043A\u0442 \u0446\u0432\u0435\u0442\u043A\u0430.
      \u0421\u0432\u0435\u0436\u0443\u044E \u0432\u0435\u0442\u043A\u0443 \u043D\u0435
      \u0441\u0443\u044E\u0442 \u0432 \u043A\u043E\u0442\u0435\u043B\u043E\u043A
      \u0431\u0435\u0437 \u0440\u0430\u0437\u0431\u043E\u0440\u0430: \u0443 \u0442\u0440\u0430\u0432\u043D\u0438\u043A\u043E\u0432
      \u043E\u043D\u0430 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u0441\u044B\u0440\u044C\u0451, \u0430 \u043D\u0435 \u043E\u0431\u044B\u0447\u043D\u0430\u044F
      \u0437\u0435\u043B\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000015
    m_Localized: "\u0416\u0438\u0432\u043E\u043A\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 83000000000000016
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u0438\u0439 \u0441\u0442\u0435\u0431\u0435\u043B\u044C
      \u0441 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C\u0438 \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u043C\u0438
      \u0446\u0432\u0435\u0442\u043A\u0430\u043C\u0438 \u0437\u0430\u043C\u0435\u0442\u0435\u043D
      \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430, \u043D\u043E \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F
      \u0441 \u043D\u0438\u043C \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E.
      \u0412 \u0442\u0440\u0430\u0432\u043D\u0438\u0447\u044C\u0438\u0445 \u043A\u043D\u0438\u0433\u0430\u0445
      \u0436\u0438\u0432\u043E\u043A\u043E\u0441\u0442\u044C \u0447\u0438\u0441\u043B\u0438\u0442\u0441\u044F
      \u0441\u0438\u043B\u044C\u043D\u044B\u043C \u0438 \u043E\u043F\u0430\u0441\u043D\u044B\u043C
      \u0441\u044B\u0440\u044C\u0451\u043C: \u0437\u043D\u0430\u044E\u0449\u0438\u0439
      \u043B\u0435\u043A\u0430\u0440\u044C \u0431\u0435\u0440\u0451\u0442 \u043B\u0438\u0448\u044C
      \u043C\u0430\u043B\u0443\u044E \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u0443\u044E
      \u0434\u043E\u043B\u044E \u0434\u043B\u044F \u043D\u0430\u0440\u0443\u0436\u043D\u043E\u0439
      \u0441\u043C\u0435\u0441\u0438, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0439
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0441\u0438\u043B\u044B \u043F\u043E\u0441\u043B\u0435
      \u0443\u0448\u0438\u0431\u0430. \u0416\u0435\u0432\u0430\u0442\u044C \u0446\u0432\u0435\u0442\u043E\u043A
      \u0438\u043B\u0438 \u0431\u0440\u043E\u0441\u0430\u0442\u044C \u0435\u0433\u043E
      \u0432 \u043F\u043E\u0445\u043E\u0434\u043D\u044B\u0439 \u0447\u0430\u0439
      \u2014 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0430, \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u043D\u0435\u0440\u0430\u0437\u0443\u043C\u043D\u044B\u0435 \u043F\u043B\u0430\u0442\u044F\u0442
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435\u043C."
