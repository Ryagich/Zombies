      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0442\u044F\u043D\u0435\u0442,
      \u043D\u0435 \u0437\u0432\u0435\u043D\u0438\u0442 \u0438 \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0438\u0441\u043A\u0430\u0442\u044C \u0437\u0430\u043C\u0435\u043D\u0443 \u0440\u0435\u0434\u043A\u043E\u0439
      \u0437\u0430\u0441\u0442\u0451\u0436\u043A\u0435."
