  - m_Id: 86000000000000010
    m_Localized: "\u0412\u044B\u0442\u044F\u043D\u0443\u0442\u0430\u044F \u0448\u0430\u043F\u043E\u0447\u043A\u0430
      \u0441 \u0442\u0451\u043F\u043B\u043E\u0439 \u043E\u0445\u0440\u0438\u0441\u0442\u043E\u0439
      \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u043E\u0439, \u0441\u0432\u0435\u0442\u043B\u043E\u0439
      \u043E\u043A\u0430\u043D\u0442\u043E\u0432\u043A\u043E\u0439 \u0438 \u0441\u0435\u0440\u044B\u043C\u0438
      \u0431\u043E\u043A\u043E\u0432\u044B\u043C\u0438 \u0433\u0440\u0430\u043D\u044F\u043C\u0438.
      \u0423 \u0432\u0438\u0441\u043A\u0430 \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u043E
      \u0434\u043B\u0438\u043D\u043D\u043E\u0435 \u0430\u043B\u043E\u0435 \u043F\u0435\u0440\u043E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0432\u044B\u0448\u0435 \u0441\u0430\u043C\u043E\u0439 \u0448\u0430\u043F\u043E\u0447\u043A\u0438
      \u0438 \u043C\u0435\u043D\u044F\u0435\u0442 \u0435\u0451 \u0441\u0438\u043B\u0443\u044D\u0442
      \u043D\u0430 \u0445\u043E\u0434\u0443. \u0412\u0435\u0449\u044C \u043D\u0430\u0440\u044F\u0434\u043D\u0430\u044F,
      \u043D\u043E \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u0430\u044F: \u0432
      \u043D\u0435\u0439 \u043D\u0435\u0442 \u043B\u0438\u0448\u043D\u0438\u0445
      \u043F\u043E\u0434\u0432\u0435\u0441\u043E\u043A \u0438\u043B\u0438 \u043F\u043E\u0437\u043E\u043B\u043E\u0442\u044B."
