      \u043A\u0440\u0443\u043F\u043D\u044B\u0435 \u043F\u0440\u044F\u043C\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0435
      \u0433\u043B\u0430\u0437\u043D\u044B\u0435 \u043F\u0440\u043E\u0451\u043C\u044B
      \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0445
      \u0443\u0433\u043B\u043E\u0432\u044B\u0445 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0439
      \u043D\u0438\u0436\u0435. \u0416\u0451\u0441\u0442\u043A\u0430\u044F \u043A\u0440\u0435\u0441\u0442\u043E\u0432\u0430\u044F
