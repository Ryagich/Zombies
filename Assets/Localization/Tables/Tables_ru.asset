  - m_Id: 84000000000000002
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E\u0440\u043D\u044B\u0439 \u043E\u043B\u0438\u0432\u043A\u043E\u0432\u044B\u0439
      \u0440\u0430\u043D\u0435\u0446 \u0438\u0437 \u043F\u043B\u043E\u0442\u043D\u043E\u0439
      \u0442\u043A\u0430\u043D\u0438: \u043A \u0432\u0435\u0440\u0445\u043D\u0435\u0439
      \u043F\u0435\u0440\u0435\u043A\u043B\u0430\u0434\u0438\u043D\u0435 \u0440\u0435\u043C\u043D\u044F\u043C\u0438
      \u043F\u0440\u0438\u0442\u044F\u043D\u0443\u0442\u043E \u0441\u0432\u0451\u0440\u043D\u0443\u0442\u043E\u0435
      \u043E\u0434\u0435\u044F\u043B\u043E, \u043F\u043E \u0431\u043E\u043A\u0430\u043C
      \u0438 \u0441\u043D\u0438\u0437\u0443 \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u044B
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0442\u044E\u043A\u0438. \u0428\u0438\u0440\u043E\u043A\u0438\u0435 \u043A\u043E\u0436\u0430\u043D\u044B\u0435
      \u0441\u0442\u044F\u0436\u043A\u0438 \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0432\u0435\u0441\u044C \u0433\u0440\u0443\u0437
      \u0438 \u043D\u0435 \u0434\u0430\u044E\u0442 \u043F\u043E\u043A\u043B\u0430\u0436\u0435
      \u0440\u0430\u0441\u043F\u043E\u043B\u0437\u0442\u0438\u0441\u044C \u043D\u0430
      \u0442\u0440\u043E\u043F\u0435. \u0422\u0430\u043A\u043E\u0439 \u0440\u0430\u043D\u0435\u0446
      \u0431\u0435\u0440\u0443\u0442 \u0432 \u0434\u043E\u043B\u0433\u0443\u044E
      \u0434\u043E\u0440\u043E\u0433\u0443, \u043A\u043E\u0433\u0434\u0430 \u043D\u043E\u0447\u043B\u0435\u0433
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043D\u0435\u0441\u0442\u0438
      \u043D\u0430 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u043F\u043B\u0435\u0447\u0430\u0445 \u0438 \u043E\u0431\u044A\u0451\u043C
      \u0432\u0430\u0436\u043D\u0435\u0435 \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u0430
      \u0432 \u0442\u0435\u0441\u043D\u043E\u043C \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u0435."
