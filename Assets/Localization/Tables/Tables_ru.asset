    m_Localized: "\u0412\u044B\u044F\u0441\u043D\u0438\u0442\u044C \u0443 \u0433\u043B\u0430\u0432\u044B
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0441\u0442\u0440\u0430\u0436\u0438,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u0432\u043E\u0440\u043E\u0442\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381582688259
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043F\u0443\u0442\u044C \u0432
      \u0433\u043E\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381582688260
    m_Localized: "\u0413\u043E\u0440\u043E\u0434 \u0437\u0430\u043A\u0440\u044B\u0442
      \u0438\u0437-\u0437\u0430 \u044D\u043F\u0438\u0434\u0435\u043C\u0438\u0438.
      \u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0438\u043D\u043E\u0439 \u0441\u043F\u043E\u0441\u043E\u0431
      \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u0432\u043D\u0443\u0442\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381582688261
    m_Localized: "\u0410\u043B\u044C\u0434\u0440\u0435\u043D \u0412\u0430\u044D\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381582688262
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E, \u0420\u0435\u043D? \u041E \u0447\u0451\u043C
      \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381582688265
    m_Localized: "\u0422\u0430\u043A. \u041D\u0430\u0441 \u043D\u0435 \u043F\u0443\u0441\u043A\u0430\u044E\u0442.
      \u0418, \u0441\u0443\u0434\u044F \u043F\u043E \u043B\u0438\u0446\u0430\u043C
      \u0443 \u0432\u043E\u0440\u043E\u0442, \u044D\u0442\u043E \u043D\u0435 \u043F\u043E\u0442\u043E\u043C\u0443,
      \u0447\u0442\u043E \u0438\u043C \u0441\u043A\u0443\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381582688266
    m_Localized: "\u041E\u0441\u0432\u0438\u043D \u041C\u0430\u0440\u043B\u043E\u0443
      \u0445\u043E\u0447\u0435\u0442 \u043E\u0431\u0441\u0443\u0434\u0438\u0442\u044C
      \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882560
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0443 \u043D\u0438\u0445
      \u043F\u0440\u0438\u043A\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882561
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435. \u0412\u043E\u0440\u043E\u0442\u0430
      \u0437\u0430\u043A\u0440\u044B\u043B\u0438 \u043D\u0430\u0433\u043B\u0443\u0445\u043E,
      \u0430 \u0441\u0442\u0440\u0430\u0436\u0430 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E \u0437\u0430 \u0441\u0442\u0435\u043D\u043E\u0439
      \u043D\u0435 \u0433\u043E\u0440\u043E\u0434, \u0430 \u043E\u0441\u0430\u0436\u0434\u0451\u043D\u043D\u0430\u044F
      \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882562
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u0434\u043E \u0443\u0442\u0440\u0430
      \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882563
    m_Localized: "\u041E\u0431\u043E\u0439\u0434\u0451\u043C \u0433\u043E\u0440\u043E\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882564
    m_Localized: "\u0422\u044B \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0441\u043B\u044B\u0448\u0430\u043B \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882565
    m_Localized: "\u041C\u043E\u0436\u0435\u043C. \u0422\u043E\u043B\u044C\u043A\u043E
      \u0443\u0442\u0440\u043E\u043C \u043E\u043D\u0438 \u0431\u0443\u0434\u0443\u0442
      \u0442\u0435\u043C\u0438 \u0436\u0435 \u043B\u044E\u0434\u044C\u043C\u0438,
      \u0441 \u0442\u0435\u043C \u0436\u0435 \u043F\u0440\u0438\u043A\u0430\u0437\u043E\u043C.
      \u042F \u0431\u044B \u043D\u0430 \u0447\u0443\u0434\u043E \u043D\u0435 \u0441\u0442\u0430\u0432\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882566
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u043B\u0435\u0441? \u041F\u043E\u0442\u043E\u043C
      \u0443\u043F\u0440\u0451\u043C\u0441\u044F \u0432 \u0434\u0440\u0443\u0433\u043E\u0439
      \u043F\u043E\u0441\u0442 \u0438 \u0432\u0441\u0451 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u043C
      \u0437\u0430\u043D\u043E\u0432\u043E. \u041E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0435\u0442\u0441\u044F,
      \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043F\u043E\u0441\u043B\u0435
      \u0442\u0430\u043A\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882567
    m_Localized: "\u0423 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u043F\u0440\u043E \u0431\u043E\u043B\u044C\u043D\u044B\u0445. \u041E\u0434\u0438\u043D
      \u0432\u043E\u0437\u0447\u0438\u043A \u043A\u043B\u044F\u043B\u0441\u044F,
      \u0447\u0442\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0443 \u043D\u0435\u0433\u043E
      \u0432 \u0442\u0435\u043B\u0435\u0433\u0435 \u0443\u043C\u0435\u0440 \u0435\u0449\u0451
      \u0434\u043E \u043F\u043E\u043B\u0443\u0434\u043D\u044F. \u0414\u0440\u0443\u0433\u043E\u0439
      \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u044D\u0442\u043E
      \u0432\u0441\u0451 \u0432\u044B\u0434\u0443\u043C\u043A\u0438 \u0441\u043E\u0432\u0435\u0442\u0430.
      \u0412 \u043E\u0431\u0449\u0435\u043C, \u043A\u0430\u0436\u0434\u044B\u0439
      \u0437\u043D\u0430\u0435\u0442 \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
      \u2014 \u0438 \u043D\u0438\u043A\u0442\u043E \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882568
    m_Localized: "\u0418 \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882569
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438 \u0441 \u0433\u043B\u0430\u0432\u043E\u0439
      \u0441\u0442\u0440\u0430\u0436\u0438. \u041D\u0435 \u043A\u0430\u043A \u0441
      \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438 \u2014 \u043A\u0430\u043A
      \u0441 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C. \u0421\u043F\u0440\u043E\u0441\u0438,
      \u0447\u0442\u043E \u0443 \u043D\u0438\u0445 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442,
      \u043A\u043E\u0433\u043E \u043F\u0443\u0441\u043A\u0430\u044E\u0442, \u043A\u043E\u0433\u043E
      \u043D\u0435\u0442. \u0415\u0441\u043B\u0438 \u0432 \u043F\u0440\u0438\u043A\u0430\u0437\u0435
      \u0435\u0441\u0442\u044C \u0445\u043E\u0442\u044C \u043A\u0430\u043A\u0430\u044F-\u0442\u043E
      \u043B\u0430\u0437\u0435\u0439\u043A\u0430, \u043E\u043D \u043E \u043D\u0435\u0439
      \u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882570
    m_Localized: "\u041B\u0430\u0434\u043D\u043E. \u041F\u043E\u0433\u043E\u0432\u043E\u0440\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882571
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438. \u0410 \u044F
      \u043F\u043E\u043A\u0430 \u043F\u043E\u0441\u0442\u043E\u044E \u0437\u0434\u0435\u0441\u044C
      \u0438 \u0441\u0434\u0435\u043B\u0430\u044E \u0432\u0438\u0434, \u0447\u0442\u043E
      \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u044E \u043A\u043E\u043F\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882572
    m_Localized: "\u042D\u0439. \u041E\u0442 \u0440\u0435\u0448\u0451\u0442\u043A\u0438
      \u043E\u0442\u043E\u0439\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882573
    m_Localized: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882574
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438 \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430.
      \u041C\u043D\u0435 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882575
    m_Localized: "\u0412 \u0433\u043E\u0440\u043E\u0434? \u0412\u0438\u0436\u0443.
      \u0417\u0430\u0447\u0435\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882576
    m_Localized: "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0432 \u0433\u043E\u0440\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882577
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u043E\u0440\u043E\u0442\u0430
      \u0437\u0430\u043A\u0440\u044B\u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882578
    m_Localized: "\u041A\u0442\u043E \u043E\u0442\u0434\u0430\u043B \u043F\u0440\u0438\u043A\u0430\u0437?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882579
    m_Localized: "\u041C\u043E\u0436\u0435\u0442, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882580
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0432
      \u0433\u043E\u0440\u043E\u0434\u0435 \u043B\u044E\u0434\u0438 \u0432\u0430\u043B\u044F\u0442\u0441\u044F
      \u0441 \u043D\u043E\u0433. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432
      \u043D\u0438\u0436\u043D\u0435\u043C \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0435,
      \u043F\u043E\u0442\u043E\u043C \u0432 \u043F\u043E\u0440\u0442\u0443. \u041B\u0435\u043A\u0430\u0440\u0438
      \u0433\u043E\u0432\u043E\u0440\u044F\u0442 \u2014 \u0437\u0430\u0440\u0430\u0437\u0430.
      \u0421\u043E\u0432\u0435\u0442 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u2014
      \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D. \u0410 \u044F \u0433\u043E\u0432\u043E\u0440\u044E:
      \u0441\u0442\u043E\u0439 \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882581
    m_Localized: "\u0421\u043E\u0432\u0435\u0442. \u041E\u043D\u0438 \u0441\u0438\u0434\u044F\u0442
      \u0437\u0430 \u0441\u0442\u0435\u043D\u043E\u0439, \u043C\u044B \u2014 \u0441
      \u044D\u0442\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B. \u041E\u0447\u0435\u043D\u044C
      \u0443\u0434\u043E\u0431\u043D\u043E \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882582
    m_Localized: "\u0421 \u043A\u0435\u043C? \u0421\u043E \u043C\u043D\u043E\u0439?
      \u041D\u0435 \u0441\u043C\u0435\u0448\u0438. \u041C\u043D\u0435 \u0437\u0430
      \u0442\u0435\u0431\u044F \u043F\u043E\u0442\u043E\u043C \u043E\u0442\u0432\u0435\u0447\u0430\u0442\u044C.
      \u0418 \u0434\u0435\u043D\u0435\u0433 \u0441\u0435\u0439\u0447\u0430\u0441
      \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0442\u0440\u043E\u0433\u0430\u0442\u044C,
      \u0435\u0441\u043B\u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882583
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043D\u0435 \u0432\u043F\u0443\u0441\u0442\u0438\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882584
    m_Localized: "\u041D\u0435 \u0447\u0435\u0440\u0435\u0437 \u0432\u043E\u0440\u043E\u0442\u0430.
      \u041D\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u0432\u043F\u0443\u0441\u043A\u0430\u0435\u043C
      \u0438 \u043D\u0435 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u043C,
      \u043F\u043E\u043A\u0430 \u043B\u0435\u043A\u0430\u0440\u0438 \u043D\u0435
      \u0440\u0430\u0437\u0431\u0435\u0440\u0443\u0442\u0441\u044F. \u042F \u043D\u0435
      \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0437\u0430 \u0431\u043E\u043B\u0435\u0437\u043D\u044C.
      \u0418, \u0447\u0435\u0441\u0442\u043D\u043E, \u0437\u043D\u0430\u0442\u044C
      \u043D\u0435 \u0445\u043E\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882585
    m_Localized: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E. \u0411\u0443\u0434\u0443
      \u0438\u0441\u043A\u0430\u0442\u044C \u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882586
    m_Localized: "\u0418\u0449\u0438. \u0422\u043E\u043B\u044C\u043A\u043E \u0447\u0435\u0440\u0435\u0437
      \u0441\u0442\u0435\u043D\u0443 \u0443 \u043C\u043E\u0435\u0433\u043E \u043F\u043E\u0441\u0442\u0430
      \u043D\u0435 \u043B\u0435\u0437\u044C. \u0422\u043E\u0433\u0434\u0430 \u043C\u043D\u0435
      \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C,
      \u0430 \u043C\u043D\u0435 \u0438 \u0431\u0435\u0437 \u0442\u043E\u0433\u043E
      \u0440\u0430\u0431\u043E\u0442\u044B \u0445\u0432\u0430\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882587
    m_Localized: "\u0412\u043E\u0442 \u0438 \u0433\u043E\u0440\u043E\u0434. \u0414\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u0432\u0441\u0451-\u0442\u0430\u043A\u0438. \u042F \u0443\u0436\u0435 \u043D\u0430\u0447\u0430\u043B
      \u0434\u0443\u043C\u0430\u0442\u044C, \u0447\u0442\u043E \u044D\u0442\u0430
      \u0434\u043E\u0440\u043E\u0433\u0430 \u043D\u0430\u0441 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882588
    m_Localized: "\u041E\u0441\u0432\u0438\u043D \u041C\u0430\u0440\u043B\u043E\u0443
      \u0445\u043E\u0447\u0435\u0442 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435 \u0434\u043E\u043B\u0433\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882589
    m_Localized: "\u041D\u0435\u0442 (\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
      \u043E\u0442 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882590
    m_Localized: "\u0414\u0430 (\u041F\u0440\u043E\u0439\u0442\u0438 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435
      \u0431\u043E\u044E \u2014 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882591
    m_Localized: "\u0412\u043E\u0442 \u044D\u0442\u043E \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440.
      \u0420\u0438\u043D\u0433 \u0443 \u0432\u043E\u0440\u043E\u0442, \u0441\u043F\u0440\u0430\u0432\u0430
      \u043E\u0442 \u0447\u0430\u0441\u0442\u043E\u043A\u043E\u043B\u0430. \u041F\u043E\u0434\u0445\u043E\u0434\u0438,
      \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432
      \u2014 \u043F\u043E\u0433\u043B\u044F\u0434\u0438\u043C, \u0447\u0442\u043E
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0443\u0441\u043F\u0435\u043B\u0430 \u0432\u044B\u0431\u0438\u0442\u044C
      \u0438\u0437 \u0442\u0432\u043E\u0435\u0439 \u0441\u0442\u043E\u0439\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882592
    m_Localized: "\u0414\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C. \u0415\u0449\u0451
      \u0434\u0435\u043D\u044C \u0432 \u0441\u0435\u0434\u043B\u0435 \u2014 \u0438
      \u044F \u0431\u044B \u043D\u0430\u0447\u0430\u043B \u0441\u043F\u043E\u0440\u0438\u0442\u044C
      \u0441 \u043B\u043E\u0448\u0430\u0434\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882593
    m_Localized: "\u0413\u043E\u0440\u043E\u0434-\u0442\u043E \u0435\u0441\u0442\u044C.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0443 \u0432\u043E\u0440\u043E\u0442
      \u043D\u0430\u0441 \u044F\u0432\u043D\u043E \u043D\u0435 \u0436\u0434\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882594
    m_Localized: "\u041D\u0435 \u0441\u043F\u043E\u0440\u044C \u0441 \u043B\u043E\u0448\u0430\u0434\u044C\u044E
      \u2014 \u0443 \u043D\u0435\u0451 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440
      \u0442\u044F\u0436\u0435\u043B\u0435\u0435 \u0442\u0432\u043E\u0435\u0433\u043E.
      \u0410 \u0433\u043E\u0440\u043E\u0434... \u0432\u0438\u0434\u0438\u0448\u044C
      \u0441\u0430\u043C: \u0441\u0442\u0435\u043D\u044B, \u0434\u044B\u043C \u0438\u0437
      \u0442\u0440\u0443\u0431, \u043B\u044E\u0434\u0438. \u041F\u043E\u0441\u043B\u0435
      \u0442\u0430\u043A\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438 \u0434\u0430\u0436\u0435
      \u044D\u0442\u043E \u0440\u0430\u0434\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882595
    m_Localized: "\u041D\u0435 \u0436\u0434\u0430\u043B\u0438. \u041A\u043E\u043F\u044C\u044F
      \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u043B\u0438, \u0432\u043E\u0440\u043E\u0442\u0430
      \u0437\u0430\u043A\u0440\u044B\u043B\u0438. \u041D\u043E \u044F \u0432\u0441\u0451
      \u0440\u0430\u0432\u043D\u043E \u0440\u0430\u0434 \u0441\u0442\u0435\u043D\u0430\u043C,
      \u043A\u0440\u044B\u0448\u0435 \u0438 \u0442\u043E\u043C\u0443, \u0447\u0442\u043E
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0430\u043C, \u043C\u043E\u0436\u0435\u0442,
      \u043D\u0435 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u043D\u043E\u0447\u0435\u0432\u0430\u0442\u044C
      \u0432 \u0433\u0440\u044F\u0437\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882596
    m_Localized: "\u0420\u0430\u0434\u0443\u0435\u0442. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u0435\u0441\u043B\u0438 \u0437\u0430 \u044D\u0442\u0438\u043C\u0438 \u0441\u0442\u0435\u043D\u0430\u043C\u0438
      \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F \u0433\u043E\u0440\u044F\u0447\u0430\u044F
      \u0435\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882597
    m_Localized: "\u0422\u044B \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043B\u0435\u0433\u043A\u043E \u043C\u0438\u0440\u0438\u0448\u044C\u0441\u044F
      \u0441 \u043F\u043B\u043E\u0445\u0438\u043C \u043F\u0440\u0438\u0451\u043C\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 54301381586882598
    m_Localized: "\u0410 \u0447\u0435\u0433\u043E \u0441\u0443\u0435\u0442\u0438\u0442\u044C\u0441\u044F?
      \u041C\u044B \u0443\u0436\u0435 \u0437\u0434\u0435\u0441\u044C. \u0412\u0438\u0434\u0438\u0448\u044C
      \u0440\u0438\u043D\u0433 \u0443 \u0441\u0442\u0440\u0430\u0436\u0438 \u2014
      \u043E\u0433\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u0443\u044E \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443
      \u0443 \u0432\u043E\u0440\u043E\u0442? \u041F\u043E\u043A\u0430 \u043E\u043D\u0438
      \u0440\u0435\u0448\u0430\u044E\u0442, \u043A\u043E\u0433\u043E \u043F\u0443\u0441\u043A\u0430\u0442\u044C,
      \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0437\u043C\u044F\u0442\u044C\u0441\u044F.
      \u041C\u044B \u0441 \u0442\u043E\u0431\u043E\u0439 \u0434\u0430\u0432\u043D\u043E
      \u043D\u0435 \u0434\u0440\u0430\u043B\u0438\u0441\u044C \u043D\u0435 \u0440\u0430\u0434\u0438
      \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u044F \u0448\u043A\u0443\u0440\u044B.
      \u0414\u0430\u0432\u0430\u0439 \u0432\u044B\u0439\u0434\u0435\u043C \u043D\u0430
      \u0440\u0438\u043D\u0433, \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C
      \u0440\u0443\u043A\u0438 \u0438 \u0433\u043E\u043B\u043E\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000001
    m_Localized: "\u041F\u0440\u043E\u0431\u0435\u043B \u2014 \u0441\u043A\u0440\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000010
    m_Localized: "\u0411\u043E\u0439 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043E\u0446\u0435\u043D\u043A\u0438
      \u0440\u0438\u0441\u043A\u0430. \u041F\u0435\u0440\u0435\u0434 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435\u043C
      \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u0439\u0442\u0435 \u0447\u0438\u0441\u043B\u043E
      \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432, \u0438\u0445
      \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0438 \u0437\u0430\u043F\u0430\u0441
      \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u0438. \u0415\u0441\u043B\u0438
      \u0438\u0441\u0445\u043E\u0434 \u043D\u0435\u043E\u0447\u0435\u0432\u0438\u0434\u0435\u043D,
      \u043E\u0431\u043E\u0439\u0434\u0438\u0442\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430:
      \u0441\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
      \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u043C
      \u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000011
    m_Localized: "\u041E\u043A\u0430\u0437\u0430\u0432\u0448\u0438\u0441\u044C \u0432
      \u043F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430,
      \u0431\u0443\u0434\u044C\u0442\u0435 \u0433\u043E\u0442\u043E\u0432\u044B \u043A
      \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u044E. \u041E\u0434\u043D\u0438
      \u0432\u0440\u0430\u0433\u0438 \u0434\u0435\u0440\u0436\u0430\u0442 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044E,
      \u0434\u0440\u0443\u0433\u0438\u0435 \u0438\u0434\u0443\u0442 \u0432 \u043B\u043E\u0431
      \u2014 \u0438\u0445 \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435
      \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0444\u0440\u0430\u043A\u0446\u0438\u0438
      \u0438 \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000012
    m_Localized: "\u0423\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435: \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      [{Dodge}]. \u041D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u044F \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
      \u0442\u0435\u043A\u0443\u0449\u0435\u043C\u0443 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044E
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F. \u0412\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435
      \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435 \u043F\u043E\u0441\u043B\u0435
      \u043D\u0430\u0447\u0430\u043B\u0430 \u0430\u0442\u0430\u043A\u0438 \u041E\u0441\u0432\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000013
    m_Localized: "\u0425\u043E\u043B\u043E\u0434\u043D\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435
      \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043E\u0431\u044B\u0447\u043D\u0443\u044E
      \u0438 \u0442\u044F\u0436\u0451\u043B\u0443\u044E \u0430\u0442\u0430\u043A\u0443:
      [{LightAttack}] \u2014 \u043E\u0431\u044B\u0447\u043D\u0430\u044F, [{HeavyAttack}]
      \u2014 \u0442\u044F\u0436\u0451\u043B\u0430\u044F. \u0410\u0442\u0430\u043A\u0438
      \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u044E\u0442 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C
      \u0438 \u0438\u043C\u0435\u044E\u0442 \u0440\u0430\u0437\u043D\u044B\u0439
      \u0442\u0435\u043C\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000014
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0439
      \u0430\u0442\u0430\u043A\u0438 \u0440\u0430\u0437\u0440\u044B\u0432\u0430\u0439\u0442\u0435
      \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044E, \u0447\u0442\u043E\u0431\u044B
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
      \u043D\u0430\u0434 \u0431\u043E\u0435\u043C. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      [{Roll}] \u0434\u043B\u044F \u043A\u0443\u0432\u044B\u0440\u043A\u0430 \u0432
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000015
    m_Localized: "\u0412\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C
      \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442\u0441\u044F \u043D\u0430
      \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435, \u0430\u0442\u0430\u043A\u0438,
      \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u044F \u0438 \u043A\u0443\u0432\u044B\u0440\u043A\u0438.
      \u0412 \u0431\u043E\u044E \u043F\u0443\u0441\u0442\u0430\u044F \u0448\u043A\u0430\u043B\u0430
      \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u0438 \u043E\u043F\u0430\u0441\u043D\u0435\u0435
      \u043F\u043E\u0442\u0435\u0440\u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F:
      \u0431\u0435\u0437 \u0440\u0435\u0441\u0443\u0440\u0441\u0430 \u043D\u0435\u043B\u044C\u0437\u044F
      \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C \u043C\u0430\u043D\u0451\u0432\u0440\u044B
      \u0438 \u0430\u0442\u0430\u043A\u0443\u044E\u0449\u0438\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000016
    m_Localized: "\u041F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u043C\u043E\u0433\u0443\u0442
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
      \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C. \u041C\u0430\u0441\u0441\u0430
      \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F \u0432\u043B\u0438\u044F\u0435\u0442
      \u043D\u0430 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u0438 \u0442\u0435\u043C\u043F \u0440\u0430\u0441\u0445\u043E\u0434\u0430
      \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u0438: \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0439
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435
      \u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0443\u0441\u0442\u0430\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000017
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D.
      \u041F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u0435 \u043E\u0441\u0432\u043E\u0435\u043D\u043D\u044B\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0432 \u0431\u043E\u044E
      \u0438 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435 \u041E\u0441\u0432\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000020
    m_Localized: "\u041E\u0446\u0435\u043D\u0438\u0442\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u0431\u043E\u044F \u0438 \u0437\u0430\u043A\u0440\u043E\u0439\u0442\u0435
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000021
    m_Localized: "\u0412\u043E\u0439\u0434\u0438\u0442\u0435 \u0432 \u043F\u043E\u043B\u0435
      \u0437\u0440\u0435\u043D\u0438\u044F \u041E\u0441\u0432\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000022
    m_Localized: "\u0423\u043A\u043B\u043E\u043D\u0438\u0442\u0435\u0441\u044C \u043E\u0442
      \u0430\u0442\u0430\u043A\u0438 \u041E\u0441\u0432\u0438\u043D\u0430: [{Dodge}]."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000023
    m_Localized: "\u0410\u0442\u0430\u043A\u0443\u0439\u0442\u0435 \u041E\u0441\u0432\u0438\u043D\u0430:
      [{LightAttack}] \u2014 \u043E\u0431\u044B\u0447\u043D\u0430\u044F, [{HeavyAttack}]
      \u2014 \u0442\u044F\u0436\u0451\u043B\u0430\u044F \u0430\u0442\u0430\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000024
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u043A\u0443\u0432\u044B\u0440\u043E\u043A:
      [{Roll}]."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000025
    m_Localized: "\u0418\u0437\u0443\u0447\u0438\u0442\u0435 \u0440\u0430\u0441\u0445\u043E\u0434
      \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000026
    m_Localized: "\u0423\u0447\u0442\u0438\u0442\u0435 \u0432\u043B\u0438\u044F\u043D\u0438\u0435
      \u0432\u0435\u0441\u0430 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F
      \u043D\u0430 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000027
    m_Localized: "\u041F\u043E\u0431\u0435\u0434\u0438\u0442\u0435 \u041E\u0441\u0432\u0438\u043D\u0430
      \u0432 \u0443\u0447\u0435\u0431\u043D\u043E\u043C \u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 71000000000000002
    m_Localized: "\u041F\u043E\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000001
    m_Localized: "\u041D\u0435\u043F\u043B\u043E\u0445\u043E. \u041F\u044F\u0442\u044C
      \u043C\u0438\u043D\u0443\u0442 \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0435\u0439
      \u0441\u043F\u0435\u0448\u043A\u0438 \u2014 \u0443\u0436\u0435 \u0440\u0430\u0431\u043E\u0442\u0430,
      \u0430 \u043D\u0435 \u043C\u0430\u0445\u0430\u043D\u0438\u0435 \u0436\u0435\u043B\u0435\u0437\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000002
    m_Localized: "\u041D\u0438\u0447\u044C\u044F. \u0422\u044B \u0434\u0435\u0440\u0436\u0430\u043B\u0441\u044F,
      \u044F \u043D\u0435 \u0434\u0430\u0432\u0438\u043B. \u0417\u043D\u0430\u0447\u0438\u0442,
      \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0443 \u043F\u0440\u043E\u0432\u0435\u043B\u0438
      \u0441 \u0442\u043E\u043B\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000003
    m_Localized: "\u0412\u0440\u0435\u043C\u044F \u0432\u044B\u0448\u043B\u043E.
      \u0420\u0443\u043A\u0438 \u043F\u043E\u043C\u043D\u044F\u0442, \u0433\u043E\u043B\u043E\u0432\u0430
      \u0442\u043E\u0436\u0435 \u2014 \u044D\u0442\u043E\u0433\u043E \u043D\u0430
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000004
    m_Localized: "\u0427\u0438\u0441\u0442\u043E \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043E.
      \u041D\u0435 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u0439\u0441\u044F:
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A
      \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u0436\u0434\u0430\u0442\u044C
      \u0443\u0434\u043E\u0431\u043D\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000005
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u0442\u0435\u043C\u043F.
      \u041F\u043E\u0431\u0435\u0434\u0430 \u0432 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0435
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u0443\u0435\u0442,
      \u043D\u043E \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0430 \u0434\u0443\u043C\u0430\u0442\u044C
      \u0443\u0436\u0435 \u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000006
    m_Localized: "\u041B\u0430\u0434\u043D\u043E, \u043F\u0440\u0438\u0437\u043D\u0430\u044E:
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u044B \u0431\u044B\u043B
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435. \u0417\u0430\u043F\u043E\u043C\u043D\u0438,
      \u0437\u0430 \u0441\u0447\u0451\u0442 \u0447\u0435\u0433\u043E \u0432\u0437\u044F\u043B
      \u0431\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000007
    m_Localized: "\u041F\u043E\u0442\u043E\u0440\u043E\u043F\u0438\u043B\u0441\u044F
      \u2014 \u0438 \u043E\u0442\u043A\u0440\u044B\u043B\u0441\u044F. \u041E\u0448\u0438\u0431\u043A\u0443
      \u0443\u0432\u0438\u0434\u0435\u043B, \u0442\u0435\u043F\u0435\u0440\u044C
      \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000008
    m_Localized: "\u0412 \u0431\u043E\u044E \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u043E\u0434\u043D\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u0430, \u0435\u0441\u043B\u0438
      \u043F\u043E\u0441\u043B\u0435 \u043D\u0435\u0433\u043E \u043D\u0435\u0447\u0435\u043C
      \u0434\u044B\u0448\u0430\u0442\u044C. \u0421\u043B\u0435\u0434\u0438 \u0437\u0430
      \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000009
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E.
      \u041F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u043D\u0430 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0435
      \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u043E\u0448\u0438\u0431\u043A\u0438
      \u0437\u0430 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u043C\u0438 \u0441\u0442\u0435\u043D\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 72000000000000010
    m_Localized: "\u041F\u043E\u043D\u044F\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 73000000000000001
    m_Localized: "\u0420\u0430\u0437\u043C\u044F\u0442\u044C \u043A\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 73000000000000002
    m_Localized: "\u041A\u0430\u043A \u0445\u043E\u0447\u0435\u0448\u044C \u0440\u0430\u0437\u043C\u044F\u0442\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 73000000000000003
    m_Localized: "\u0421\u043F\u0430\u0440\u0440\u0438\u043D\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 73000000000000004
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435
      \u0435\u0449\u0451 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 73000000000000005
    m_Localized: "\u041F\u043E\u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u044F \u0438 \u043A\u0443\u0432\u044B\u0440\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 73000000000000006
    m_Localized: "\u042F \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000001
    m_Localized: "\u0423\u0441\u043F\u0435\u0448\u043D\u043E \u0443\u043A\u043B\u043E\u043D\u0438\u0442\u0435\u0441\u044C
      \u043E\u0442 \u0430\u0442\u0430\u043A \u041E\u0441\u0432\u0438\u043D\u0430:
      {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000002
    m_Localized: "\u0422\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430 \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000003
    m_Localized: "\u0423\u043A\u043B\u043E\u043D\u044F\u0439\u0442\u0435\u0441\u044C
      \u043E\u0442 \u0430\u0442\u0430\u043A \u041E\u0441\u0432\u0438\u043D\u0430,
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u0443\u0432\u043E\u0440\u043E\u0442\u044B
      \u0438 \u043A\u0443\u0432\u044B\u0440\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000004
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000005
    m_Localized: "\u041E\u0441\u0432\u0438\u043D \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442
      \u0443\u0447\u0435\u0431\u043D\u044B\u0439 \u0431\u043E\u0439. \u041E\u0441\u0432\u043E\u0439\u0442\u0435
      \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u043F\u0440\u0438\u0451\u043C\u044B,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E
      \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439
      \u0441\u0445\u0432\u0430\u0442\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000006
    m_Localized: "\u041D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0432\u0441\u0435\u043C
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000007
    m_Localized: "\u041E\u0441\u0432\u043E\u0439\u0442\u0435 \u0431\u0430\u0437\u043E\u0432\u044B\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0431\u043E\u0439\u0446\u0430:
      \u043E\u0446\u0435\u043D\u043A\u0443 \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438,
      \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435, \u0430\u0442\u0430\u043A\u0438,
      \u043A\u0443\u0432\u044B\u0440\u043E\u043A \u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000008
    m_Localized: "\u041F\u043E\u0431\u0435\u0434\u0438\u0442\u044C \u041E\u0441\u0432\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 74000000000000009
    m_Localized: "\u041F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u0435 \u0438\u0437\u0443\u0447\u0435\u043D\u043D\u044B\u0435
      \u043F\u0440\u0438\u0451\u043C\u044B \u0432 \u0443\u0447\u0435\u0431\u043D\u043E\u043C
      \u0431\u043E\u044E \u0438 \u043E\u0434\u043E\u043B\u0435\u0439\u0442\u0435
      \u041E\u0441\u0432\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 30000000000000003
    m_Localized: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30000000000000004
    m_Localized: "\u0416\u0443\u0440\u043D\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000001
    m_Localized: "\u042F \u0445\u043E\u0442\u0435\u043B \u0431\u044B \u0443 \u0442\u0435\u0431\u044F
      \u043A\u043E\u0435-\u0447\u0442\u043E \u0443\u0437\u043D\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000002
    m_Localized: "\u0427\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u0445\u043E\u0442\u0435\u043B
      \u0443\u0437\u043D\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000003
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u0438. \u042F \u0441\u043B\u0443\u0448\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000004
    m_Localized: "\u041D\u0443? \u0427\u0442\u043E \u0443 \u0442\u0435\u0431\u044F
      \u043D\u0430 \u0443\u043C\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000005
    m_Localized: "\u0421\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439, \u043F\u043E\u043A\u0430
      \u0443 \u043C\u0435\u043D\u044F \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435
      \u043D\u0435 \u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000006
    m_Localized: "\u0414\u0430-\u0434\u0430. \u0412\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000007
    m_Localized: "\u0427\u0442\u043E \u0441\u043A\u0430\u0436\u0435\u0448\u044C \u043E
      \u043B\u0435\u0441\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000008
    m_Localized: "\u0421\u0430\u043C \u043B\u0435\u0441 \u043D\u0438\u043A\u0443\u0434\u0430
      \u043D\u0435 \u0434\u0435\u043B\u0441\u044F. \u0414\u0435\u0440\u0435\u0432\u044C\u044F
      \u0441\u0442\u043E\u044F\u0442, \u043F\u0442\u0438\u0446\u044B \u043F\u043E\u044E\u0442
      \u2014 \u043A\u043E\u0433\u0434\u0430 \u0438\u043C \u0432\u0437\u0434\u0443\u043C\u0430\u0435\u0442\u0441\u044F.
      \u0410 \u0432\u043E\u0442 \u0442\u0440\u0430\u043A\u0442 \u043F\u043E\u0434
      \u043D\u0438\u043C\u0438 \u0441\u043B\u043E\u0432\u043D\u043E \u0432\u044B\u043C\u0435\u0440.
      \u041F\u0440\u0435\u0436\u0434\u0435 \u043A \u0437\u0430\u043A\u0430\u0442\u0443
      \u0442\u0430\u043C \u0442\u0435\u043B\u0435\u0433\u0438 \u043E\u0431\u0433\u043E\u043D\u044F\u043B\u0438
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430, \u043F\u0443\u0442\u043D\u0438\u043A\u0438
      \u0440\u0443\u0433\u0430\u043B\u0438\u0441\u044C \u0438\u0437-\u0437\u0430
      \u043C\u0435\u0441\u0442\u0430 \u0443 \u043E\u0433\u043D\u044F. \u0422\u0435\u043F\u0435\u0440\u044C
      \u043F\u0440\u043E\u0439\u0434\u0451\u0448\u044C \u043F\u043E\u043B\u0434\u043D\u044F
      \u0438 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0448\u044C \u0440\u0430\u0437\u0432\u0435
      \u0447\u0442\u043E \u0441\u043B\u0435\u0434\u044B \u0432 \u0433\u0440\u044F\u0437\u0438.
      \u0418 \u043D\u0435 \u0432\u0441\u044F\u043A\u0438\u0439 \u0441\u043B\u0435\u0434
      \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000009
    m_Localized: "\u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u0440\u0430\u0441\u043F\u0443\u0433\u0430\u043B\u0438
      \u043B\u044E\u0434\u0435\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000010
    m_Localized: "\u041E\u0442\u0447\u0430\u0441\u0442\u0438. \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A
      \u2014 \u0431\u0435\u0434\u0430 \u043F\u0440\u043E\u0441\u0442\u0430\u044F:
      \u0436\u0430\u0434\u043D\u044B\u0439, \u0433\u043E\u043B\u043E\u0434\u043D\u044B\u0439,
      \u0441 \u043D\u043E\u0436\u043E\u043C. \u0415\u0433\u043E \u043C\u043E\u0436\u043D\u043E
      \u043E\u0431\u043E\u0439\u0442\u0438, \u043F\u043E\u0434\u043A\u0443\u043F\u0438\u0442\u044C
      \u0438\u043B\u0438 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C \u0441
      \u043E\u0440\u0443\u0436\u0438\u0435\u043C \u0432 \u0440\u0443\u043A\u0435.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0438 \u043E\u043D\u0438 \u0432 \u043B\u0435\u0441\u0443
      \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u043E\u043B\u0433\u043E \u043D\u0435
      \u0441\u0438\u0434\u044F\u0442. \u042F \u0432\u0438\u0434\u0435\u043B \u0438\u0445
      \u0441\u0442\u043E\u044F\u043D\u043A\u0443: \u043A\u043E\u0441\u0442\u0451\u0440
      \u0437\u0430\u0442\u0443\u0448\u0435\u043D, \u043A\u043E\u0442\u0435\u043B\u043E\u043A
      \u0431\u0440\u043E\u0448\u0435\u043D, \u0430 \u0434\u043E\u0437\u043E\u0440\u043D\u044B\u0439
      \u0441\u043B\u0435\u0434\u0438\u0442 \u043D\u0435 \u0437\u0430 \u0434\u043E\u0440\u043E\u0433\u043E\u0439
      \u2014 \u0437\u0430 \u0447\u0430\u0449\u0435\u0439. \u0417\u043D\u0430\u0447\u0438\u0442,
      \u0431\u043E\u044F\u0442\u0441\u044F \u0442\u0430\u043C \u043D\u0435 \u043E\u0434\u043D\u0438
      \u043F\u0443\u0442\u043D\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000011
    m_Localized: "\u0410 \u0447\u0442\u043E \u0437\u0430 \u0447\u0443\u0432\u0441\u0442\u0432\u043E,
      \u0431\u0443\u0434\u0442\u043E \u0441\u043B\u0435\u0434\u044F\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000012
    m_Localized: "\u041D\u0435 \u0437\u043D\u0430\u044E. \u0418 \u043E\u0442\u0442\u043E\u0433\u043E
      \u043E\u043D\u043E \u0445\u0443\u0436\u0435. \u041D\u0438 \u0448\u043E\u0440\u043E\u0445\u0430,
      \u043D\u0438 \u0441\u043B\u0435\u0434\u0430, \u043D\u0438 \u0434\u044B\u043C\u0430
      \u043C\u0435\u0436\u0434\u0443 \u0441\u0442\u0432\u043E\u043B\u0430\u043C\u0438.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0438\u0434\u0451\u0448\u044C \u2014
      \u0438 \u0432\u0434\u0440\u0443\u0433 \u0443\u0432\u0435\u0440\u0435\u043D,
      \u0447\u0442\u043E \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u043A\u0442\u043E-\u0442\u043E
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u0442\u043E\u0431\u043E\u0439. \u041E\u0431\u0435\u0440\u043D\u0451\u0448\u044C\u0441\u044F:
      \u043C\u043E\u0445, \u043A\u043E\u0440\u043D\u0438, \u0432\u0435\u0442\u043A\u0438.
      \u0412\u043E\u043B\u043A \u0447\u0435\u0441\u0442\u043D\u0435\u0435: \u0443\u0432\u0438\u0434\u0438\u0448\u044C
      \u0437\u0443\u0431\u044B \u2014 \u043F\u043E\u0439\u043C\u0451\u0448\u044C,
      \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C. \u0410 \u0442\u0443\u0442
      \u043B\u0435\u0441 \u043C\u043E\u043B\u0447\u0438\u0442, \u0431\u0443\u0434\u0442\u043E
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442. \u041F\u043E\u0441\u043B\u0435
      \u0437\u0430\u043A\u0430\u0442\u0430 \u044F \u0442\u0443\u0434\u0430 \u043D\u0435
      \u0445\u043E\u0436\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000013
    m_Localized: "\u041A\u0430\u043A \u0442\u0435\u0431\u0435 \u0437\u0434\u0435\u0448\u043D\u044F\u044F
      \u0442\u0430\u0432\u0435\u0440\u043D\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000014
    m_Localized: "\u0414\u043E\u0431\u0440\u0430\u044F \u0431\u044B\u043B\u0430 \u0442\u0430\u0432\u0435\u0440\u043D\u0430.
      \u041A\u043E\u0433\u0434\u0430 \u0442\u0440\u0430\u043A\u0442 \u0436\u0438\u043B,
      \u0432 \u043D\u0435\u0439 \u0441 \u0443\u0442\u0440\u0430 \u0441\u043F\u043E\u0440\u0438\u043B\u0438
      \u043E \u0446\u0435\u043D\u0430\u0445, \u043A \u043D\u043E\u0447\u0438 \u2014
      \u043E \u0431\u043E\u0433\u0430\u0445, \u0430 \u043A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443
      \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u043F\u0430\u043B \u043B\u0438\u0446\u043E\u043C \u0432 \u0441\u0442\u043E\u043B\u0435.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0432 \u0437\u0430\u043B\u0435 \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u043D\u043E.
      \u0421\u043B\u044B\u0448\u043D\u043E, \u043A\u0430\u043A \u043B\u043E\u0436\u043A\u0430
      \u043E \u043C\u0438\u0441\u043A\u0443 \u0441\u0442\u0443\u043A\u0430\u0435\u0442.
      \u041D\u043E \u0445\u043E\u0437\u044F\u0439\u043A\u0430 \u043D\u0435 \u0441\u043A\u0438\u0441\u043B\u0430:
      \u043E\u0433\u043E\u043D\u044C \u0432 \u043E\u0447\u0430\u0433\u0435 \u0434\u0435\u0440\u0436\u0438\u0442,
      \u0441\u0442\u043E\u043B\u044B \u043C\u043E\u0435\u0442, \u0431\u0443\u0434\u0442\u043E
      \u043E\u0431\u043E\u0437\u044B \u0432\u043E\u0442-\u0432\u043E\u0442 \u0441\u043D\u043E\u0432\u0430
      \u043F\u043E\u0442\u044F\u043D\u0443\u0442\u0441\u044F. \u0423\u043F\u0440\u044F\u043C\u0430\u044F
      \u0436\u0435\u043D\u0449\u0438\u043D\u0430. \u0422\u0430\u043A\u0438\u0435
      \u043C\u0435\u0441\u0442\u0430 \u043D\u0430 \u0443\u043F\u0440\u044F\u043C\u0441\u0442\u0432\u0435
      \u0438 \u0441\u0442\u043E\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000015
    m_Localized: "\u0410 \u043A\u043E\u0440\u043C\u044F\u0442 \u0442\u0430\u043C
      \u0438 \u043F\u0440\u0430\u0432\u0434\u0430 \u0445\u043E\u0440\u043E\u0448\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000016
    m_Localized: "\u0415\u0441\u043B\u0438 \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0448\u044C
      \u0434\u043E\u043F\u044B\u0442\u044B\u0432\u0430\u0442\u044C\u0441\u044F, \u043E\u0442\u043A\u0443\u0434\u0430
      \u0432 \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0435 \u043C\u044F\u0441\u043E,
      \u2014 \u043E\u0447\u0435\u043D\u044C \u0434\u0430\u0436\u0435. \u0425\u043B\u0435\u0431
      \u0443 \u043D\u0435\u0451 \u0433\u043E\u0440\u044F\u0447\u0438\u0439, \u043B\u0443\u043A
      \u043D\u0435 \u0436\u0430\u043B\u0435\u0435\u0442, \u0430 \u043E\u0442 \u043E\u0434\u043D\u043E\u0439
      \u043C\u0438\u0441\u043A\u0438 \u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u043C\u044B\u0441\u043B\u0438 \u043E \u0437\u0430\u0432\u0442\u0440\u0430\u0448\u043D\u0435\u043C
      \u0434\u043D\u0435. \u0412 \u043D\u0430\u0448\u0438 \u0434\u043D\u0438 \u0437\u0430
      \u0442\u0430\u043A\u043E\u0435 \u0438 \u043C\u043E\u043D\u0435\u0442\u0443
      \u043E\u0442\u0434\u0430\u0442\u044C \u043D\u0435 \u0436\u0430\u043B\u043A\u043E.
      \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0445\u0432\u0430\u043B\u0438
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0433\u0440\u043E\u043C\u043A\u043E:
      \u0445\u043E\u0437\u044F\u0439\u043A\u0430 \u0441\u0434\u0435\u043B\u0430\u0435\u0442
      \u0432\u0438\u0434, \u0447\u0442\u043E \u043D\u0435 \u0441\u043B\u044B\u0448\u0438\u0442,
      \u0430 \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u043B\u043E\u0436\u0438\u0442
      \u0442\u0435\u0431\u0435 \u0434\u043E\u0431\u0430\u0432\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000017
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432 \u043D\u0435\u0439
      \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u0443\u0441\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000018
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0434\u043E\u0440\u043E\u0433\u0430
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0430 \u043A\u043E\u0440\u043C\u0438\u0442\u044C.
      \u041F\u0443\u0442\u043D\u0438\u043A \u0435\u0434\u0435\u0442, \u043A\u043E\u0433\u0434\u0430
      \u0437\u043D\u0430\u0435\u0442: \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u043D\u043E\u0447\u043B\u0435\u0433, \u0440\u0430\u0431\u043E\u0442\u0430
      \u0438\u043B\u0438 \u0445\u043E\u0442\u044F \u0431\u044B \u0440\u044B\u043D\u043E\u043A.
      \u0410 \u043A\u043E\u0433\u0434\u0430 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u0441\u043B\u0443\u0445\u0438, \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0438 \u043B\u044E\u0434\u0438 \u0441
      \u043D\u043E\u0436\u0430\u043C\u0438, \u043E\u043D \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0434\u043E\u043C\u0430. \u0422\u0430\u0432\u0435\u0440\u043D\u0430 \u0442\u0443\u0442
      \u043D\u0438 \u043F\u0440\u0438 \u0447\u0451\u043C. \u041F\u0440\u043E\u0441\u0442\u043E
      \u043C\u0438\u0440\u0443 \u043D\u044B\u043D\u0447\u0435 \u043D\u0435 \u0434\u043E
      \u043A\u0440\u0443\u0436\u0435\u043A \u0438 \u043F\u0435\u0441\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000019
    m_Localized: "\u0427\u0442\u043E \u0442\u0430\u043C \u0441 \u0440\u0435\u043A\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000020
    m_Localized: "\u0414\u043D\u0451\u043C \u2014 \u0440\u0435\u043A\u0430 \u043A\u0430\u043A
      \u0440\u0435\u043A\u0430: \u043C\u0435\u043B\u043A\u043E\u0432\u043E\u0434\u044C\u0435,
      \u043A\u0430\u043C\u044B\u0448, \u0441\u0442\u0440\u0435\u043A\u043E\u0437\u044B
      \u043D\u0430\u0434 \u0432\u043E\u0434\u043E\u0439. \u0410 \u0432 \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445
      \u043E\u043D\u0430 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F. \u041A\u0430\u043C\u044B\u0448
      \u0448\u0435\u0432\u0435\u043B\u0438\u0442\u0441\u044F \u043F\u0440\u043E\u0442\u0438\u0432
      \u0432\u0435\u0442\u0440\u0430, \u043F\u043E \u0432\u043E\u0434\u0435 \u043A\u0440\u0443\u0433\u0438
      \u0438\u0434\u0443\u0442 \u0442\u0430\u043C, \u0433\u0434\u0435 \u0440\u044B\u0431\u0435
      \u0434\u0435\u043B\u0430\u0442\u044C \u043D\u0435\u0447\u0435\u0433\u043E.
      \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0437\u0430\u0432\u0435\u043B\u043E\u0441\u044C
      \u0447\u0442\u043E-\u0442\u043E \u0432\u043E\u0434\u044F\u043D\u043E\u0435.
      \u0414\u043D\u0451\u043C \u043A \u0431\u0435\u0440\u0435\u0433\u0443 \u043D\u0435
      \u043B\u0435\u0437\u0435\u0442 \u2014 \u043C\u043E\u0436\u0435\u0442, \u0441\u0432\u0435\u0442\u0430
      \u043D\u0435 \u043B\u044E\u0431\u0438\u0442. \u041D\u043E\u0447\u044C\u044E
      \u044F \u0431\u044B \u0442\u0430\u043C \u0434\u0430\u0436\u0435 \u0444\u043B\u044F\u0433\u0443
      \u043D\u0435 \u043F\u043E\u043B\u043E\u0441\u043A\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000021
    m_Localized: "\u0418 \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u043A \u0440\u0435\u043A\u0435
      \u0441\u0442\u043E\u0438\u0442 \u0445\u043E\u0434\u0438\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000022
    m_Localized: "\u0415\u0441\u043B\u0438 \u0434\u0435\u043B\u043E \u0435\u0441\u0442\u044C
      \u2014 \u0441\u0442\u043E\u0438\u0442. \u0423 \u043E\u0442\u043C\u0435\u043B\u0435\u0439
      \u0440\u0430\u0441\u0442\u0451\u0442 \u043A\u0440\u043E\u0432\u043E\u0446\u0432\u0435\u0442:
      \u043D\u0435\u0432\u0437\u0440\u0430\u0447\u043D\u044B\u0439 \u0441 \u0432\u0438\u0434\u0443,
      \u0437\u0430\u0442\u043E \u0440\u0430\u043D\u0443 \u0441\u0442\u044F\u043D\u0435\u0442
      \u043B\u0443\u0447\u0448\u0435 \u0438\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439
      \u043C\u0430\u0437\u0438. \u0421\u043E\u0431\u0438\u0440\u0430\u0439 \u0443\u0442\u0440\u043E\u043C,
      \u043F\u043E\u043A\u0430 \u0432\u0438\u0434\u043D\u043E \u0434\u043D\u043E.
      \u0418 \u043D\u0435 \u0442\u044F\u043D\u0438\u0441\u044C \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u043C
      \u0446\u0432\u0435\u0442\u043A\u043E\u043C: \u043E\u0434\u0438\u043D \u0433\u043B\u0430\u0437
      \u043D\u0430 \u0442\u0440\u0430\u0432\u0435, \u0432\u0442\u043E\u0440\u043E\u0439
      \u0434\u0435\u0440\u0436\u0438 \u043D\u0430 \u0432\u043E\u0434\u0435. \u0420\u0435\u043A\u0430
      \u0442\u0435\u0440\u043F\u0438\u0442 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0445.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u0442\u043E\u043C
      \u0434\u043E\u043B\u0433\u043E \u0438\u0449\u0443\u0442 \u043D\u0438\u0436\u0435
      \u043F\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000023
    m_Localized: "\u0410 \u043A\u0442\u043E \u0436\u0438\u0432\u0451\u0442 \u0432
      \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043D\u0438\u0436\u0435 \u043F\u043E
      \u0442\u0435\u0447\u0435\u043D\u0438\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000024
    m_Localized: "\u041B\u044E\u0434\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442:
      \u043D\u0435\u043B\u044E\u0434\u0438. \u0410 \u043B\u044E\u0434\u0438 \u043C\u043D\u043E\u0433\u043E
      \u0447\u0435\u0433\u043E \u0433\u043E\u0432\u043E\u0440\u044F\u0442, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u0435\u0441\u043B\u0438 \u0432\u0438\u0434\u0435\u043B\u0438 \u0434\u044B\u043C
      \u043D\u0430\u0434 \u0447\u0443\u0436\u0438\u043C\u0438 \u043A\u0440\u044B\u0448\u0430\u043C\u0438
      \u0438 \u043B\u043E\u0434\u043A\u0443 \u0431\u0435\u0437 \u0444\u043E\u043D\u0430\u0440\u044F.
      \u042F \u0442\u0430\u043C \u043D\u0435 \u0431\u044B\u043B, \u0442\u0430\u043A
      \u0447\u0442\u043E \u0432\u0440\u0430\u0442\u044C \u043D\u0435 \u0441\u0442\u0430\u043D\u0443.
      \u0420\u044B\u0431\u0430\u043A\u0438 \u0441\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F
      \u043D\u0438\u0436\u0435 \u0440\u0435\u0434\u043A\u043E \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F
      \u0431\u0435\u0437 \u0443\u043B\u043E\u0432\u0430, \u043D\u043E \u0446\u0435\u043B\u044B\u0435.
      \u0415\u0441\u043B\u0438 \u0441\u043E\u0431\u0435\u0440\u0451\u0448\u044C\u0441\u044F
      \u0442\u0443\u0434\u0430, \u043D\u0435 \u043B\u0435\u0437\u044C \u0441 \u0440\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0430\u043C\u0438,
      \u043A\u0442\u043E \u043E\u043D\u0438 \u0434\u0430 \u0447\u0435\u043C \u0445\u0443\u0436\u0435
      \u043D\u0430\u0441. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0437\u0434\u043E\u0440\u043E\u0432\u0430\u0439\u0441\u044F.
      \u0418\u043D\u043E\u0433\u0434\u0430 \u044D\u0442\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000025
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438 \u043E \u0434\u0435\u0440\u0435\u0432\u043D\u0435
      \u0443 \u0442\u0440\u0430\u043A\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000026
    m_Localized: "\u041D\u0438\u0447\u0435\u043C \u0441 \u0432\u0438\u0434\u0443
      \u043D\u0435 \u043F\u0440\u0438\u043C\u0435\u0442\u043D\u0430\u044F: \u043A\u0440\u0438\u0432\u044B\u0435
      \u0437\u0430\u0431\u043E\u0440\u044B, \u043E\u0433\u043E\u0440\u043E\u0434\u044B,
      \u0434\u0435\u0442\u0438 \u0431\u043E\u0441\u0438\u043A\u043E\u043C \u0434\u043E
      \u043F\u0435\u0440\u0432\u044B\u0445 \u0445\u043E\u043B\u043E\u0434\u043E\u0432.
      \u041D\u043E \u043C\u0435\u0441\u0442\u043E \u0441\u0442\u043E\u044F\u043B\u043E
      \u043D\u0430 \u0442\u0440\u0430\u043A\u0442\u0435, \u0430 \u0437\u043D\u0430\u0447\u0438\u0442
      \u2014 \u0436\u0438\u043B\u043E. \u041A\u043E\u043C\u0443 \u043E\u0432\u0441\u0430
      \u043F\u0440\u043E\u0434\u0430\u0442\u044C, \u043A\u043E\u043C\u0443 \u043A\u043E\u043B\u0435\u0441\u043E
      \u043F\u043E\u0434\u043F\u0440\u0430\u0432\u0438\u0442\u044C, \u043A\u043E\u043C\u0443
      \u043F\u043E\u0441\u0442\u0435\u043B\u044C \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435
      \u0437\u0430\u0441\u0442\u0435\u043B\u0438\u0442\u044C. \u041F\u0440\u043E\u0435\u0437\u0436\u0438\u0439
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B \u043C\u043E\u043D\u0435\u0442\u0443,
      \u0430 \u0434\u0435\u0440\u0435\u0432\u043D\u044F \u043A\u0440\u0443\u0442\u0438\u043B\u0430\u0441\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435. \u041F\u043E\u043A\u0430 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0431\u044B\u043B\u0430 \u043F\u043E\u043B\u043D\u0430 \u043B\u044E\u0434\u0435\u0439,
      \u0438 \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u0431\u044B\u043B\u043E
      \u043A\u043E\u043C\u0443 \u0440\u0443\u0433\u0430\u0442\u044C\u0441\u044F,
      \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u0438 \u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u043F\u043B\u0430\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000027
    m_Localized: "\u0412\u044B\u0445\u043E\u0434\u0438\u0442, \u0432\u0441\u0451
      \u0442\u0430\u043C \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u043D\u0430
      \u0442\u0430\u0432\u0435\u0440\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000028
    m_Localized: "\u041D\u0435 \u043D\u0430 \u043E\u0434\u043D\u043E\u0439 \u0442\u0430\u0432\u0435\u0440\u043D\u0435
      \u2014 \u043D\u0430 \u0432\u0441\u0451\u043C, \u0447\u0442\u043E \u0432\u043E\u043A\u0440\u0443\u0433
      \u043D\u0435\u0451 \u043A\u0440\u0443\u0442\u0438\u043B\u043E\u0441\u044C.
      \u041A\u0443\u0437\u043D\u0435\u0446 \u043F\u043E\u0434\u043A\u043E\u0432\u044B
      \u043A\u043E\u0432\u0430\u043B, \u043C\u0435\u043B\u044C\u043D\u0438\u043A
      \u043C\u0443\u043A\u0443 \u043C\u043E\u043B\u043E\u043B, \u0432\u0434\u043E\u0432\u044B
      \u0441\u0442\u0438\u0440\u0430\u043B\u0438 \u0447\u0443\u0436\u043E\u0435 \u0431\u0435\u043B\u044C\u0451,
      \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0438 \u0431\u0435\u0433\u0430\u043B\u0438
      \u0437\u0430 \u0432\u043E\u0437\u0430\u043C\u0438. \u041E\u0434\u0438\u043D
      \u043F\u0443\u0442\u043D\u0438\u043A \u043A\u0443\u043F\u0438\u0442 \u043A\u0440\u0443\u0436\u043A\u0443,
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442
      \u0437\u0430 \u043F\u043E\u0447\u0438\u043D\u043A\u0443 \u2014 \u0438 \u0443
      \u0434\u0435\u0441\u044F\u0442\u043A\u0430 \u043B\u044E\u0434\u0435\u0439 \u043D\u0430
      \u0443\u0436\u0438\u043D \u0447\u0442\u043E-\u0442\u043E \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F.
      \u0411\u0435\u0437 \u0434\u043E\u0440\u043E\u0433\u0438 \u044D\u0442\u043E
      \u043D\u0435 \u0434\u0435\u0440\u0435\u0432\u043D\u044F \u0443 \u0442\u0440\u0430\u043A\u0442\u0430,
      \u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u0432\u043E\u0440\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u0441\u0442\u0430\u043B\u043E \u0442\u0435\u0441\u043D\u043E \u0441\u043E
      \u0441\u0432\u043E\u0435\u0439 \u0431\u0435\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000029
    m_Localized: "\u0410 \u0447\u0442\u043E \u0441 \u043D\u0435\u0439 \u0442\u0435\u043F\u0435\u0440\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000030
    m_Localized: "\u041D\u0435 \u0441\u043A\u0430\u0436\u0443. \u0420\u0430\u043D\u044C\u0448\u0435
      \u043E\u0442\u0442\u0443\u0434\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C
      \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0435\u0445\u0430\u043B:
      \u0441 \u0437\u0435\u0440\u043D\u043E\u043C, \u0437\u0430 \u0441\u043E\u043B\u044C\u044E,
      \u0434\u0430 \u0445\u043E\u0442\u044C \u043F\u0440\u043E\u0441\u0442\u043E
      \u044F\u0437\u044B\u043A\u043E\u043C \u043F\u043E\u0447\u0435\u0441\u0430\u0442\u044C.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0438\u043A\u043E\u0433\u043E.
      \u041C\u043E\u0436\u0435\u0442, \u043F\u0435\u0440\u0435\u0436\u0438\u0434\u0430\u044E\u0442
      \u0438 \u0434\u0432\u0435\u0440\u0435\u0439 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442.
      \u0410 \u043C\u043E\u0436\u0435\u0442, \u0438\u043C \u0443\u0436\u0435 \u043D\u0435\u043A\u043E\u043C\u0443
      \u0435\u0445\u0430\u0442\u044C. \u0413\u0430\u0434\u0430\u0442\u044C \u043D\u0435
      \u043B\u044E\u0431\u043B\u044E. \u041E\u0442 \u0433\u0430\u0434\u0430\u043D\u0438\u0439
      \u0434\u043E\u0440\u043E\u0433\u0430 \u043D\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435, \u0430 \u043B\u044E\u0434\u0438
      \u2014 \u0436\u0438\u0432\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000031
    m_Localized: "\u0427\u0442\u043E \u0434\u0443\u043C\u0430\u0435\u0448\u044C \u043E
      \u0433\u043E\u0440\u043E\u0434\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000032
    m_Localized: "\u0418\u0437\u0434\u0430\u043B\u0438 \u0433\u043E\u0440\u043E\u0434
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u0435\u043C: \u0441\u0442\u0435\u043D\u044B,
      \u043A\u0440\u044B\u0448\u0438, \u0434\u044B\u043C \u0438\u0437 \u0442\u0440\u0443\u0431.
      \u0414\u0443\u043C\u0430\u0435\u0448\u044C, \u0437\u0430 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438
      \u0442\u0435\u0431\u044F \u0436\u0434\u0443\u0442 \u0435\u0434\u0430 \u0438
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A. \u041F\u043E\u0442\u043E\u043C
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0448\u044C \u0431\u043B\u0438\u0436\u0435
      \u2014 \u0432\u0438\u0434\u0438\u0448\u044C \u043E\u0447\u0435\u0440\u0435\u0434\u044C,
      \u043A\u043E\u043F\u044C\u044F \u0438 \u043B\u0438\u0446\u0430 \u0441\u0442\u0440\u0430\u0436\u0438.
      \u0417\u0430 \u0441\u0442\u0435\u043D\u0430\u043C\u0438 \u0435\u0441\u0442\u044C
      \u0440\u0430\u0431\u043E\u0442\u0430, \u0440\u044B\u043D\u043E\u043A, \u043B\u0435\u043A\u0430\u0440\u044C.
      \u0422\u0430\u043C \u0436\u0435 \u0435\u0441\u0442\u044C \u0447\u0443\u0436\u0438\u0435
      \u0437\u0430\u043A\u043E\u043D\u044B \u0438 \u043B\u044E\u0434\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u0432\u044B\u0433\u043E\u0434\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
      \u0442\u044B \u0438\u0445 \u0431\u043E\u044F\u043B\u0441\u044F. \u041D\u043E
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E: \u044F \u0432\u044B\u0431\u0435\u0440\u0443
      \u0433\u043E\u0440\u043E\u0434, \u0430 \u043D\u0435 \u043D\u043E\u0447\u0451\u0432\u043A\u0443
      \u0432 \u043B\u0435\u0441\u0443. \u0423 \u0441\u0442\u0435\u043D \u0445\u043E\u0442\u044F
      \u0431\u044B \u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0435 \u0437\u0443\u0431\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000033
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u043E\u0440\u043E\u0442\u0430
      \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000034
    m_Localized: "\u0411\u0443\u0434\u044C \u0443 \u043C\u0435\u043D\u044F \u043E\u0442\u0432\u0435\u0442,
      \u044F \u0431\u044B \u043D\u0435 \u043C\u0451\u0440\u0437 \u043F\u043E\u0434
      \u044D\u0442\u0438\u043C\u0438 \u0441\u0442\u0435\u043D\u0430\u043C\u0438 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C\u0438. \u0413\u043E\u0440\u043E\u0434
      \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0432\u043E\u0440\u043E\u0442\u0430,
      \u043A\u043E\u0433\u0434\u0430 \u0431\u043E\u0438\u0442\u0441\u044F \u0442\u043E\u0433\u043E,
      \u0447\u0442\u043E \u0438\u0434\u0451\u0442 \u043A \u043D\u0435\u043C\u0443,
      \u0438\u043B\u0438 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0443\u0436\u0435
      \u0443\u0441\u043F\u0435\u043B\u043E \u0432\u043E\u0439\u0442\u0438. \u0421\u0442\u0440\u0430\u0436\u0430
      \u043C\u043E\u043B\u0447\u0438\u0442. \u0410 \u043A\u043E\u0433\u0434\u0430
      \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0435 \u043B\u044E\u0434\u0438
      \u043C\u043E\u043B\u0447\u0430\u0442, \u0441\u043C\u043E\u0442\u0440\u0438
      \u043D\u0435 \u043D\u0430 \u0440\u043E\u0442 \u2014 \u043D\u0430 \u0440\u0443\u043A\u0438.
      \u042D\u0442\u0438 \u0434\u0435\u0440\u0436\u0430\u0442 \u043A\u043E\u043F\u044C\u044F
      \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E \u0436\u0434\u0443\u0442
      \u0431\u0435\u0434\u044B \u0441 \u043E\u0431\u0435\u0438\u0445 \u0441\u0442\u043E\u0440\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000036
    m_Localized: "\u0421\u043F\u0440\u043E\u0448\u0443 \u043E \u0447\u0451\u043C-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0435\u0449\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000037
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u041C\u043D\u0435
      \u043F\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 75000000000000038
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000001
    m_Localized: "\u0415\u0441\u0442\u044C \u043B\u0438 \u043A\u043E \u043C\u043D\u0435
      \u0434\u0435\u043B\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000002
    m_Localized: "\u0414\u0435\u043B\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0430\u0439\u0434\u0443\u0442\u0441\u044F.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0441\u043F\u0435\u0440\u0432\u0430 \u0441\u043A\u0430\u0436\u0438,
      \u043E \u0447\u0451\u043C \u0440\u0435\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000003
    m_Localized: "\u0427\u0442\u043E \u0437\u0430 \u043F\u0440\u043E\u0441\u0442\u0430\u044F
      \u043F\u0440\u043E\u0441\u044C\u0431\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000004
    m_Localized: "\u042F\u0431\u043B\u043E\u043A \u0445\u043E\u0447\u0443. \u041D\u0435
      \u043F\u0438\u0440\u043E\u0433\u043E\u0432, \u043D\u0435 \u0431\u043E\u0447\u043A\u0438
      \u0441\u0438\u0434\u0440\u0430 \u2014 \u043F\u0440\u043E\u0441\u0442\u043E
      \u044F\u0431\u043B\u043E\u043A. \u0414\u0435\u0441\u044F\u0442\u043E\u043A.
      \u0412 \u0434\u043E\u0440\u043E\u0433\u0435 \u043F\u0440\u0438\u0432\u044B\u043A:
      \u043E\u0442 \u043A\u0438\u0441\u043B\u043E\u0433\u043E \u044F\u0431\u043B\u043E\u043A\u0430
      \u0433\u043E\u043B\u043E\u0432\u0430 \u044F\u0441\u043D\u0435\u0435, \u0447\u0435\u043C
      \u043E\u0442 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B \u0441\u043E\u0432\u0435\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000005
    m_Localized: "\u041B\u0430\u0434\u043D\u043E. \u041F\u0440\u0438\u043D\u0435\u0441\u0443
      \u0442\u0435\u0431\u0435 \u0434\u0435\u0441\u044F\u0442\u044C \u044F\u0431\u043B\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000006
    m_Localized: "\u0412\u043E\u0442 \u0438 \u0441\u043B\u0430\u0432\u043D\u043E.
      \u041D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0441\u044C \u043E\u0431\u0434\u0438\u0440\u0430\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0434\u0435\u0440\u0435\u0432\u043E
      \u0443 \u0447\u044C\u0435\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0434\u043E\u043C\u0430 \u2014 \u043C\u043D\u0435 \u044F\u0431\u043B\u043E\u043A\u0438
      \u043D\u0443\u0436\u043D\u044B, \u0430 \u043D\u0435 \u043D\u043E\u0432\u0430\u044F
      \u0441\u0441\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000007
    m_Localized: "\u0410 \u0447\u0442\u043E \u0437\u0430 \u0434\u0435\u043B\u043E
      \u0441 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000008
    m_Localized: "\u0412 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u0436\u0438\u043B
      \u043A\u0443\u0437\u043D\u0435\u0446, \u0441\u0442\u0430\u0440\u044B\u0439
      \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439. \u0420\u0443\u043A\u0438
      \u0443 \u043D\u0435\u0433\u043E \u0442\u044F\u0436\u0451\u043B\u044B\u0435,
      \u044F\u0437\u044B\u043A \u0435\u0449\u0451 \u0442\u044F\u0436\u0435\u043B\u0435\u0435,
      \u043D\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0439.
      \u0414\u0430\u0432\u043D\u043E \u043E\u0442 \u043D\u0435\u0433\u043E \u043D\u0438
      \u0432\u0435\u0441\u0442\u043E\u0447\u043A\u0438. \u041D\u0430\u0432\u0435\u0441\u0442\u0438
      \u0435\u0433\u043E, \u0435\u0441\u043B\u0438 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0442\u0443\u0434\u0430 \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000009
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E. \u041F\u043E\u0438\u0449\u0443
      \u043A\u0443\u0437\u043D\u0435\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000010
    m_Localized: "\u0421\u043A\u0430\u0436\u0438 \u0435\u043C\u0443, \u041E\u0441\u0432\u0438\u043D
      \u0435\u0449\u0451 \u043F\u043E\u043C\u043D\u0438\u0442, \u043A\u0442\u043E
      \u043E\u0434\u043D\u0430\u0436\u0434\u044B \u043F\u043E\u0434\u043A\u043E\u0432\u0430\u043B
      \u0435\u043C\u0443 \u043A\u043E\u043D\u044F \u0432 \u0434\u043E\u043B\u0433.
      \u041E\u043D \u043F\u043E\u0439\u043C\u0451\u0442. \u0410 \u0435\u0441\u043B\u0438
      \u0441\u0434\u0435\u043B\u0430\u0435\u0442 \u0432\u0438\u0434, \u0447\u0442\u043E
      \u043D\u0435 \u043F\u043E\u043D\u044F\u043B \u2014 \u0437\u043D\u0430\u0447\u0438\u0442,
      \u0436\u0438\u0432 \u0438 \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443
      \u0443\u043F\u0440\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000011
    m_Localized: "\u042F \u043F\u0440\u0438\u043D\u0451\u0441 \u044F\u0431\u043B\u043E\u043A\u0438.
      \u0420\u043E\u0432\u043D\u043E \u0434\u0435\u0441\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000012
    m_Localized: "\u0414\u0430\u0439 \u0432\u0437\u0433\u043B\u044F\u043D\u0443\u0442\u044C...
      \u0425\u043E\u0440\u043E\u0448\u0438\u0435. \u041D\u0435 \u0446\u0430\u0440\u0441\u043A\u0438\u0439
      \u0441\u0442\u043E\u043B, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043D\u043E
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0435 \u0438 \u0442\u0430\u043A\u043E\u0435
      \u0431\u043E\u0433\u0430\u0442\u0441\u0442\u0432\u043E\u043C \u043A\u0430\u0436\u0435\u0442\u0441\u044F.
      \u0421\u043F\u0430\u0441\u0438\u0431\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000013
    m_Localized: "\u042F\u0431\u043B\u043E\u043A\u0438 \u0434\u043B\u044F \u041E\u0441\u0432\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000014
    m_Localized: "\u041E\u0441\u0432\u0438\u043D \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B
      \u0440\u0430\u0437\u0434\u043E\u0431\u044B\u0442\u044C \u0434\u043B\u044F \u043D\u0435\u0433\u043E
      \u0434\u0435\u0441\u044F\u0442\u044C \u044F\u0431\u043B\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000015
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u0434\u0435\u0441\u044F\u0442\u044C
      \u044F\u0431\u043B\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000016
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0435\u0441\u044F\u0442\u044C
      \u044F\u0431\u043B\u043E\u043A \u0434\u043B\u044F \u041E\u0441\u0432\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000017
    m_Localized: "\u041E\u0442\u043D\u0435\u0441\u0442\u0438 \u044F\u0431\u043B\u043E\u043A\u0438
      \u041E\u0441\u0432\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000018
    m_Localized: "\u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u0434\u0435\u0441\u044F\u0442\u044C
      \u044F\u0431\u043B\u043E\u043A. \u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C
      \u043A \u041E\u0441\u0432\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000019
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439
      \u041E\u0441\u0432\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000020
    m_Localized: "\u041E\u0441\u0432\u0438\u043D \u043F\u0440\u043E\u0441\u0438\u0442
      \u043D\u0430\u0432\u0435\u0441\u0442\u0438\u0442\u044C \u0441\u0432\u043E\u0435\u0433\u043E
      \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E-\u043A\u0443\u0437\u043D\u0435\u0446\u0430
      \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000021
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043A\u0443\u0437\u043D\u0435\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 76000000000000022
    m_Localized: "\u0414\u043E\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C \u0434\u043E
      \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u0438 \u0440\u0430\u0437\u044B\u0449\u0438\u0442\u0435
      \u043A\u0443\u0437\u043D\u0435\u0446\u0430, \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u041E\u0441\u0432\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000001
    m_Localized: "\u0427\u0442\u043E \u0442\u0443\u0442 \u0432\u043E\u043A\u0440\u0443\u0433
      \u0442\u0432\u043E\u0440\u0438\u0442\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000002
    m_Localized: "\u0412\u043E\u043A\u0440\u0443\u0433 \u2014 \u0441\u044B\u0440\u043E\u0441\u0442\u044C,
      \u043F\u0443\u0441\u0442\u044B\u0435 \u0434\u043E\u0440\u043E\u0433\u0438 \u0438
      \u0442\u0435, \u043A\u0442\u043E \u0440\u0435\u0448\u0438\u043B, \u0447\u0442\u043E
      \u0437\u0430\u043A\u043E\u043D \u0443\u0448\u0451\u043B \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u043F\u0443\u0442\u043D\u0438\u043A\u0430\u043C\u0438. \u0421\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439,
      \u0435\u0441\u043B\u0438 \u043D\u0435 \u0437\u0430 \u043F\u0443\u0441\u0442\u044B\u043C
      \u044F\u0437\u044B\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000003
    m_Localized: "\u0427\u0442\u043E \u0432 \u043B\u0435\u0441\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000004
    m_Localized: "\u041B\u0435\u0441 \u043A\u0430\u043A \u043B\u0435\u0441. \u0422\u043E\u043B\u044C\u043A\u043E
      \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u0435\u0431\u044F \u0442\u0430\u043C
      \u0440\u0430\u043D\u044C\u0448\u0435 \u0437\u0432\u0435\u0440\u044F \u0443\u0441\u043B\u044B\u0448\u0438\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441 \u043B\u0443\u043A\u043E\u043C.
      \u0414\u0432\u043E\u0438\u0445 \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u0432\u044B\u0432\u043E\u0434\u0438\u043B\u0438:
      \u0441 \u0442\u0440\u0430\u043A\u0442\u0430 \u0441\u043E\u0448\u043B\u0438
      \u043D\u0430 \u043F\u0430\u0440\u0443 \u0448\u0430\u0433\u043E\u0432, \u043F\u043E\u0442\u043E\u043C
      \u2014 \u043A\u0440\u0438\u043A, \u0431\u0435\u0433\u043E\u0442\u043D\u044F.
      \u041E\u0434\u043D\u043E\u0433\u043E \u043D\u0430\u0448\u043B\u0438. \u0412\u0442\u043E\u0440\u043E\u0433\u043E
      \u043B\u0435\u0441 \u0441\u0435\u0431\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000005
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0442\u0430\u043C \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000006
    m_Localized: "\u0415\u0441\u0442\u044C. \u0421\u0438\u0434\u044F\u0442 \u0443
      \u0441\u0442\u0430\u0440\u043E\u0439 \u043B\u0435\u0441\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438,
      \u0433\u0434\u0435 \u0442\u0435\u043B\u0435\u0433\u0443 \u043D\u0435 \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u044C.
      \u0412\u044B\u0441\u043A\u043E\u0447\u0430\u0442, \u0437\u0430\u043E\u0440\u0443\u0442,
      \u043B\u043E\u0448\u0430\u0434\u044C \u0441\u043F\u0443\u0433\u043D\u0443\u0442
      \u2014 \u0438 \u043F\u043E\u043A\u0430 \u0442\u044B \u0441\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u0448\u044C,
      \u0447\u0442\u043E \u043A \u0447\u0435\u043C\u0443, \u0443\u0436\u0435 \u0431\u0435\u0437
      \u043A\u043E\u0448\u0435\u043B\u044F. \u041E\u0434\u0438\u043D \u0445\u043E\u0434\u0438
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E \u043D\u0443\u0436\u0434\u0435.
      \u0418 \u0442\u043E \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000007
    m_Localized: "\u0410 \u0440\u0435\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000008
    m_Localized: "\u0414\u043D\u0451\u043C \u0443 \u0431\u0440\u043E\u0434\u0430
      \u0442\u0438\u0445\u043E. \u041D\u043E\u0447\u044C\u044E \u2014 \u043D\u0435
      \u0437\u043D\u0430\u044E. \u0412\u0438\u0434\u0435\u043B, \u043A\u0430\u043A
      \u0432\u043E\u0434\u0430 \u043F\u043B\u0435\u0441\u043D\u0443\u043B\u0430,
      \u0431\u0443\u0434\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u0432 \u043D\u0435\u0439
      \u0431\u0440\u0435\u0432\u043D\u043E \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u043B.
      \u041F\u043E\u0442\u043E\u043C \u043B\u043E\u0434\u043E\u0447\u043D\u0438\u043A
      \u0441 \u0431\u0435\u0440\u0435\u0433\u0430 \u0434\u0430\u043B \u0434\u0451\u0440\u0443,
      \u0432\u0435\u0441\u043B\u043E \u0431\u0440\u043E\u0441\u0438\u043B. \u0417\u0434\u043E\u0440\u043E\u0432\u044B\u0439
      \u043C\u0443\u0436\u0438\u043A, \u043C\u0435\u0436\u0434\u0443 \u043F\u0440\u043E\u0447\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000009
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u043C\u043E\u0436\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000010
    m_Localized: "\u041C\u043E\u0436\u043D\u043E. \u041F\u043E\u043A\u0430 \u0441\u0432\u0435\u0442\u043B\u043E,
      \u043F\u043E \u043C\u0435\u043B\u043A\u043E\u043C\u0443 \u043C\u0435\u0441\u0442\u0443
      \u0438 \u0431\u0435\u0437 \u0436\u0435\u043B\u0435\u0437\u0430 \u043D\u0430
      \u0441\u0435\u0431\u0435. \u041F\u043E\u043B\u0435\u0437\u0435\u0448\u044C
      \u0432 \u043A\u0430\u043C\u044B\u0448\u0438 \u0437\u0430 \u0442\u0440\u0430\u0432\u043E\u0439
      \u2014 \u0441\u043C\u043E\u0442\u0440\u0438 \u043F\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C.
      \u0423\u043C\u043D\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u0431\u0435\u0440\u0435\u0433,
      \u043F\u043E\u0442\u043E\u043C \u0443\u0436\u0435 \u0441\u0447\u0438\u0442\u0430\u0435\u0442,
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0446\u0432\u0435\u0442\u043A\u043E\u0432
      \u043D\u0430\u0431\u0440\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000011
    m_Localized: "\u0427\u0442\u043E \u0441\u043A\u0430\u0436\u0435\u0448\u044C \u043E
      \u0442\u0430\u0432\u0435\u0440\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000012
    m_Localized: "\u041A\u0440\u044B\u0448\u0430 \u043D\u0435 \u0442\u0435\u0447\u0451\u0442,
      \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0430 \u0433\u043E\u0440\u044F\u0447\u0430\u044F,
      \u0445\u043E\u0437\u044F\u0439\u043A\u0430 \u0441\u0434\u0430\u0447\u0443 \u043D\u0435
      \u0437\u0430\u0431\u044B\u0432\u0430\u0435\u0442 \u2014 \u0443\u0436\u0435
      \u043D\u0435\u043F\u043B\u043E\u0445\u043E. \u0420\u0430\u043D\u044C\u0448\u0435
      \u0442\u0430\u043C \u043A \u043D\u043E\u0447\u0438 \u0433\u0443\u0434\u0435\u043B\u043E
      \u0442\u0430\u043A, \u0447\u0442\u043E \u043F\u043E\u0441\u0442\u043E\u0432\u044B\u0435
      \u0440\u0443\u0433\u0430\u043B\u0438\u0441\u044C. \u0421\u0435\u0439\u0447\u0430\u0441
      \u0442\u0438\u0448\u0435. \u0418 \u043B\u0443\u0447\u0448\u0435: \u043F\u044C\u044F\u043D\u044B\u0439
      \u0441 \u043D\u043E\u0436\u043E\u043C \u2014 \u0442\u0430 \u0436\u0435 \u0431\u0435\u0434\u0430,
      \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043F\u0435\u0440\u0432\u0430 \u043F\u0435\u0441\u043D\u044E
      \u0437\u0430\u0442\u044F\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000013
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u0430\u043C \u043F\u043E\u0447\u0442\u0438
      \u043F\u0443\u0441\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000014
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0434\u043E\u0440\u043E\u0433\u0430
      \u043F\u0443\u0441\u0442\u0430\u044F. \u041F\u0443\u0442\u043D\u0438\u043A
      \u043D\u0435 \u0434\u0443\u0440\u0430\u043A: \u0443\u0441\u043B\u044B\u0448\u0430\u043B
      \u043F\u0440\u043E \u0442\u0432\u0430\u0440\u0435\u0439, \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432
      \u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      \u2014 \u0441\u0432\u0435\u0440\u043D\u0443\u043B \u0440\u0430\u043D\u044C\u0448\u0435.
      \u0410 \u0431\u0435\u0437 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432
      \u0442\u0430\u0432\u0435\u0440\u043D\u0430 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043C\u0435\u0441\u0442\u043D\u044B\u0445. \u0423 \u043C\u0435\u0441\u0442\u043D\u044B\u0445
      \u043C\u043E\u043D\u0435\u0442\u0430 \u0435\u0441\u0442\u044C \u043D\u0435
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0432\u0435\u0447\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000015
    m_Localized: "\u0410 \u0434\u0435\u0440\u0435\u0432\u043D\u044F \u0443 \u0442\u0440\u0430\u043A\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000016
    m_Localized: "\u041D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0431\u044B\u043B\u0430
      \u0434\u0435\u0440\u0435\u0432\u043D\u044F. \u041D\u0430\u0440\u043E\u0434
      \u0440\u0430\u0431\u043E\u0442\u044F\u0449\u0438\u0439, \u0437\u043B\u043E\u0439
      \u0440\u043E\u0432\u043D\u043E \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E,
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0434\u043E, \u0447\u0442\u043E\u0431\u044B
      \u0447\u0443\u0436\u043E\u0439 \u0432 \u043E\u0433\u043E\u0440\u043E\u0434
      \u043D\u0435 \u043B\u0435\u0437. \u0414\u043E\u0440\u043E\u0433\u0430 \u0438\u0445
      \u043A\u043E\u0440\u043C\u0438\u043B\u0430: \u043F\u043E\u0434\u0432\u043E\u0434\u0430
      \u0441\u043B\u043E\u043C\u0430\u043B\u0430\u0441\u044C \u2014 \u0435\u0441\u0442\u044C
      \u0440\u0430\u0431\u043E\u0442\u0430, \u043F\u0443\u0442\u043D\u0438\u043A
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F \u2014 \u0435\u0441\u0442\u044C
      \u0445\u043B\u0435\u0431. \u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0438
      \u0442\u043E\u0433\u043E, \u043D\u0438 \u0434\u0440\u0443\u0433\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000017
    m_Localized: "\u0422\u0443\u0434\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E
      \u0438\u0434\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000018
    m_Localized: "\u0415\u0441\u043B\u0438 \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435
      \u2014 \u043E\u043F\u0430\u0441\u043D\u043E \u0432\u0435\u0437\u0434\u0435.
      \u0415\u0441\u043B\u0438 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0448\u044C
      \u043F\u0440\u043E \u043B\u044E\u0434\u0435\u0439, \u0442\u043E \u043D\u0435
      \u043B\u0435\u0437\u044C \u0432 \u0447\u0443\u0436\u043E\u0439 \u0434\u0432\u043E\u0440
      \u0441 \u0440\u0443\u043A\u0430\u043C\u0438 \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u0430\u0445
      \u0438 \u043D\u0435 \u0441\u0442\u0440\u043E\u0439 \u0438\u0437 \u0441\u0435\u0431\u044F
      \u0433\u043E\u0441\u043F\u043E\u0434\u0438\u043D\u0430 \u2014 \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C
      \u0431\u0443\u0434\u0443\u0442. \u0410 \u0447\u0442\u043E \u0442\u0430\u043C
      \u0441\u0435\u0439\u0447\u0430\u0441, \u043D\u0435 \u0441\u043A\u0430\u0436\u0443.
      \u0414\u0430\u0432\u043D\u043E \u043E\u0442\u0442\u0443\u0434\u0430 \u043D\u0438\u043A\u0442\u043E
      \u043A \u0432\u043E\u0440\u043E\u0442\u0430\u043C \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000019
    m_Localized: "\u0427\u0442\u043E \u0441 \u0433\u043E\u0440\u043E\u0434\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000020
    m_Localized: "\u0421 \u0433\u043E\u0440\u043E\u0434\u043E\u043C \u2014 \u043F\u0440\u0438\u043A\u0430\u0437.
      \u0412\u043D\u0443\u0442\u0440\u0438 \u043B\u044E\u0434\u0438 \u0432\u0430\u043B\u044F\u0442\u0441\u044F
      \u0441 \u043D\u043E\u0433, \u043B\u0435\u043A\u0430\u0440\u0438 \u0448\u0435\u043F\u0447\u0443\u0442\u0441\u044F,
      \u0441\u043E\u0432\u0435\u0442 \u0437\u0430\u043F\u0435\u0440\u0441\u044F.
      \u0410 \u043C\u044B \u0441\u043D\u0430\u0440\u0443\u0436\u0438 \u0434\u0435\u0440\u0436\u0438\u043C
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0438 \u0441\u043B\u0443\u0448\u0430\u0435\u043C,
      \u043A\u0430\u043A \u043D\u0430\u0441 \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442
      \u0441\u0432\u043E\u043B\u043E\u0447\u0430\u043C\u0438. \u0420\u0430\u0431\u043E\u0442\u0430
      \u0434\u0440\u044F\u043D\u044C, \u043D\u043E \u043A\u0442\u043E-\u0442\u043E
      \u0435\u0451 \u0434\u0435\u043B\u0430\u0442\u044C \u0434\u043E\u043B\u0436\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000021
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0432\u043E\u0440\u043E\u0442\u0430
      \u043E\u0442\u043A\u0440\u043E\u044E\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 77000000000000022
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0441\u0432\u0435\u0440\u0445\u0443
      \u0441\u043A\u0430\u0436\u0443\u0442. \u042F \u043D\u0435 \u0441\u043E\u0432\u0435\u0442,
      \u043D\u0435 \u043B\u0435\u043A\u0430\u0440\u044C \u0438 \u043D\u0435 \u043F\u0440\u043E\u0432\u0438\u0434\u0435\u0446.
      \u041C\u043E\u0451 \u0434\u0435\u043B\u043E \u2014 \u0447\u0442\u043E\u0431\u044B
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u043B\u0435\u0437,
      \u043F\u043E\u043A\u0430 \u0437\u0430\u0440\u0430\u0437\u0430 \u043D\u0435
      \u0440\u0435\u0448\u0438\u0442, \u0447\u0442\u043E \u0435\u0439 \u0442\u0435\u0441\u043D\u043E
      \u0437\u0430 \u0441\u0442\u0435\u043D\u043E\u0439. \u041D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
      \u2014 \u043C\u043D\u0435 \u0442\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000001
    m_Localized: "\u0415\u0441\u0442\u044C \u0443 \u0432\u0430\u0441 \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000002
    m_Localized: "\u0415\u0441\u0442\u044C. \u0422\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u0434\u0432\u0438\u0433\u0438 \u043D\u0435 \u043E\u0431\u0435\u0449\u0430\u044E:
      \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u0433\u0440\u044F\u0437\u044C,
      \u0447\u0443\u0436\u0438\u0435 \u0431\u0435\u0434\u044B \u0438 \u0434\u043E\u0440\u043E\u0433\u0430,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u043E\u0440\u043E\u0432\u0438\u0442
      \u0432\u0437\u044F\u0442\u044C \u0441 \u0442\u0435\u0431\u044F \u043F\u043B\u0430\u0442\u0443
      \u0434\u0432\u0430\u0436\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000003
    m_Localized: "\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
      \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000004
    m_Localized: "\u041C\u0435\u043B\u044C\u043D\u0438\u043A \u043E\u0431\u044B\u0447\u043D\u043E
      \u0440\u0430\u0437 \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439 \u0437\u0430\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u043B
      \u043A \u0432\u043E\u0440\u043E\u0442\u0430\u043C: \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0441\u044F
      \u0437\u0430 \u0441\u043E\u043B\u044C, \u0440\u0443\u0433\u0430\u043B\u0441\u044F
      \u043D\u0430 \u0446\u0435\u043D\u044B, \u043F\u0440\u0438\u0432\u043E\u0437\u0438\u043B
      \u043C\u0443\u043A\u0443. \u0423\u0436\u0435 \u0432\u0442\u043E\u0440\u043E\u0439
      \u0434\u0435\u043D\u044C \u0435\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u043D\u043E.
      \u0410 \u043D\u0430 \u043A\u0430\u0440\u0430\u0443\u043B\u0435 \u0431\u0435\u0437
      \u0441\u0432\u0435\u0436\u0435\u0433\u043E \u0445\u043B\u0435\u0431\u0430 \u043B\u044E\u0434\u0438
      \u0431\u044B\u0441\u0442\u0440\u043E \u043C\u0440\u0430\u0447\u043D\u0435\u044E\u0442.
      \u0421\u0445\u043E\u0434\u0438, \u0443\u0437\u043D\u0430\u0439, \u0447\u0442\u043E
      \u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000005
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0441\u0430\u043C\u0438 \u043D\u0435
      \u0441\u0445\u043E\u0434\u0438\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000006
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0443
      \u043D\u0430\u0441 \u043E\u0434\u043D\u0438 \u043A\u0430\u0440\u0430\u0443\u043B\u044B.
      \u041B\u044E\u0434\u0435\u0439 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442:
      \u043E\u0434\u0438\u043D \u0437\u0430\u0431\u043E\u043B\u0435\u043B, \u0434\u0432\u043E\u0438\u0445
      \u0441 \u043D\u043E\u0447\u043D\u043E\u0439 \u0441\u043C\u0435\u043D\u044B
      \u043D\u0435 \u0441\u043D\u0438\u043C\u0435\u0448\u044C, \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
      \u0443\u0436\u0435 \u0432\u0442\u043E\u0440\u043E\u0439 \u0434\u0435\u043D\u044C
      \u0441\u0442\u043E\u0438\u0442 \u0443 \u0432\u043E\u0440\u043E\u0442. \u042F
      \u0438 \u0441\u0430\u043C \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F
      \u043A \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435 \u2014 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435
      \u044D\u0442\u043E \u043D\u0435 \u043F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430
      \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0443. \u041D\u043E \u0442\u0443\u0442
      \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u0432\u044B. \u0423\u0437\u043D\u0430\u0435\u0442\u0435,
      \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C,
      \u2014 \u043D\u0435 \u043E\u0431\u0438\u0436\u0443 \u043D\u0430\u0433\u0440\u0430\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000007
    m_Localized: "\u041B\u0430\u0434\u043D\u043E. \u0421\u0445\u043E\u0436\u0443
      \u043A \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000009
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E. \u041D\u0435 \u0433\u0435\u0440\u043E\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435:
      \u0441\u043F\u0435\u0440\u0432\u0430 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435,
      \u0435\u0441\u0442\u044C \u043B\u0438 \u0442\u0430\u043C \u043B\u044E\u0434\u0438,
      \u0430 \u0443\u0436\u0435 \u043F\u043E\u0442\u043E\u043C \u043B\u0435\u0437\u044C\u0442\u0435
      \u0432\u043D\u0443\u0442\u0440\u044C. \u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C
      \u0441 \u0442\u0435\u043C, \u0447\u0442\u043E \u0443\u0437\u043D\u0430\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000011
    m_Localized: "\u0427\u0442\u043E \u0437\u0430 \u0434\u0435\u043B\u043E \u0432
      \u0442\u0430\u0432\u0435\u0440\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000012
    m_Localized: "\u0422\u0430\u0432\u0435\u0440\u043D\u0430 \u0443 \u0442\u0440\u0430\u043A\u0442\u0430
      \u0440\u0430\u043D\u044C\u0448\u0435 \u0436\u0438\u043B\u0430 \u0448\u0443\u043C\u043E\u043C.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u0442\u0442\u0443\u0434\u0430 \u0434\u0430\u0432\u043D\u043E
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B,
      \u0434\u0430\u0436\u0435 \u0437\u0430 \u0441\u043E\u043B\u044C\u044E. \u0425\u043E\u0437\u044F\u0438\u043D
      \u0441 \u0434\u043E\u0447\u0435\u0440\u044C\u044E \u0434\u0435\u0440\u0436\u0430\u043B\u0438
      \u043C\u0435\u0441\u0442\u043E \u043A\u0440\u0435\u043F\u043A\u043E; \u0435\u0441\u043B\u0438
      \u043C\u043E\u043B\u0447\u0430\u0442, \u0437\u043D\u0430\u0447\u0438\u0442,
      \u043B\u0438\u0431\u043E \u0431\u0435\u0434\u0430, \u043B\u0438\u0431\u043E
      \u0434\u0432\u0435\u0440\u044C \u0437\u0430\u043F\u0435\u0440\u043B\u0438 \u0438\u0437
      \u0441\u0442\u0440\u0430\u0445\u0430. \u0417\u0430\u0439\u0434\u0438\u0442\u0435
      \u0438 \u0443\u0437\u043D\u0430\u0439\u0442\u0435, \u0432\u0441\u0451 \u043B\u0438
      \u0443 \u043D\u0438\u0445 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000013
    m_Localized: "\u042D\u0442\u043E \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435
      \u0434\u043B\u044F \u0441\u0442\u0440\u0430\u0436\u0438 \u0438\u043B\u0438
      \u043B\u0438\u0447\u043D\u043E\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000014
    m_Localized: "\u0418 \u0442\u043E \u0438 \u0434\u0440\u0443\u0433\u043E\u0435.
      \u041F\u0443\u0441\u0442\u0430\u044F \u0442\u0430\u0432\u0435\u0440\u043D\u0430
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u2014 \u043F\u043B\u043E\u0445\u043E\u0439
      \u0437\u043D\u0430\u043A \u0434\u043B\u044F \u0432\u0441\u0435\u0445. \u0410
      \u0434\u043E\u0447\u044C \u0445\u043E\u0437\u044F\u0438\u043D\u0430... \u043E\u043D\u0430
      \u0443\u043C\u0435\u0435\u0442 \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0433\u043E\u043B\u043E\u0432\u0443
      \u0432\u044B\u0448\u0435 \u0431\u0435\u0434\u044B. \u0425\u043E\u0442\u0435\u043B
      \u0431\u044B \u0437\u043D\u0430\u0442\u044C, \u0436\u0438\u0432\u0430 \u043B\u0438
      \u044D\u0442\u0430 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0430. \u041D\u0435
      \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0435\u0439
      \u043B\u0438\u0448\u043D\u0435\u0433\u043E. \u041F\u0440\u043E\u0441\u0442\u043E
      \u0443\u0437\u043D\u0430\u0439\u0442\u0435, \u043A\u0430\u043A \u043E\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000015
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0443
      \u0438 \u0440\u0430\u0441\u0441\u043F\u0440\u043E\u0448\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000016
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u041D\u0435 \u0442\u0440\u0435\u0431\u0443\u0439\u0442\u0435
      \u043E\u0442 \u043D\u0438\u0445 \u043E\u0442\u0447\u0451\u0442\u0430, \u043A\u0430\u043A
      \u043E\u0442 \u0441\u043E\u043B\u0434\u0430\u0442. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435,
      \u0447\u0442\u043E \u0443\u0432\u0438\u0434\u0438\u0442\u0435, \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435
      \u043F\u043E-\u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438
      \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0442\u0435\u0441\u044C
      \u0441 \u0432\u0435\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000018
    m_Localized: "\u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u043C\u043E\u043B\u0447\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000019
    m_Localized: "\u0413\u043B\u0430\u0432\u0430 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
      \u0441\u0442\u0440\u0430\u0436\u0438 \u043F\u0440\u043E\u0441\u0438\u0442 \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u043A
      \u043D\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u043B\u0441\u044F \u0443
      \u0432\u043E\u0440\u043E\u0442 \u0443\u0436\u0435 \u0434\u0432\u0430 \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000020
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000021
    m_Localized: "\u0414\u043E\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C \u0434\u043E
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B \u0438 \u0443\u0437\u043D\u0430\u0439\u0442\u0435,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E \u0441
      \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000022
    m_Localized: "\u0412\u0435\u0441\u0442\u0438 \u0438\u0437 \u0442\u0430\u0432\u0435\u0440\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000023
    m_Localized: "\u0413\u043B\u0430\u0432\u0430 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
      \u0441\u0442\u0440\u0430\u0436\u0438 \u043F\u0440\u043E\u0441\u0438\u0442 \u0443\u0437\u043D\u0430\u0442\u044C,
      \u0432\u0441\u0451 \u043B\u0438 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435
      \u0443 \u0445\u043E\u0437\u044F\u0438\u043D\u0430 \u0442\u0430\u0432\u0435\u0440\u043D\u044B
      \u0438 \u0435\u0433\u043E \u0434\u043E\u0447\u0435\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000024
    m_Localized: "\u0417\u0430\u0439\u0442\u0438 \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000025
    m_Localized: "\u0414\u043E\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C \u0434\u043E
      \u0442\u0430\u0432\u0435\u0440\u043D\u044B \u0443 \u0442\u0440\u0430\u043A\u0442\u0430
      \u0438 \u0443\u0437\u043D\u0430\u0439\u0442\u0435, \u0447\u0442\u043E \u0442\u0430\u043C
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000026
    m_Localized: "\u0410 \u0442\u044B \u0441\u0430\u043C? \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0448\u044C
      \u043E \u0441\u0435\u0431\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000027
    m_Localized: "\u042F? \u0418\u0437 \u043A\u0430\u043D\u0430\u0432\u044B, \u0435\u0441\u043B\u0438
      \u043F\u043E \u043F\u0440\u0430\u0432\u0434\u0435. \u041C\u0435\u043D\u044F
      \u043C\u0430\u043B\u044C\u0446\u043E\u043C \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0431\u0440\u043E\u0441\u0438\u043B\u0438. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u043F\u043E \u0434\u0432\u043E\u0440\u0430\u043C \u043F\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F,
      \u043F\u043E\u0442\u043E\u043C \u0442\u0430\u0441\u043A\u0430\u043B, \u0447\u0442\u043E
      \u043F\u043B\u043E\u0445\u043E \u043B\u0435\u0436\u0438\u0442. \u041D\u0435
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0434\u0443\u0448\u0430
      \u043A \u0442\u043E\u043C\u0443 \u043B\u0435\u0436\u0430\u043B\u0430 \u2014
      \u043F\u0443\u0441\u0442\u043E\u0439 \u0436\u0438\u0432\u043E\u0442 \u0443\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442
      \u043B\u0443\u0447\u0448\u0435 \u043B\u044E\u0431\u043E\u0433\u043E \u0443\u043C\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000028
    m_Localized: "\u0418 \u043A\u0430\u043A \u0442\u044B \u0432 \u0441\u0442\u0440\u0430\u0436\u0443
      \u043F\u043E\u043F\u0430\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000029
    m_Localized: "\u0412\u044B\u0440\u043E\u0441 \u2014 \u043F\u043E\u043D\u044F\u043B:
      \u0432\u043E\u0440 \u0438\u0437 \u043C\u0435\u043D\u044F \u0442\u0430\u043A
      \u0441\u0435\u0431\u0435, \u0434\u0430 \u0438 \u0431\u0435\u0433\u0430\u0442\u044C
      \u043E\u0442 \u043F\u0430\u043B\u043A\u0438 \u043D\u0430\u0434\u043E\u0435\u043B\u043E.
      \u041F\u043E\u0442\u043E\u043C \u0432\u0441\u0451 \u0442\u0443\u0442 \u043F\u043E\u043A\u0430\u0442\u0438\u043B\u043E\u0441\u044C:
      \u0434\u043E\u0440\u043E\u0433\u0438 \u043E\u043F\u0443\u0441\u0442\u0435\u043B\u0438,
      \u043B\u044E\u0434\u0435\u0439 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442.
      \u0411\u0440\u0430\u043B\u0438 \u043A\u0430\u0436\u0434\u043E\u0433\u043E,
      \u043A\u0442\u043E \u043A\u043E\u043F\u044C\u0451 \u043D\u0435 \u0440\u043E\u043D\u044F\u0435\u0442
      \u0438 \u0432 \u043F\u0435\u0440\u0432\u0443\u044E \u043D\u043E\u0447\u044C
      \u043D\u0435 \u0441\u0431\u0435\u0436\u0438\u0442. \u042F \u043E\u0441\u0442\u0430\u043B\u0441\u044F.
      \u0420\u0430\u0431\u043E\u0442\u0430 \u0434\u0440\u044F\u043D\u044C, \u043D\u043E
      \u0434\u0435\u043B\u0430\u044E \u043A\u0430\u043A \u0441\u043B\u0435\u0434\u0443\u0435\u0442.
      \u0427\u0443\u0436\u043E\u0433\u043E \u043D\u0435 \u0431\u0435\u0440\u0443,
      \u0441\u043B\u0430\u0431\u043E\u0433\u043E \u043D\u0435 \u043F\u0438\u043D\u0430\u044E,
      \u0441\u043B\u043E\u0432\u043E \u0434\u0435\u0440\u0436\u0443. \u0411\u043E\u043B\u044C\u0448\u0435
      \u0443 \u043C\u0435\u043D\u044F \u0437\u0430 \u0434\u0443\u0448\u043E\u0439
      \u0438 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000030
    m_Localized: "\u041A\u043E\u0436\u0430\u043D\u044B\u0439 \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0439
      \u0434\u0443\u0431\u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000031
    m_Localized: "\u0414\u0443\u0431\u043B\u0435\u0442 \u0438\u0437 \u043F\u0440\u043E\u0441\u0442\u043E\u0439
      \u0432\u044B\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0439 \u043A\u043E\u0436\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u043E\u0441\u044F\u0442 \u043F\u043E\u0432\u0435\u0440\u0445
      \u0440\u0443\u0431\u0430\u0445\u0438 \u0432 \u0434\u043E\u0440\u043E\u0433\u0443
      \u0438 \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443. \u041E\u043D \u043D\u0435
      \u0434\u0435\u043B\u0430\u0435\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0441\u043E\u043B\u0434\u0430\u0442\u043E\u043C, \u0437\u0430\u0442\u043E
      \u0431\u0435\u0440\u0435\u0436\u0451\u0442 \u043E\u0434\u0435\u0436\u0434\u0443
      \u043E\u0442 \u043C\u043E\u043A\u0440\u043E\u0439 \u0442\u0440\u0430\u0432\u044B,
      \u0440\u0435\u043C\u043D\u0435\u0439 \u0438 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439
      \u043F\u044B\u043B\u0438. \u0428\u0432\u044B \u043C\u043E\u0436\u043D\u043E
      \u043F\u043E\u0434\u043B\u0430\u0442\u0430\u0442\u044C \u0443 \u043B\u044E\u0431\u043E\u0433\u043E
      \u0441\u043A\u043E\u0440\u043D\u044F\u043A\u0430, \u0430 \u043F\u043E\u0442\u0451\u0440\u0442\u043E\u0441\u0442\u0438
      \u043D\u0430 \u0442\u0430\u043A\u043E\u0439 \u043A\u043E\u0436\u0435 \u043D\u0435
      \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u043F\u043E\u0437\u043E\u0440\u043E\u043C.
      \u0422\u0430\u043A\u0438\u0435 \u0432\u0435\u0449\u0438 \u0446\u0435\u043D\u044F\u0442
      \u043D\u0435 \u0437\u0430 \u043D\u0430\u0440\u044F\u0434\u043D\u043E\u0441\u0442\u044C,
      \u0430 \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u0443\u0442\u0440\u043E\u043C
      \u0438\u0445 \u0441\u043D\u043E\u0432\u0430 \u043C\u043E\u0436\u043D\u043E
      \u043D\u0430\u0434\u0435\u0442\u044C \u0438 \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000032
    m_Localized: "\u0428\u0430\u043F\u0435\u0440\u043E\u043D \u0441 \u043A\u0440\u0430\u0441\u043D\u044B\u043C
      \u043F\u0435\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000033
    m_Localized: "\u0428\u0430\u043F\u0435\u0440\u043E\u043D \u0434\u043B\u044F \u0442\u0435\u0445,
      \u043A\u0442\u043E \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442 \u0434\u0435\u043D\u044C
      \u043D\u0430 \u0432\u0435\u0442\u0440\u0443, \u043D\u043E \u043D\u0435 \u0445\u043E\u0447\u0435\u0442
      \u043F\u0440\u044F\u0442\u0430\u0442\u044C \u043B\u0438\u0446\u043E \u043F\u043E\u0434
      \u043A\u0430\u043F\u044E\u0448\u043E\u043D\u043E\u043C. \u041A\u0440\u0430\u0441\u043D\u043E\u0435
      \u043F\u0435\u0440\u043E \u2014 \u0437\u0430\u043C\u0435\u0442\u043D\u0430\u044F,
      \u043D\u043E \u043D\u0435\u0434\u043E\u0440\u043E\u0433\u0430\u044F \u043F\u043E\u043F\u044B\u0442\u043A\u0430
      \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C
      \u0441 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C; \u0432\u0441\u0451
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u0432 \u043D\u0451\u043C
      \u043F\u043E\u0434\u0447\u0438\u043D\u0435\u043D\u043E \u0434\u043E\u0440\u043E\u0433\u0435.
      \u0412 \u043D\u0451\u043C \u0443\u0434\u043E\u0431\u043D\u043E \u0441\u043B\u0443\u0448\u0430\u0442\u044C,
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0438 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0442\u044C\u0441\u044F,
      \u0447\u0442\u043E \u0432 \u043F\u0443\u0442\u0438 \u0432\u0430\u0436\u043D\u0435\u0435
      \u0432\u0441\u044F\u043A\u043E\u0439 \u043C\u043E\u0434\u044B. \u041D\u0430
      \u043F\u0440\u0438\u0451\u043C \u0432 \u0442\u0430\u043A\u043E\u043C \u043D\u0435
      \u0438\u0434\u0443\u0442, \u043D\u043E \u0443 \u0432\u043E\u0440\u043E\u0442,
      \u043D\u0430 \u0440\u044B\u043D\u043A\u0435 \u0438 \u0432 \u0441\u0435\u0434\u043B\u0435
      \u043E\u043D \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u0443\u0434\u0438\u0432\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000034
    m_Localized: "\u0414\u043E\u0440\u043E\u0436\u043D\u044B\u0435 \u0448\u0442\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000035
    m_Localized: "\u0428\u0442\u0430\u043D\u044B \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B,
      \u0430 \u043D\u0435 \u0434\u043B\u044F \u0441\u0443\u043D\u0434\u0443\u043A\u0430.
      \u041A\u0440\u0435\u043F\u043A\u0430\u044F \u0442\u043A\u0430\u043D\u044C \u0438
      \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439 \u043A\u0440\u043E\u0439
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0434\u043E\u043B\u0433\u043E
      \u0441\u0438\u0434\u0435\u0442\u044C \u0432 \u0441\u0435\u0434\u043B\u0435,
      \u0442\u0430\u0441\u043A\u0430\u0442\u044C \u044F\u0449\u0438\u043A\u0438 \u0438\u043B\u0438
      \u0441\u0442\u043E\u044F\u0442\u044C \u043D\u0430 \u043F\u043E\u0441\u0442\u0443.
      \u041A\u043E\u043B\u0435\u043D\u0438 \u0438 \u0448\u0432\u044B \u0437\u0434\u0435\u0441\u044C
      \u0432\u0430\u0436\u043D\u0435\u0435 \u0440\u0438\u0441\u0443\u043D\u043A\u0430:
      \u043E\u0434\u0435\u0436\u0434\u0443 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u0447\u0430\u0441\u0442\u043E \u0441\u0442\u0438\u0440\u0430\u0442\u044C,
      \u0441\u0443\u0448\u0438\u0442\u044C \u0443 \u043E\u0433\u043D\u044F \u0438
      \u0447\u0438\u043D\u0438\u0442\u044C \u043D\u0430\u0441\u043F\u0435\u0445.
      \u0423 \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0445\u043E\u0437\u044F\u0438\u043D\u0430
      \u0442\u0430\u043A\u0438\u0435 \u0448\u0442\u0430\u043D\u044B \u043D\u0435
      \u043B\u0435\u0436\u0430\u0442 \u0431\u0435\u0437 \u0434\u0435\u043B\u0430
      \u2014 \u0438\u0445 \u0438\u0437\u043D\u0430\u0448\u0438\u0432\u0430\u044E\u0442
      \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u0437\u0430\u043F\u043B\u0430\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000036
    m_Localized: "\u0421\u0430\u043F\u043E\u0433\u0438 \u0441 \u043E\u0431\u043C\u043E\u0442\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000037
    m_Localized: "\u041F\u0430\u0440\u0430 \u0433\u0440\u0443\u0431\u044B\u0445 \u043A\u043E\u0436\u0430\u043D\u044B\u0445
      \u0441\u0430\u043F\u043E\u0433 \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u043E\u043C\u0443
      \u0447\u0430\u0441\u0442\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u043C\u0435\u0440\u0438\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443 \u043D\u043E\u0433\u0430\u043C\u0438.
      \u0412\u044B\u0441\u043E\u043A\u0438\u0435 \u0433\u043E\u043B\u0435\u043D\u0438\u0449\u0430
      \u0434\u0435\u0440\u0436\u0430\u0442 \u0433\u0440\u044F\u0437\u044C \u0438
      \u043A\u043E\u043B\u044E\u0447\u043A\u0438 \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435
      \u043E\u0442 \u043E\u0434\u0435\u0436\u0434\u044B, \u0430 \u043F\u043B\u043E\u0442\u043D\u0430\u044F
      \u043F\u043E\u0434\u043E\u0448\u0432\u0430 \u0442\u0435\u0440\u043F\u0438\u0442
      \u043A\u0430\u043C\u043D\u0438, \u0449\u0435\u0431\u0435\u043D\u044C \u0438
      \u043A\u043E\u0440\u043D\u0438. \u0418\u0445 \u043D\u0435 \u0436\u0430\u043B\u0435\u044E\u0442:
      \u0441\u0443\u0448\u0430\u0442 \u0443 \u043E\u0433\u043D\u044F, \u0441\u043C\u0430\u0437\u044B\u0432\u0430\u044E\u0442
      \u0436\u0438\u0440\u043E\u043C \u0438 \u0441\u043D\u043E\u0432\u0430 \u0432\u044B\u0432\u043E\u0434\u044F\u0442
      \u0432 \u0434\u043E\u0436\u0434\u044C. \u041F\u043E\u043A\u0430 \u043F\u043E\u0434\u043E\u0448\u0432\u0430
      \u0446\u0435\u043B\u0430, \u0441\u0430\u043F\u043E\u0433\u0438 \u0447\u0435\u0441\u0442\u043D\u043E
      \u043E\u0442\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0442 \u0446\u0435\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000038
    m_Localized: "\u0421\u0442\u0451\u0433\u0430\u043D\u044B\u0435 \u043D\u0430\u0440\u0443\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000039
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430
      \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u0438\u0439, \u043A\u043E\u0433\u0434\u0430
      \u043B\u0430\u0434\u043E\u043D\u0438 \u0434\u043E\u043B\u0436\u043D\u044B \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F
      \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u043C\u0438. \u0421\u0442\u0451\u0433\u0430\u043D\u0430\u044F
      \u0442\u043A\u0430\u043D\u044C \u0441\u043C\u044F\u0433\u0447\u0438\u0442 \u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0449\u0438\u0439
      \u0443\u0434\u0430\u0440, \u0443\u0434\u0435\u0440\u0436\u0438\u0442 \u0440\u0435\u043C\u0435\u043D\u044C
      \u0449\u0438\u0442\u0430 \u0438 \u043F\u0440\u0438\u043A\u0440\u043E\u0435\u0442
      \u0440\u0443\u043A\u0438 \u043E\u0442 \u0433\u0440\u0443\u0431\u043E\u0439
      \u0440\u0430\u0431\u043E\u0442\u044B; \u043A\u043E\u0436\u0430\u043D\u044B\u0435
      \u0437\u0430\u0441\u0442\u0451\u0436\u043A\u0438 \u043D\u0435 \u0434\u0430\u0434\u0443\u0442
      \u043D\u0430\u0440\u0443\u0447\u0430\u043C \u0441\u043F\u043E\u043B\u0437\u0430\u0442\u044C.
      \u041E\u043D\u0438 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u0442
      \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u0435 \u043B\u0430\u0442\u043D\u044B\u0435
      \u0440\u0443\u043A\u0430\u0432\u0438\u0446\u044B, \u043D\u043E \u0438 \u0441\u0442\u043E\u044F\u0442
      \u043D\u0435 \u043A\u0430\u043A \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435
      \u0440\u044B\u0446\u0430\u0440\u044F. \u0422\u0430\u043A\u0438\u0435 \u0432\u0435\u0449\u0438
      \u043D\u0430\u0434\u0435\u0432\u0430\u044E\u0442 \u043D\u0435 \u0440\u0430\u0434\u0438
      \u0432\u0438\u0434\u0430, \u0430 \u043A\u043E\u0433\u0434\u0430 \u0437\u043D\u0430\u044E\u0442,
      \u0447\u0442\u043E \u0434\u0435\u043D\u044C \u043C\u043E\u0436\u0435\u0442
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C\u0441\u044F \u0441\u0441\u0430\u0434\u0438\u043D\u043E\u0439
      \u0438\u043B\u0438 \u0434\u0440\u0430\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000040
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u044B\u0439 \u043C\u0435\u0447 \u0441
      \u043B\u0430\u0442\u0443\u043D\u043D\u043E\u0439 \u0433\u0430\u0440\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 78000000000000041
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E \u0441\u0431\u0430\u043B\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043C\u0435\u0447 \u0440\u0430\u0431\u043E\u0442\u044B \u0443\u043C\u0435\u043B\u043E\u0433\u043E,
      \u043D\u043E \u043D\u0435 \u0438\u043C\u0435\u043D\u0438\u0442\u043E\u0433\u043E
      \u043A\u0443\u0437\u043D\u0435\u0446\u0430. \u041A\u043B\u0438\u043D\u043E\u043A
      \u043F\u043E\u0441\u043B\u0443\u0448\u0435\u043D \u0432 \u0440\u0443\u043A\u0435,
      \u043B\u0430\u0442\u0443\u043D\u043D\u0430\u044F \u0433\u0430\u0440\u0434\u0430
      \u0441\u0434\u0435\u043B\u0430\u043D\u0430 \u0431\u0435\u0437 \u043F\u043E\u043A\u0430\u0437\u043D\u043E\u0439
      \u0440\u0435\u0437\u044C\u0431\u044B, \u0430 \u043D\u0430\u0432\u0435\u0440\u0448\u0438\u0435
      \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043D\u043E \u0442\u0430\u043A,
      \u0447\u0442\u043E\u0431\u044B \u043C\u0435\u0447 \u043D\u0435 \u043A\u043B\u0435\u0432\u0430\u043B
      \u043D\u043E\u0441\u043E\u043C \u0432 \u0443\u0434\u0430\u0440\u0435. \u041A\u0430\u0436\u0434\u0430\u044F
      \u043C\u043E\u043D\u0435\u0442\u0430 \u0432 \u0435\u0433\u043E \u0446\u0435\u043D\u0435
      \u0443\u043F\u043B\u0430\u0447\u0435\u043D\u0430 \u0437\u0430 \u0441\u0442\u0430\u043B\u044C
      \u0438 \u0440\u0430\u0431\u043E\u0442\u0443, \u0430 \u043D\u0435 \u0437\u0430
      \u0433\u0440\u043E\u043C\u043A\u043E\u0435 \u0438\u043C\u044F \u043C\u0430\u0441\u0442\u0435\u0440\u0430.
      \u0422\u0430\u043A\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442
      \u043D\u0435\u0431\u043E\u0433\u0430\u0442\u044B\u0435 \u0434\u0432\u043E\u0440\u044F\u043D\u0435
      \u0438 \u043B\u044E\u0434\u0438 \u043F\u0440\u0438 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438:
      \u0438\u043C \u043D\u0443\u0436\u0435\u043D \u0432\u0435\u0440\u043D\u044B\u0439
      \u043A\u043B\u0438\u043D\u043E\u043A \u043D\u0430 \u0433\u043E\u0434\u044B,
      \u0430 \u043D\u0435 \u0444\u0430\u043C\u0438\u043B\u044C\u043D\u0430\u044F
      \u0432\u0435\u0449\u044C \u0434\u043B\u044F \u043F\u0430\u0440\u0430\u0434\u043D\u043E\u0433\u043E
      \u043F\u043E\u044F\u0441\u0430. \u0415\u0441\u043B\u0438 \u0437\u0430 \u043D\u0438\u043C
      \u0441\u043B\u0435\u0434\u0438\u0442\u044C, \u043E\u043D \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0451\u0442
      \u043D\u0435 \u043E\u0434\u043D\u0443 \u0441\u043C\u0435\u043D\u0443 \u0445\u043E\u0437\u044F\u0435\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 79000000000000001
    m_Localized: "\u041A\u043E\u0436\u0430\u043D\u0430\u044F \u043F\u043B\u0435\u0447\u0435\u0432\u0430\u044F
      \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 79000000000000002
    m_Localized: "\u0428\u0438\u0440\u043E\u043A\u0430\u044F \u043A\u043E\u0436\u0430\u043D\u0430\u044F
      \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u044C \u0438\u0434\u0451\u0442 \u043E\u0442
      \u043F\u043B\u0435\u0447\u0430 \u043A \u043F\u043E\u044F\u0441\u0443 \u043F\u043E\u0432\u0435\u0440\u0445
      \u0440\u0443\u0431\u0430\u0445\u0438. \u041E\u043D\u0430 \u0434\u0435\u0440\u0436\u0438\u0442
      \u0437\u0430\u043F\u043B\u0435\u0447\u043D\u0443\u044E \u043D\u043E\u0448\u0443
      \u0440\u043E\u0432\u043D\u0435\u0435, \u0430 \u043F\u043E\u0442\u0435\u043C\u043D\u0435\u0432\u0448\u0438\u0435
      \u043E\u0442 \u043C\u0430\u0441\u043B\u0430 \u0448\u0432\u044B \u043B\u0435\u0433\u043A\u043E
      \u043F\u043E\u0434\u043B\u0430\u0442\u0430\u0442\u044C \u0432 \u0434\u043E\u0440\u043E\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 79000000000000003
    m_Localized: "\u0414\u043E\u0440\u043E\u0436\u043D\u0430\u044F \u0436\u0438\u043B\u0435\u0442\u043A\u0430
      \u0441 \u0440\u0435\u043C\u043D\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 79000000000000004
    m_Localized: "\u041A\u043E\u0440\u043E\u0442\u043A\u0430\u044F \u0436\u0438\u043B\u0435\u0442\u043A\u0430
      \u0438\u0437 \u043F\u043B\u043E\u0442\u043D\u043E\u0439 \u043A\u043E\u0436\u0438
      \u0441\u043E\u0431\u0440\u0430\u043D\u0430 \u0438\u0437 \u043D\u0430\u043A\u043B\u0430\u0434\u043D\u044B\u0445
      \u0434\u0435\u0442\u0430\u043B\u0435\u0439 \u0438 \u0441\u0442\u044F\u043D\u0443\u0442\u0430
      \u0440\u0435\u043C\u043D\u044F\u043C\u0438. \u041E\u043D\u0430 \u043D\u0435
