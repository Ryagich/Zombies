  - m_Id: 87000000000000006
    m_Localized: "\u0422\u0451\u043C\u043D\u043E-\u0441\u0438\u043D\u0438\u0435 \u043F\u043E\u043B\u044F
      \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0448\u0438\u0440\u043E\u043A\u0438\u043C
      \u0440\u043E\u0432\u043D\u044B\u043C \u043A\u0440\u0443\u0433\u043E\u043C,
      \u0430 \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0442\u0443\u043B\u044C\u044F
      \u0441\u0442\u044F\u043D\u0443\u0442\u0430 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u043C
      \u0440\u0435\u043C\u043D\u0451\u043C. \u0421\u043F\u0435\u0440\u0435\u0434\u0438
      \u0440\u0435\u043C\u0435\u043D\u044C \u0437\u0430\u043C\u044B\u043A\u0430\u0435\u0442
      \u043A\u0440\u0443\u043F\u043D\u0430\u044F \u0441\u0432\u0435\u0442\u043B\u0430\u044F
      \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u0430\u044F \u043F\u0440\u044F\u0436\u043A\u0430
      \u2014 \u043F\u0440\u043E\u0441\u0442\u0430\u044F \u043F\u043E \u0444\u043E\u0440\u043C\u0435,
      \u043D\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0437\u0430\u043C\u0435\u0442\u043D\u0430\u044F,
      \u0447\u0442\u043E\u0431\u044B \u0431\u044B\u0442\u044C \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0439.
      \u0428\u043B\u044F\u043F\u0430 \u0441\u0442\u0440\u043E\u0433\u0430\u044F \u0438
      \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u0430\u044F: \u0435\u0451 \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442
      \u043F\u043E \u043F\u0440\u044F\u0436\u043A\u0435, \u0430 \u043D\u0435 \u043F\u043E
      \u043F\u044B\u0448\u043D\u043E\u0441\u0442\u0438."
