  - m_Id: 91000000000000002
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u044B\u0439 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0439
      \u0448\u043B\u0435\u043C \u0441\u043E\u0431\u0440\u0430\u043D \u0432 \u0441\u0442\u0440\u043E\u0433\u0438\u0439
      \u043A\u043B\u0438\u043D\u043E\u0432\u0438\u0434\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442.
      \u041D\u0430\u0434 \u043B\u0431\u043E\u043C \u043B\u0435\u0436\u0438\u0442
      \u043A\u0440\u0443\u043F\u043D\u0430\u044F \u0440\u043E\u043C\u0431\u043E\u0432\u0438\u0434\u043D\u0430\u044F
      \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430 \u0441 \u0442\u0451\u043C\u043D\u043E\u0439
      \u043E\u043A\u0430\u043D\u0442\u043E\u0432\u043A\u043E\u0439; \u043D\u0438\u0436\u0435,
      \u043F\u043E \u043E\u0431\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
      \u043E\u0442 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0446\u044B,
      \u0432\u044B\u0441\u0442\u0440\u043E\u0435\u043D\u044B \u0443\u0437\u043A\u0438\u0435
      \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435 \u0441\u043C\u043E\u0442\u0440\u043E\u0432\u044B\u0435
      \u043F\u0440\u043E\u0440\u0435\u0437\u0438. \u0428\u0438\u0440\u043E\u043A\u0438\u0439
      \u043D\u0438\u0436\u043D\u0438\u0439 \u043A\u0440\u0430\u0439 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442
      \u0444\u043E\u0440\u043C\u0443 \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043A\u0430
      \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u0432\u0435\u0449\u044C
      \u0440\u043E\u0432\u043D\u043E\u0439 \u0442\u044F\u0436\u0451\u043B\u043E\u0439
      \u043B\u0438\u043D\u0438\u0435\u0439."
