  - m_Id: 84000000000000004
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u043F\u0440\u044F\u043C\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0439
      \u0440\u0430\u043D\u0435\u0446 \u0438\u0437 \u043F\u043B\u043E\u0442\u043D\u043E\u0439
      \u0442\u043A\u0430\u043D\u0438, \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0439
      \u0434\u0432\u0443\u043C\u044F \u0448\u0438\u0440\u043E\u043A\u0438\u043C\u0438
      \u043A\u043E\u0436\u0430\u043D\u044B\u043C\u0438 \u0441\u0442\u044F\u0436\u043A\u0430\u043C\u0438.
      \u041D\u0430 \u043A\u0430\u0436\u0434\u043E\u0439 \u2014 \u0441\u0432\u0435\u0442\u043B\u0430\u044F
      \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u043F\u0440\u044F\u0436\u043A\u0430; \u0431\u043E\u043A\u043E\u0432\u044B\u0435
      \u043A\u043B\u0430\u043F\u0430\u043D\u044B \u0434\u0435\u0440\u0436\u0430\u0442
      \u0444\u043E\u0440\u043C\u0443 \u0438 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435 \u043E\u0442 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439
      \u043F\u044B\u043B\u0438. \u0412\u0435\u0449\u044C \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0441\u043A\u0440\u043E\u043C\u043D\u043E, \u043D\u043E \u0441\u0448\u0438\u0442\u0430
      \u0440\u043E\u0432\u043D\u043E: \u0435\u0451 \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442
      \u0442\u0435, \u043A\u0442\u043E \u043D\u043E\u0441\u0438\u0442 \u0437\u0430\u043F\u0430\u0441
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C \u0438 \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u0435\u0442,
      \u0447\u0442\u043E\u0431\u044B \u0440\u0435\u043C\u043D\u0438 \u0441\u043B\u0443\u0436\u0438\u043B\u0438
      \u0434\u043E\u043B\u044C\u0448\u0435 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0445
      \u0441\u043B\u043E\u0432."
