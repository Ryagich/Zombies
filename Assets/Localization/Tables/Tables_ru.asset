  - m_Id: 91000000000000006
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u0438\u0439 \u0437\u0430\u043E\u0441\u0442\u0440\u0451\u043D\u043D\u044B\u0439
      \u0433\u0440\u0435\u0431\u0435\u043D\u044C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442 \u043B\u0431\u0430 \u043A \u0432\u0435\u0440\u0448\u0438\u043D\u0435
      \u0438 \u043F\u0440\u0438\u0434\u0430\u0451\u0442 \u044D\u0442\u043E\u043C\u0443
      \u0448\u043B\u0435\u043C\u0443 \u0440\u0435\u0437\u043A\u0438\u0439, \u043F\u043E\u0447\u0442\u0438
      \u0431\u0430\u0448\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u043E\u0444\u0438\u043B\u044C.
      \u041F\u043E\u0434 \u043D\u0438\u043C \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0443\u0437\u043A\u0430\u044F \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u0430\u044F
      \u0449\u0435\u043B\u044C, \u0430 \u043D\u0438\u0436\u043D\u044F\u044F \u0447\u0430\u0441\u0442\u044C
      \u043F\u0440\u043E\u0440\u0435\u0437\u0430\u043D\u0430 \u0434\u043B\u0438\u043D\u043D\u044B\u043C\u0438
      \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u043E\u043A\u043D\u0430\u043C\u0438. \u041C\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0435
      \u0431\u043E\u043A\u043E\u0432\u044B\u0435 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u044B
      \u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u043A \u0443\u0433\u043B\u0443
      \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043A\u0430, \u0442\u0430\u043A
      \u0447\u0442\u043E \u0432\u0435\u0441\u044C \u043E\u0431\u044A\u0451\u043C
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043F\u043B\u043E\u0442\u043D\u044B\u043C
      \u0438 \u0446\u0435\u043B\u044C\u043D\u044B\u043C."
