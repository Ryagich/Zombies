  - m_Id: 80000000000000040
    m_Localized: "\u0423\u0437\u043A\u0438\u0439 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0439
      \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u043A \u0441 \u0431\u0435\u043B\u043E\u0439
      \u043A\u0430\u0439\u043C\u043E\u0439 \u0441\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u0447\u0442\u0438 \u0434\u043E \u043A\u043E\u043B\u0435\u043D,
      \u0430 \u0441\u0432\u0435\u0442\u043B\u044B\u0435 \u0431\u043E\u043A\u043E\u0432\u044B\u0435
      \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0438 \u0437\u0430\u0449\u0438\u0449\u0430\u044E\u0442
      \u0431\u0451\u0434\u0440\u0430. \u041E\u0434\u0435\u0436\u0434\u0430 \u0441\u043E\u0431\u0440\u0430\u043D\u0430
      \u0440\u0435\u043C\u043D\u044F\u043C\u0438 \u0443 \u043F\u043E\u044F\u0441\u0430
      \u0438 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u043D\u043E\u0439
      \u043D\u0430 \u0447\u0430\u0441\u0442\u0443\u044E, \u0430 \u043D\u0435 \u0431\u0435\u0440\u0435\u0436\u043D\u0443\u044E
      \u043D\u043E\u0441\u043A\u0443."
