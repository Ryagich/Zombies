  - m_Id: 80000000000000042
    m_Localized: "\u0422\u0451\u043C\u043D\u044B\u0435 \u0448\u0442\u0430\u043D\u044B
      \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u044B \u043E\u0434\u043D\u043E\u0439
      \u0441\u0432\u0435\u0442\u043B\u043E\u0439 \u0431\u043E\u043A\u043E\u0432\u043E\u0439
      \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u043E\u0439, \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u043E\u0439
      \u0440\u0435\u043C\u043D\u0451\u043C \u0443 \u0431\u0435\u0434\u0440\u0430.
      \u0410\u0441\u0438\u043C\u043C\u0435\u0442\u0440\u0438\u044F \u0437\u0434\u0435\u0441\u044C
      \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u0430: \u0437\u0430\u0449\u0438\u0442\u0430
      \u0438 \u043B\u0438\u0448\u043D\u0438\u0439 \u0441\u043B\u043E\u0439 \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0430\u043C, \u0433\u0434\u0435
      \u043E\u043D\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0443\u0436\u043D\u044B."
