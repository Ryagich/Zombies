  - m_Id: 90000000000000002
    m_Localized: "\u0422\u0451\u043C\u043D\u044B\u0439 \u0443\u0431\u043E\u0440 \u043F\u043B\u043E\u0442\u043D\u043E
      \u043E\u0431\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u0443,
      \u043B\u0438\u0446\u043E \u0438 \u0448\u0435\u044E, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u0433\u043B\u0443\u0431\u043E\u043A\u0443\u044E
      \u0443\u0437\u043A\u0443\u044E \u0442\u0435\u043D\u044C \u0432\u043C\u0435\u0441\u0442\u043E
      \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u043F\u0440\u043E\u0451\u043C\u0430.
      \u041F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u0440\u0430\u0437\u0431\u0438\u0442\u0430
      \u043D\u0430 \u0448\u0438\u0440\u043E\u043A\u0438\u0435 \u0441\u0435\u0440\u043E-\u0441\u0438\u043D\u0438\u0435
      \u043F\u043E\u043B\u043E\u0441\u044B \u0441 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0449\u0438\u043C\u0441\u044F
      \u0441\u0442\u0443\u043F\u0435\u043D\u0447\u0430\u0442\u044B\u043C \u0443\u0437\u043E\u0440\u043E\u043C;
      \u043E\u043D \u0438\u0434\u0451\u0442 \u0440\u043E\u0432\u043D\u044B\u043C\u0438
      \u0440\u044F\u0434\u0430\u043C\u0438 \u0438 \u043F\u043E\u0434\u0447\u0451\u0440\u043A\u0438\u0432\u0430\u0435\u0442
      \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439
      \u0441\u0438\u043B\u0443\u044D\u0442. \u0412\u0435\u0449\u044C \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0441\u0434\u0435\u0440\u0436\u0430\u043D\u043D\u043E, \u043D\u043E \u0435\u0451
      \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0441\u0442\u044C \u043D\u0435 \u0434\u0430\u0451\u0442
      \u0437\u0430\u0431\u044B\u0442\u044C \u043E \u0441\u0435\u0431\u0435."
