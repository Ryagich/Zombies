  - m_Id: 94000000000000019
    m_Localized: "\u0425\u0435\u0434\u0434\u0430 \u0420\u043E\u0443\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 94000000000000020
    m_Localized: "\u041A\u043E\u0440\u0432\u0438\u043D \u0412\u0435\u0439\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 94000000000000021
    m_Localized: "\u0423\u043B\u044C\u0440\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 94000000000000022
    m_Localized: "\u041A\u0435\u043B\u0434 \u0420\u0443\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 94000000000000023
    m_Localized: "\u0411\u0440\u0430\u043C \u0412\u043E\u0441\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 94000000000000024
    m_Localized: "\u0412\u0430\u0440\u0435\u043A \u0425\u043E\u043B\u044C\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000001
    m_Localized: "\u0421\u0442\u043E\u0439. \u0414\u043E\u0440\u043E\u0433\u0430
      \u0443 \u043D\u0430\u0441 \u043D\u0430 \u043F\u0430\u0439\u043A\u0435: \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0437\u043E\u043B\u043E\u0442\u044B\u0445 \u2014 \u0438 \u0442\u043E\u043F\u0430\u0439
      \u043A\u0443\u0434\u0430 \u0445\u043E\u0447\u0435\u0448\u044C. \u041E\u0434\u0438\u043D
      \u0440\u0430\u0437 \u043E\u0442\u0441\u0442\u0435\u0433\u043D\u0443\u043B,
      \u0432\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0437 \u043D\u0435 \u0442\u0440\u044F\u0441\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000002
    m_Localized: "\u0414\u0435\u0440\u0436\u0438. \u041F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0437\u043E\u043B\u043E\u0442\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000003
    m_Localized: "\u041D\u0435 \u0441\u0442\u0430\u043D\u0443 \u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0430\u043C \u0437\u0430
      \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000004
    m_Localized: "\u041C\u043D\u0435 \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u0432\u0430\u0441
      \u0441 \u043A\u043E\u0440\u0435\u0448\u0430\u043C\u0438 \u043F\u043E\u0440\u0435\u0437\u0430\u0442\u044C,
      \u0447\u0435\u043C \u043F\u043B\u0430\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000005
    m_Localized: "\u0412\u043E\u0442 \u0438 \u043B\u0430\u0434\u043D\u043E. \u041C\u043E\u043D\u0435\u0442\u0430
      \u0432 \u043E\u0431\u0449\u0430\u043A\u0435, \u0442\u044B \u2014 \u043D\u0430
      \u0434\u043E\u0440\u043E\u0433\u0435. \u041D\u0435 \u043A\u0440\u0443\u0442\u0438\u0441\u044C
      \u0442\u0443\u0442 \u043B\u0438\u0448\u043D\u0438\u0439 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000006
    m_Localized: "\u041D\u0443 \u0438 \u043A\u0430\u0442\u0438\u0441\u044C \u043D\u0430\u0437\u0430\u0434.
      \u041D\u0435 \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u043E-\u0445\u043E\u0440\u043E\u0448\u0435\u043C\u0443
      \u2014 \u0431\u0443\u0434\u0435\u0448\u044C \u043B\u0435\u0441\u043E\u043C
      \u043F\u0435\u0442\u043B\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000007
    m_Localized: "\u0421\u0430\u043C \u0432\u043B\u0435\u0437. \u041F\u0430\u0440\u043D\u0438,
      \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u0435 \u0433\u043E\u0441\u0442\u044E,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u0441 \u043D\u043E\u0436\u043E\u043C
      \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u043F\u043E\u0437\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000008
    m_Localized: "\u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043E \u043B\u0435\u0441\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000009
    m_Localized: "\u041B\u0435\u0441? \u041F\u0440\u043E \u0442\u0440\u043E\u043F\u044B
      \u0433\u0443\u0431\u0443 \u0437\u0430\u043A\u0430\u0442\u0430\u0439. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439, \u043F\u043E\u043A\u0430
      \u044F \u0434\u043E\u0431\u0440\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000010
    m_Localized: "\u041F\u043E \u043F\u043E\u0432\u043E\u0434\u0443 \u043F\u043B\u0430\u0442\u044B
      \u0437\u0430 \u043F\u0440\u043E\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000011
    m_Localized: "\u0427\u0435\u0433\u043E \u043D\u0430\u0434\u043E, \u043F\u0443\u0442\u043D\u0438\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000012
    m_Localized: "\u041B\u0430\u0434\u043D\u043E, \u043E \u0434\u0440\u0443\u0433\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000013
    m_Localized: "\u041F\u043E\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000014
    m_Localized: "\u0427\u0442\u043E \u0437\u0430 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435 \u0432 \u043B\u0435\u0441\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000015
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044C \u0437\u0430 \u0440\u0443\u0447\u044C\u0451\u043C.
      \u0422\u0430\u043C \u0441\u0432\u043E\u0438, \u0447\u0443\u0436\u043E\u0433\u043E
      \u0431\u044B\u0441\u0442\u0440\u043E \u043D\u0430 \u043C\u0435\u0441\u0442\u043E
      \u0441\u0442\u0430\u0432\u044F\u0442. \u041D\u0430\u0441 \u0441\u044E\u0434\u0430
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0441 \u0434\u043E\u0440\u043E\u0433\u0438
      \u043A\u043E\u0440\u043C\u0438\u0442\u044C\u0441\u044F: \u0441 \u043F\u0440\u043E\u0435\u0437\u0436\u0438\u0445
      \u0432 \u043E\u0431\u0449\u0430\u043A \u043A\u0430\u043F\u0430\u0435\u0442
      \u0440\u043E\u0432\u043D\u0435\u0435, \u0447\u0435\u043C \u0441 \u043E\u0445\u043E\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000016
    m_Localized: "\u0413\u043B\u0430\u0432\u0430\u0440\u044C \u0434\u0435\u0440\u0436\u0438\u0442
      \u0432\u0430\u0441 \u0432 \u043A\u0443\u043B\u0430\u043A\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000017
    m_Localized: "\u0413\u043B\u0430\u0432\u0430\u0440\u044C \u043F\u0443\u0441\u0442\u044B\u0435
      \u0440\u0443\u043A\u0438 \u043D\u0435 \u043B\u044E\u0431\u0438\u0442. \u041F\u0440\u0438\u043A\u0430\u0437
      \u043F\u0440\u043E\u0441\u0442\u043E\u0439: \u0441\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0445
      \u0441\u0442\u0440\u044F\u0441\u0442\u0438, \u0448\u0443\u043C \u043D\u0435
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C. \u0414\u043E\u043B\u044E
      \u043D\u0430\u0432\u0435\u0440\u0445, \u043A\u0440\u043E\u0448\u043A\u0438
      \u043D\u0430\u043C. \u0422\u0430\u043A \u0438 \u0436\u0438\u0432\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000018
    m_Localized: "\u0418 \u0441\u0442\u0440\u0430\u0436\u0430 \u044D\u0442\u043E
      \u0442\u0435\u0440\u043F\u0438\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000019
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u0430? \u0420\u0430\u043D\u044C\u0448\u0435
      \u043D\u0430\u0441 \u043F\u043E \u043A\u0443\u0441\u0442\u0430\u043C \u0433\u043E\u043D\u044F\u043B\u0430:
      \u043A \u043D\u043E\u0447\u0438 \u043A\u043E\u0441\u0442\u0451\u0440 \u0440\u0430\u0437\u043E\u0436\u0436\u0451\u0448\u044C
      \u2014 \u043A \u0443\u0442\u0440\u0443 \u043A\u043E\u043F\u044C\u044F \u0438\u0437
      \u0447\u0430\u0449\u0438 \u0442\u043E\u0440\u0447\u0430\u0442. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0438\u043C \u0431\u044B \u0432\u043E\u0440\u043E\u0442\u0430 \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C.
      \u0414\u043E \u043B\u0435\u0441\u0430 \u0440\u0443\u043A\u0438 \u043D\u0435
      \u0434\u043E\u0445\u043E\u0434\u044F\u0442 \u2014 \u0432\u043E\u0442 \u043C\u044B
      \u0438 \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0438 \u043F\u043B\u0435\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000020
    m_Localized: "\u0414\u0443\u043C\u0430\u0435\u0442\u0435, \u043B\u0435\u0441
      \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u0430\u0448?"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000021
    m_Localized: "\u041B\u0435\u0441 \u043D\u0435 \u0447\u0435\u0439, \u043F\u043E\u043A\u0430
      \u0435\u0433\u043E \u043D\u0435 \u0434\u0435\u0440\u0436\u0430\u0442. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u0434\u043E\u0440\u043E\u0433\u0430, \u043F\u043E\u0442\u043E\u043C \u0442\u0440\u043E\u043F\u044B,
      \u0430 \u043F\u043E\u0441\u043B\u0435 \u0438 \u043B\u044E\u0434\u0438 \u043F\u0440\u0438\u0432\u044B\u043A\u0430\u044E\u0442
      \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F
      \u0443 \u0442\u0435\u0445, \u043A\u0442\u043E \u0441 \u0436\u0435\u043B\u0435\u0437\u043E\u043C.
      \u0414\u0435\u043B\u043E \u043D\u0430\u0436\u0438\u0432\u043D\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000022
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E, \u0440\u0435\u0448\u0438\u043B\u0441\u044F?
      \u041A\u043E\u0448\u0435\u043B\u044C \u0440\u0430\u0437\u0432\u044F\u0437\u044B\u0432\u0430\u0442\u044C
      \u0431\u0443\u0434\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000023
    m_Localized: "\u0414\u0435\u0440\u0436\u0438 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0437\u043E\u043B\u043E\u0442\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000024
    m_Localized: "\u042F \u0442\u0443\u0442 \u043F\u043E\u0434\u0443\u043C\u0430\u043B:
      \u043C\u043D\u0435 \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u0432\u0430\u0441
      \u0441 \u043A\u043E\u0440\u0435\u0448\u0430\u043C\u0438 \u043F\u043E\u0440\u0435\u0437\u0430\u0442\u044C,
      \u0447\u0435\u043C \u043F\u043B\u0430\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000025
    m_Localized: "\u0410 \u043D\u0435\u0442, \u043D\u0438\u0447\u0435\u0433\u043E.
      \u0417\u0430\u0431\u0443\u0434\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000026
    m_Localized: "\u0422\u044B \u043D\u0435 \u0431\u043E\u0438\u0448\u044C\u0441\u044F
      \u0442\u0432\u0430\u0440\u0435\u0439 \u0432 \u043B\u0435\u0441\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000027
    m_Localized: "\u0411\u043E\u044E\u0441\u044C. \u0422\u043E\u043B\u044C\u043A\u043E
      \u0434\u0443\u0440\u0430\u043A \u0441\u043A\u0430\u0436\u0435\u0442, \u0447\u0442\u043E
      \u043D\u0435\u0442. \u0414\u0435\u0440\u0436\u0438\u043C\u0441\u044F \u0442\u0440\u043E\u043F\u044B,
      \u043E\u0433\u043E\u043D\u044C \u043D\u0435 \u0433\u0430\u0441\u0438\u043C,
      \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u0432 \u0447\u0430\u0449\u0443
      \u043D\u0435 \u0441\u0443\u0451\u043C\u0441\u044F. \u041D\u0435\u0434\u0435\u043B\u044E
      \u043D\u0430\u0437\u0430\u0434 \u0441 \u0434\u0430\u043B\u044C\u043D\u0435\u0433\u043E
      \u043F\u043E\u0441\u0442\u0430 \u043E\u0434\u0438\u043D \u043F\u0440\u0438\u043F\u043B\u0451\u043B\u0441\u044F
      \u2014 \u0431\u043E\u0441\u043E\u0439, \u0431\u0435\u0437 \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u0430.
      \u0421\u043A\u0430\u0437\u0430\u043B: \xAB\u041E\u043D\u043E \u0440\u044F\u0434\u043E\u043C
      \u0448\u043B\u043E\xBB. \u0418 \u0432\u0441\u0451. \u0421 \u0442\u0435\u0445
      \u043F\u043E\u0440 \u0434\u0430\u0436\u0435 \u0441\u0430\u043C\u044B\u0435
      \u0437\u0443\u0431\u0430\u0441\u0442\u044B\u0435 \u043D\u043E\u0447\u044C\u044E
      \u043D\u0435 \u043E\u0441\u0442\u0440\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000028
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C
      \u043E \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u0443 \u0442\u0440\u0430\u043A\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000029
    m_Localized: "\u0414\u0435\u0440\u0435\u0432\u043D\u044F \u0441\u0438\u0434\u0438\u0442
      \u043F\u043E \u0445\u0430\u0442\u0430\u043C \u0438 \u0436\u0434\u0451\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u0434\u043E\u0440\u043E\u0433\u0430 \u0441\u043D\u043E\u0432\u0430
      \u043D\u0430\u0447\u043D\u0451\u0442 \u043A\u043E\u0440\u043C\u0438\u0442\u044C.
      \u041A\u0442\u043E \u043F\u043E\u0441\u043C\u0435\u043B\u0435\u0435 \u2014
      \u0445\u0430\u0440\u0447 \u043F\u0440\u044F\u0447\u0435\u0442. \u041A\u0442\u043E
      \u043F\u043E\u0443\u043C\u043D\u0435\u0435 \u2014 \u044F\u0437\u044B\u043A
      \u0437\u0430 \u0437\u0443\u0431\u0430\u043C\u0438 \u0434\u0435\u0440\u0436\u0438\u0442.
      \u0410 \u043C\u044B \u043C\u0438\u043C\u043E \u043D\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000030
    m_Localized: "\u0427\u0435\u0433\u043E \u0432\u044B\u043D\u044E\u0445\u0438\u0432\u0430\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000031
    m_Localized: "\u0427\u0442\u043E \u0432\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0441 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000032
    m_Localized: "\u0412\u0437\u044F\u043B\u0438 \u0442\u043E, \u0447\u0442\u043E
      \u043B\u0435\u0436\u0430\u043B\u043E \u0431\u0435\u0437 \u0445\u043E\u0437\u044F\u0438\u043D\u0430.
      \u041A\u043E\u043B\u0435\u0441\u043E \u043A\u0440\u0443\u0442\u0438\u0442\u0441\u044F,
      \u043C\u0443\u043A\u0430 \u0438\u0434\u0451\u0442. \u041A\u043E\u043C\u0443
      \u043F\u043E\u043C\u043E\u043B \u043D\u0443\u0436\u0435\u043D \u2014 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043C\u043E\u043D\u0435\u0442\u0443 \u0438 \u043D\u0435 \u0443\u043C\u043D\u0438\u0447\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000033
    m_Localized: "\u0413\u0434\u0435 \u043C\u0435\u043B\u044C\u043D\u0438\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000034
    m_Localized: "\u0416\u0438\u0432 \u0442\u0432\u043E\u0439 \u0423\u043B\u044C\u0440\u0438\u043A.
      \u0421\u0438\u0434\u0438\u0442 \u043D\u0430 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435
      \u043F\u043E\u0434 \u0437\u0430\u043C\u043A\u043E\u043C, \u0445\u043B\u0435\u0431
      \u0441 \u0432\u043E\u0434\u043E\u0439 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442.
      \u0411\u0443\u0434\u0435\u0442 \u0442\u0438\u0445\u0438\u043C \u2014 \u0434\u043E\u0442\u044F\u043D\u0435\u0442
      \u0434\u043E \u0443\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000035
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0434\u0435\u0440\u0436\u0438\u0442\u0435
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0437\u0430\u043B\u043E\u0436\u043D\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000036
    m_Localized: "\u0417\u0430\u043B\u043E\u0436\u043D\u0438\u043A, \u043F\u043B\u0435\u043D\u043D\u0438\u043A
      \u2014 \u0441\u043B\u043E\u0432\u0430 \u0434\u043B\u044F \u0441\u044B\u0442\u044B\u0445.
      \u0421\u0438\u0434\u0438\u0442 \u0442\u0438\u0445\u043E, \u0432 \u043B\u0435\u0441
      \u043D\u0435 \u0434\u0440\u0430\u043F\u0430\u0435\u0442, \u0441\u0442\u0440\u0430\u0436\u0443
      \u043D\u0435 \u043A\u043B\u0438\u0447\u0435\u0442. \u041D\u0430\u043C \u043C\u0435\u043D\u044C\u0448\u0435
      \u043C\u043E\u0440\u043E\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000037
    m_Localized: "\u0410 \u043F\u043E\u043B\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000038
    m_Localized: "\u041F\u043E\u043B\u0435 \u0434\u0435\u0440\u0436\u0438\u043C \u2014
      \u043F\u043E\u043B\u0435 \u043A\u043E\u0440\u043C\u0438\u0442. \u041C\u0443\u043A\u0430
      \u043F\u043E\u0434 \u0431\u043E\u043A\u043E\u043C, \u0445\u0430\u0440\u0447
      \u0441\u0432\u0435\u0436\u0438\u0439. \u0418\u0437 \u043B\u0430\u0433\u0435\u0440\u044F
      \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0439 \u043A\u043E\u0440\u043A\u043E\u0439
      \u043D\u0435 \u043D\u0430\u0431\u0435\u0433\u0430\u0435\u0448\u044C\u0441\u044F.
      \u0422\u044B \u0431\u044B \u0442\u043E\u0436\u0435 \u043D\u0435 \u043D\u043E\u0441
      \u0432\u043E\u0440\u043E\u0442\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000039
    m_Localized: "\u042F\u0441\u043D\u043E. \u0414\u0430\u0432\u0430\u0439 \u043E
      \u0434\u0440\u0443\u0433\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 95000000000000040
    m_Localized: "\u0411\u044B\u0432\u0430\u0439. \u0418 \u043D\u0435 \u0448\u0430\u0441\u0442\u0430\u0439
      \u0442\u0443\u0442 \u0437\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000001
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u043E
      \u0441\u0443\u0434\u044C\u0431\u0435 \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000002
    m_Localized: "\u041C\u0435\u043B\u044C\u043D\u0438\u043A\u0430 \u0434\u0435\u0440\u0436\u0430\u0442
      \u0431\u0430\u043D\u0434\u0438\u0442\u044B \u0432 \u0437\u0430\u043F\u0435\u0440\u0442\u043E\u0439
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435. \u042D\u0442\u0438\u043C
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F\u043C \u043D\u0443\u0436\u0435\u043D
      \u0442\u043E\u0442, \u043A\u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0442
      \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000003
    m_Localized: "\u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043B\u044E\u0434\u0435\u0439
      \u043E \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000004
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u043F\u043E\u043C\u043E\u0449\u044C
      \u0434\u043B\u044F \u043F\u043B\u0435\u043D\u0451\u043D\u043D\u043E\u0433\u043E
      \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000005
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0432
      \u0442\u0430\u0432\u0435\u0440\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000006
    m_Localized: "\u041A\u0443\u0437\u043D\u0435\u0446 \u0441\u043E\u0432\u0435\u0442\u0443\u0435\u0442
      \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C \u043F\u043E\u043C\u043E\u0449\u044C
      \u0443 \u043B\u044E\u0434\u0435\u0439 \u0425\u0430\u043B\u044C\u0432\u0430\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000007
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0433\u043B\u0430\u0432\u0435
      \u0441\u0442\u0440\u0430\u0436\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000008
    m_Localized: "\u0425\u0430\u043B\u044C\u0432\u0430\u0440 \u0443\u0432\u0435\u0440\u0435\u043D:
      \u0441 \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u043C\u0438 \u0434\u043E\u043B\u0436\u043D\u0430
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044C\u0441\u044F \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0430\u044F
      \u0441\u0442\u0440\u0430\u0436\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000009
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C \u043E\u0442\u0440\u044F\u0434
      \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000010
    m_Localized: "\u0423 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B \u043E\u0436\u0438\u0434\u0430\u0435\u0442
      \u043E\u0442\u0440\u044F\u0434 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
      \u0441\u0442\u0440\u0430\u0436\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000011
    m_Localized: "\u041F\u043E\u043C\u043E\u0447\u044C \u043E\u0442\u0431\u0438\u0442\u044C
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000012
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u0438\u0434\u0451\u0442 \u0432\u044B\u0431\u0438\u0432\u0430\u0442\u044C
      \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432. \u0420\u0435\u0448\u0430\u0439,
      \u043D\u0430 \u0447\u044C\u0435\u0439 \u0442\u044B \u0441\u0442\u043E\u0440\u043E\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000013
    m_Localized: "\u0414\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u043E \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000014
    m_Localized: "\u0413\u043B\u0430\u0432\u0435 \u0441\u0442\u0440\u0430\u0436\u0438
      \u043D\u0443\u0436\u043D\u043E \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u044C,
      \u0447\u0442\u043E \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0430 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442
      \u0431\u0430\u043D\u0434\u0438\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000015
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C \u043E\u0442\u0440\u044F\u0434
      \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000016
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u0430 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
      \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B \u043F\u0435\u0440\u0435\u0434
      \u0432\u044B\u043B\u0430\u0437\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000017
    m_Localized: "\u041F\u043E\u043C\u043E\u0447\u044C \u043E\u0442\u0431\u0438\u0442\u044C
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 96000000000000018
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u0432\u0441\u0442\u0443\u043F\u0430\u0435\u0442
      \u0432 \u0431\u043E\u0439 \u0441 \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u043C\u0438
      \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000001
    m_Localized: "\u0411\u0430\u043D\u0434\u0438\u0442\u044B \u0434\u0435\u0440\u0436\u0430\u0442
      \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0430 \u0432 \u0437\u0430\u043B\u043E\u0436\u043D\u0438\u043A\u0430\u0445.
      \u0413\u0434\u0435 \u0438\u0441\u043A\u0430\u0442\u044C \u043F\u043E\u043C\u043E\u0449\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000002
    m_Localized: "\u0414\u0435\u043B\u043E \u0441\u043A\u0432\u0435\u0440\u043D\u043E\u0435.
      \u0423 \u043C\u0435\u043D\u044F \u043C\u043E\u043B\u043E\u0442 \u0434\u043B\u044F
      \u0436\u0435\u043B\u0435\u0437\u0430, \u0430 \u043D\u0435 \u043E\u0442\u0440\u044F\u0434
      \u043F\u0440\u043E\u0442\u0438\u0432 \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432.
      \u0421\u043F\u0440\u043E\u0441\u0438 \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435
      \u0443 \u0425\u0430\u043B\u044C\u0432\u0430\u0440\u0430: \u0442\u0430\u043C
      \u044F\u0437\u044B\u043A\u0438 \u0440\u0430\u0437\u0432\u044F\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000003
    m_Localized: "\u041D\u0443\u0436\u043D\u044B \u0442\u0435\u043F\u043B\u043E,
      \u044D\u043B\u044C \u0438\u043B\u0438 \u0442\u0438\u0445\u0438\u0439 \u0443\u0433\u043E\u043B
      \u2014 \u0442\u044B \u0443 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439
      \u0441\u0442\u043E\u0439\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000004
    m_Localized: "\u0422\u044B \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0437\u043D\u0430\u0435\u0448\u044C \u043E \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0435,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0434\u0435\u0440\u0436\u0430\u0442
      \u043D\u0430 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000005
    m_Localized: "\u0423 \u043C\u043E\u0438\u0445 \u0433\u043E\u0441\u0442\u0435\u0439
      \u043E\u0442\u0433\u043E\u0432\u043E\u0440\u043A\u0438, \u0430 \u043D\u0435
      \u0445\u0440\u0430\u0431\u0440\u043E\u0441\u0442\u044C. \u0417\u0430\u043B\u043E\u0436\u043D\u0438\u043A
      \u0438 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0435 \u0431\u0430\u043D\u0434\u0438\u0442\u044B
      \u2014 \u0434\u0435\u043B\u043E \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
      \u0441\u0442\u0440\u0430\u0436\u0438. \u0418\u0434\u0438 \u043A \u0438\u0445
      \u0433\u043B\u0430\u0432\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000006
    m_Localized: "\u0411\u0430\u043D\u0434\u0438\u0442\u044B \u043D\u0430 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435
      \u0434\u0435\u0440\u0436\u0430\u0442 \u0423\u043B\u044C\u0440\u0438\u043A\u0430
      \u0432 \u0437\u0430\u043B\u043E\u0436\u043D\u0438\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000007
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0436\u0434\u0430\u0442\u044C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0447\u0435\u0433\u043E.
      \u042F \u0443\u0436\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B
      \u043E\u0442\u0440\u044F\u0434 \u043A \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435;
      \u0432\u0441\u0442\u0440\u0435\u0442\u044C \u0438\u0445 \u0442\u0430\u043C
      \u0438 \u043D\u0435 \u043B\u0435\u0437\u044C \u0432\u043F\u0435\u0440\u0451\u0434
      \u0434\u043E \u043F\u0440\u0438\u043A\u0430\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000008
    m_Localized: "\u0422\u044B \u0442\u043E\u0442, \u043A\u043E\u0433\u043E \u043D\u0430\u043C
      \u0432\u0435\u043B\u0435\u043B\u0438 \u0436\u0434\u0430\u0442\u044C? \u0410\u043B\u044C\u0434\u0440\u0435\u043D
      \u0412\u0430\u044D\u043B\u044C, \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
      \u0441\u0442\u0440\u0430\u0436. \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
      \u0442\u044B \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0441\u044F \u0441
      \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u043C\u0438 \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000009
    m_Localized: "\u042F \u0433\u043E\u0442\u043E\u0432. \u0412\u0435\u0434\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000010
    m_Localized: "\u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u0441\u043D\u043E\u0432\u0430
      \u043D\u0430\u0448\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000011
    m_Localized: "\u041D\u0430\u0441\u0447\u0451\u0442 \u043D\u0430\u0433\u0440\u0430\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000012
    m_Localized: "\u0422\u044B \u0432\u0441\u0442\u0430\u043B \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043D\u0430\u043C\u0438, \u043A\u043E\u0433\u0434\u0430 \u044D\u0442\u043E
      \u0431\u044B\u043B\u043E \u0432\u0430\u0436\u043D\u043E. \u0411\u0435\u0440\u0438
      \u0434\u0432\u0430 \u043B\u0435\u0447\u0435\u0431\u043D\u044B\u0445 \u0437\u0435\u043B\u044C\u044F
      \u0438 \u043A\u0440\u0443\u0436\u043A\u0443 \u044D\u043B\u044F. \u041D\u0430\u0434\u043E
      \u0432\u044B\u043F\u0438\u0442\u044C \u0437\u0430 \u0442\u0435\u0445, \u043A\u0442\u043E
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0434\u043E\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000013
    m_Localized: "\u0410 \u043C\u043E\u044F \u0434\u043E\u043B\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000014
    m_Localized: "\u041F\u043E\u043A\u0430 \u0434\u0440\u0443\u0433\u0438\u0435 \u0438\u0441\u0442\u0435\u043A\u0430\u043B\u0438
      \u043A\u0440\u043E\u0432\u044C\u044E, \u0442\u044B \u0441\u043C\u043E\u0442\u0440\u0435\u043B.
      \u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430
      \u2014 \u0432\u043E\u0442 \u0442\u0432\u043E\u044F \u0434\u043E\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000017
    m_Localized: "\u042F \u0441\u0440\u0430\u0436\u0430\u043B\u0441\u044F \u043D\u0430
      \u0432\u0430\u0448\u0435\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000018
    m_Localized: "\u0420\u0430\u0437 \u0441\u0442\u0430\u043B\u044C \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430,
      \u0442\u044B \u0432\u0441\u0442\u0430\u043B \u0441 \u043D\u0430\u043C\u0438.
      \u0414\u0435\u0440\u0436\u0438 \u043F\u0438\u0432\u043E \u0438 \u0437\u0435\u043B\u044C\u0435.
      \u0411\u0440\u0430\u043C\u0443 \u0431\u0443\u0434\u0435\u0442 \u0447\u0442\u043E
      \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C: \u043A\u0430\u043A
      \u0441\u0442\u0440\u0430\u0436\u0430 \u0437\u0443\u0431\u044B \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430,
      \u0434\u0430 \u0438\u043C\u0438 \u0436\u0435 \u0437\u0435\u043C\u043B\u044E
      \u0440\u044B\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000019
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u0430 \u043D\u0435 \u0441\u043C\u043E\u0433\u043B\u0430
      \u0432\u0430\u0441 \u0441\u043B\u043E\u043C\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000020
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u0430 \u0432\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C
      \u0441 \u0432\u043E\u0435\u043C, \u0430 \u0443\u0448\u043B\u0430 \u043C\u043E\u043B\u0447\u0430.
      \u0422\u044B \u043D\u0435 \u043B\u0435\u0437 \u2014 \u0434\u0435\u0440\u0436\u0438
      \u043F\u0438\u0432\u043E \u0438 \u0437\u0430\u043F\u043E\u043C\u043D\u0438,
      \u0447\u044C\u044F \u0442\u0443\u0442 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000021
    m_Localized: "\u0412\u0430\u0440\u0435\u043A \u043F\u043E\u0441\u043B\u0430\u043B
      \u043C\u0435\u043D\u044F \u043F\u043E\u0441\u043B\u0435 \u0431\u043E\u044F
      \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000022
    m_Localized: "\u0412\u0430\u0440\u0435\u043A \u0441\u043A\u0430\u0437\u0430\u043B,
      \u0442\u044B \u043D\u0435 \u0434\u0440\u043E\u0433\u043D\u0443\u043B, \u043A\u043E\u0433\u0434\u0430
      \u0441\u0442\u0440\u0430\u0436\u0430 \u043F\u043E\u043B\u0435\u0437\u043B\u0430.
      \u0417\u0430 \u0442\u0430\u043A\u043E\u0435 \u0434\u0435\u0440\u0436\u0438
      \u0441\u0442\u043E \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u043C\u043E\u043D\u0435\u0442.
      \u0421\u043F\u0443\u0441\u0442\u0438 \u0438\u0445 \u0431\u044B\u0441\u0442\u0440\u043E,
      \u043F\u043E\u043A\u0430 \u043A\u0442\u043E-\u0442\u043E \u043D\u0435 \u0440\u0435\u0448\u0438\u043B,
      \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u043A\u043E\u0448\u0435\u043B\u044C
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u044F\u0436\u0451\u043B\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000023
    m_Localized: "\u0422\u044B \u0432\u0435\u0440\u043D\u0443\u043B \u043C\u043D\u0435
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443.
      \u041A\u043E\u0433\u0434\u0430 \u043F\u043E\u043B\u0435 \u0441\u043D\u043E\u0432\u0430
      \u0437\u0430\u0437\u0435\u043B\u0435\u043D\u0435\u0435\u0442, \u0445\u043B\u0435\u0431
      \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F \u0434\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E,
      \u043A\u043E\u043C\u0443 \u043E\u043D \u043D\u0443\u0436\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000024
    m_Localized: "\u0427\u0435\u0433\u043E \u0442\u0435\u0431\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000025
    m_Localized: "\u0422\u044B \u043F\u043E\u043C\u043E\u0436\u0435\u0448\u044C \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0443,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0434\u0435\u0440\u0436\u0430\u0442
      \u0431\u0430\u043D\u0434\u0438\u0442\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000026
    m_Localized: "\u041C\u043D\u0435 \u0434\u0435\u0442\u0435\u0439 \u043A\u043E\u0440\u043C\u0438\u0442\u044C.
      \u042F \u043D\u0435 \u043F\u0440\u043E\u043C\u0435\u043D\u044F\u044E \u0438\u0445
      \u0443\u0436\u0438\u043D \u043D\u0430 \u0447\u0443\u0436\u0443\u044E \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000027
    m_Localized: "\u042F \u043E\u0434\u043D\u0430\u0436\u0434\u044B \u0432\u0438\u0434\u0435\u043B
      \u043B\u044E\u0434\u0435\u0439 \u0441 \u043A\u043B\u0438\u043D\u043A\u0430\u043C\u0438.
      \u041D\u0430 \u043E\u0434\u043D\u0443 \u0436\u0438\u0437\u043D\u044C \u043C\u043D\u0435
      \u0445\u0432\u0430\u0442\u0438\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000028
    m_Localized: "\u042F \u043F\u043B\u0430\u0447\u0443 \u043D\u0430\u043B\u043E\u0433\u0438.
      \u041F\u0443\u0441\u0442\u044C \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044E\u0442\u0441\u044F
      \u0442\u0435, \u043A\u043E\u043C\u0443 \u043F\u043B\u0430\u0442\u044F\u0442
      \u0437\u0430 \u043C\u0435\u0447."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000029
    m_Localized: "\u0422\u044B \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0437\u043D\u0430\u0435\u0448\u044C \u043E \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000030
    m_Localized: "\u041D\u0435\u0442. \u0418 \u044F \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C
      \u0434\u0435\u043B\u0430\u0442\u044C \u0437\u0430\u043B\u043E\u0436\u043D\u0438\u043A\u0430
      \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432 \u0441\u0432\u043E\u0438\u043C
      \u0434\u0435\u043B\u043E\u043C. \u041D\u0435\u0441\u0438 \u044D\u0442\u0443
      \u043D\u043E\u0448\u0443 \u0442\u043E\u043C\u0443, \u043A\u0442\u043E \u043D\u043E\u0441\u0438\u0442
      \u0437\u043D\u0430\u043A \u0441\u0442\u0440\u0430\u0436\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000031
    m_Localized: "\u0427\u0442\u043E \u043D\u0443\u0436\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043B\u0435\u043D\u043D\u0438\u043A\u0430 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000032
    m_Localized: "\u041F\u043B\u0435\u043D\u043D\u0438\u043A \u043D\u0435 \u043D\u0430
      \u043C\u043E\u0435\u0439 \u0448\u0435\u0435. \u0423 \u0411\u0440\u0430\u043C\u0430
      \u043A\u043B\u044E\u0447\u0438 \u0438 \u0432\u0435\u0441\u044C \u0441\u0447\u0451\u0442.
      \u041E\u043D \u0432 \u043B\u0430\u0433\u0435\u0440\u0435 \u0437\u0430 \u043B\u0435\u0441\u043E\u043C.
      \u0422\u043E\u043F\u0430\u0439 \u0442\u0443\u0434\u0430 \u0441 \u043A\u043E\u0448\u0435\u043B\u0451\u043C
      \u2014 \u0431\u0435\u0437 \u0437\u0432\u043E\u043D\u043A\u043E\u0439 \u043C\u043E\u043D\u0435\u0442\u044B
      \u043E\u043D \u0434\u0430\u0436\u0435 \u043D\u0430 \u0441\u0438\u0434\u0435\u043B\u044C\u0446\u0430
      \u043D\u0435 \u0433\u043B\u044F\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000033
    m_Localized: "\u0412\u0430\u0440\u0435\u043A \u0441\u043A\u0430\u0437\u0430\u043B,
      \u0447\u0442\u043E \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043E
      \u043F\u043B\u0435\u043D\u043D\u0438\u043A\u0435 \u0432\u0435\u0434\u0451\u0442
      \u0411\u0440\u0430\u043C \u0412\u043E\u0441\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000034
    m_Localized: "\u0410, \u0437\u0430 \u0441\u0438\u0434\u0435\u043B\u044C\u0446\u0430
      \u043F\u0440\u0438\u0448\u0451\u043B. \u0414\u0432\u0435 \u0442\u044B\u0441\u044F\u0447\u0438
      \u043C\u043E\u043D\u0435\u0442 \u2014 \u0438 \u0423\u043B\u044C\u0440\u0438\u043A
      \u0432\u044B\u0439\u0434\u0435\u0442 \u043F\u043E\u0434\u044B\u0448\u0430\u0442\u044C.
      \u041D\u0435 \u043A\u0440\u0438\u0432\u0438\u0441\u044C: \u0441\u0432\u043E\u0431\u043E\u0434\u0430
      \u043D\u044B\u043D\u0447\u0435 \u0442\u043E\u0432\u0430\u0440 \u0434\u043E\u0440\u043E\u0433\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000035
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0434\u0432\u0435
      \u0442\u044B\u0441\u044F\u0447\u0438 \u043C\u043E\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000036
    m_Localized: "\u0414\u0432\u0435 \u0442\u044B\u0441\u044F\u0447\u0438 \u0437\u0432\u044F\u043A\u043D\u0443\u043B\u0438
      \u2014 \u043B\u0430\u0434\u043D\u043E. \u0422\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u043A\u0430 \u0442\u044B \u0438\u0445 \u0442\u0430\u0441\u043A\u0430\u043B,
      \u0441\u0447\u0451\u0442 \u043F\u043E\u0434\u0440\u043E\u0441. \u0415\u0449\u0451
      \u043F\u044F\u0442\u044C\u0441\u043E\u0442, \u0438 \u043A\u043B\u044E\u0447
      \u043F\u043E\u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000037
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0435\u0449\u0451
      \u043F\u044F\u0442\u044C\u0441\u043E\u0442 \u043C\u043E\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000038
    m_Localized: "\u0412\u043E\u0442 \u0442\u0435\u043F\u0435\u0440\u044C \u0440\u0430\u0441\u0447\u0451\u0442
      \u0437\u0430\u043A\u0440\u044B\u0442. \u041B\u044E\u0434\u0438 \u0441 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B
      \u0441\u043D\u0438\u043C\u0443\u0442\u0441\u044F. \u0411\u0435\u0433\u0438
      \u043F\u0440\u043E\u0432\u0435\u0440\u044C, \u043F\u043E\u043A\u0430 \u044F
      \u043D\u0435 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B, \u0447\u0442\u043E
      \u0437\u0430 \u0432\u043E\u0437\u0434\u0443\u0445 \u0442\u043E\u0436\u0435
      \u0431\u0435\u0440\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000039
    m_Localized: "\u0411\u0440\u0430\u043C \u0432\u0437\u044F\u043B \u0434\u0432\u0435
      \u0442\u044B\u0441\u044F\u0447\u0438 \u0437\u0430 \u043F\u043B\u0435\u043D\u043D\u0438\u043A\u0430
      \u0438 \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B \u0435\u0449\u0451
      \u043F\u044F\u0442\u044C\u0441\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000040
    m_Localized: "\u0414\u0432\u0435 \u0442\u044B\u0441\u044F\u0447\u0438 \u2014
      \u0438 \u0442\u044B \u0436\u0434\u0430\u043B \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u0441\u043B\u043E\u0432\u0430 \u043E\u0442 \u0411\u0440\u0430\u043C\u0430?
      \u041B\u0430\u0434\u043D\u043E, \u0443\u0440\u043E\u043A \u0434\u043E\u0440\u043E\u0433\u043E\u0439,
      \u0437\u0430\u0442\u043E \u0436\u0438\u0432\u043E\u0439. \u041C\u043E\u0438
      \u043B\u044E\u0434\u0438 \u0443\u0436\u0435 \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B:
      \u0432\u0441\u0442\u0440\u0435\u0442\u044C \u0438\u0445, \u0438 \u0432\u044B\u0433\u043E\u043D\u0438\u043C
      \u044D\u0442\u0443 \u0448\u0430\u0439\u043A\u0443 \u043F\u043E \u0443\u0441\u0442\u0430\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000041
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 97000000000000042
    m_Localized: "\u041F\u043E\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000003
    m_Localized: "\u0428\u0442\u0443\u0440\u043C \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000004
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u0430 \u043F\u043E\u0433\u0438\u0431\u043B\u0430.
      \u0421\u043E\u043E\u0431\u0449\u0438\u0442\u0435 \u0433\u043B\u0430\u0432\u0435
      \u0441\u0442\u0440\u0430\u0436\u0438 \u043E \u043F\u0440\u043E\u0432\u0430\u043B\u0435
      \u0438\u043B\u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F \u0441
      \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u043C\u0438, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u044C \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000005
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u0443 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B
      \u043F\u043E\u0433\u0438\u0431."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000006
    m_Localized: "\u041B\u044E\u0434\u0435\u0439 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435\u0442. \u042F \u043D\u0435 \u043F\u043E\u0448\u043B\u044E \u0432
      \u0442\u0443 \u0436\u0435 \u043C\u043E\u0433\u0438\u043B\u0443 \u0442\u0435\u0445,
      \u043A\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0443 \u0432\u043E\u0440\u043E\u0442.
      \u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C \u0432\u044B\u0442\u0430\u0449\u0438\u0442\u044C
      \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0430, \u0442\u0435\u043F\u0435\u0440\u044C
      \u0438\u0449\u0438 \u0441\u043F\u043E\u0441\u043E\u0431 \u0441\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000007
    m_Localized: "\u041D\u0443 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0431\u0435\u0437 \u0434\u043E\u043F\u0440\u043E\u0441\u0430,
      \u043B\u0430\u0434\u043D\u043E? \u042F \u043E\u0442 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u043E\u0432
      \u0437\u0430 \u0434\u0432\u0435\u0440\u044C\u044E \u0435\u0449\u0451 \u043D\u0435
      \u043E\u0442\u043E\u0448\u0451\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000008
    m_Localized: "\u042F \u0445\u043E\u0442\u0435\u043B \u0431\u044B \u0442\u0435\u0431\u044F
      \u043A\u043E\u0435-\u0447\u0442\u043E \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000009
    m_Localized: "\u0427\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0431\u0443\u0434\u0435\u0442
      \u0441 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000010
    m_Localized: "\u0414\u0430 \u0447\u0442\u043E \u0431\u0443\u0434\u0435\u0442...
      \u0414\u0432\u043E\u0440 \u043E\u0442\u043C\u044B\u0432\u0430\u0442\u044C,
      \u043E\u043A\u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C,
      \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C, \u043D\u0435 \u043F\u043E\u043F\u043E\u0440\u0442\u0438\u043B\u0438
      \u043B\u0438 \u043A\u0430\u043C\u0435\u043D\u044C. \u0411\u0430\u043D\u0434\u0438\u0442\u044B
      \u0432 \u0436\u0435\u0440\u043D\u043E\u0432\u0430 \u043D\u0435 \u043B\u0435\u0437\u043B\u0438
      \u2014 \u0438 \u043D\u0430 \u0442\u043E\u043C \u0441\u043F\u0430\u0441\u0438\u0431\u043E.
      \u0410 \u0434\u0430\u043B\u044C\u0448\u0435 \u043B\u044E\u0434\u0438 \u043F\u043E\u043D\u0435\u0441\u0443\u0442
      \u0437\u0435\u0440\u043D\u043E, \u0435\u0441\u043B\u0438 \u043D\u0435 \u043F\u043E\u0431\u043E\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000011
    m_Localized: "\u041B\u044E\u0434\u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000012
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u0441\u044F. \u041D\u0435
      \u043A\u043E \u043C\u043D\u0435, \u043A \u0441\u0432\u043E\u0438\u043C \u043C\u0435\u0448\u043A\u0430\u043C.
      \u0423 \u043D\u0438\u0445 \u0437\u0435\u0440\u043D\u043E \u043B\u0435\u0436\u0438\u0442,
      \u0443 \u043C\u0435\u043D\u044F \u043A\u0430\u043C\u043D\u0438 \u0441\u0442\u043E\u044F\u0442.
      \u0422\u0443\u0442 \u0434\u043E\u043B\u0433\u043E \u0443\u043F\u0440\u044F\u043C\u0438\u0442\u044C\u0441\u044F
      \u043D\u0435 \u0432\u044B\u0439\u0434\u0435\u0442: \u0435\u0441\u0442\u044C-\u0442\u043E
      \u0432\u0441\u0435\u043C \u0445\u043E\u0447\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000013
    m_Localized: "\u0422\u044B \u0441\u0430\u043C \u0441\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000014
    m_Localized: "\u0421 \u043E\u0434\u043D\u043E\u0439-\u0442\u043E \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435\u0439?
      \u0421\u043F\u0440\u0430\u0432\u043B\u044E\u0441\u044C. \u041D\u0435 \u0432
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437. \u041A\u0430\u043C\u0435\u043D\u044C
      \u0435\u0441\u043B\u0438 \u0434\u0443\u0440\u0438\u0442 \u2014 \u0441\u0440\u0430\u0437\u0443
      \u0441\u043B\u044B\u0448\u043D\u043E. \u0421 \u043B\u044E\u0434\u044C\u043C\u0438
      \u0445\u0443\u0436\u0435: \u043A\u043B\u044F\u043D\u0443\u0442\u0441\u044F
      \u043F\u0440\u0438\u0439\u0442\u0438 \u0441 \u0443\u0442\u0440\u0430, \u0430
      \u0441\u0430\u043C\u0438 \u043D\u0435\u0434\u0435\u043B\u044E \u0433\u0434\u0435-\u0442\u043E
      \u0445\u043E\u0434\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000015
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u044D\u0442\u0430 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430
      \u0442\u0430\u043A \u0432\u0430\u0436\u043D\u0430 \u043B\u044E\u0434\u044F\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000016
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0431\u0435\u0437
      \u043D\u0435\u0451 \u0437\u0435\u0440\u043D\u043E \u0442\u0430\u043A \u0438
      \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0437\u0435\u0440\u043D\u043E\u043C.
      \u0416\u0435\u0432\u0430\u0442\u044C \u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E,
      \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0443\u0431\u044B \u0431\u044B\u0441\u0442\u0440\u043E
      \u043A\u043E\u043D\u0447\u0430\u0442\u0441\u044F. \u0423 \u043A\u043E\u0433\u043E
      \u0434\u043E\u043C\u0430 \u0440\u0443\u0447\u043D\u043E\u0439 \u0436\u0435\u0440\u043D\u043E\u0432
      \u0435\u0441\u0442\u044C \u2014 \u0442\u043E\u043C\u0443 \u043B\u0435\u0433\u0447\u0435.
      \u0423 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445 \u043E\u0434\u043D\u0430
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0441\u044E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000017
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0442\u044B \u043A\u043E\u0440\u043C\u0438\u0448\u044C
      \u0432\u0441\u044E \u043E\u043A\u0440\u0443\u0433\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000018
    m_Localized: "\u041D\u0435 \u044F \u043A\u043E\u0440\u043C\u043B\u044E. \u042F
      \u043F\u043E\u043C\u043E\u043B \u0434\u0435\u0440\u0436\u0443. \u0417\u0435\u0440\u043D\u043E
      \u0441\u0435\u044F\u043B \u043D\u0435 \u044F, \u043C\u0435\u0448\u043A\u0438
      \u0442\u0430\u0449\u0438\u043B \u043D\u0435 \u044F, \u043F\u0435\u0447\u044C
      \u0442\u043E\u0436\u0435 \u043D\u0435 \u043C\u043E\u044F. \u041C\u043E\u0451
      \u0434\u0435\u043B\u043E \u2014 \u0447\u0442\u043E\u0431 \u043A\u0430\u043C\u043D\u0438
      \u043D\u0435 \u0432\u0441\u0442\u0430\u043B\u0438 \u0432 \u0441\u0430\u043C\u044B\u0439
      \u0434\u0443\u0440\u043D\u043E\u0439 \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000019
    m_Localized: "\u0410 \u0442\u0435\u0431\u0435 \u0441\u0430\u043C\u043E\u043C\u0443
      \u0447\u0442\u043E \u0441 \u044D\u0442\u043E\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000020
    m_Localized: "\u0410 \u043C\u043D\u0435 \u0437\u0430 \u0440\u0430\u0431\u043E\u0442\u0443
      \u043D\u0435 \u0431\u0440\u0430\u0442\u044C? \u041A\u0430\u043C\u043D\u0438
      \u0441\u0430\u043C\u0438 \u043D\u0435 \u043F\u0440\u0430\u0432\u044F\u0442\u0441\u044F,
      \u043B\u043E\u0442\u043E\u043A \u0441\u0430\u043C \u043D\u0435 \u0447\u0438\u0441\u0442\u0438\u0442\u0441\u044F.
      \u0414\u0430, \u0431\u0435\u0440\u0443. \u0418\u043D\u0430\u0447\u0435 \u044D\u0442\u0430
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u0434\u0430\u0432\u043D\u043E
      \u0431\u044B \u0440\u0430\u0437\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C,
      \u0430 \u0432\u044B \u0431\u044B \u0440\u0443\u0447\u043D\u044B\u043C\u0438
      \u0436\u0435\u0440\u043D\u043E\u0432\u0430\u043C\u0438 \u0441\u043F\u0438\u043D\u044B
      \u0433\u043D\u0443\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000021
    m_Localized: "\u0427\u0442\u043E \u0431\u0430\u043D\u0434\u0438\u0442\u044B \u0434\u0435\u043B\u0430\u043B\u0438
      \u0441 \u0442\u043E\u0431\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000022
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0438\u0441\u043A\u0430\u043B\u0438
      \u0434\u0435\u043D\u044C\u0433\u0438. \u041D\u0430\u0448\u043B\u0438 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043C\u0443\u043A\u0443 \u0434\u0430 \u0441\u0447\u0451\u0442\u043D\u044B\u0435
      \u0434\u043E\u0449\u0435\u0447\u043A\u0438. \u041F\u043E\u0442\u043E\u043C
      \u0443\u0441\u0430\u0434\u0438\u043B\u0438 \u0432 \u0447\u0443\u043B\u0430\u043D
      \u0438 \u0432\u0435\u043B\u0435\u043B\u0438 \u043C\u043E\u043B\u0447\u0430\u0442\u044C.
      \u0410 \u0441\u0430\u043C\u0438 \u043F\u043E \u0434\u0432\u043E\u0440\u0443
      \u0445\u043E\u0434\u0438\u043B\u0438, \u043C\u0435\u0448\u043A\u0438 \u0449\u0443\u043F\u0430\u043B\u0438,
      \u0431\u0443\u0434\u0442\u043E \u0443\u0436\u0435 \u0432\u0441\u0451 \u0438\u0445\u043D\u0435\u0435.
      \u0412\u043E\u0442 \u044D\u0442\u043E \u0445\u0443\u0436\u0435 \u0432\u0441\u0435\u0433\u043E
      \u0438 \u0431\u044B\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000023
    m_Localized: "\u041E\u043D\u0438 \u0442\u0435\u0431\u044F \u0431\u0438\u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000024
    m_Localized: "\u041E\u0434\u0438\u043D \u0440\u0430\u0437. \u041D\u0435 \u0437\u0430
      \u0447\u0442\u043E-\u0442\u043E \u2014 \u0434\u043B\u044F \u043F\u043E\u0440\u044F\u0434\u043A\u0430.
      \u041F\u043E\u0442\u043E\u043C \u0445\u0432\u0430\u0442\u0430\u043B\u043E,
      \u0447\u0442\u043E \u0441\u0430\u043F\u043E\u0433\u0438 \u0443 \u0434\u0432\u0435\u0440\u0438
      \u0441\u043A\u0440\u0438\u043F\u043D\u0443\u0442. \u042F \u0438 \u0441\u0430\u043C
      \u0443\u0436\u0435 \u0432\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u043B,
      \u043A\u0430\u043A \u0434\u0443\u0440\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000025
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u043D\u0435
      \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0441\u044F \u043E\u0442\u0431\u0438\u0442\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000026
    m_Localized: "\u0427\u0435\u043C? \u041B\u043E\u043F\u0430\u0442\u043E\u0439?
      \u0423 \u043C\u0435\u043D\u044F \u043D\u043E\u0436 \u0434\u043B\u044F \u043C\u0435\u0448\u043A\u043E\u0432,
      \u0430 \u0443 \u043D\u0438\u0445 \u0436\u0435\u043B\u0435\u0437\u043E \u0438
      \u0444\u0430\u043A\u0435\u043B\u044B. \u041D\u0430\u0447\u043D\u0438 \u044F
      \u0433\u0435\u0440\u043E\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u2014 \u043F\u043E\u0434\u043E\u0436\u0433\u043B\u0438 \u0431\u044B \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443.
      \u0418 \u043A\u043E\u043C\u0443 \u043E\u0442 \u0442\u043E\u0433\u043E \u043B\u0435\u0433\u0447\u0435
      \u0441\u0442\u0430\u043B\u043E \u0431\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000027
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C
      \u043E \u0441\u0442\u0440\u0430\u0436\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000028
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u0430 \u043A\u0430\u043A \u0441\u0442\u0440\u0430\u0436\u0430.
      \u041F\u043E\u043A\u0430 \u0434\u043E\u0435\u0445\u0430\u043B\u0438 \u2014
      \u044F \u0443\u0436\u0435 \u043D\u0435 \u0436\u0434\u0430\u043B \u043D\u0438\u043A\u043E\u0433\u043E.
      \u041D\u043E \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0438, \u0434\u0432\u0435\u0440\u044C
      \u043E\u0442\u043A\u0440\u044B\u043B\u0438. \u0417\u0430 \u044D\u0442\u043E
      \u0441\u043F\u0430\u0441\u0438\u0431\u043E. \u0410 \u0447\u0442\u043E \u0440\u0430\u043D\u044C\u0448\u0435
      \u043D\u0435 \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0438 \u2014 \u0437\u0430
      \u044D\u0442\u043E \u0441\u043F\u0430\u0441\u0438\u0431\u043E \u043D\u0435
      \u0441\u043A\u0430\u0436\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000029
    m_Localized: "\u041E\u043D\u0438 \u043F\u0440\u0438\u0448\u043B\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043F\u043E\u0437\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000030
    m_Localized: "\u041F\u043E\u0437\u0434\u043D\u043E \u2014 \u044D\u0442\u043E
      \u043A\u043E\u0433\u0434\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0432\u044B\u043D\u043E\u0441\u044F\u0442 \u043D\u043E\u0433\u0430\u043C\u0438
      \u0432\u043F\u0435\u0440\u0451\u0434. \u041C\u0435\u043D\u044F \u043D\u0435
      \u0432\u044B\u043D\u0435\u0441\u043B\u0438. \u0410 \u0441\u0447\u0451\u0442
      \u0442\u0435\u043C, \u043A\u0442\u043E \u0441\u0438\u0434\u0438\u0442 \u0432
      \u0433\u043E\u0440\u043E\u0434\u0435 \u0438 \u0432\u0441\u0451 \u0440\u0435\u0448\u0430\u0435\u0442,
      \u044F \u0441\u0430\u043C \u043D\u0435 \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u044E.
      \u041D\u0435 \u043C\u043E\u0435\u0433\u043E \u0443\u043C\u0430 \u0434\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000031
    m_Localized: "\u0422\u044B \u0438\u043C \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u043E\u0431\u044F\u0437\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000032
    m_Localized: "\u041E\u0431\u044F\u0437\u0430\u043D? \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0435\u043D
      \u2014 \u0434\u0430. \u041E\u0431\u044F\u0437\u0430\u043D \u2014 \u043D\u0435\u0442.
      \u041E\u043D\u0438 \u0441\u043B\u0443\u0436\u0431\u0443 \u0441\u0432\u043E\u044E
      \u0441\u0434\u0435\u043B\u0430\u043B\u0438. \u041F\u043E\u0437\u0434\u043D\u043E,
      \u0440\u0430\u043D\u043E \u2014 \u0441\u0434\u0435\u043B\u0430\u043B\u0438.
      \u042F \u0438\u043C \u043D\u0435 \u043F\u043E\u043F, \u0433\u0440\u0435\u0445\u0438
      \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u043D\u0435 \u0441\u0442\u0430\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000033
    m_Localized: "\u0427\u0442\u043E \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E
      \u0442\u044B \u0437\u0434\u0435\u0441\u044C \u0432\u0438\u0434\u0435\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000034
    m_Localized: "\u0411\u044B\u043B\u043E \u0442\u0443\u0442 \u043E\u0434\u043D\u043E.
      \u0415\u0449\u0451 \u0434\u043E \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432.
      \u041D\u043E\u0447\u044C\u044E \u043A\u043E\u043B\u0435\u0441\u043E \u0441\u0442\u043E\u044F\u043B\u043E,
      \u0432\u043E\u0434\u0430 \u0442\u0438\u0445\u0430\u044F, \u0430 \u043F\u043E\u0434
      \u043B\u043E\u0442\u043A\u043E\u043C \u043A\u0442\u043E-\u0442\u043E \u0441\u0442\u0443\u0447\u0430\u043B.
      \u0422\u0440\u0438 \u0440\u0430\u0437\u0430, \u043F\u043E\u0442\u043E\u043C
      \u0442\u0438\u0448\u0438\u043D\u0430, \u043F\u043E\u0442\u043E\u043C \u0435\u0449\u0451
      \u0442\u0440\u0438. \u042F \u0437\u0430\u0441\u043B\u043E\u043D\u043A\u0443
      \u043F\u043E\u0434\u043D\u044F\u043B \u2014 \u043F\u0443\u0441\u0442\u043E.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0447\u0435\u0448\u0443\u044F \u0440\u044B\u0431\u044C\u044F
      \u043D\u0430 \u0441\u0443\u0445\u0438\u0445 \u043A\u0430\u043C\u043D\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000035
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430 \u0432\u043E\u0434\u0443
      \u0438\u043B\u0438 \u0437\u0432\u0435\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000036
    m_Localized: "\u041C\u043E\u0436\u0435\u0442. \u0422\u043E\u043B\u044C\u043A\u043E
      \u0432\u043E\u0434\u0430 \u043D\u0435 \u0441\u0442\u0443\u0447\u0438\u0442.
      \u041E\u043D\u0430 \u0448\u0443\u0440\u0448\u0438\u0442, \u0431\u0443\u043B\u044C\u043A\u0430\u0435\u0442,
      \u043F\u043E \u043A\u0430\u043C\u043D\u044E \u043B\u0443\u043F\u0438\u0442
      \u2014 \u044F \u0435\u0451 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u043B\u0435\u0442 \u0441\u043B\u0443\u0448\u0430\u044E. \u0410 \u0442\u0443\u0442
      \u0431\u0443\u0434\u0442\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043A\u0443\u043B\u0430\u043A\u043E\u043C
      \u0432 \u0434\u0432\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000037
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u043D\u0438\u043A\u043E\u043C\u0443
      \u043D\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000038
    m_Localized: "\u041A\u043E\u043C\u0443 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C?
      \u0421\u043A\u0430\u0436\u0443\u0442: \u0423\u043B\u044C\u0440\u0438\u043A
      \u0437\u0435\u0440\u043D\u043E \u0441 \u043F\u043B\u0435\u0441\u0435\u043D\u044C\u044E
      \u043D\u044E\u0445\u0430\u043B. \u042F \u0445\u043E\u0442\u0435\u043B \u0441\u0430\u043C
      \u0434\u043D\u0451\u043C \u0432\u0441\u0451 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C.
      \u0410 \u043F\u043E\u0442\u043E\u043C \u044D\u0442\u0438 \u044F\u0432\u0438\u043B\u0438\u0441\u044C,
      \u0438 \u0441\u0442\u0430\u043B\u043E \u043D\u0435 \u0434\u043E \u0441\u0442\u0443\u043A\u0430.
      \u0415\u0441\u043B\u0438 \u043E\u043F\u044F\u0442\u044C \u0443\u0441\u043B\u044B\u0448\u0438\u0448\u044C
      \u2014 \u0432 \u0432\u043E\u0434\u0443 \u043D\u043E\u0447\u044C\u044E \u043D\u0435
      \u043B\u0435\u0437\u044C. \u041C\u0435\u043D\u044F \u043F\u043E\u0437\u043E\u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000039
    m_Localized: "\u041F\u043E\u043A\u0430 \u0445\u0432\u0430\u0442\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000040
    m_Localized: "\u041B\u044E\u0434\u0438 \u043D\u0435 \u043C\u0435\u0448\u043A\u0438.
      \u0421 \u043D\u0438\u043C\u0438 \u0441\u043B\u043E\u0436\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000041
    m_Localized: "\u0412\u043E\u0442 \u0438 \u044F \u043E \u0442\u043E\u043C. \u0421
      \u043C\u0435\u0448\u043A\u043E\u043C \u043F\u0440\u043E\u0441\u0442\u043E:
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0432 \u0441\u0443\u0445\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E \u2014 \u0438 \u0432\u0441\u0451. \u0410 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043D\u0430\u043F\u0443\u0433\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u0436\u0435\u0442
      \u0433\u043E\u0434 \u043C\u0438\u043C\u043E \u0445\u043E\u0434\u0438\u0442\u044C.
      \u042F \u0438\u0445 \u0437\u0432\u0430\u0442\u044C \u043D\u0435 \u0441\u0442\u0430\u043D\u0443.
      \u041E\u0442\u043A\u0440\u043E\u044E \u0434\u0432\u0435\u0440\u044C, \u0437\u0430\u0442\u043E\u043F\u043B\u044E
      \u043F\u0435\u0447\u044C \u2014 \u0441\u0430\u043C\u0438 \u0440\u0435\u0448\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000042
    m_Localized: "\u0422\u0435\u0431\u0435 \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u043B\u044E\u0434\u0438 \u043D\u0443\u0436\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000043
    m_Localized: "\u0410 \u043A\u043E\u043C\u0443 \u043D\u0435 \u043D\u0443\u0436\u043D\u044B?
      \u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u0431\u0435\u0437 \u043B\u044E\u0434\u0435\u0439
      \u2014 \u0441\u0430\u0440\u0430\u0439 \u0441 \u0434\u043E\u0440\u043E\u0433\u0438\u043C\u0438
      \u043A\u0430\u043C\u043D\u044F\u043C\u0438. \u0422\u043E\u043B\u044C\u043A\u043E
      \u044F \u043D\u0435 \u0441\u0442\u0430\u043D\u0443 \u0431\u0435\u0433\u0430\u0442\u044C
      \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u043C \u0438 \u043A\u043B\u0430\u043D\u044F\u0442\u044C\u0441\u044F.
      \u041F\u0440\u0438\u0434\u0443\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u2014 \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000044
    m_Localized: "\u0422\u044B \u0432\u0441\u0451 \u0436\u0435 \u0431\u0435\u0440\u0451\u0448\u044C
      \u0441 \u043D\u0438\u0445 \u0434\u0435\u043D\u044C\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000045
    m_Localized: "\u0411\u0435\u0440\u0443. \u0418 \u0437\u0430 \u043B\u043E\u0448\u0430\u0434\u044C
      \u0443 \u043A\u0443\u0437\u043D\u0435\u0446\u0430 \u043F\u043B\u0430\u0442\u044F\u0442,
      \u0438 \u0437\u0430 \u043A\u0440\u044B\u0448\u0443 \u043F\u043B\u043E\u0442\u043D\u0438\u043A\u0443.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u0442 \u0435\u0441\u043B\u0438
      \u0443 \u0432\u0434\u043E\u0432\u044B \u043C\u0435\u0448\u043E\u043A \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u2014 \u044F \u043D\u0435 \u0441\u0442\u0430\u043D\u0443 \u0441 \u043D\u0435\u0451
      \u0448\u043A\u0443\u0440\u0443 \u0434\u0440\u0430\u0442\u044C. \u042D\u0442\u043E
      \u0443 \u043D\u0430\u0441 \u0438 \u0431\u0435\u0437 \u043C\u0435\u043D\u044F
      \u0443\u043C\u0435\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000046
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0442\u044B \u0445\u043E\u0440\u043E\u0448\u043E
      \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000047
    m_Localized: "\u041F\u043E\u043A\u0430 \u043A\u043E\u043B\u0435\u0441\u043E \u043A\u0440\u0443\u0442\u0438\u0442\u0441\u044F
      \u2014 \u043C\u043E\u0436\u0435\u0442, \u0438 \u0442\u0430\u043A. \u0410 \u0432\u0441\u0442\u0430\u043D\u0435\u0442
      \u2014 \u043F\u0435\u0440\u0432\u044B\u043C \u043A\u043E \u043C\u043D\u0435
      \u043F\u0440\u0438\u0434\u0443\u0442, \u043D\u0435 \u043A \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u0435.
      \u0425\u043E\u0440\u043E\u0448\u043E \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0441\u044F
      \u2014 \u044D\u0442\u043E \u043A\u043E\u0433\u0434\u0430 \u043E \u0442\u0435\u0431\u0435
      \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000048
    m_Localized: "\u0422\u044B \u043D\u0430 \u043D\u0438\u0445 \u0437\u043B\u0438\u0448\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000049
    m_Localized: "\u0417\u043B\u0438\u043B\u0441\u044F. \u0421\u0435\u0439\u0447\u0430\u0441
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F.
      \u0417\u043B\u043E\u0441\u0442\u044C \u0441\u0438\u043B\u044B \u0435\u0441\u0442,
      \u0430 \u0441\u0438\u043B \u0443 \u043C\u0435\u043D\u044F \u0438 \u0442\u0430\u043A
      \u043D\u0435 \u043B\u0438\u0448\u043A\u0430. \u0425\u043E\u0447\u0443, \u0447\u0442\u043E\u0431\u044B
      \u043E\u043D\u0438 \u0441\u044E\u0434\u0430 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043F\u0440\u0438\u0448\u043B\u0438. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u043F\u043E\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000050
    m_Localized: "\u0422\u044B \u0441\u043F\u0430\u0441\u0430\u043B \u043D\u0435
      \u0441\u0435\u0431\u044F, \u0430 \u0437\u0435\u0440\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000051
    m_Localized: "\u042F \u0441\u0435\u0431\u044F \u0442\u043E\u0436\u0435 \u0441\u043F\u0430\u0441\u0430\u043B.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0437\u043D\u0430\u043B, \u0447\u0435\u043C
      \u043E\u043D\u0438 \u0431\u0443\u0434\u0443\u0442 \u043F\u0443\u0433\u0430\u0442\u044C.
      \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0431\u0435\u0437 \u0435\u0434\u044B
      \u2014 \u0442\u043E\u0436\u0435 \u043F\u043B\u0435\u043D\u043D\u0438\u043A,
      \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u0432\u0435\u0440\u0438 \u0443
      \u043D\u0435\u0433\u043E \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000052
    m_Localized: "\u0422\u044B \u0431\u044B \u0441\u043A\u0430\u0437\u0430\u043B
      \u044D\u0442\u043E \u0433\u043B\u0430\u0432\u0435 \u0441\u0442\u0440\u0430\u0436\u0438
      \u0432 \u043B\u0438\u0446\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000053
    m_Localized: "\u0421\u043A\u0430\u0437\u0430\u043B \u0431\u044B. \u0422\u043E\u043B\u044C\u043A\u043E
      \u043E\u043D \u0431\u044B \u043A\u0438\u0432\u043D\u0443\u043B, \u0434\u0430
      \u0438 \u043F\u043E\u0448\u0451\u043B \u0434\u0430\u043B\u044C\u0448\u0435
      \u043F\u043E \u0441\u0432\u043E\u0438\u043C \u0431\u0443\u043C\u0430\u0433\u0430\u043C.
      \u042F \u043D\u0435 \u0434\u043B\u044F \u0442\u043E\u0433\u043E \u0436\u0438\u0432
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E \u0433\u043E\u0440\u043E\u0434\u0443 \u0440\u0443\u0433\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000054
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0442\u0430\u043A\u043E\u0433\u043E
      \u043B\u0435\u0433\u043A\u043E \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000055
    m_Localized: "\u041B\u0435\u0433\u043A\u043E? \u0422\u044B \u0432 \u0447\u0443\u043B\u0430\u043D\u0435
      \u043F\u043E\u0441\u0438\u0434\u0438, \u043A\u043E\u0433\u0434\u0430 \u0441\u043D\u0430\u0440\u0443\u0436\u0438
      \u0447\u0443\u0436\u0438\u0435 \u0441\u0430\u043F\u043E\u0433\u0438 \u0445\u043E\u0434\u044F\u0442.
      \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C,
      \u0447\u0442\u043E \u043B\u0435\u0433\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000056
    m_Localized: "\u0414\u043D\u0451\u043C \u043D\u0430\u0434\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043F\u043E\u0434 \u043B\u043E\u0442\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000057
    m_Localized: "\u041D\u0430\u0434\u043E. \u0422\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441. \u042F \u0441\u043F\u0435\u0440\u0432\u0430
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443 \u0432 \u043F\u043E\u0440\u044F\u0434\u043E\u043A
      \u043F\u0440\u0438\u0432\u0435\u0434\u0443. \u041F\u043E\u0442\u043E\u043C
      \u0432\u043E\u0437\u044C\u043C\u0443 \u0444\u043E\u043D\u0430\u0440\u044C,
      \u043A\u0440\u044E\u043A \u2014 \u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E.
      \u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C, \u043F\u0440\u0438\u0445\u043E\u0434\u0438
      \u0434\u043D\u0451\u043C. \u041E\u0434\u0438\u043D \u0442\u0443\u0434\u0430
      \u043B\u0435\u0437\u0442\u044C \u044F \u043D\u0435 \u0441\u0442\u0430\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000058
    m_Localized: "\u0410 \u0435\u0441\u043B\u0438 \u043E\u043D\u043E \u043E\u043F\u044F\u0442\u044C
      \u043F\u043E\u0441\u0442\u0443\u0447\u0438\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 99000000000000059
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0439.
      \u0412\u043E\u0442 \u044D\u0442\u043E \u0433\u043B\u0430\u0432\u043D\u043E\u0435.
      \u041D\u0435 \u0437\u043E\u0432\u0438, \u043D\u0435 \u0441\u0442\u0443\u0447\u0438
      \u0432 \u043E\u0442\u0432\u0435\u0442. \u0423\u0442\u0440\u043E\u043C \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C.
      \u041D\u043E\u0447\u044C \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u0437
      \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0432\u0435\u0449\u0438 \u0442\u0430\u043A\u0443\u044E
      \u0434\u0440\u044F\u043D\u044C \u0441\u0434\u0435\u043B\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043F\u043E\u0442\u043E\u043C \u0441\u0430\u043C \u0441\u0435\u0431\u0435
      \u043D\u0435 \u0432\u0435\u0440\u0438\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000001
    m_Localized: "\u0411\u0443\u043C\u0430\u0433\u0438 \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000002
    m_Localized: "\u041F\u043E\u043A\u0430 \u0423\u043B\u044C\u0440\u0438\u043A \u0431\u044B\u043B
      \u0432 \u043F\u043B\u0435\u043D\u0443, \u043A\u0442\u043E-\u0442\u043E \u0443\u043A\u0440\u0430\u043B
      \u0431\u0443\u043C\u0430\u0433\u0438 \u043D\u0430 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443
      \u0438 \u0445\u043E\u0447\u0435\u0442 \u043E\u0444\u043E\u0440\u043C\u0438\u0442\u044C
      \u0435\u0451 \u043D\u0430 \u0441\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000003
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u043D\u0430 \u0441\u043B\u0435\u0434
      \u0431\u0443\u043C\u0430\u0433 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000004
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u0425\u0435\u0434\u0434\u043E\u0439 \u0420\u043E\u0443\u043D \u0438\u043B\u0438
      \u041A\u0435\u043B\u0434\u043E\u043C \u0420\u0443\u043A\u043E\u043C, \u0447\u0442\u043E\u0431\u044B
      \u0432\u044B\u0439\u0442\u0438 \u043D\u0430 \u0441\u043B\u0435\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000005
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u041A\u043E\u0440\u0432\u0438\u043D\u043E\u043C \u0412\u0435\u0439\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000006
    m_Localized: "\u0421\u043B\u0435\u0434 \u0432\u0435\u0434\u0451\u0442 \u043A
      \u041A\u043E\u0440\u0432\u0438\u043D\u0443 \u0412\u0435\u0439\u0440\u0443 \u0438
      \u0443\u043A\u0440\u0430\u0434\u0435\u043D\u043D\u044B\u043C \u0431\u0443\u043C\u0430\u0433\u0430\u043C
      \u0423\u043B\u044C\u0440\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000007
    m_Localized: "\u041F\u0440\u0438\u0442\u044F\u0437\u0430\u043D\u0438\u0435 \u0443\u043B\u0430\u0436\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000008
    m_Localized: "\u0421\u0443\u0434\u044C\u0431\u0430 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B
      \u0423\u043B\u044C\u0440\u0438\u043A\u0430 \u0440\u0435\u0448\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000009
    m_Localized: "\u0422\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0435\u0441\u0442\u044C
      \u0435\u0449\u0451 \u0431\u0435\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000010
    m_Localized: "\u041E\u043D\u0438 \u0432\u0437\u044F\u043B\u0438 \u043B\u0430\u0440\u0435\u0446
      \u0441 \u0431\u0443\u043C\u0430\u0433\u0430\u043C\u0438, \u043D\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u043E.
      \u041A\u0442\u043E-\u0442\u043E \u0437\u043D\u0430\u043B, \u043A\u0430\u043A\u043E\u0439
      \u044F\u0449\u0438\u043A \u043E\u0442\u043A\u0440\u044B\u0442\u044C. \u041F\u043E\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439
      \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0434\u0435\u043B\u0430\u0439
      \u0438\u0437 \u043C\u0435\u043D\u044F \u0441\u0432\u044F\u0442\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000011
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C
      \u043E \u0431\u0443\u043C\u0430\u0433\u0430\u0445 \u0423\u043B\u044C\u0440\u0438\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000012
    m_Localized: "\u0421\u043A\u0430\u0436\u0443. \u041D\u043E \u0441\u043F\u0435\u0440\u0432\u0430
      \u0437\u0430\u043A\u0440\u043E\u0439 \u0434\u043E\u043B\u0433 \u043E\u0434\u043D\u043E\u0439
      \u0432\u0434\u043E\u0432\u044B \u0437\u0430 \u043F\u043E\u043C\u043E\u043B.
      \u041F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438 \u043C\u0443\u0436\u0430
      \u043E\u043D\u0430 \u0442\u044F\u043D\u0435\u0442 \u0434\u043E\u043C \u0438
      \u0434\u0435\u0442\u0435\u0439; \u0423\u043B\u044C\u0440\u0438\u043A \u043D\u0435
      \u0433\u043E\u043D\u0438\u0442 \u0435\u0451, \u043D\u043E \u0441\u0430\u043C
      \u0436\u0434\u0451\u0442 \u0434\u0435\u043D\u0435\u0433. \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u043F\u044F\u0442\u044C \u043A\u0440\u043E\u043D \u2014 \u0438 \u0443 \u043D\u0435\u0451
      \u0445\u043E\u0442\u044F \u0431\u044B \u043C\u0435\u0441\u044F\u0446 \u0431\u0443\u0434\u0435\u0442
      \u043D\u0435 \u043E \u0447\u0435\u043C \u0434\u0440\u043E\u0436\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000013
    m_Localized: "\u042F \u0437\u0430\u043A\u0440\u043E\u044E \u0434\u043E\u043B\u0433
      \u0432\u0434\u043E\u0432\u044B. (25 \u043A\u0440\u043E\u043D)"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000014
    m_Localized: "\u0414\u043E \u043D\u0430\u043B\u0451\u0442\u0430 \u043F\u0438\u0441\u0435\u0446
      \u041A\u043E\u0440\u0432\u0438\u043D\u0430 \u0412\u0435\u0439\u0440\u0430 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B
      \u043E \u043F\u0435\u0447\u0430\u0442\u0438 \u0423\u043B\u044C\u0440\u0438\u043A\u0430
      \u0438 \u043E \u0437\u0430\u043C\u043A\u0435 \u0432 \u0434\u043E\u043C\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000015
    m_Localized: "\u041A\u0442\u043E \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u0437\u0430 \u043D\u0430\u043B\u0451\u0442 \u043D\u0430 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000016
    m_Localized: "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043A\u0440\u043E\u043D
      \u043F\u043E\u0439\u0434\u0443\u0442 \u0440\u0430\u043D\u0435\u043D\u043E\u043C\u0443
      \u0433\u043E\u043D\u0446\u0443. \u0417\u0430\u043F\u043B\u0430\u0442\u0438
      \u2014 \u0441\u043A\u0430\u0436\u0443, \u0447\u0435\u0439 \u043A\u043E\u0448\u0435\u043B\u044C
      \u0434\u043E\u0431\u0440\u0430\u043B\u0441\u044F \u0434\u043E \u043B\u0430\u0433\u0435\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000017
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430
      \u0440\u0430\u043D\u0435\u043D\u043E\u0433\u043E \u0433\u043E\u043D\u0446\u0430
      (30 \u043A\u0440\u043E\u043D)."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000018
    m_Localized: "\u041A\u043E\u0440\u0432\u0438\u043D \u0412\u0435\u0439\u0440 \u043F\u043B\u0430\u0442\u0438\u043B
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0438\u0441\u0446\u0430. \u0415\u043C\u0443
      \u043D\u0443\u0436\u0435\u043D \u0431\u044B\u043B \u043B\u0430\u0440\u0435\u0446
      \u0441 \u0431\u0443\u043C\u0430\u0433\u0430\u043C\u0438, \u043D\u0435 \u043A\u0440\u043E\u0432\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000019
    m_Localized: "\u041D\u0430\u0434\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u043E \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435 \u0423\u043B\u044C\u0440\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000020
    m_Localized: "\u041D\u0430\u0434\u043E \u2014 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C.
      \u0421\u043B\u0443\u0445\u0438 \u043E\u0431\u044B\u0447\u043D\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
      \u0441 \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u044F\u043C\u0438,
      \u0430 \u043D\u0435 \u0441 \u0431\u0443\u043C\u0430\u0433\u0430\u043C\u0438.
      \u0423 \u043C\u0435\u043D\u044F \u0431\u0443\u043C\u0430\u0433\u0438, \u0443
      \u0442\u0435\u0431\u044F \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435.
      \u041D\u043E \u044F \u043D\u0435 \u043B\u044E\u0431\u043B\u044E \u0433\u0440\u043E\u043C\u043A\u0438\u0445
      \u0441\u0446\u0435\u043D: \u043E\u043D\u0438 \u0434\u0435\u043B\u0430\u044E\u0442
      \u043B\u044E\u0434\u0435\u0439 \u0441\u043C\u0435\u043B\u0435\u0435, \u0447\u0435\u043C
      \u043E\u043D\u0438 \u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000021
    m_Localized: "\u0421\u043D\u0438\u043C\u0438 \u043F\u0440\u0435\u0442\u0435\u043D\u0437\u0438\u044E
      \u0438 \u0432\u0435\u0440\u043D\u0438 \u0431\u0443\u043C\u0430\u0433\u0438
      \u0423\u043B\u044C\u0440\u0438\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000022
    m_Localized: "\u0417\u0430\u0431\u0438\u0440\u0430\u0439. \u0423\u043B\u044C\u0440\u0438\u043A
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442 \u0431\u0443\u043C\u0430\u0433\u0438,
      \u0430 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0438\u043C\u0438
      \u2014 \u0432\u0441\u0435 \u0441\u0447\u0435\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u044F \u043C\u043E\u0433 \u0431\u044B \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u044C.
      \u041D\u0435 \u0441\u0447\u0438\u0442\u0430\u0439 \u044D\u0442\u043E \u0440\u0430\u0441\u043A\u0430\u044F\u043D\u0438\u0435\u043C.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0441\u043F\u043E\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0437\u0430 \u0434\u0432\u0435\u0440\u044C,
      \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0434\u043E\u0440\u043E\u0436\u0435, \u0447\u0435\u043C \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000023
    m_Localized: "\u041C\u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442
      \u0441\u0442\u043E \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u043A\u0440\u043E\u043D.
      \u0411\u0443\u043C\u0430\u0433\u0438 \u043E\u0441\u0442\u0430\u0432\u044C \u0441\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000024
    m_Localized: "\u0412\u043E\u0442 \u0438 \u0440\u0430\u0437\u0443\u043C\u043D\u043E.
      \u0423\u043B\u044C\u0440\u0438\u043A \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442
      \u043C\u043E\u043B\u043E\u0442\u044C, \u0442\u044B \u0443\u0439\u0434\u0451\u0448\u044C
      \u0441 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438, \u0430 \u0431\u0443\u043C\u0430\u0433\u0438
      \u043E\u0441\u0442\u0430\u043D\u0443\u0442\u0441\u044F \u0442\u0430\u043C,
      \u0433\u0434\u0435 \u0438\u0445 \u043D\u0435 \u0440\u0430\u0437\u043E\u0440\u0432\u0443\u0442
      \u043F\u0440\u0438 \u043F\u0435\u0440\u0432\u043E\u043C \u0434\u0443\u0440\u043D\u043E\u043C
      \u0432\u0435\u0442\u0440\u0435. \u041D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0432\u044B\u0439\u0434\u0435\u0442 \u0447\u0438\u0441\u0442\u044B\u043C,
      \u043D\u043E \u0432\u0441\u0435 \u0432\u044B\u0439\u0434\u0443\u0442 \u0436\u0438\u0432\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000025
    m_Localized: "\u041D\u0443? \u0427\u0435\u0433\u043E \u0445\u043E\u0442\u0435\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000026
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438 \u043E \u0441\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000027
    m_Localized: "\u041E\u0431\u043E \u043C\u043D\u0435? \u041B\u0430\u0434\u043D\u043E.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0431\u0435\u0437 \u0434\u0435\u0448\u0451\u0432\u043E\u0433\u043E
      \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u0430: \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439
      \u043F\u0440\u044F\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000028
    m_Localized: "\u041A\u0430\u043A \u0442\u044B \u0441\u0442\u0430\u043B \u0433\u043B\u0430\u0432\u0430\u0440\u0451\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000029
    m_Localized: "\u041F\u0440\u0435\u0436\u043D\u0438\u0439 \u0433\u043B\u0430\u0432\u0430\u0440\u044C
      \u043B\u044E\u0431\u0438\u043B \u043C\u0430\u0445\u0430\u0442\u044C \u043D\u043E\u0436\u043E\u043C
      \u0438 \u043D\u0435 \u0443\u043C\u0435\u043B \u0441\u0447\u0438\u0442\u0430\u0442\u044C.
      \u041A\u043E\u0433\u0434\u0430 \u0435\u0433\u043E \u043D\u0435 \u0441\u0442\u0430\u043B\u043E,
      \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0442\u0440\u043E\u0435 \u0437\u043B\u044B\u0445,
      \u043F\u0443\u0441\u0442\u043E\u0439 \u043A\u043E\u0442\u0451\u043B \u0438
      \u0434\u043E\u043B\u0433 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0443.
      \u042F \u043F\u043E\u0434\u0435\u043B\u0438\u043B \u0435\u0434\u0443, \u0437\u0430\u043A\u0440\u044B\u043B
      \u0434\u043E\u043B\u0433 \u0438 \u0441\u043A\u0430\u0437\u0430\u043B: \u0431\u0435\u0437
      \u043C\u043E\u0435\u0433\u043E \u0441\u043B\u043E\u0432\u0430 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432
      \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0442\u044C. \u0417\u0430 \u044D\u0442\u043E
      \u043E\u0442\u0432\u0435\u0447\u0430\u0442\u044C \u0431\u0443\u0434\u0435\u043C
      \u0432\u0441\u0435. \u0422\u0430\u043A \u0438 \u0432\u044B\u0448\u043B\u043E.
      \u041B\u044E\u0434\u044F\u043C \u043D\u0443\u0436\u0435\u043D \u043D\u0435
      \u0441\u0430\u043C\u044B\u0439 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0439,
      \u0430 \u0442\u043E\u0442, \u043A\u0442\u043E \u043D\u0435 \u0431\u0440\u043E\u0441\u0438\u0442
      \u0438\u0445 \u0431\u0435\u0437 \u0435\u0434\u044B \u0443\u0442\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000030
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u044B \u0434\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C
      \u0438\u043C\u0435\u043D\u043D\u043E \u0437\u0434\u0435\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000031
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u0437\u0434\u0435\u0441\u044C
      \u043E\u0434\u043D\u0430, \u0430 \u043E\u0431\u0445\u043E\u0434 \u2014 \u0442\u0440\u0438
      \u0434\u043D\u044F \u043F\u043E \u043C\u043E\u043A\u0440\u043E\u043C\u0443
      \u043B\u0435\u0441\u0443. \u0413\u043E\u0440\u043E\u0434 \u0437\u0430\u043A\u0440\u044B\u043B\u0438,
      \u0432\u043E\u0437\u044B \u0432\u0441\u0442\u0430\u043B\u0438, \u0441\u0442\u0440\u0430\u0436\u0430
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0441\u0442\u0435\u043D\u044B.
      \u041C\u044B \u0441\u043C\u043E\u0442\u0440\u0438\u043C \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443.
      \u0411\u0440\u0430\u043C \u0431\u0435\u0440\u0451\u0442 \u043F\u043B\u0430\u0442\u0443
      \u0443 \u043F\u0440\u043E\u0445\u043E\u0434\u0430 \u2014 \u043E\u043D \u043D\u0435
      \u0433\u043B\u0430\u0432\u0430\u0440\u044C, \u043E\u043D \u043D\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u0435.
      \u041C\u043E\u0451 \u0434\u0435\u043B\u043E \u2014 \u043D\u0435 \u0434\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438\u043C \u0434\u0443\u0440\u0430\u043A\u0430\u043C \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044C
      \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u043E\u043A \u0432 \u0440\u0435\u0437\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000032
    m_Localized: "\u0427\u0442\u043E \u0443 \u0432\u0430\u0441 \u0442\u0443\u0442
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u043B\u043E \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
      \u0432\u0440\u0435\u043C\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000033
    m_Localized: "\u0413\u043E\u0440\u043E\u0434 \u0437\u0430\u043A\u0440\u044B\u043B\u0441\u044F
      \u2014 \u0438 \u0432\u0441\u0435\u043C \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u043B\u0430\u0441\u044C
      \u0434\u043E\u0440\u043E\u0433\u0430. \u0412\u0447\u0435\u0440\u0430 \u043A\u0443\u043F\u0435\u0446
      \u043F\u0440\u043E\u0441\u0438\u043B \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u043E\u0431\u043E\u0437, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0438\u043D
      \u043F\u0440\u043E\u0434\u0430\u0451\u0442 \u043D\u043E\u0436, \u0447\u0442\u043E\u0431\u044B
      \u043A\u0443\u043F\u0438\u0442\u044C \u043C\u0443\u043A\u0438. \u0412 \u0442\u0430\u043A\u0438\u0435
      \u0434\u043D\u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u0445\u043E\u0447\u0435\u0442
      \u0443\u0440\u0432\u0430\u0442\u044C \u0441\u0432\u043E\u0451. \u041F\u043E\u0442\u043E\u043C
      \u043E\u0431\u044B\u0447\u043D\u043E \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u0437\u0430
      \u044D\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u0434\u0440\u0443\u0433\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000034
    m_Localized: "\u0421 \u043A\u0435\u043C \u0442\u044B \u0437\u0434\u0435\u0441\u044C
      \u0441\u0447\u0438\u0442\u0430\u0435\u0448\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000035
    m_Localized: "\u0421 \u0442\u0435\u043C\u0438, \u043A\u0442\u043E \u0434\u0435\u0440\u0436\u0438\u0442
      \u0441\u043B\u043E\u0432\u043E. \u0411\u0440\u0430\u043C \u043B\u044E\u0431\u0438\u0442
      \u0434\u0430\u0432\u0438\u0442\u044C \u0433\u043E\u043B\u043E\u0441\u043E\u043C,
      \u043D\u043E \u043F\u043E\u043A\u0430 \u0441\u043B\u0443\u0448\u0430\u0435\u0442
      \u2014 \u0433\u043E\u0434\u0438\u0442\u0441\u044F \u0434\u043B\u044F \u0434\u043E\u0440\u043E\u0433\u0438.
      \u0421\u0442\u0440\u0430\u0436\u0435 \u043D\u0443\u0436\u043D\u0430 \u0442\u0438\u0448\u0438\u043D\u0430
      \u0443 \u0432\u043E\u0440\u043E\u0442, \u043C\u043D\u0435 \u2014 \u0447\u0442\u043E\u0431\u044B
      \u043E\u043D\u0438 \u043D\u0435 \u043B\u0435\u0437\u043B\u0438 \u0432 \u043B\u0435\u0441
      \u0437\u0430 \u0441\u043B\u0430\u0432\u043E\u0439. \u0414\u0435\u0440\u0435\u0432\u0435\u043D\u0441\u043A\u0438\u0435
      \u043D\u0430\u043C \u043D\u0435 \u0434\u0440\u0443\u0437\u044C\u044F, \u043D\u043E
      \u0438 \u043D\u0435 \u0434\u043E\u0431\u044B\u0447\u0430. \u0421 \u0441\u043E\u0441\u0435\u0434\u044F\u043C\u0438
      \u043B\u0443\u0447\u0448\u0435 \u0438\u043C\u0435\u0442\u044C \u0441\u0447\u0451\u0442,
      \u0447\u0435\u043C \u0441\u0442\u0430\u0440\u0443\u044E \u043A\u0440\u043E\u0432\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000036
    m_Localized: "\u0422\u044B \u0438 \u043F\u0440\u0430\u0432\u0434\u0430 \u0447\u0438\u0442\u0430\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000037
    m_Localized: "\u0427\u0438\u0442\u0430\u044E. \u0411\u0443\u043A\u0432\u044B
      \u043C\u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438 \u0432
      \u0434\u043E\u043B\u0433\u043E\u0432\u043E\u0439 \u044F\u043C\u0435: \u0441\u043D\u0430\u0447\u0430\u043B\u0430,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u0442\u044C
      \u0441\u0435\u0431\u0435 \u043F\u0435\u0442\u043B\u044E, \u043F\u043E\u0442\u043E\u043C
      \u0432\u0442\u044F\u043D\u0443\u043B\u0441\u044F. \u0421\u0447\u0435\u0442\u0430,
      \u0441\u0443\u0434\u0435\u0431\u043D\u044B\u0435 \u043B\u0438\u0441\u0442\u043A\u0438,
      \u0441\u0442\u0430\u0440\u044B\u0435 \u043F\u043E\u0445\u043E\u0434\u043D\u044B\u0435
      \u043A\u043D\u0438\u0436\u043A\u0438. \u0412 \u0431\u0443\u043C\u0430\u0433\u0430\u0445
      \u043B\u044E\u0434\u0438 \u0432\u0440\u0443\u0442 \u043D\u0435 \u0445\u0443\u0436\u0435,
      \u0447\u0435\u043C \u0432 \u043B\u0438\u0446\u043E. \u0422\u043E\u043B\u044C\u043A\u043E
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435. \u041F\u043E\u043B\u0435\u0437\u043D\u043E:
      \u043F\u0440\u043E\u0447\u0442\u0451\u0448\u044C \u2014 \u0438 \u0443\u0436\u0435
      \u0432\u0438\u0434\u043D\u043E, \u043A\u043E\u0433\u043E \u0434\u0435\u0440\u0436\u0430\u0442
      \u0437\u0430 \u0444\u0440\u0430\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000038
    m_Localized: "\u0415\u0441\u0442\u044C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u043F\u043E \u0434\u0435\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000039
    m_Localized: "\u041F\u043E \u0434\u0435\u043B\u0443 \u2014 \u0433\u043E\u0432\u043E\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000040
    m_Localized: "\u041E \u043D\u0430\u043B\u0451\u0442\u0435 \u043D\u0430 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443
      \u0423\u043B\u044C\u0440\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000041
    m_Localized: "\u041F\u0440\u043E \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443
      \u0441\u043B\u044B\u0448\u0430\u043B. \u041D\u043E \u0442\u0435\u0431\u0435
      \u043D\u0435 \u0441\u043B\u0443\u0445 \u043D\u0443\u0436\u0435\u043D, \u0430
      \u0438\u043C\u044F. \u0421\u043A\u0430\u0436\u0438 \u0441\u043D\u0430\u0447\u0430\u043B\u0430,
      \u0437\u0430\u0447\u0435\u043C \u043E\u043D\u043E \u0442\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000042
    m_Localized: "\u0422\u043E\u0442, \u043A\u0442\u043E \u0432\u0430\u0441 \u043D\u0430\u043D\u044F\u043B,
      \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0441\u044F \u0437\u0430 \u0447\u0443\u0436\u0438\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438. \u0415\u0441\u043B\u0438 \u0432\u0441\u0451
      \u0432\u0441\u043F\u043B\u044B\u0432\u0451\u0442, \u043E\u043D \u043E\u0442\u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u043E\u0442 \u0432\u0430\u0441. \u0422\u0435\u0431\u0435 \u044D\u0442\u043E
      \u0438 \u0441\u0430\u043C\u043E\u043C\u0443 \u044F\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000044
    m_Localized: "\u0422\u044B \u0432\u0437\u044F\u043B \u0434\u0435\u043D\u044C\u0433\u0438
      \u0437\u0430 \u043D\u0430\u043B\u0451\u0442. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0439, \u043A\u0442\u043E
      \u043F\u043B\u0430\u0442\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000045
    m_Localized: "\u041D\u0435 \u0434\u0435\u0440\u0436\u0438 \u043C\u0435\u043D\u044F
      \u0437\u0430 \u0444\u0440\u0430\u0435\u0440\u0430. \u042F \u0432\u0437\u044F\u043B
      \u0437\u0430\u043A\u0430\u0437: \u0437\u0430\u0431\u0440\u0430\u0442\u044C
      \u043B\u0430\u0440\u0435\u0446, \u043B\u044E\u0434\u0435\u0439 \u043D\u0435
      \u043A\u0430\u043B\u0435\u0447\u0438\u0442\u044C. \u0417\u0430\u043A\u0430\u0437\u0447\u0438\u043A
      \u0431\u043E\u044F\u043B\u0441\u044F \u0448\u0443\u043C\u0430 \u0441\u0438\u043B\u044C\u043D\u0435\u0435,
      \u0447\u0435\u043C \u043D\u0430\u0441. \u0422\u0430\u043A\u0438\u0435 \u043F\u043E\u0442\u043E\u043C
      \u043F\u0435\u0440\u0432\u044B\u043C\u0438 \u0440\u0435\u0436\u0443\u0442 \u043A\u043E\u043D\u0446\u044B
      \u0447\u0443\u0436\u0438\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438.
      \u041D\u043E \u0442\u044B \u043F\u0440\u0438\u0448\u0451\u043B \u043D\u0435
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u0430 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C.
      \u0420\u0438\u0441\u043A \u043C\u043E\u0439, \u043F\u043E\u043B\u044C\u0437\u0430
      \u0442\u0432\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000046
    m_Localized: "\u041B\u0430\u0434\u043D\u043E. \u0421\u043A\u043E\u043B\u044C\u043A\u043E
      \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u0437\u0430 \u0440\u0438\u0441\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000047
    m_Localized: "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043A\u0440\u043E\u043D.
      \u041D\u0435 \u0437\u0430 \u0438\u043C\u044F \u2014 \u0437\u0430 \u0442\u043E,
      \u0447\u0442\u043E \u043F\u043E\u0441\u043B\u0435 \u0442\u0435\u0431\u044F
      \u043C\u043D\u0435 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u043B\u044E\u0434\u044F\u043C \u0437\u0430 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435.
      \u0418 \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u0439\u0441\u044F: \u0441\u0430\u043C
      \u0432\u044B\u0431\u0440\u0430\u043B, \u043A\u0430\u043A \u0441\u043E \u043C\u043D\u043E\u0439
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000048
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C 30 \u043A\u0440\u043E\u043D
      \u0437\u0430 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000049
    m_Localized: "\u041A\u043E\u0440\u0432\u0438\u043D \u0412\u0435\u0439\u0440 \u043F\u043B\u0430\u0442\u0438\u043B
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0438\u0441\u0446\u0430. \u041B\u0430\u0440\u0435\u0446
      \u0441 \u0431\u0443\u043C\u0430\u0433\u0430\u043C\u0438 \u0431\u044B\u043B
      \u043D\u0430\u0437\u0432\u0430\u043D \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E,
      \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u0432 \u0434\u043E\u043C\u0435 \u0435\u0433\u043E \u0432\u043E\u0432\u0441\u0435
      \u043D\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043B\u043E.
      \u0418 \u0435\u0449\u0451: \u043F\u0438\u0441\u0435\u0446 \u0441\u043A\u0430\u0437\u0430\u043B,
      \u0447\u0442\u043E \u0431\u0443\u043C\u0430\u0433\u0438 \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0442\u044C
      \u0438 \u043D\u0435 \u0447\u0438\u0442\u0430\u0442\u044C. \u0414\u043B\u044F
      \u043C\u0435\u043D\u044F \u044D\u0442\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043D\u044F\u0442\u044C, \u0447\u044C\u044F
      \u044D\u0442\u043E \u0431\u044B\u043B\u0430 \u0437\u0430\u0442\u0435\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000050
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000051
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000052
    m_Localized: "\u041A\u0442\u043E \u0442\u0430\u043C? \u0415\u0441\u043B\u0438
      \u043D\u0443\u0436\u0435\u043D \u0442\u043E\u0432\u0430\u0440 \u2014 \u043D\u0430\u0437\u044B\u0432\u0430\u0439,
      \u043A\u0430\u043A\u043E\u0439. \u0415\u0441\u043B\u0438 \u0431\u0435\u0441\u0435\u0434\u0430
      \u2014 \u0443 \u0442\u0435\u0431\u044F \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439
      \u0432\u043A\u0443\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000053
    m_Localized: "\u0422\u044B \u042D\u0440\u0434\u044D\u043D \u0412\u0435\u043B\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000054
    m_Localized: "\u0418\u043C\u044F \u0441\u0442\u0430\u0440\u043E\u0435. \u0418\u0441\u0442\u043E\u0440\u0438\u0439
      \u0432\u043E\u043A\u0440\u0443\u0433 \u043D\u0435\u0433\u043E \u0435\u0449\u0451
      \u0431\u043E\u043B\u044C\u0448\u0435. \u0422\u044B \u043F\u0440\u0438\u0448\u0451\u043B
      \u043A\u0443\u043F\u0438\u0442\u044C \u0447\u0442\u043E-\u0442\u043E \u0438\u043B\u0438
      \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u0438\u0445 \u043C\u043D\u0435 \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0435\u0440\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000055
    m_Localized: "\u042F \u0441\u043B\u044B\u0448\u0430\u043B, \u0447\u0442\u043E
      \u0442\u0432\u043E\u0451 \u0438\u043C\u044F \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u043B\u0438
      \u0441 \u041A\u0440\u0430\u0441\u043D\u043E\u0439 \u041B\u0443\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000056
    m_Localized: "\u0421\u0432\u044F\u0437\u044B\u0432\u0430\u043B\u0438 \u0438 \u0441
      \u0447\u0443\u043C\u043E\u0439, \u0438 \u0441 \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u043C\u0438
      \u043A\u043E\u0440\u043E\u0432\u0430\u043C\u0438. \u041B\u044E\u0434\u044F\u043C
      \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
      \u0443 \u0431\u0435\u0434\u044B \u0435\u0441\u0442\u044C \u043E\u0434\u043D\u043E
      \u0438\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000057
    m_Localized: "\u0422\u0430\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u043E \u0434\u0435\u0442\u044F\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043E\u0442\u0431\u0438\u0440\u0430\u043B\u0438 \u043F\u043E\u0441\u043B\u0435
      \u041A\u0440\u0430\u0441\u043D\u043E\u0439 \u041B\u0443\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000058
    m_Localized: "\u0418\u0445 \u043D\u0435 \u043E\u0442\u0431\u0438\u0440\u0430\u043B\u0438
      \u043F\u043E\u0441\u043B\u0435 \u041B\u0443\u043D\u044B. \u0420\u0435\u0430\u043A\u0446\u0438\u044F
      \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u043B\u0430\u0441\u044C \u0440\u0430\u043D\u044C\u0448\u0435,
      \u0430 \u041A\u0440\u0430\u0441\u043D\u0430\u044F \u041B\u0443\u043D\u0430
      \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u043B\u0430
      \u0435\u0451... \u0412\u043E\u0442 \u0438\u043C\u0435\u043D\u043D\u043E \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u044F \u043D\u0435 \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u044E \u044D\u0442\u043E
      \u0441 \u0442\u0435\u043C\u0438, \u043A\u0442\u043E \u043F\u0440\u0438\u043D\u0451\u0441
      \u0441\u043B\u0443\u0445\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000059
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000060
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0442\u044B \u0443\u043C\u0435\u0435\u0448\u044C
      \u0441\u043B\u0443\u0448\u0430\u0442\u044C. \u042D\u0442\u043E \u0435\u0449\u0451
      \u043D\u0435 \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E \u0442\u044B
      \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C, \u043E \u0447\u0451\u043C
      \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000061
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043E\u0431\u044A\u044F\u0441\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000062
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u041A\u0440\u0430\u0441\u043D\u043E\u0439
      \u041B\u0443\u043D\u044B \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0434\u0435\u0442\u0438 \u043C\u0435\u043D\u044F\u043B\u0438\u0441\u044C.
      \u041D\u0435 \u0432\u043D\u0435\u0448\u043D\u0435. \u0418\u043C \u0441\u043D\u0438\u043B\u0438\u0441\u044C
      \u0441\u043E\u0431\u044B\u0442\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u043E\u0442\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u043B\u0438\u0441\u044C.
      \u041E\u043D\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
      \u043B\u044E\u0434\u0435\u0439 \u0437\u0430 \u0441\u0442\u0435\u043D\u043E\u0439.
      \u0418\u043D\u043E\u0433\u0434\u0430 \u0440\u044F\u0434\u043E\u043C \u0441
      \u043D\u0438\u043C\u0438 \u0441\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u043B\u0438
      \u0432\u0435\u0449\u0438, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043D\u0435 \u0432\u043B\u0438\u044F\u0435\u0442. \u041C\u044B \u0445\u043E\u0442\u0435\u043B\u0438
      \u043F\u043E\u043D\u044F\u0442\u044C, \u043F\u043E\u0447\u0435\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000063
    m_Localized: "\u0418 \u043F\u043E\u0442\u043E\u043C \u0432\u044B \u043D\u0430\u0447\u0430\u043B\u0438
      \u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043D\u0430 \u043D\u0438\u0445
      \u043E\u043F\u044B\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000064
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B\u0438.
      \u041F\u043E\u0442\u043E\u043C \u0440\u0435\u0448\u0438\u043B\u0438, \u0447\u0442\u043E
      \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0439 \u043C\u0430\u043B\u043E.
      \u041F\u0440\u043E\u0432\u0435\u0440\u044F\u043B\u0438 \u0441\u0432\u0435\u0442
      \u041B\u0443\u043D\u044B, \u043A\u0440\u043E\u0432\u044C, \u043C\u0438\u043D\u0435\u0440\u0430\u043B\u044B,
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F. \u0412 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
      \u043C\u043E\u043C\u0435\u043D\u0442 \u0434\u0435\u0442\u0438 \u0441\u0442\u0430\u043B\u0438
      \u0434\u043B\u044F \u043D\u0430\u0441 \u043D\u0435 \u043B\u044E\u0434\u044C\u043C\u0438,
      \u0430 \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043E\u0442\u0432\u0435\u0442. \u042D\u0442\u043E \u0431\u044B\u043B\u043E
      \u0443\u0434\u043E\u0431\u043D\u043E. \u0418 \u043C\u0435\u0440\u0437\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000065
    m_Localized: "\u041A\u0442\u043E-\u0442\u043E \u0438\u0437 \u043D\u0438\u0445
      \u0432\u044B\u0436\u0438\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000066
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E. \u041D\u0435
      \u0432\u0441\u0435 \u0443\u0448\u043B\u0438 \u0442\u0430\u043A\u0438\u043C\u0438,
      \u043A\u0430\u043A\u0438\u043C\u0438 \u043F\u0440\u0438\u0448\u043B\u0438.
      \u041F\u043E\u0442\u043E\u043C \u043A\u0442\u043E-\u0442\u043E \u0438\u0437
      \u0432\u044B\u0436\u0438\u0432\u0448\u0438\u0445 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B,
      \u0438\u043B\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u043C\u0430\u0433\u043E\u0432
      \u0440\u0430\u0441\u043A\u043E\u043B\u043E\u043B\u0438. \u0418\u043C\u0435\u043D\u0430
      \u043F\u043E\u0448\u043B\u0438 \u043F\u043E \u0440\u0443\u043A\u0430\u043C.
      \u0414\u0432\u0443\u0445 \u043C\u043E\u0438\u0445 \u043A\u043E\u043B\u043B\u0435\u0433
      \u0443\u0436\u0435 \u043D\u0430\u0448\u043B\u0438 \u043C\u0451\u0440\u0442\u0432\u044B\u043C\u0438.
      \u042F \u043D\u0435 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u044E,
      \u0447\u0442\u043E \u043D\u0430 \u043D\u0438\u0445 \u0432\u0441\u0451 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000067
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0432\u0441\u0451
      \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C
      \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0435\u0440\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000068
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0434\u0432\u0435\u0440\u044C,
      \u043A\u0430\u043C\u0435\u043D\u044C \u0438 \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u0437\u0430\u043C\u043E\u043A \u0441\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u043B\u0435\u0437\u043D\u0435\u0435
      \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0430 \u043C\u043E\u0438\u0445
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000069
    m_Localized: "\u0422\u044B \u0436\u0434\u0451\u0448\u044C, \u0447\u0442\u043E
      \u043A \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0434\u0443\u0442 \u043C\u0441\u0442\u0438\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000070
    m_Localized: "\u041D\u0435 \u0436\u0434\u0443. \u0413\u043E\u0442\u043E\u0432\u043B\u044E\u0441\u044C.
      \u0423 \u043D\u0438\u0445 \u0441\u043D\u0430\u0440\u0443\u0436\u0438 \u043B\u0435\u0441,
      \u0434\u043E\u0440\u043E\u0433\u0438 \u0438 \u0432\u0440\u0435\u043C\u044F.
      \u0423 \u043C\u0435\u043D\u044F \u2014 \u0441\u0442\u0435\u043D\u044B, \u0437\u0430\u043F\u0430\u0441\u044B
      \u0438 \u0448\u0430\u043D\u0441 \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
      \u0448\u0430\u0433\u0438 \u043D\u0430 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435.
      \u042D\u0442\u043E \u043D\u0435 \u0436\u0438\u0437\u043D\u044C. \u041D\u043E
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u044F \u0431\u044B\u043B
      \u0431\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0435\u0449\u0451 \u043E\u0434\u043D\u0438\u043C
      \u0438\u043C\u0435\u043D\u0435\u043C \u0432 \u0447\u0443\u0436\u043E\u043C
      \u0441\u043F\u0438\u0441\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000071
    m_Localized: "\u041E \u043C\u0430\u0433\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000072
    m_Localized: "\u0415\u0441\u043B\u0438 \u0442\u044B \u043F\u0440\u0438\u0448\u0451\u043B
      \u0437\u0430 \u0443\u0440\u043E\u043A\u043E\u043C, \u0442\u043E \u043E\u043F\u043E\u0437\u0434\u0430\u043B
      \u043B\u0435\u0442 \u043D\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C.
      \u0415\u0441\u043B\u0438 \u0437\u0430 \u0442\u043E\u0432\u0430\u0440\u043E\u043C
      \u2014 \u044D\u0442\u043E \u044F \u0435\u0449\u0451 \u043C\u043E\u0433\u0443
      \u043F\u043E\u043D\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000073
    m_Localized: "\u041A\u0430\u043A \u0442\u044B \u0432\u043E\u043E\u0431\u0449\u0435
      \u0441\u0442\u0430\u043B \u043C\u0430\u0433\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000074
    m_Localized: "\u0423\u043C\u0435\u043B \u0447\u0438\u0442\u0430\u0442\u044C,
      \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u0438 \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u043B
      \u0441 \u043B\u044E\u0434\u044C\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u043B\u0430\u0442\u0438\u043B\u0438 \u0437\u0430 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435.
      \u0422\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
      \u0447\u0442\u043E \u044D\u0442\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.
      \u041F\u043E\u0442\u043E\u043C \u0432\u044B\u044F\u0441\u043D\u0438\u043B\u043E\u0441\u044C:
      \u0437\u043D\u0430\u043D\u0438\u044F \u0431\u0435\u0437 \u043C\u0435\u0440\u044B
      \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u0430\u044E\u0442 \u0442\u0435\u0431\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u0432
      \u043D\u0430\u0432\u0440\u0435\u0434\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000075
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0432\u0441\u0451
      \u0435\u0449\u0451 \u0442\u043E\u0440\u0433\u0443\u0435\u0448\u044C \u0441
      \u043B\u044E\u0434\u044C\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000076
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u044B
      \u0435\u0434\u0430, \u043C\u0430\u0441\u043B\u043E \u0434\u043B\u044F \u043B\u0430\u043C\u043F
      \u0438 \u0440\u0435\u0434\u043A\u0438\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430.
      \u0418 \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044F
      \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440, \u0433\u0434\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0445\u043E\u0442\u044F \u0431\u044B \u0434\u0435\u043B\u0430\u0435\u0442
      \u0432\u0438\u0434, \u0447\u0442\u043E \u0441\u043B\u0443\u0448\u0430\u0435\u0442
      \u0443\u0441\u043B\u043E\u0432\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000077
    m_Localized: "\u0427\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
      \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000078
    m_Localized: "\u0422\u044B \u0438\u0449\u0435\u0448\u044C \u0441\u043F\u043B\u0435\u0442\u043D\u0438
      \u043D\u0435 \u043F\u043E \u0430\u0434\u0440\u0435\u0441\u0443. \u041D\u043E
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u0445
      \u0432\u0435\u0449\u0435\u0439 \u044F \u0437\u0430\u043C\u0435\u0447\u0430\u044E
      \u0434\u0430\u0436\u0435 \u0438\u0437 \u0431\u0430\u0448\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000079
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C
      \u043E \u041A\u0430\u0434\u043C\u043E\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000080
    m_Localized: "\u041A\u0430\u0434\u043C\u043E\u043D \u043B\u044E\u0431\u0438\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u0443 \u0432\u0441\u0435\u0433\u043E \u0435\u0441\u0442\u044C
      \u043F\u0440\u043E\u0441\u0442\u043E\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435
      \u0438 \u043E\u0434\u0438\u043D \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u044B\u0439.
      \u042D\u0442\u043E \u0443\u0441\u043F\u043E\u043A\u0430\u0438\u0432\u0430\u0435\u0442
      \u043B\u044E\u0434\u0435\u0439. \u0413\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043F\u0440\u0430\u0432\u0434\u0430,
      \u043D\u0435 \u0441\u043F\u0430\u0441\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000081
    m_Localized: "\u0410 \u041C\u0435\u0439\u0440\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000082
    m_Localized: "\u0423 \u041C\u0435\u0439\u0440\u044B \u0445\u043E\u0440\u043E\u0448\u0438\u0435
      \u0440\u0443\u043A\u0438 \u0438 \u0434\u0443\u0440\u043D\u0430\u044F \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0430
      \u0432\u0435\u0440\u0438\u0442\u044C \u0442\u043E\u043C\u0443, \u0447\u0442\u043E
      \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E \u043E\u0434\u043D\u0430\u0436\u0434\u044B.
      \u041E\u043D\u0430 \u0432\u0438\u0434\u0438\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u0430 \u043D\u0435 \u0437\u0430\u0434\u0430\u0447\u0443. \u0418\u043D\u043E\u0433\u0434\u0430
      \u044D\u0442\u043E \u0441\u043F\u0430\u0441\u0430\u0435\u0442. \u0418\u043D\u043E\u0433\u0434\u0430
      \u043C\u0435\u0448\u0430\u0435\u0442 \u043F\u043E\u043D\u044F\u0442\u044C,
      \u0447\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u044B \u043B\u0435\u0447\u0438\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000083
    m_Localized: "\u0427\u0442\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438
      \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000084
    m_Localized: "\u041F\u043E\u043A\u0430 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442, \u043B\u044E\u0434\u0438
      \u0440\u0443\u0433\u0430\u044E\u0442\u0441\u044F \u0438\u0437-\u0437\u0430
      \u0446\u0435\u043D\u044B \u043D\u0430 \u043C\u0443\u043A\u0443. \u041A\u043E\u0433\u0434\u0430
      \u0432\u0441\u0442\u0430\u043D\u0435\u0442 \u2014 \u043D\u0430\u0447\u043D\u0443\u0442
      \u0440\u0443\u0433\u0430\u0442\u044C\u0441\u044F \u0438\u0437-\u0437\u0430
      \u0435\u0434\u044B. \u0421\u0442\u0440\u0430\u0436\u0430 \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442
      \u0432\u043E\u0440\u043E\u0442\u0430, \u0431\u0430\u043D\u0434\u0438\u0442\u044B
      \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443,
      \u0430 \u0434\u0435\u0440\u0435\u0432\u043D\u044F \u0441\u0447\u0438\u0442\u0430\u0435\u0442,
      \u043D\u0430 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439
      \u0445\u0432\u0430\u0442\u0438\u0442 \u0437\u0430\u043F\u0430\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000085
    m_Localized: "\u0422\u044B \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0437\u043D\u0430\u0435\u0448\u044C \u043E \u0442\u0430\u0432\u0435\u0440\u043D\u0435
      \u0438 \u043F\u0440\u0438\u0435\u0437\u0436\u0438\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000086
    m_Localized: "\u0412 \u0442\u0430\u0432\u0435\u0440\u043D\u0443 \u044F \u043D\u0435
      \u0445\u043E\u0436\u0443. \u0425\u0430\u043B\u044C\u0432\u0430\u0440 \u0437\u043D\u0430\u0435\u0442,
      \u043A\u0442\u043E \u043F\u044C\u0451\u0442, \u043A\u0442\u043E \u0432\u0440\u0451\u0442
      \u0438 \u043A\u0442\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C.
      \u041B\u0438\u0432\u0438\u043E \u0437\u043D\u0430\u0435\u0442, \u0443 \u043A\u043E\u0433\u043E
      \u0431\u0435\u0434\u0430. \u041E\u0431\u0430 \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442
      \u044D\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000087
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000088
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000089
    m_Localized: "\u0417\u0430\u043F\u0430\u0441 \u042D\u0440\u0434\u044D\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000090
    m_Localized: "\u042D\u0440\u0434\u044D\u043D \u043F\u0440\u043E\u0441\u0438\u0442
      \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0448\u0435\u0441\u0442\u044C
      \u0441\u0432\u0435\u0436\u0438\u0445 \u0446\u0432\u0435\u0442\u043A\u043E\u0432
      \u0440\u043E\u043C\u0430\u0448\u043A\u0438. \u0421\u0430\u043C \u043E\u043D
      \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437 \u0431\u0430\u0448\u043D\u0438
      \u0438 \u043D\u0435 \u0445\u043E\u0447\u0435\u0442 \u0431\u0440\u0430\u0442\u044C
      \u0442\u0440\u0430\u0432\u044B \u0438\u0437 \u0437\u0430\u043F\u0430\u0441\u043E\u0432
      \u041C\u0435\u0439\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000091
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u0440\u043E\u043C\u0430\u0448\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000092
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u0448\u0435\u0441\u0442\u044C
      \u0441\u0432\u0435\u0436\u0438\u0445 \u0446\u0432\u0435\u0442\u043A\u043E\u0432
      \u0440\u043E\u043C\u0430\u0448\u043A\u0438 \u0434\u043B\u044F \u042D\u0440\u0434\u044D\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000093
    m_Localized: "\u041E\u0442\u043D\u0435\u0441\u0442\u0438 \u0440\u043E\u043C\u0430\u0448\u043A\u0443
      \u042D\u0440\u0434\u044D\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000094
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0431\u0430\u0448\u043D\u0435
      \u042D\u0440\u0434\u044D\u043D\u0430 \u0438 \u043E\u0442\u0434\u0430\u0442\u044C
      \u0435\u043C\u0443 \u0448\u0435\u0441\u0442\u044C \u0446\u0432\u0435\u0442\u043A\u043E\u0432
      \u0440\u043E\u043C\u0430\u0448\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000095
    m_Localized: "\u0423 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043A\u043E
      \u043C\u043D\u0435 \u0434\u0435\u043B\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000096
    m_Localized: "\u0415\u0441\u0442\u044C. \u041D\u0443\u0436\u043D\u0430 \u0440\u043E\u043C\u0430\u0448\u043A\u0430
      \u2014 \u0448\u0435\u0441\u0442\u044C \u0441\u0432\u0435\u0436\u0438\u0445
      \u0446\u0432\u0435\u0442\u043A\u043E\u0432, \u043D\u0435 \u0441\u0443\u0445\u0430\u044F
      \u0442\u0440\u0443\u0445\u0430. \u0420\u0430\u0441\u0442\u0451\u0442 \u0443
      \u0432\u043E\u0434\u044B \u0438 \u043D\u0430 \u0441\u0432\u0435\u0442\u043B\u044B\u0445
      \u0441\u043A\u043B\u043E\u043D\u0430\u0445. \u0417\u0430\u043F\u0430\u0441
      \u0443 \u043C\u0435\u043D\u044F \u043F\u043E\u0447\u0442\u0438 \u0432\u044B\u0448\u0435\u043B,
      \u0430 \u0438\u0437 \u0431\u0430\u0448\u043D\u0438 \u044F, \u043A\u0430\u043A
      \u0432\u0438\u0434\u0438\u0448\u044C, \u043D\u0435 \u0445\u043E\u0436\u0443.
      \u041F\u0440\u0438\u043D\u0435\u0441\u0451\u0448\u044C \u2014 \u0437\u0430\u043F\u043B\u0430\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000097
    m_Localized: "\u041C\u0435\u0439\u0440\u0430 \u0436\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442
      \u0442\u0440\u0430\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000098
    m_Localized: "\u0414\u043B\u044F \u0442\u0435\u0445, \u043A\u043E\u043C\u0443
      \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u044C
      \u043D\u043E\u0447\u044C. \u042F \u043D\u0435 \u0441\u0442\u0430\u043D\u0443
      \u0432\u044B\u0442\u044F\u0433\u0438\u0432\u0430\u0442\u044C \u0438\u0437 \u0435\u0451
      \u043A\u043E\u0440\u0437\u0438\u043D\u044B \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
      \u0449\u0435\u043F\u043E\u0442\u044C, \u0447\u0442\u043E\u0431\u044B \u043C\u043D\u0435
      \u0431\u044B\u043B\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435.
      \u0418 \u043D\u0435 \u043F\u0440\u0438\u043D\u043E\u0441\u0438 \u0435\u0451
      \u043D\u0430\u0441\u0442\u043E\u0438: \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u0430
      \u0447\u0438\u0441\u0442\u0430\u044F \u0440\u043E\u043C\u0430\u0448\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000099
    m_Localized: "\u041B\u0430\u0434\u043D\u043E, \u0441\u043E\u0431\u0435\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000100
    m_Localized: "\u041D\u0435 \u0432\u044B\u0434\u0451\u0440\u0433\u0438\u0432\u0430\u0439
      \u0432\u0441\u0451 \u0441 \u043A\u043E\u0440\u043D\u0435\u043C. \u0428\u0435\u0441\u0442\u044C
      \u0446\u0432\u0435\u0442\u043A\u043E\u0432, \u0447\u0438\u0441\u0442\u044B\u0445
      \u0438 \u0441\u0432\u0435\u0436\u0438\u0445. \u0415\u0441\u043B\u0438 \u0443\u0432\u0438\u0434\u0438\u0448\u044C,
      \u0447\u0442\u043E \u0440\u044F\u0434\u043E\u043C \u0443\u0436\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442
      \u041C\u0435\u0439\u0440\u0430, \u2014 \u043E\u0431\u043E\u0439\u0434\u0438
      \u0435\u0451 \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000101
    m_Localized: "\u041F\u043E\u0438\u0449\u0438 \u0434\u0440\u0443\u0433\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000102
    m_Localized: "\u042F \u043F\u0440\u0438\u043D\u0451\u0441 \u0440\u043E\u043C\u0430\u0448\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000103
    m_Localized: "\u0428\u0435\u0441\u0442\u044C. \u0418 \u043D\u0435 \u0440\u0430\u0437\u043C\u043E\u043A\u043B\u0438
      \u2014 \u0440\u0435\u0434\u043A\u0430\u044F \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E\u0441\u0442\u044C.
      \u0414\u0435\u0440\u0436\u0438 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u043F\u044F\u0442\u044C \u043A\u0440\u043E\u043D. \u042D\u0442\u043E \u043D\u0435
      \u0449\u0435\u0434\u0440\u043E\u0441\u0442\u044C, \u0430 \u0446\u0435\u043D\u0430
      \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u043C\u043D\u0435 \u043D\u0435
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0434\u0432\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000104
    m_Localized: "\u0422\u0430\u043A \u0438 \u0441\u0434\u0435\u043B\u0430\u044E.
      \u0422\u043E\u043B\u044C\u043A\u043E \u043B\u044E\u0431\u043E\u0439, \u043A\u0442\u043E
      \u0443\u043C\u0435\u0435\u0442 \u0441\u043B\u0443\u0448\u0430\u0442\u044C,
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0437\u0430\u043F\u0435\u0440\u0442 \u0437\u0430
      \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000105
    m_Localized: "\u0415\u0441\u043B\u0438 \u043F\u0440\u0438\u0448\u0451\u043B \u0437\u0430
      \u043F\u0440\u043E\u043F\u043E\u0432\u0435\u0434\u044C\u044E \u2014 \u043D\u0435
      \u0434\u043E\u0436\u0434\u0451\u0448\u044C\u0441\u044F. \u0415\u0441\u043B\u0438
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u2014 \u0433\u043E\u0432\u043E\u0440\u0438
      \u043F\u0440\u044F\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000106
    m_Localized: "\u0427\u0435\u043C \u0442\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C, \u043A\u0440\u043E\u043C\u0435 \u0441\u043B\u0443\u0436\u0431\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000107
    m_Localized: "\u0422\u0435\u043C, \u0447\u0442\u043E \u043B\u044E\u0434\u0438
      \u043E\u0431\u044B\u0447\u043D\u043E \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043F\u043E\u0437\u0434\u043D\u043E:
      \u043A\u043E\u043C\u0443 \u043D\u0443\u0436\u043D\u0430 \u0435\u0434\u0430,
      \u0443 \u043A\u043E\u0433\u043E \u043A\u0440\u044B\u0448\u0430 \u0442\u0435\u0447\u0451\u0442,
      \u043A\u043E\u0433\u043E \u043D\u0435\u043A\u043E\u043C\u0443 \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u0438\u0442\u044C.
      \u0421\u043B\u0443\u0436\u0431\u0430 \u2014 \u043D\u0435 \u0441\u043B\u043E\u0432\u0430
      \u0443 \u0430\u043B\u0442\u0430\u0440\u044F. \u0421\u043B\u043E\u0432\u0430
      \u043F\u0440\u043E\u0449\u0435 \u0432\u0441\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000108
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000109
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043F\u0440\u0438\u0445\u043E\u0434
      \u2014 \u044D\u0442\u043E \u043D\u0435 \u0437\u0434\u0430\u043D\u0438\u0435
      \u0438 \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C.
      \u042D\u0442\u043E \u043B\u044E\u0434\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C \u043F\u043E \u0438\u043C\u0435\u043D\u0430\u043C.
      \u0423\u0439\u0442\u0438, \u043A\u043E\u0433\u0434\u0430 \u0441\u0442\u0430\u043B\u043E
      \u0442\u0435\u0441\u043D\u043E \u0438 \u0441\u0442\u0440\u0430\u0448\u043D\u043E,
      \u0431\u044B\u043B\u043E \u0431\u044B \u0443\u0434\u043E\u0431\u043D\u043E.
      \u042F \u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0443\u0432\u0430\u0436\u0430\u044E
      \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000110
    m_Localized: "\u0427\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0431\u0443\u0434\u0435\u0442
      \u0438\u0437-\u0437\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000111
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043B\u044E\u0434\u0438
      \u043F\u0440\u044F\u0447\u0443\u0442 \u043C\u0443\u043A\u0443. \u041F\u043E\u0442\u043E\u043C
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0441\u0447\u0438\u0442\u0430\u0442\u044C
      \u0447\u0443\u0436\u0438\u0435 \u043C\u0435\u0448\u043A\u0438. \u0415\u0441\u043B\u0438
      \u0434\u043E\u0439\u0434\u0451\u0442 \u0434\u043E \u044D\u0442\u043E\u0433\u043E,
      \u0441\u0442\u0440\u0430\u0436\u0430 \u0443\u0436\u0435 \u043D\u0438\u0447\u0435\u043C
      \u043D\u0435 \u043F\u043E\u043C\u043E\u0436\u0435\u0442. \u041F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0432\u0430\u0436\u043D\u0435\u0435,
      \u043A\u0442\u043E \u043F\u043E\u0434\u0435\u043B\u0438\u0442\u0441\u044F \u0432\u043E\u0434\u043E\u0439
      \u0438 \u0434\u0440\u043E\u0432\u0430\u043C\u0438, \u0447\u0435\u043C \u043A\u0442\u043E
      \u0433\u0440\u043E\u043C\u0447\u0435 \u043A\u0440\u0438\u0447\u0438\u0442 \u0443
      \u0432\u043E\u0440\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000112
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C
      \u043E\u0431 \u042D\u0440\u0434\u044D\u043D\u0435 \u0412\u0435\u043B\u043B\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000113
    m_Localized: "\u042F \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u044E \u0441\u0436\u0435\u0447\u044C
      \u0435\u0433\u043E \u0431\u0430\u0448\u043D\u044E \u0438 \u043D\u0435 \u0431\u043E\u044E\u0441\u044C
      \u0441\u043B\u043E\u0432\u0430 \xAB\u043C\u0430\u0433\xBB. \u042F \u0432\u0438\u0436\u0443
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u0440\u0438\u0432\u044B\u043A \u0441\u0447\u0438\u0442\u0430\u0442\u044C
      \u0447\u0443\u0436\u0443\u044E \u0436\u0438\u0437\u043D\u044C \u0447\u0430\u0441\u0442\u044C\u044E
      \u0440\u0430\u0441\u0447\u0451\u0442\u0430. \u0412\u043E\u0442 \u044D\u0442\u043E\u0433\u043E
      \u044F \u043D\u0435 \u043F\u0440\u0438\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000114
    m_Localized: "\u0422\u044B \u043E\u0441\u0443\u0436\u0434\u0430\u0435\u0448\u044C
      \u0442\u043E, \u0447\u0435\u0433\u043E \u0441\u0430\u043C \u043D\u0435 \u0437\u043D\u0430\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000115
    m_Localized: "\u042F \u0437\u043D\u0430\u044E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E:
      \u0437\u0430 \u0435\u0433\u043E \u0434\u0432\u0435\u0440\u044C\u044E \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u0441\u0442\u0440\u0430\u0445, \u0430 \u0441\u043D\u0430\u0440\u0443\u0436\u0438
      \u2014 \u043B\u044E\u0434\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u044D\u0442\u043E\u0442 \u0441\u0442\u0440\u0430\u0445 \u0434\u043E\u0441\u0442\u0430\u043B\u0441\u044F.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u043E\u043D \u043C\u043E\u0436\u0435\u0442
      \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435\u043C,
      \u043E\u0448\u0438\u0431\u043A\u043E\u0439 \u0438\u043B\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C\u044E.
      \u0411\u043E\u043B\u044C \u043E\u0442 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F
      \u043D\u0435 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000116
    m_Localized: "\u041E\u043D \u0431\u043E\u0438\u0442\u0441\u044F \u043C\u0435\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000117
    m_Localized: "\u041F\u0443\u0441\u0442\u044C \u0431\u043E\u0438\u0442\u0441\u044F.
      \u0421\u0442\u0440\u0430\u0445 \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u0435\u043C.
      \u041D\u043E \u043E\u043D \u0438 \u043D\u0435 \u0441\u0442\u0438\u0440\u0430\u0435\u0442
      \u0442\u043E, \u043E\u0442 \u0447\u0435\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0437\u0430\u043F\u0435\u0440\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000118
    m_Localized: "\u0422\u044B \u043D\u0435\u0434\u043E\u043B\u044E\u0431\u043B\u0438\u0432\u0430\u0435\u0448\u044C
      \u041C\u0435\u0439\u0440\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000119
    m_Localized: "\u042F \u043D\u0435\u0434\u043E\u043B\u044E\u0431\u043B\u0438\u0432\u0430\u044E,
      \u043A\u043E\u0433\u0434\u0430 \u0437\u0430 \u043D\u0443\u0436\u0434\u0443
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0431\u0435\u0440\u0443\u0442\u0441\u044F
      \u0431\u0435\u0437 \u043C\u0435\u0440\u044B. \u041D\u043E \u041C\u0435\u0439\u0440\u0430
      \u043A \u0431\u043E\u043B\u044C\u043D\u043E\u043C\u0443 \u043F\u043E\u0439\u0434\u0451\u0442
      \u0438 \u043D\u043E\u0447\u044C\u044E, \u0438 \u0432 \u0433\u0440\u044F\u0437\u044C.
      \u0417\u0430 \u044D\u0442\u043E \u044F \u0435\u0451 \u0443\u0432\u0430\u0436\u0430\u044E,
      \u0445\u043E\u0442\u044C \u043E\u043D\u0430 \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
      \u0441\u043A\u0430\u0436\u0435\u0442, \u0447\u0442\u043E \u0435\u0439 \u043C\u043E\u0451
      \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000120
    m_Localized: "\u041B\u044E\u0434\u0438 \u0435\u0439 \u0434\u043E\u0432\u0435\u0440\u044F\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000121
    m_Localized: "\u0418 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0434\u0435\u043B\u0430\u044E\u0442.
      \u0414\u043E\u0432\u0435\u0440\u0438\u0435 \u2014 \u043D\u0435 \u043D\u0430\u0433\u0440\u0430\u0434\u0430
      \u0437\u0430 \u0431\u0435\u0437\u043E\u0448\u0438\u0431\u043E\u0447\u043D\u043E\u0441\u0442\u044C.
      \u042D\u0442\u043E \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C:
      \u0442\u0435\u0431\u044F \u043D\u0435 \u0431\u0440\u043E\u0441\u044F\u0442,
      \u0435\u0441\u043B\u0438 \u0441\u0442\u0430\u043D\u0435\u0442 \u043F\u043B\u043E\u0445\u043E.
      \u041E\u043D\u0430 \u043D\u0435 \u0431\u0440\u043E\u0441\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000122
    m_Localized: "\u041D\u0435 \u0432\u0441\u044F\u043A\u0443\u044E \u0445\u0432\u043E\u0440\u044C
      \u043B\u0435\u0447\u0430\u0442 \u043C\u043E\u043B\u0438\u0442\u0432\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000123
    m_Localized: "\u041D\u0435 \u043B\u0435\u0447\u0430\u0442. \u042F \u0447\u0438\u0442\u0430\u044E
      \u043D\u0430\u0434 \u0443\u043C\u0438\u0440\u0430\u044E\u0449\u0438\u043C \u043D\u0435
      \u043F\u043E\u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u0434\u0443\u043C\u0430\u044E
      \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u044D\u0442\u0438\u043C \u0435\u0451
      \u0440\u0443\u043A\u0438. \u042F \u0447\u0438\u0442\u0430\u044E, \u0447\u0442\u043E\u0431\u044B
      \u043E\u043D \u043D\u0435 \u0443\u0445\u043E\u0434\u0438\u043B \u043E\u0434\u0438\u043D.
      \u041D\u0435 \u043F\u0443\u0442\u0430\u0439 \u0443\u0442\u0435\u0448\u0435\u043D\u0438\u0435
      \u0441 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000124
    m_Localized: "\u0427\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0441 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435\u0439
      \u0423\u043B\u044C\u0440\u0438\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000125
    m_Localized: "\u041F\u043E\u043A\u0430 \u043E\u043D\u0430 \u0441\u0442\u043E\u0438\u0442
      \u2014 \u0431\u0435\u0434\u0430 \u043E\u0434\u043D\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.
      \u0415\u0441\u043B\u0438 \u0432\u0441\u0442\u0430\u043D\u0435\u0442 \u043D\u0430\u0434\u043E\u043B\u0433\u043E
      \u2014 \u0431\u0435\u0434\u0430 \u0441\u0442\u0430\u043D\u0435\u0442 \u043E\u0431\u0449\u0435\u0439.
      \u0423\u043B\u044C\u0440\u0438\u043A \u044D\u0442\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442,
      \u0445\u043E\u0442\u044C \u043F\u0440\u0435\u0436\u0434\u0435 \u0435\u043C\u0443
      \u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C, \u043A\u043E\u0433\u0434\u0430
      \u043B\u044E\u0434\u0438 \u043F\u043E\u043C\u043D\u0438\u043B\u0438, \u043A\u043E\u043C\u0443
      \u043E\u0431\u044F\u0437\u0430\u043D\u044B \u0445\u043B\u0435\u0431\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000126
    m_Localized: "\u0427\u0442\u043E \u0441\u043A\u0430\u0436\u0435\u0448\u044C \u043E
      \u0442\u0430\u0432\u0435\u0440\u043D\u0435 \u0438 \u043F\u0440\u0438\u0435\u0437\u0436\u0438\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000127
    m_Localized: "\u0425\u0430\u043B\u044C\u0432\u0430\u0440 \u0434\u0430\u043B \u043B\u044E\u0434\u044F\u043C
      \u043A\u0440\u044B\u0448\u0443, \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u0440\u043E\u0442\u0430
      \u0437\u0430\u043A\u0440\u044B\u043B\u0438\u0441\u044C. \u0412 \u0442\u0430\u043A\u0443\u044E
      \u043F\u043E\u0440\u0443 \u044D\u0442\u043E \u0432\u0430\u0436\u043D\u0435\u0435,
      \u0447\u0435\u043C \u0442\u043E, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043A\u0440\u0443\u0436\u0435\u043A \u043E\u043D \u0438\u043C \u043D\u0430\u043B\u044C\u0451\u0442.
      \u0410 \u043F\u0440\u0438\u0435\u0437\u0436\u0438\u0435\u2026 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0436\u0434\u0451\u0442, \u043F\u043E\u043A\u0430 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0441\u043D\u043E\u0432\u0430 \u0441\u0442\u0430\u043D\u0435\u0442 \u0447\u0443\u0436\u043E\u0439
      \u0437\u0430\u0431\u043E\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000128
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000129
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000130
    m_Localized: "\u0415\u0441\u043B\u0438 \u0437\u0430 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E\u043C
      \u2014 \u0441\u043A\u0430\u0436\u0438, \u0447\u0442\u043E \u0431\u043E\u043B\u0438\u0442.
      \u0415\u0441\u043B\u0438 \u043F\u043E\u0431\u043E\u043B\u0442\u0430\u0442\u044C
      \u2014 \u043D\u0435 \u0441\u0442\u043E\u0439 \u0443 \u043A\u043E\u0440\u0437\u0438\u043D,
      \u0442\u0440\u0430\u0432\u044B \u043E\u0442 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u043E\u0432
      \u043D\u0435 \u0441\u0443\u0448\u0430\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000131
    m_Localized: "\u041A\u0430\u043A \u0442\u044B \u043B\u0435\u0447\u0438\u0448\u044C
      \u043B\u044E\u0434\u0435\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000132
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u043B\u0443\u0448\u0430\u044E.
      \u041F\u043E\u0442\u043E\u043C \u0441\u043C\u043E\u0442\u0440\u044E \u043D\u0430
      \u0440\u0443\u043A\u0438, \u0433\u043B\u0430\u0437\u0430, \u0434\u044B\u0445\u0430\u043D\u0438\u0435.
      \u0423\u0436\u0435 \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E
      \u0434\u043E\u0441\u0442\u0430\u044E \u0442\u0440\u0430\u0432\u044B. \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
      \u0445\u043E\u0447\u0435\u0442 \u043D\u0430\u043E\u0431\u043E\u0440\u043E\u0442:
      \u0432\u044B\u043F\u0438\u0442\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0438 \u043D\u0435 \u0434\u0443\u043C\u0430\u0442\u044C, \u043F\u043E\u0447\u0435\u043C\u0443
      \u0438\u0445 \u0441\u043A\u0440\u0443\u0442\u0438\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000133
    m_Localized: "\u0422\u044B \u0441\u0430\u043C\u0430 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C
      \u0432\u0441\u0435 \u0442\u0440\u0430\u0432\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000134
    m_Localized: "\u0427\u0442\u043E \u043C\u043E\u0433\u0443 \u2014 \u0441\u0430\u043C\u0430.
      \u041D\u043E \u043D\u0435 \u0432\u0441\u0451, \u0447\u0442\u043E \u0440\u0430\u0441\u0442\u0451\u0442,
      \u043C\u043E\u0436\u043D\u043E \u0442\u0430\u0449\u0438\u0442\u044C \u0432
      \u043E\u0442\u0432\u0430\u0440. \u0418 \u043D\u0435 \u0432\u0441\u0451, \u0447\u0442\u043E
      \u0441\u043E\u0440\u0432\u0430\u043B\u0438, \u0433\u043E\u0434\u0438\u0442\u0441\u044F.
      \u0426\u0432\u0435\u0442\u043E\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u0440\u043E\u043B\u0435\u0436\u0430\u043B \u0432 \u043C\u043E\u043A\u0440\u043E\u0439
      \u0441\u0443\u043C\u043A\u0435 \u0434\u0435\u043D\u044C, \u043B\u0435\u0447\u0438\u0442
      \u0440\u0430\u0437\u0432\u0435 \u0447\u0442\u043E \u0447\u044C\u044E-\u0442\u043E
      \u0441\u043E\u0432\u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000135
    m_Localized: "\u041A\u0430\u043A \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u043F\u043E\u0432\u043B\u0438\u044F\u043B\u0438
      \u043D\u0430 \u0442\u0435\u0431\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000136
    m_Localized: "\u041F\u043E\u043A\u0430 \u043B\u044E\u0434\u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u044B
      \u2014 \u043F\u043E\u0447\u0442\u0438 \u043D\u0438\u043A\u0430\u043A. \u0410
      \u043F\u043E\u0442\u043E\u043C \u0432 \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C
      \u0443 \u0442\u0440\u043E\u0438\u0445 \u0436\u0430\u0440, \u0443 \u0440\u0435\u0431\u0451\u043D\u043A\u0430
      \u043A\u0430\u0448\u0435\u043B\u044C, \u0438 \u0432\u044B\u044F\u0441\u043D\u044F\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u043D\u0430\u0441\u0442\u043E\u0439
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043D\u0430 \u0434\u043E\u043D\u044B\u0448\u043A\u0435.
      \u0412\u043E\u0440\u043E\u0442\u0430 \u043D\u0435 \u0434\u0435\u043B\u0430\u044E\u0442
      \u043B\u044E\u0434\u0435\u0439 \u0431\u043E\u043B\u044C\u043D\u044B\u043C\u0438.
      \u041E\u043D\u0438 \u043D\u0435 \u0434\u0430\u044E\u0442 \u0432\u043E\u0432\u0440\u0435\u043C\u044F
      \u0434\u043E\u0441\u0442\u0430\u0442\u044C \u0442\u043E, \u0447\u0442\u043E
      \u0438\u0445 \u043B\u0435\u0447\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000137
    m_Localized: "\u0427\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u0441 \u043E\u0442\u0446\u043E\u043C
      \u041A\u0430\u0434\u043C\u043E\u043D\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000138
    m_Localized: "\u041E\u043D \u0441\u0447\u0438\u0442\u0430\u0435\u0442, \u0447\u0442\u043E
      \u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0447\u0430\u0441\u0442\u043E
      \u043B\u0435\u0437\u0443 \u0442\u0443\u0434\u0430, \u0433\u0434\u0435 \u043C\u043E\u0436\u043D\u043E
      \u043D\u0430\u0432\u0440\u0435\u0434\u0438\u0442\u044C. \u042F \u0441\u0447\u0438\u0442\u0430\u044E,
      \u0447\u0442\u043E \u043E\u043D \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0434\u043E\u043B\u0433\u043E \u0436\u0434\u0451\u0442, \u043F\u043E\u043A\u0430
      \u0432\u0441\u0451 \u0441\u0442\u0430\u043D\u0435\u0442 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u043C.
      \u0410 \u0431\u043E\u043B\u044C\u043D\u043E\u043C\u0443 \u0432\u0441\u0451
      \u0440\u0430\u0432\u043D\u043E, \u043A\u0430\u043A \u044D\u0442\u043E \u043D\u0430\u0437\u0432\u0430\u0442\u044C,
      \u2014 \u0435\u043C\u0443 \u0431\u044B \u0434\u043E \u0443\u0442\u0440\u0430
      \u0434\u043E\u0436\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000139
    m_Localized: "\u041D\u043E \u043E\u043D \u043F\u0440\u0430\u0432: \u043B\u0435\u0447\u0435\u043D\u0438\u0435
      \u2014 \u044D\u0442\u043E \u0440\u0438\u0441\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000140
    m_Localized: "\u041F\u0440\u0430\u0432. \u041F\u043E\u044D\u0442\u043E\u043C\u0443
      \u044F \u043D\u0435 \u043E\u0431\u0435\u0449\u0430\u044E \u0447\u0443\u0434\u0435\u0441
      \u0438 \u043D\u0435 \u0441\u0443\u044E \u043D\u0430\u0441\u0442\u043E\u0439
      \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u043F\u043E\u0434\u0440\u044F\u0434.
      \u0422\u043E\u043B\u044C\u043A\u043E \u043E\u0442\u043A\u0430\u0437 \u0442\u043E\u0436\u0435
      \u0440\u0438\u0441\u043A. \u041A\u0430\u0434\u043C\u043E\u043D \u044D\u0442\u043E
      \u0437\u043D\u0430\u0435\u0442 \u2014 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0435\u043C\u0443 \u043B\u0435\u0433\u0447\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u043E \u043D\u0451\u043C \u043F\u043E\u0441\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000141
    m_Localized: "\u041E\u043D \u0432\u0441\u0451 \u0436\u0435 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0441 \u043B\u044E\u0434\u044C\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000142
    m_Localized: "\u041E\u0441\u0442\u0430\u0451\u0442\u0441\u044F. \u041A\u043E\u0433\u0434\u0430
      \u0443 \u043C\u0435\u043D\u044F \u0440\u0443\u043A\u0438 \u0437\u0430\u043D\u044F\u0442\u044B,
      \u043E\u043D \u043D\u043E\u0441\u0438\u0442 \u0432\u043E\u0434\u0443, \u0434\u0435\u0440\u0436\u0438\u0442
      \u0441\u0432\u0435\u0442, \u0441\u0438\u0434\u0438\u0442 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0442\u0435\u043C\u0438, \u043A\u043E\u0433\u043E \u0443\u0436\u0435
      \u043D\u0435 \u0441\u043F\u0430\u0441\u0442\u0438. \u041D\u0435 \u0432\u0441\u0451
      \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u043B\u0435\u0447\u0438\u0442\u044C.
      \u041D\u0435 \u0432\u0441\u0451 \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0441\u0442\u043E\u0438\u0442 \u0431\u0440\u043E\u0441\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000143
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C
      \u043E\u0431 \u042D\u0440\u0434\u044D\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000144
    m_Localized: "\u041E\u043D \u0443\u043C\u0435\u0435\u0442 \u0432\u0438\u0434\u0435\u0442\u044C
      \u0432 \u0442\u0435\u043B\u0435 \u0432\u0435\u0449\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u044F \u043D\u0435 \u0443\u0432\u0438\u0436\u0443, \u0445\u043E\u0442\u044C
      \u0432\u0441\u044E \u043D\u043E\u0447\u044C \u043F\u0440\u043E\u0441\u0438\u0436\u0443
      \u0443 \u043F\u043E\u0441\u0442\u0435\u043B\u0438. \u042D\u0442\u043E \u0440\u0435\u0434\u043A\u043E\u0435
      \u0443\u043C\u0435\u043D\u0438\u0435. \u0418 \u043E\u043F\u0430\u0441\u043D\u043E\u0435,
      \u043A\u043E\u0433\u0434\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0437\u0430\u0431\u044B\u0432\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C \u043D\u0435
      \u0437\u0430\u0434\u0430\u0447\u0430, \u0430 \u0436\u0438\u0432\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000145
    m_Localized: "\u041E\u043D \u0437\u0430\u043F\u0435\u0440\u0441\u044F \u043E\u0442
      \u0441\u0442\u0440\u0430\u0445\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000146
    m_Localized: "\u0414\u0430. \u0418 \u044F \u043D\u0435 \u0441\u0442\u0430\u043D\u0443
      \u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0438\u0434, \u0447\u0442\u043E
      \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E \u044D\u0442\u043E\u0433\u043E
      \u0441\u0442\u0440\u0430\u0445\u0430. \u041D\u043E \u0435\u0441\u043B\u0438
      \u0443\u043C\u0435\u0435\u0448\u044C \u043F\u043E\u043C\u043E\u0447\u044C \u0438
      \u0441\u0438\u0434\u0438\u0448\u044C \u0437\u0430 \u0434\u0432\u0435\u0440\u044C\u044E,
      \u0441\u0442\u0440\u0430\u0445 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u043B\u043E\u0436\u0438\u0442\u0441\u044F \u043D\u0430 \u0442\u0435\u0445,
      \u043A\u043E\u043C\u0443 \u0442\u044B \u043D\u0435 \u0432\u044B\u0448\u0435\u043B
      \u043F\u043E\u043C\u043E\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000147
    m_Localized: "\u0422\u044B \u0431\u044B \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0430
      \u0435\u0433\u043E \u043B\u0435\u0447\u0438\u0442\u044C \u043B\u044E\u0434\u0435\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000148
    m_Localized: "\u041D\u0435 \u043F\u0440\u043E\u0441\u0438\u043B\u0430 \u0431\u044B.
      \u041F\u043E\u043C\u043E\u0449\u044C, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u0438\u0437 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0432\u044B\u0442\u044F\u0433\u0438\u0432\u0430\u044E\u0442,
      \u043F\u043E\u0442\u043E\u043C \u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0441\u0447\u0451\u0442. \u041B\u0443\u0447\u0448\u0435 \u044F \u0441\u0434\u0435\u043B\u0430\u044E,
      \u0447\u0442\u043E \u0443\u043C\u0435\u044E. \u0410 \u043E\u043D \u043F\u0443\u0441\u0442\u044C
      \u043E\u0434\u043D\u0430\u0436\u0434\u044B \u0441\u0430\u043C \u0440\u0435\u0448\u0438\u0442,
      \u043A\u0435\u043C \u0431\u044B\u0442\u044C \u0437\u0430 \u044D\u0442\u043E\u0439
      \u0434\u0432\u0435\u0440\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000149
    m_Localized: "\u0427\u0442\u043E \u0441\u043B\u044B\u0448\u043D\u043E \u043E
      \u0442\u0430\u0432\u0435\u0440\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000150
    m_Localized: "\u0422\u0430\u043C \u0442\u0435\u0441\u043D\u043E, \u0448\u0443\u043C\u043D\u043E
      \u0438 \u0432\u0441\u0435 \u0434\u0435\u043B\u0430\u044E\u0442 \u0432\u0438\u0434,
      \u0447\u0442\u043E \u0437\u043D\u0430\u044E\u0442, \u043A\u043E\u0433\u0434\u0430
      \u043E\u0442\u043A\u0440\u043E\u044E\u0442 \u0432\u043E\u0440\u043E\u0442\u0430.
      \u0425\u0430\u043B\u044C\u0432\u0430\u0440 \u043A\u043E\u0440\u043C\u0438\u0442
      \u043F\u0440\u0438\u0435\u0437\u0436\u0438\u0445, \u043F\u043E\u043A\u0430
      \u043C\u043E\u0436\u0435\u0442. \u0410 \u041B\u0438\u0432\u0438\u043E \u0443\u0436\u0435
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442, \u043A\u0442\u043E \u0438\u0437
      \u043D\u0438\u0445 \u043F\u0435\u0440\u0432\u044B\u043C \u0440\u0435\u0448\u0438\u0442
      \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000151
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000152
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000153
    m_Localized: "\u0415\u0441\u043B\u0438 \u0437\u0430 \u043C\u044F\u0441\u043E\u043C
      \u2014 \u043F\u043E\u0437\u0434\u043D\u043E, \u0432\u0441\u0451 \u0443\u0436\u0435
      \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043B\u0438. \u0415\u0441\u043B\u0438
      \u0432 \u043B\u0435\u0441 \u2014 \u0441\u043C\u043E\u0442\u0440\u0438 \u043F\u043E\u0434
      \u043D\u043E\u0433\u0438 \u0438 \u0441\u043B\u0443\u0448\u0430\u0439. \u042D\u0442\u043E\u0433\u043E
      \u043E\u0431\u044B\u0447\u043D\u043E \u0445\u0432\u0430\u0442\u0430\u0435\u0442,
      \u0447\u0442\u043E\u0431\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000154
    m_Localized: "\u0422\u044B \u0434\u0430\u0432\u043D\u043E \u043E\u0445\u043E\u0442\u0438\u0448\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000155
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u043B\u0435\u0441
      \u0441\u0432\u043E\u0438\u043C. \u0417\u0432\u0435\u0440\u044C \u0442\u0435\u0440\u043F\u0438\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043F\u043E\u043A\u0430
      \u0442\u043E\u0442 \u043D\u0435 \u0448\u0443\u043C\u0438\u0442, \u043D\u0435
      \u0436\u0430\u0434\u043D\u0438\u0447\u0430\u0435\u0442 \u0438 \u0437\u043D\u0430\u0435\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u0443\u0439\u0442\u0438. \u041B\u044E\u0434\u0438
      \u0441 \u044D\u0442\u0438\u043C \u0445\u0443\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000156
    m_Localized: "\u0427\u0442\u043E \u0442\u0432\u043E\u0440\u0438\u0442\u0441\u044F
      \u0432 \u043B\u0435\u0441\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000157
    m_Localized: "\u041C\u0435\u043D\u044C\u0448\u0435 \u0437\u0432\u0435\u0440\u044F
      \u0443 \u0434\u043E\u0440\u043E\u0433\u0438. \u0411\u043E\u043B\u044C\u0448\u0435
      \u0434\u044B\u043C\u0430, \u0441\u0432\u0435\u0436\u0438\u0445 \u043F\u043D\u0435\u0439
      \u0438 \u0441\u043B\u0435\u0434\u043E\u0432 \u0432 \u0441\u0430\u043F\u043E\u0433\u0430\u0445.
      \u041E\u043B\u0435\u043D\u0438 \u0443\u0448\u043B\u0438 \u0433\u043B\u0443\u0431\u0436\u0435,
      \u043F\u0442\u0438\u0446\u044B \u043C\u043E\u043B\u0447\u0430\u0442 \u0443
      \u0441\u0442\u0430\u0440\u043E\u0439 \u0442\u0440\u043E\u043F\u044B. \u041B\u0435\u0441
      \u043D\u0435 \u043F\u0443\u0433\u0430\u0435\u0442\u0441\u044F. \u041E\u043D
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u043D\u0430\u0435\u0442, \u0433\u0434\u0435
      \u043D\u0435 \u0441\u0442\u043E\u0438\u0442 \u0431\u044B\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000158
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0441\u0430\u043C
      \u043D\u0435 \u043F\u0440\u043E\u0433\u043E\u043D\u0438\u0448\u044C \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000159
    m_Localized: "\u041E\u0434\u0438\u043D \u043E\u0445\u043E\u0442\u043D\u0438\u043A
      \u043C\u043E\u0436\u0435\u0442 \u0441\u043D\u044F\u0442\u044C \u0447\u0430\u0441\u043E\u0432\u043E\u0433\u043E.
      \u041B\u0430\u0433\u0435\u0440\u044C \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E
      \u043F\u0440\u0438\u0448\u043B\u0451\u0442 \u0434\u0440\u0443\u0433\u0438\u0445.
      \u042F \u0434\u043E\u0431\u044B\u0432\u0430\u044E \u0435\u0434\u0443, \u043D\u0435
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E \u0432\u043E\u0439\u043D\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0434\u0435\u0440\u0435\u0432\u043D\u044F
      \u043F\u043E\u0442\u043E\u043C \u0431\u0443\u0434\u0435\u0442 \u0434\u043E\u0435\u0434\u0430\u0442\u044C
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0437\u0430\u043F\u0430\u0441\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000160
    m_Localized: "\u0414\u043B\u044F \u0442\u0435\u0431\u044F \u0431\u0430\u043D\u0434\u0438\u0442\u044B
      \u2014 \u043D\u0435 \u0434\u043E\u0431\u044B\u0447\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000161
    m_Localized: "\u0414\u043E\u0431\u044B\u0447\u0430 \u043D\u0435 \u0441\u0442\u0430\u0432\u0438\u0442
      \u043A\u0430\u0440\u0430\u0443\u043B \u0438 \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442
      \u043C\u0441\u0442\u0438\u0442\u044C \u043A \u0434\u043E\u043C\u0443. \u0421
      \u0432\u043E\u043B\u043A\u043E\u043C \u0432\u0441\u0451 \u043F\u0440\u043E\u0449\u0435:
      \u043E\u043D \u0433\u043E\u043B\u043E\u0434\u0435\u043D, \u0442\u044B \u0442\u043E\u0436\u0435.
      \u0421 \u043B\u044E\u0434\u044C\u043C\u0438 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043D\u0430\u0434\u043E \u043F\u043E\u043D\u044F\u0442\u044C, \u0447\u0435\u0433\u043E
      \u043E\u043D\u0438 \u0445\u043E\u0442\u044F\u0442. \u041F\u043E\u0442\u043E\u043C
      \u0443\u0436\u0435 \u0442\u044F\u043D\u0443\u0442\u044C\u0441\u044F \u043A
      \u043B\u0443\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000162
    m_Localized: "\u041A\u0430\u043A \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u043C\u0435\u043D\u044F\u044E\u0442 \u043E\u0445\u043E\u0442\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000163
    m_Localized: "\u041B\u044E\u0434\u0435\u0439 \u0432 \u043B\u0435\u0441\u0443
      \u0441\u0442\u0430\u043D\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435.
      \u041E\u0434\u043D\u0438 \u043F\u043E\u0439\u0434\u0443\u0442 \u0437\u0430
      \u043C\u044F\u0441\u043E\u043C, \u0434\u0440\u0443\u0433\u0438\u0435 \u2014
      \u0437\u0430 \u0447\u0443\u0436\u0438\u043C \u043C\u044F\u0441\u043E\u043C.
      \u041A\u043E\u0433\u0434\u0430 \u0435\u0434\u044B \u043C\u0430\u043B\u043E,
      \u0441\u043B\u0435\u0434\u043E\u0432 \u043C\u043D\u043E\u0433\u043E, \u0430
      \u0437\u0432\u0435\u0440\u044F \u043C\u0435\u043D\u044C\u0448\u0435. \u042F
      \u0431\u0435\u0440\u0443 \u0440\u043E\u0432\u043D\u043E \u0441\u0442\u043E\u043B\u044C\u043A\u043E,
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043E\u043D\u0435\u0441\u0443
      \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000164
    m_Localized: "\u0427\u0442\u043E \u0441\u043A\u0430\u0436\u0435\u0448\u044C \u043E
      \u041C\u0435\u0439\u0440\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000165
    m_Localized: "\u041E\u043D\u0430 \u0437\u043D\u0430\u0435\u0442, \u043A\u0430\u043A\u0443\u044E
      \u0447\u0430\u0441\u0442\u044C \u0437\u0432\u0435\u0440\u044F \u0441\u0443\u0448\u0438\u0442\u044C,
      \u0430 \u043A\u0430\u043A\u0443\u044E \u0431\u0440\u043E\u0441\u0430\u0442\u044C.
      \u0418 \u043D\u0435 \u0433\u043D\u0443\u0448\u0430\u0435\u0442\u0441\u044F
      \u0441\u043B\u0443\u0448\u0430\u0442\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0433\u043E\u0432\u043E\u0440\u044E, \u0433\u0434\u0435 \u0432\u043E\u0434\u0430
      \u043C\u0443\u0442\u043D\u0430\u044F \u0438\u043B\u0438 \u0441\u043B\u0435\u0434\u044B
      \u0431\u043E\u043B\u044C\u043D\u044B\u0435. \u0423\u043C\u043D\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0442
      \u0432\u0438\u0434, \u0447\u0442\u043E \u0432\u0441\u0451 \u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000166
    m_Localized: "\u0427\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0441 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435\u0439
      \u0423\u043B\u044C\u0440\u0438\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000167
    m_Localized: "\u0411\u0435\u0437 \u043C\u0443\u043A\u0438 \u043E\u0445\u043E\u0442\u0430
      \u043D\u0435 \u0441\u043F\u0430\u0441\u0451\u0442 \u0434\u0435\u0440\u0435\u0432\u043D\u044E.
      \u041C\u044F\u0441\u043E \u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u043E,
      \u0435\u0441\u043B\u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u0440\u0435\u0448\u0438\u0442,
      \u0447\u0442\u043E \u0435\u043C\u0443 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E
      \u0431\u043E\u043B\u044C\u0448\u0435. \u0423\u043B\u044C\u0440\u0438\u043A
      \u044D\u0442\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442. \u041F\u043E\u043D\u044F\u043B
      \u0431\u044B \u0435\u0449\u0451, \u0447\u0442\u043E \u0445\u043B\u0435\u0431
      \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0442 \u0435\u0433\u043E \u0432\u0430\u0436\u043D\u0435\u0435
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445 \u2014 \u0446\u0435\u043D\u044B
      \u0431\u044B \u0435\u043C\u0443 \u043D\u0435 \u0431\u044B\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000168
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000169
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000170
    m_Localized: "\u0421\u0440\u0430\u0437\u0443 \u0441\u043A\u0430\u0436\u0438,
      \u0447\u0442\u043E \u0441\u043B\u043E\u043C\u0430\u043B\u043E\u0441\u044C.
      \u041A\u043E\u0433\u0434\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430, \u043E\u0431\u044B\u0447\u043D\u043E
      \u0432\u044B\u044F\u0441\u043D\u044F\u0435\u0442\u0441\u044F: \u043E\u043D
      \u0431\u0438\u043B \u043F\u043E \u043A\u0430\u043C\u043D\u044E, \u0430 \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u043E
      \u0436\u0435\u043B\u0435\u0437\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000171
    m_Localized: "\u0422\u044B \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B
      \u043A\u0443\u0437\u043D\u0435\u0446\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000172
    m_Localized: "\u041D\u0435\u0442. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u0442\u0430\u0441\u043A\u0430\u043B \u0443\u0433\u043E\u043B\u044C \u0438
      \u043A\u0430\u0447\u0430\u043B \u043C\u0435\u0445\u0430 \u0443 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u043C\u0430\u0441\u0442\u0435\u0440\u0430. \u041F\u043E\u0442\u043E\u043C
      \u043E\u043D \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B \u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043A\u043B\u0435\u0449\u0438, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
      \u0440\u0443\u043A\u0438 \u0443 \u043D\u0435\u0433\u043E \u0441\u0442\u0430\u043B\u0438
      \u0434\u0440\u043E\u0436\u0430\u0442\u044C. \u041A\u0443\u0437\u043D\u0435\u0446\u043E\u043C
      \u043C\u0435\u043D\u044F \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u043D\u0435
      \u043C\u043E\u043B\u043E\u0442\u044B \u2014 \u043B\u044E\u0434\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0447\u0438\u043D\u0438\u0442\u044C
      \u0442\u043E, \u0447\u0442\u043E \u043E\u043D\u0438 \u0443\u0441\u043F\u0435\u043B\u0438
      \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000173
    m_Localized: "\u0427\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043D\u044F\u0442\u044C
      \u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0435 \u043F\u043E \u0435\u0433\u043E
      \u043E\u0440\u0443\u0436\u0438\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000174
    m_Localized: "\u041D\u0435 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E
      \u043E\u0440\u0443\u0436\u0438\u044E, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E \u0442\u043E\u043C\u0443, \u043A\u0430\u043A \u043E\u043D \u0437\u0430
      \u043D\u0438\u043C \u0441\u043B\u0435\u0434\u0438\u0442. \u0427\u0438\u0441\u0442\u044B\u0439
      \u043A\u043B\u0438\u043D\u043E\u043A \u0431\u044B\u0432\u0430\u0435\u0442 \u0443
      \u0442\u0440\u0443\u0441\u0430 \u0438 \u0443 \u0433\u0435\u0440\u043E\u044F.
      \u0410 \u0440\u0443\u043A\u043E\u044F\u0442\u044C, \u0437\u0430\u043C\u043E\u0442\u0430\u043D\u043D\u0430\u044F
      \u043F\u043E\u043B\u043E\u0441\u043E\u0439 \u0441\u0442\u0430\u0440\u043E\u0439
      \u0440\u0443\u0431\u0430\u0445\u0438, \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443 \u0441\u0435\u0439\u0447\u0430\u0441
      \u043D\u0435 \u0434\u043E \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u043D\u043E\u0432\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000175
    m_Localized: "\u0422\u044B \u0436\u0430\u043B\u0435\u0435\u0448\u044C \u0442\u0430\u043A\u0438\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000176
    m_Localized: "\u0416\u0430\u043B\u043E\u0441\u0442\u044C \u0436\u0435\u043B\u0435\u0437\u043E
      \u043D\u0435 \u0447\u0438\u043D\u0438\u0442. \u0415\u0441\u043B\u0438 \u043C\u043E\u0433\u0443
      \u2014 \u0441\u0434\u0435\u043B\u0430\u044E \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B
      \u0432\u0435\u0449\u044C \u043F\u0440\u043E\u0436\u0438\u043B\u0430 \u0435\u0449\u0451
      \u0441\u0435\u0437\u043E\u043D. \u041F\u043E\u0442\u043E\u043C \u043F\u0443\u0441\u0442\u044C
      \u0440\u0435\u0448\u0430\u044E\u0442, \u043A\u0443\u0434\u0430 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C
      \u0434\u0435\u043D\u044C\u0433\u0438: \u043D\u0430 \u0440\u0443\u043A\u043E\u044F\u0442\u044C,
      \u0441\u0430\u043F\u043E\u0433\u0438 \u0438\u043B\u0438 \u0435\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000177
    m_Localized: "\u0410 \u0435\u0441\u043B\u0438 \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442
      \u043E\u0440\u0443\u0436\u0438\u0435 \u0434\u043B\u044F \u043F\u043B\u043E\u0445\u043E\u0433\u043E
      \u0434\u0435\u043B\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000178
    m_Localized: "\u042F \u043D\u0435 \u0441\u0443\u0434\u044C\u044F. \u041D\u043E
      \u044F \u0438 \u043D\u0435 \u0441\u043B\u0435\u043F\u043E\u0439. \u0415\u0441\u043B\u0438
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u0440\u043E\u0441\u0438\u0442
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043D\u043E\u0436 \u0443\u0434\u043E\u0431\u043D\u0435\u0435
      \u0434\u043B\u044F \u0434\u0440\u0430\u043A\u0438 \u0441 \u0441\u043E\u0441\u0435\u0434\u043E\u043C
      \u2014 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E \u0435\u0433\u043E
      \u043E\u0441\u0442\u044B\u0442\u044C. \u0415\u0441\u043B\u0438 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u043C, \u0433\u043E\u0432\u043E\u0440\u0438\u043C
      \u043E \u0440\u0430\u0431\u043E\u0442\u0435. \u0415\u0441\u043B\u0438 \u043D\u0435\u0442
      \u2014 \u043F\u0443\u0441\u0442\u044C \u0438\u0449\u0435\u0442 \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u043C\u0430\u0441\u0442\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000179
    m_Localized: "\u041A\u0430\u043A \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0443\u0434\u0430\u0440\u0438\u043B\u0438
      \u043F\u043E \u043A\u0443\u0437\u043D\u0438\u0446\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000180
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u0441\u0435 \u0434\u0443\u043C\u0430\u043B\u0438,
      \u0447\u0442\u043E \u0441\u0442\u0430\u043B\u0438 \u043C\u0435\u043D\u044C\u0448\u0435
      \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C. \u0412\u044B\u0448\u043B\u043E
      \u043D\u0430\u043E\u0431\u043E\u0440\u043E\u0442: \u043D\u043E\u0432\u043E\u0435
      \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442, \u0441\u0442\u0430\u0440\u043E\u0435
      \u043D\u0435\u0441\u0443\u0442 \u0447\u0438\u043D\u0438\u0442\u044C. \u0413\u0432\u043E\u0437\u0434\u0438
      \u0432\u044B\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442 \u043F\u043E \u0434\u0432\u0430
      \u0440\u0430\u0437\u0430, \u0442\u043E\u043F\u043E\u0440\u044B \u0442\u043E\u0447\u0430\u0442
      \u0434\u043E \u0443\u0437\u043A\u043E\u0433\u043E \u0437\u0443\u0431\u0430.
      \u0425\u0443\u0436\u0435 \u0432\u0441\u0435\u0433\u043E \u043D\u0435 \u043D\u0435\u0445\u0432\u0430\u0442\u043A\u0430
      \u0436\u0435\u043B\u0435\u0437\u0430 \u2014 \u043D\u0435\u0445\u0432\u0430\u0442\u043A\u0430
      \u0442\u043E\u0433\u043E, \u0447\u0435\u043C \u0442\u043E\u043F\u0438\u0442\u044C
      \u0433\u043E\u0440\u043D. \u0411\u0435\u0437 \u0436\u0430\u0440\u0430 \u043B\u044E\u0431\u0430\u044F
      \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043A\u0443\u0441\u043E\u043A \u0437\u0430\u0431\u043E\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000181
    m_Localized: "\u0427\u0442\u043E \u0441\u043A\u0430\u0436\u0435\u0448\u044C \u043E
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0441\u0442\u0440\u0430\u0436\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000182
    m_Localized: "\u0418\u0445 \u0441\u0442\u0430\u043B\u044C \u0432\u0438\u0436\u0443
      \u0447\u0430\u0449\u0435, \u0447\u0435\u043C \u0438\u0445 \u043B\u0438\u0446\u0430.
      \u041F\u0440\u0438\u043D\u043E\u0441\u044F\u0442 \u0449\u0438\u0442\u044B \u0441
      \u0442\u0440\u0435\u0449\u0438\u043D\u0430\u043C\u0438, \u043F\u0440\u044F\u0436\u043A\u0438,
      \u043D\u043E\u0436\u043D\u044B \u2014 \u0438 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0440\u0430\u0437 \u0433\u043E\u0432\u043E\u0440\u044F\u0442: \xAB\u0441\u0440\u043E\u0447\u043D\u043E\xBB.
      \u0420\u0430\u0431\u043E\u0442\u0430 \u0443 \u043D\u0438\u0445 \u0442\u0430\u043A\u0430\u044F.
      \u041C\u043E\u0451 \u0434\u0435\u043B\u043E \u2014 \u043D\u0435 \u0433\u0430\u0434\u0430\u0442\u044C,
      \u043E\u0442 \u043A\u043E\u0433\u043E \u043E\u043D\u0438 \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0438
      \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C \u0433\u043E\u0440\u043E\u0434,
      \u0430 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B
      \u0437\u0430\u0441\u0442\u0451\u0436\u043A\u0430 \u043D\u0435 \u043F\u043E\u0434\u0432\u0435\u043B\u0430
      \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000183
    m_Localized: "\u041A\u0430\u043A \u0442\u044B \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C
      \u043D\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u044E \u0441 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435\u0439
      \u0423\u043B\u044C\u0440\u0438\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000184
    m_Localized: "\u041F\u043B\u043E\u0445\u043E. \u041D\u0435 \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u0423\u043B\u044C\u0440\u0438\u043A \u0441\u0432\u044F\u0442\u043E\u0439
      \u2014 \u043E\u043D \u0442\u043E\u0440\u0433\u0443\u0435\u0442\u0441\u044F
      \u0437\u0430 \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u043A\u043E\u0431\u0443.
      \u041D\u043E \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u043A\u043E\u0440\u043C\u0438\u0442
      \u0442\u0435\u0445, \u043A\u0442\u043E \u0441 \u043D\u0438\u043C \u043D\u0435
      \u0441\u043F\u043E\u0440\u0438\u043B. \u041A\u043E\u0433\u0434\u0430 \u0441\u043F\u043E\u0440
      \u043E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u0438\u0434\u0451\u0442 \u0447\u0435\u0440\u0435\u0437 \u0433\u043E\u043B\u043E\u0434,
      \u044D\u0442\u043E \u0443\u0436\u0435 \u043D\u0435 \u0441\u043F\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000185
    m_Localized: "\u0422\u044B \u0447\u0430\u0441\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C
      \u0441 \u041C\u0435\u0439\u0440\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000186
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430. \u0415\u0439 \u043D\u0443\u0436\u043D\u044B
      \u0447\u0438\u0441\u0442\u044B\u0435 \u0438\u0433\u043B\u044B, \u043A\u0440\u044E\u0447\u043A\u0438,
      \u043A\u043E\u0442\u0435\u043B\u043A\u0438, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u0442\u0435\u043A\u043B\u0438. \u041E\u043D\u0430 \u043F\u043B\u0430\u0442\u0438\u0442
      \u0432\u043E\u0432\u0440\u0435\u043C\u044F \u0438 \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u0442
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0435.
      \u0417\u0430 \u044D\u0442\u043E \u044F \u0433\u043E\u0442\u043E\u0432 \u0441\u043B\u0443\u0448\u0430\u0442\u044C
      \u043F\u0440\u043E \u0442\u0440\u0430\u0432\u044B, \u0434\u0430\u0436\u0435
      \u0435\u0441\u043B\u0438 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0439
      \u0437\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A \u043D\u0430\u0441\u043C\u0435\u0448\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000187
    m_Localized: "\u0427\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u043C\u043E\u0436\u043D\u043E
      \u043A\u0443\u043F\u0438\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000188
    m_Localized: "\u0422\u043E, \u0447\u0442\u043E \u043D\u0435 \u043F\u043E\u0434\u0432\u0435\u0434\u0451\u0442
      \u0441\u0440\u0430\u0437\u0443. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u043F\u043E\u043A\u0430\u0436\u0435\u0442 \u0432\u0440\u0435\u043C\u044F.
      \u0421\u043C\u043E\u0442\u0440\u0438 \u0442\u043E\u0432\u0430\u0440 \u0441\u0430\u043C
      \u2014 \u0440\u0443\u0433\u0430\u0442\u044C \u0435\u0433\u043E \u0434\u043E
      \u0441\u0434\u0435\u043B\u043A\u0438 \u043D\u0435 \u0441\u0442\u0430\u043D\u0443
      \u0438 \u0440\u0430\u0441\u0445\u0432\u0430\u043B\u0438\u0432\u0430\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000189
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000190
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000191
    m_Localized: "\u0415\u0441\u043B\u0438 \u0438\u0449\u0435\u0448\u044C \u043A\u043E\u0433\u043E-\u0442\u043E,
      \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439 \u043F\u0440\u044F\u043C\u043E.
      \u0421\u0435\u0439\u0447\u0430\u0441 \u043B\u044E\u0434\u0438 \u0438 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
      \u0434\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u043D\u0435 \u0432\u0441\u044F\u043A\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000192
    m_Localized: "\u0427\u0435\u043C \u0442\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000193
    m_Localized: "\u0422\u0435\u043C, \u0447\u0442\u043E \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0443\u0436\u043D\u0435\u0435 \u0432\u0441\u0435\u0433\u043E \u043A
      \u0432\u0435\u0447\u0435\u0440\u0443: \u043D\u043E\u0448\u0443 \u0432\u043E\u0434\u0443,
      \u043F\u043E\u043C\u043E\u0433\u0430\u044E \u0441 \u0435\u0434\u043E\u0439,
      \u043F\u0440\u0438\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E \u0437\u0430
      \u0434\u043E\u043C\u043E\u043C, \u043F\u043E\u043A\u0430 \u0445\u043E\u0437\u044F\u0435\u0432\u0430
      \u0437\u0430\u043D\u044F\u0442\u044B. \u0423 \u044D\u0442\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B
      \u043D\u0435\u0442 \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0433\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F,
      \u0437\u0430\u0442\u043E \u043E\u043D\u0430 \u0441\u0440\u0430\u0437\u0443
      \u0437\u0430\u043C\u0435\u0442\u043D\u0430, \u043A\u043E\u0433\u0434\u0430
      \u0435\u0451 \u043D\u0435\u043A\u043E\u043C\u0443 \u0434\u0435\u043B\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000194
    m_Localized: "\u041A\u0430\u043A \u0434\u0435\u0440\u0435\u0432\u043D\u044F \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000195
    m_Localized: "\u041D\u0435\u0440\u043E\u0432\u043D\u043E. \u0414\u043D\u0451\u043C
      \u0432\u0441\u0435 \u0437\u0430\u043D\u044F\u0442\u044B \u0438 \u0434\u0435\u043B\u0430\u044E\u0442
      \u0432\u0438\u0434, \u0447\u0442\u043E \u043F\u043E\u0440\u044F\u0434\u043E\u043A
      \u043F\u0440\u0435\u0436\u043D\u0438\u0439. \u0412\u0435\u0447\u0435\u0440\u043E\u043C
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0441\u0447\u0438\u0442\u0430\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B, \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C
      \u0441\u0442\u0430\u0440\u044B\u0435 \u043E\u0431\u0438\u0434\u044B, \u0433\u0430\u0434\u0430\u0442\u044C,
      \u043A\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u043C \u0440\u0435\u0448\u0438\u0442
      \u0443\u0435\u0445\u0430\u0442\u044C, \u0435\u0441\u043B\u0438 \u0432\u043E\u0440\u043E\u0442\u0430
      \u043E\u0442\u043A\u0440\u043E\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000196
    m_Localized: "\u041E\u043D\u0438 \u0431\u043E\u044F\u0442\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000197
    m_Localized: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E. \u041D\u043E \u0441\u0442\u0440\u0430\u0445
      \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043A\u0440\u0438\u0447\u0438\u0442.
      \u0418\u043D\u043E\u0433\u0434\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0441\u0438\u0442 \u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u0433\u043E\u0440\u0448\u043E\u043A \u0441\u0435\u0433\u043E\u0434\u043D\u044F,
      \u0445\u043E\u0442\u044F \u0440\u0430\u043D\u044C\u0448\u0435 \u043D\u0435
      \u0441\u043F\u0435\u0448\u0438\u043B. \u0418\u043B\u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0434\u0432\u0435\u0440\u044C \u043D\u0435\u0437\u0430\u043F\u0435\u0440\u0442\u043E\u0439,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043B\u044B\u0448\u0430\u0442\u044C \u0443\u043B\u0438\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000198
    m_Localized: "\u0418 \u043C\u043D\u043E\u0433\u0438\u0435 \u0437\u043B\u044F\u0442\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000199
    m_Localized: "\u0417\u043B\u044F\u0442\u0441\u044F \u0442\u0435, \u043A\u043E\u043C\u0443
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u043A\u0442\u043E-\u0442\u043E
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0432\u0438\u043D\u043E\u0432\u0430\u0442
      \u0432 \u0438\u0445 \u043F\u0443\u0441\u0442\u043E\u0439 \u043A\u043B\u0430\u0434\u043E\u0432\u043E\u0439.
      \u0421 \u0442\u0430\u043A\u0438\u043C\u0438 \u043B\u0443\u0447\u0448\u0435
      \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u0442\u044C \u043E \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u0438
      \u043D\u0430 \u043F\u0443\u0441\u0442\u043E\u0439 \u0436\u0435\u043B\u0443\u0434\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000200
    m_Localized: "\u0427\u0442\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C
      \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u044F
      \u0432\u043E\u0440\u043E\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000201
    m_Localized: "\u041B\u044E\u0434\u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438
      \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u043C\u0435\u043B\u043E\u0447\u0438.
      \u041A\u0442\u043E \u0445\u043E\u0442\u0435\u043B \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C
      \u043A\u0440\u044B\u0448\u0443 \u2014 \u0447\u0438\u043D\u0438\u0442 \u0441\u0435\u0439\u0447\u0430\u0441.
      \u041A\u0442\u043E \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B
      \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F
      \u2014 \u0442\u043E\u0436\u0435. \u0411\u0443\u0434\u0442\u043E \u0435\u0441\u043B\u0438
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C \u0432\u0441\u0451 \u043D\u0435\u0434\u043E\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0435,
      \u0432\u043E\u0440\u043E\u0442\u0430 \u043E\u0442\u043A\u0440\u043E\u044E\u0442
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435. \u041D\u0435 \u043E\u0442\u043A\u0440\u043E\u044E\u0442,
      \u043A\u043E\u043D\u0435\u0447\u043D\u043E. \u041D\u043E \u0440\u0443\u043A\u0438
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0437\u0430\u043D\u044F\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000202
    m_Localized: "\u0427\u0442\u043E \u0441\u043B\u044B\u0448\u043D\u043E \u0432
      \u0442\u0430\u0432\u0435\u0440\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000203
    m_Localized: "\u0422\u0430\u043C \u0442\u0435\u043F\u0435\u0440\u044C \u043B\u044E\u0431\u0430\u044F
      \u043D\u043E\u0432\u043E\u0441\u0442\u044C \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0433\u0440\u043E\u043C\u0447\u0435, \u0447\u0435\u043C \u0431\u044B\u043B\u0430
      \u043D\u0430 \u0443\u043B\u0438\u0446\u0435. \u0425\u0430\u043B\u044C\u0432\u0430\u0440
      \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F, \u043D\u0435 \u0432\u044B\u0433\u043E\u043D\u044F\u0435\u0442
      \u043F\u0440\u0438\u0435\u0437\u0436\u0438\u0445, \u043F\u043E\u043A\u0430
      \u0435\u0441\u0442\u044C \u0447\u0435\u043C \u043A\u043E\u0440\u043C\u0438\u0442\u044C.
      \u0410 \u041B\u0438\u0432\u0438\u043E \u0443\u0436\u0435 \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u0435\u0442
      \u0441\u0442\u0440\u0430\u0445 \u043F\u043E \u0442\u043E\u043C\u0443, \u0447\u0442\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0433\u043E\u0442\u043E\u0432 \u0437\u0430\u043B\u043E\u0436\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000204
    m_Localized: "\u0427\u0442\u043E \u0434\u0443\u043C\u0430\u0435\u0448\u044C \u043E
      \u0413\u0430\u0440\u0432\u0435\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000205
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u0440\u0435\u0437\u043A\u043E,
      \u043D\u043E \u0435\u0441\u043B\u0438 \u0443 \u0441\u043E\u0441\u0435\u0434\u0430
      \u0442\u0440\u0435\u0441\u043D\u0435\u0442 \u0437\u0430\u043C\u043E\u043A,
      \u043D\u0435 \u043F\u043E\u0448\u043B\u0451\u0442 \u0435\u0433\u043E \u0441\u043F\u0435\u0440\u0432\u0430
      \u0438\u0441\u043A\u0430\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438.
      \u0423 \u043D\u0435\u0433\u043E \u0441\u0432\u043E\u0439 \u0441\u0447\u0451\u0442
      \u0434\u043E\u0431\u0440\u0443: \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0440\u0430\u0431\u043E\u0442\u0443 \u0447\u0435\u0441\u0442\u043D\u043E \u0438
      \u043D\u0435 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C \u043F\u043E\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000206
    m_Localized: "\u0427\u0442\u043E \u0441\u043A\u0430\u0436\u0435\u0448\u044C \u043E\u0431
      \u0423\u043B\u044C\u0440\u0438\u043A\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000207
    m_Localized: "\u041E\u043D \u043F\u0440\u0438\u0432\u044B\u043A, \u0447\u0442\u043E
      \u0435\u0433\u043E \u0434\u0435\u043B\u043E \u043D\u0430 \u0432\u0438\u0434\u0443:
      \u0448\u0443\u043C \u043A\u043E\u043B\u0435\u0441\u0430, \u043C\u0435\u0448\u043A\u0438,
      \u043E\u0447\u0435\u0440\u0435\u0434\u044C. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0435\u043C\u0443 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u043C\u043E\u0449\u0438,
      \u0438 \u044D\u0442\u043E \u0441\u043B\u044B\u0448\u043D\u043E \u0432 \u043A\u0430\u0436\u0434\u043E\u043C
      \u0441\u043B\u043E\u0432\u0435. \u041D\u0435 \u0432\u0441\u0435\u043C \u043B\u0435\u0433\u043A\u043E
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044C \u0431\u044B\u0442\u044C
      \u0445\u043E\u0437\u044F\u0438\u043D\u043E\u043C \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000208
    m_Localized: "\u041A\u0430\u043A \u0442\u0435\u0431\u0435 \u041C\u0435\u0439\u0440\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000209
    m_Localized: "\u041E\u043D\u0430 \u043D\u0435 \u0443\u043C\u0435\u0435\u0442
      \u0443\u0441\u043F\u043E\u043A\u0430\u0438\u0432\u0430\u0442\u044C \u0441\u043B\u043E\u0432\u0430\u043C\u0438,
      \u0437\u0430\u0442\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0441
      \u0442\u0435\u043C, \u0447\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043C\u043E\u0447\u044C.
      \u041B\u044E\u0434\u044F\u043C \u044D\u0442\u043E \u0438\u043D\u043E\u0433\u0434\u0430
      \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F: \u043E\u043D\u0438
      \u0445\u043E\u0442\u044F\u0442 \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C,
      \u0447\u0442\u043E \u0432\u0441\u0451 \u0431\u0443\u0434\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u043E.
      \u0410 \u043E\u043D\u0430 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442,
      \u0433\u0434\u0435 \u0431\u043E\u043B\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000210
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000211
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000212
    m_Localized: "\u0415\u0441\u043B\u0438 \u043F\u0440\u0438\u0448\u0451\u043B \u0437\u0430
      \u0441\u0430\u043F\u043E\u0433\u0430\u043C\u0438, \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0441\u043A\u0430\u0436\u0438, \u043A\u0443\u0434\u0430 \u0438\u0434\u0451\u0448\u044C.
      \u0414\u043B\u044F \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u0438 \u0434\u043B\u044F
      \u043B\u0435\u0441\u0430 \u043E\u0434\u043D\u0430 \u043A\u043E\u0436\u0430
      \u043D\u0435 \u0433\u043E\u0434\u0438\u0442\u0441\u044F. \u0410 \u0435\u0441\u043B\u0438
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C
      \u0434\u043E\u0436\u0434\u044C \u2014 \u0432\u043E\u043D \u043D\u0430\u0432\u0435\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000213
    m_Localized: "\u0427\u0435\u043C \u0442\u044B \u0442\u043E\u0440\u0433\u0443\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000214
    m_Localized: "\u041E\u0431\u0443\u0432\u044C\u044E, \u0448\u0430\u043F\u043A\u0430\u043C\u0438,
      \u0440\u0435\u043C\u043D\u044F\u043C\u0438. \u0412\u0435\u0449\u0430\u043C\u0438,
      \u043E \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u043D\u0430\u0442\u0438\u0440\u0430\u0442\u044C, \u043C\u0451\u0440\u0437\u043D\u0443\u0442\u044C
      \u0438\u043B\u0438 \u0442\u0435\u0440\u044F\u0442\u044C \u043A\u043E\u0448\u0435\u043B\u044C.
      \u0425\u043E\u0440\u043E\u0448\u0430\u044F \u043E\u0434\u0435\u0436\u0434\u0430
      \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0431\u043E\u0433\u0430\u0447\u0435. \u041E\u043D\u0430 \u043D\u0435 \u0434\u0430\u0451\u0442
      \u0431\u0435\u0434\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C \u0435\u0433\u043E
      \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000215
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0442\u0430\u043A
      \u0434\u0435\u0440\u0436\u0438\u0448\u044C\u0441\u044F \u0437\u0430 \u043E\u0431\u0443\u0432\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000216
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0434\u043E\u0440\u043E\u0433\u0430
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0431\u0435\u0440\u0451\u0442 \u043D\u043E\u0433\u0438.
      \u041D\u0430\u0442\u0451\u0440 \u043F\u044F\u0442\u043A\u0443 \u2014 \u0438\u0434\u0451\u0448\u044C
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435. \u041F\u0440\u043E\u043C\u043E\u0447\u0438\u043B
      \u0441\u0430\u043F\u043E\u0433\u0438 \u2014 \u043C\u0451\u0440\u0437\u043D\u0435\u0448\u044C.
      \u041F\u043E\u0440\u0432\u0430\u043B \u043F\u043E\u0434\u043E\u0448\u0432\u0443
      \u2014 \u0443\u0436\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C
      \u043D\u0435 \u043D\u0430 \u043F\u0443\u0442\u044C, \u0430 \u043F\u043E\u0434
      \u043D\u043E\u0433\u0438. \u041F\u043E\u0442\u043E\u043C \u043B\u044E\u0434\u0438
      \u0443\u0434\u0438\u0432\u043B\u044F\u044E\u0442\u0441\u044F, \u0447\u0442\u043E
      \u043C\u0435\u043B\u043E\u0447\u044C \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u043B\u0430
      \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043F\u043B\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000217
    m_Localized: "\u0422\u044B \u0441\u0430\u043C\u0430 \u043C\u043D\u043E\u0433\u043E
      \u0445\u043E\u0434\u0438\u043B\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000218
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E. \u0422\u043E\u0440\u0433\u043E\u0432\u043B\u044F
      \u043D\u0430\u0443\u0447\u0438\u043B\u0430: \u0441\u043B\u043E\u0432\u0430
      \u0431\u044B\u0432\u0430\u044E\u0442 \u0434\u0435\u0448\u0435\u0432\u043B\u0435
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438, \u043D\u043E \u0442\u043E\u0432\u0430\u0440
      \u043D\u0430\u0434\u043E \u0434\u043E\u043D\u0435\u0441\u0442\u0438 \u0441\u0430\u043C\u043E\u043C\u0443.
      \u0422\u0435\u043F\u0435\u0440\u044C \u044F \u0437\u0430\u0440\u0430\u043D\u0435\u0435
      \u0432\u0438\u0436\u0443, \u0443 \u043A\u043E\u0433\u043E \u043D\u043E\u0433\u0438
      \u0431\u043E\u043B\u044F\u0442, \u043F\u043E \u0442\u043E\u043C\u0443, \u043A\u0430\u043A
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043A \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000219
    m_Localized: "\u041D\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u043C\u043E\u0436\u0435\u0442
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430 \u0445\u043E\u0440\u043E\u0448\u0438\u0435
      \u0441\u0430\u043F\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000220
    m_Localized: "\u0417\u043D\u0430\u044E. \u041F\u043E\u0442\u043E\u043C\u0443
      \u043D\u0435 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E \u0434\u043E\u0440\u043E\u0433\u0443\u044E
      \u043F\u0430\u0440\u0443 \u0442\u043E\u043C\u0443, \u043A\u043E\u043C\u0443
      \u043D\u0443\u0436\u043D\u0430 \u0437\u0430\u043F\u043B\u0430\u0442\u0430 \u0434\u043E
      \u0432\u0435\u0441\u043D\u044B. \u0420\u0435\u043C\u0435\u043D\u044C \u043C\u043E\u0436\u043D\u043E
      \u0441\u043C\u0435\u043D\u0438\u0442\u044C, \u043F\u043E\u0434\u043E\u0448\u0432\u0443
      \u043F\u043E\u0434\u0448\u0438\u0442\u044C. \u041D\u0435 \u0432\u0441\u0451
      \u043D\u0430\u0434\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C \u0437\u0430\u043D\u043E\u0432\u043E,
      \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u043F\u0440\u043E\u0434\u0430\u0432\u0446\u0443
      \u044D\u0442\u043E \u0432\u044B\u0433\u043E\u0434\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000221
    m_Localized: "\u041A\u0430\u043A \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000222
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D\u044B \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442,
      \u0430 \u043B\u044E\u0434\u0438 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u043D\u0430 \u0442\u043E\u0432\u0430\u0440 \u0443\u0436\u0435 \u043D\u0435
      \u0432\u044B\u0431\u0438\u0440\u0430\u044F, \u0430 \u043F\u0440\u0438\u043A\u0438\u0434\u044B\u0432\u0430\u044F,
      \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0451\u0442 \u043B\u0438 \u043E\u043D
      \u0441\u0435\u0437\u043E\u043D. \u0420\u0430\u0437\u043C\u0435\u0440\u044B
      \u043A\u043E\u043D\u0447\u0430\u044E\u0442\u0441\u044F \u043D\u0435 \u043F\u043E
      \u043F\u043E\u0440\u044F\u0434\u043A\u0443, \u043A\u043E\u0436\u0430 \u043D\u0435
      \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u043E \u0436\u0435\u043B\u0430\u043D\u0438\u044E.
      \u041F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0447\u0435\u0441\u0442\u043D\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \xAB\u043D\u0435\u0442\xBB
      \u0447\u0430\u0449\u0435, \u0447\u0435\u043C \u043C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000223
    m_Localized: "\u0427\u0442\u043E \u0441 \u043F\u0440\u0438\u0435\u0437\u0436\u0438\u043C\u0438
      \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000224
    m_Localized: "\u041E\u043D\u0438 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u0442\u043E\u044F\u0442
      \u0443 \u0434\u0432\u0435\u0440\u0438, \u0441\u043B\u043E\u0432\u043D\u043E
      \u0438\u043C \u0432\u043E\u0442-\u0432\u043E\u0442 \u043A\u0440\u0438\u043A\u043D\u0443\u0442,
      \u0447\u0442\u043E \u043F\u0443\u0442\u044C \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D.
      \u041E\u0434\u0438\u043D \u043A\u0443\u043F\u0438\u043B \u0448\u0430\u043F\u043A\u0443
      \u043E\u0442 \u0432\u0435\u0442\u0440\u0430 \u0438 \u043D\u043E\u0441\u0438\u0442
      \u0435\u0451 \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438
      \u2014 \u043D\u0435 \u043E\u0442 \u0445\u043E\u043B\u043E\u0434\u0430, \u0430
      \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u0434\u0443\u043C\u0430\u0442\u044C,
      \u043A\u0430\u043A \u0434\u043E\u043B\u0433\u043E \u0436\u0434\u0430\u0442\u044C.
      \u041B\u044E\u0434\u0438 \u0432 \u043F\u0443\u0442\u0438 \u043D\u0435 \u0443\u043C\u0435\u044E\u0442
      \u0441\u0442\u043E\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000225
    m_Localized: "\u0422\u044B \u043F\u043E\u0434\u043D\u044F\u043B\u0430 \u0446\u0435\u043D\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000226
    m_Localized: "\u041F\u043E\u0434\u043D\u044F\u043B\u0430 \u043D\u0430 \u0442\u043E,
      \u0447\u0442\u043E \u0441\u0442\u0430\u043B\u043E \u0434\u043E\u0440\u043E\u0436\u0435
      \u043C\u043D\u0435. \u041D\u0435 \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443 \u043D\u0443\u0436\u043D\u043E
      \u0441\u0440\u043E\u0447\u043D\u043E. \u041C\u043E\u0436\u043D\u043E \u043D\u0430\u0436\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0445\u043E\u043B\u043E\u0434\u0435, \u043D\u043E \u043F\u043E\u0442\u043E\u043C
      \u044D\u0442\u043E\u0442 \u0445\u043E\u043B\u043E\u0434 \u0431\u0443\u0434\u0435\u0442
      \u0441\u0442\u043E\u044F\u0442\u044C \u0443 \u0442\u0432\u043E\u0435\u0439
      \u0434\u0432\u0435\u0440\u0438. \u041B\u0438\u0432\u0438\u043E, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
      \u0441\u043A\u0430\u0437\u0430\u043B \u0431\u044B, \u0447\u0442\u043E \u044D\u0442\u043E
      \u043D\u0435 \u0441\u0447\u0451\u0442. \u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0441\u0432\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000227
    m_Localized: "\u0427\u0442\u043E \u0434\u0443\u043C\u0430\u0435\u0448\u044C \u043E
      \u0413\u0430\u0440\u0432\u0435\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000228
    m_Localized: "\u0413\u0430\u0440\u0432\u0435\u043D \u0440\u0443\u0433\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043F\u043B\u043E\u0445\u0443\u044E \u043F\u0440\u044F\u0436\u043A\u0443
      \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E \u0435\u0451 \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0435\u043C\u0443 \u043D\u0430\u0437\u043B\u043E. \u041F\u043E\u0442\u043E\u043C
      \u0431\u0435\u0440\u0451\u0442 \u043C\u043E\u043B\u043E\u0442 \u0438 \u0447\u0438\u043D\u0438\u0442.
      \u041C\u043D\u0435 \u0441 \u043D\u0438\u043C \u043B\u0435\u0433\u043A\u043E:
      \u0435\u0441\u043B\u0438 \u0440\u0435\u043C\u0435\u043D\u044C \u043D\u0435
      \u0434\u0435\u0440\u0436\u0438\u0442, \u043E\u043D \u0441\u043A\u0430\u0436\u0435\u0442
      \u043F\u0440\u044F\u043C\u043E, \u0430 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0438\u0434, \u0447\u0442\u043E
      \u0432\u0438\u043D\u043E\u0432\u0430\u0442 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000229
    m_Localized: "\u041A\u0430\u043A \u0442\u0435\u0431\u0435 \u041C\u0435\u0439\u0440\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000230
    m_Localized: "\u0414\u043B\u044F \u043D\u0435\u0451 \u044F \u0441\u0448\u0438\u0432\u0430\u044E
      \u0440\u0435\u043C\u0435\u0448\u043A\u0438 \u0434\u043B\u044F \u0441\u0443\u043C\u043E\u043A
      \u0438 \u043D\u043E\u0436\u043D\u044B \u0434\u043B\u044F \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u044B\u0445
      \u0444\u043B\u0430\u043A\u043E\u043D\u043E\u0432. \u041E\u043D\u0430 \u0437\u043D\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043E\u0442 \u0433\u0440\u044F\u0437\u043D\u044B\u0445
      \u0440\u0443\u043A \u043F\u043E\u0440\u043E\u0439 \u0445\u0443\u0436\u0435,
      \u0447\u0435\u043C \u043E\u0442 \u043F\u043B\u043E\u0445\u043E\u0439 \u0442\u0440\u0430\u0432\u044B.
      \u0421 \u043D\u0435\u0439 \u043C\u043E\u0436\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u043E \u0440\u0430\u0431\u043E\u0442\u0435, \u0430 \u043D\u0435 \u043E \u0447\u0443\u0434\u0435\u0441\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000231
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000232
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000233
    m_Localized: "\u0415\u0441\u043B\u0438 \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u0430
      \u0434\u0432\u0435\u0440\u044C \u2014 \u0433\u043E\u0432\u043E\u0440\u0438,
      \u0433\u0434\u0435 \u043F\u0440\u043E\u0451\u043C. \u0415\u0441\u043B\u0438
      \u0441\u043E\u0432\u0435\u0442 \u2014 \u0442\u043E\u0436\u0435 \u0433\u043E\u0432\u043E\u0440\u0438.
      \u042F \u043D\u0435 \u043B\u044E\u0431\u043B\u044E \u0433\u0430\u0434\u0430\u0442\u044C,
      \u0447\u0442\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0445\u043E\u0447\u0435\u0442
      \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0438\u0437 \u0447\u0443\u0436\u0438\u0445
      \u0441\u043B\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000234
    m_Localized: "\u0427\u0435\u043C \u0442\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000235
    m_Localized: "\u041A\u0440\u044B\u0448\u0430\u043C\u0438, \u0434\u0432\u0435\u0440\u044F\u043C\u0438,
      \u0442\u0435\u043B\u0435\u0433\u0430\u043C\u0438, \u0437\u0430\u0431\u043E\u0440\u0430\u043C\u0438.
      \u0412\u0441\u0435\u043C \u0442\u0435\u043C, \u043D\u0430 \u0447\u0442\u043E
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0442,
      \u043F\u043E\u043A\u0430 \u043E\u043D\u043E \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F.
      \u0410 \u043A\u0430\u043A \u043F\u0435\u0440\u0435\u043A\u043E\u0441\u0438\u0442\u0441\u044F
      \u2014 \u0441\u0440\u0430\u0437\u0443 \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442
      \u0420\u043E\u0433\u0430\u043D\u0430. \u041D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0439
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000236
    m_Localized: "\u0427\u0442\u043E \u0432 \u043F\u043B\u043E\u0442\u043D\u0438\u0446\u043A\u043E\u043C
      \u0434\u0435\u043B\u0435 \u0432\u0430\u0436\u043D\u0435\u0435 \u0432\u0441\u0435\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000237
    m_Localized: "\u041D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u044C\u0441\u044F
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u0434\u0435\u0440\u0435\u0432\u043E
      \u0435\u0449\u0451 \u0432\u043B\u0430\u0436\u043D\u043E\u0435. \u0421\u043D\u0430\u0440\u0443\u0436\u0438
      \u0434\u043E\u0441\u043A\u0430 \u0440\u043E\u0432\u043D\u0430\u044F, \u0430
      \u043F\u043E\u0442\u043E\u043C \u0435\u0451 \u043F\u043E\u0432\u0435\u0434\u0451\u0442
      \u2014 \u0438 \u043F\u0435\u0440\u0435\u043A\u043E\u0441\u0438\u0442\u0441\u044F
      \u0432\u0441\u044F \u0440\u0430\u0431\u043E\u0442\u0430. \u041B\u044E\u0434\u0438
      \u043B\u044E\u0431\u044F\u0442 \u0441\u0440\u0435\u0437\u0430\u0442\u044C \u0432\u0440\u0435\u043C\u044F.
      \u0414\u0435\u0440\u0435\u0432\u043E \u0437\u0430 \u044D\u0442\u043E \u0432\u0441\u0435\u0433\u0434\u0430
      \u0432\u0437\u044B\u0441\u043A\u0438\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000238
    m_Localized: "\u0414\u0435\u0440\u0435\u0432\u043E \u043C\u043E\u0436\u0435\u0442
      \u043E\u0431\u043C\u0430\u043D\u0443\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000239
    m_Localized: "\u041E\u043D\u043E \u043D\u0435 \u043E\u0431\u043C\u0430\u043D\u044B\u0432\u0430\u0435\u0442.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E: \u0441\u0443\u0447\u043A\u043E\u043C,
      \u0442\u0440\u0435\u0449\u0438\u043D\u043E\u0439, \u0441\u044B\u0440\u043E\u0439
      \u043A\u0440\u043E\u043C\u043A\u043E\u0439. \u0415\u0441\u043B\u0438 \u043D\u0435
      \u0441\u043B\u0443\u0448\u0430\u0442\u044C \u2014 \u043F\u043E\u0442\u043E\u043C
      \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0434\u0432\u0435\u0440\u044C\u044E,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043C\u043E\u0440\u043E\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000240
    m_Localized: "\u0422\u0430\u043A \u043B\u044E\u0431\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043F\u0435\u0440\u0435\u0434\u0435\u043B\u044B\u0432\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000241
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430. \u041B\u0443\u0447\u0448\u0435
      \u043F\u0435\u0440\u0435\u0434\u0435\u043B\u0430\u0442\u044C \u043E\u0434\u043D\u0443
      \u0431\u0430\u043B\u043A\u0443, \u0447\u0435\u043C \u043F\u043E\u0442\u043E\u043C
      \u043F\u043E\u0434\u043F\u0438\u0440\u0430\u0442\u044C \u0446\u0435\u043B\u0443\u044E
      \u043A\u0440\u044B\u0448\u0443. \u0412 \u0440\u0430\u0431\u043E\u0442\u0435
      \u044D\u0442\u043E \u043F\u043E\u043D\u044F\u0442\u043D\u043E. \u0421 \u043B\u044E\u0434\u044C\u043C\u0438
      \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E \u0436\u0434\u0443\u0442,
      \u043F\u043E\u043A\u0430 \u0440\u0443\u0445\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000242
    m_Localized: "\u0427\u0442\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u043F\u043E\u043C\u0435\u043D\u044F\u043B\u0438
      \u0432 \u0442\u0432\u043E\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000243
    m_Localized: "\u0417\u0430\u043A\u0430\u0437\u043E\u0432 \u0441\u0442\u0430\u043B\u043E
      \u0431\u043E\u043B\u044C\u0448\u0435, \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430
      \u043C\u0435\u043D\u044C\u0448\u0435. \u041B\u044E\u0434\u0438 \u0447\u0438\u043D\u044F\u0442
      \u0441\u0442\u0430\u0432\u043D\u0438, \u043F\u043E\u0434\u043F\u0438\u0440\u0430\u044E\u0442
      \u043A\u0430\u043B\u0438\u0442\u043A\u0438, \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u044F\u0442
      \u0434\u0440\u043E\u0432\u0430 \u0431\u043B\u0438\u0436\u0435 \u043A \u0434\u043E\u043C\u0443.
      \u041D\u0435 \u043F\u043E\u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u0434\u0435\u0440\u0435\u0432\u043E
      \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u043E\u0442 \u0432\u0441\u0435\u0433\u043E.
      \u041F\u0440\u043E\u0441\u0442\u043E \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u043A\u0440\u0443\u0433
      \u043D\u0435\u044F\u0441\u043D\u043E, \u0445\u043E\u0447\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E\u0431\u044B \u0445\u043E\u0442\u044F \u0431\u044B \u0441\u0432\u043E\u0451
      \u043D\u0435 \u0441\u043A\u0440\u0438\u043F\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000244
    m_Localized: "\u0427\u0442\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u0432
      \u043B\u0435\u0441\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000245
    m_Localized: "\u0417\u0430 \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u043B\u0435\u0441\u043E\u043C
      \u0442\u0435\u043F\u0435\u0440\u044C \u043D\u0435 \u0445\u043E\u0436\u0443.
      \u0423 \u0434\u043E\u0440\u043E\u0433\u0438 \u043C\u043D\u043E\u0433\u043E
      \u0447\u0443\u0436\u0438\u0445 \u0441\u043B\u0435\u0434\u043E\u0432, \u0430
      \u043C\u0451\u0440\u0442\u0432\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u043E
      \u0438 \u0442\u0443\u0442 \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F.
      \u0425\u0430\u0440\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u043B\u0435\u0441
      \u0441\u0430\u043C \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
      \u0433\u0434\u0435 \u043B\u0438\u0448\u043D\u0438\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A.
      \u042F \u0435\u043C\u0443 \u0432\u0435\u0440\u044E. \u041D\u0435 \u0445\u043E\u0447\u0443
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0433\u0440\u043E\u043C\u043A\u043E \u043E\u043D \u0443\u043C\u0435\u0435\u0442
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000246
    m_Localized: "\u0422\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C
      \u0441 \u0413\u0430\u0440\u0432\u0435\u043D\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000247
    m_Localized: "\u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E. \u0425\u043E\u0440\u043E\u0448\u0430\u044F
      \u0434\u0432\u0435\u0440\u044C \u0431\u0435\u0437 \u043F\u0435\u0442\u0435\u043B\u044C
      \u2014 \u0434\u043E\u0441\u043A\u0438, \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u0437\u0430\u0431\u043E\u0440 \u0431\u0435\u0437 \u0441\u043A\u043E\u0431
      \u2014 \u043F\u0440\u043E\u0441\u044C\u0431\u0430 \u0432\u0435\u0442\u0440\u0443
      \u043D\u0435 \u0434\u0443\u0442\u044C. \u0413\u0430\u0440\u0432\u0435\u043D
      \u0443\u043C\u0435\u0435\u0442 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0436\u0435\u043B\u0435\u0437\u043E
      \u043F\u0440\u043E\u0441\u0442\u044B\u043C. \u042D\u0442\u043E \u0440\u0435\u0434\u043A\u0438\u0439
      \u0434\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000248
    m_Localized: "\u0427\u0442\u043E \u0434\u0443\u043C\u0430\u0435\u0448\u044C \u043E
      \u0425\u0430\u0440\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000249
    m_Localized: "\u041E\u043D \u043C\u0430\u043B\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0437\u0430\u0442\u043E \u043D\u0435 \u043E\u0431\u0435\u0449\u0430\u0435\u0442
      \u043B\u0435\u0441\u0430 \u0442\u0435\u043C, \u043A\u0442\u043E \u043D\u0435
      \u0441\u043C\u043E\u0436\u0435\u0442 \u0438\u0437 \u043D\u0435\u0433\u043E
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F. \u0414\u043B\u044F
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0435\u0433\u043E \u0434\u0435\u043B\u0430
      \u044D\u0442\u043E \u0432\u0430\u0436\u043D\u0435\u0435 \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0445
      \u0441\u043B\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000250
    m_Localized: "\u041C\u0435\u0439\u0440\u0430 \u0447\u0442\u043E-\u0442\u043E
      \u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0443 \u0442\u0435\u0431\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000251
    m_Localized: "\u042F\u0449\u0438\u043A\u0438 \u0434\u043B\u044F \u0441\u0443\u0448\u0451\u043D\u044B\u0445
      \u0442\u0440\u0430\u0432 \u0438 \u043F\u043E\u043B\u043A\u0438, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0432\u0441\u0451
      \u0443 \u043F\u043E\u043B\u0430. \u041E\u043D\u0430 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442,
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0442
      \u0434\u043E\u0441\u043A\u0430, \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C
      \u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043D\u0430 \u043D\u0435\u0451
      \u0431\u0430\u043D\u043A\u0443. \u0421 \u0442\u0430\u043A\u0438\u043C \u0437\u0430\u043A\u0430\u0437\u043E\u043C
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043B\u0435\u0433\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000252
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000253
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000254
    m_Localized: "\u0415\u0441\u043B\u0438 \u043F\u0440\u0438\u0448\u0451\u043B \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u0437\u0435\u043C\u043B\u044E \u2014 \u0441\u043C\u043E\u0442\u0440\u0438.
      \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u043E\u043D\u0430 \u043C\u043E\u043B\u0447\u0438\u0442.
      \u0417\u0435\u043C\u043B\u044F \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
      \u043F\u043E\u0437\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000255
    m_Localized: "\u0422\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C
      \u0432 \u043F\u043E\u043B\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000256
    m_Localized: "\u0420\u0430\u0431\u043E\u0442\u0430\u044E. \u0421\u0435\u044E,
      \u043F\u043E\u043B\u044E, \u0447\u0438\u043D\u044E \u043A\u0430\u043D\u0430\u0432\u044B,
      \u0441\u043C\u043E\u0442\u0440\u044E, \u0447\u0442\u043E \u0432\u0437\u043E\u0448\u043B\u043E,
      \u0430 \u0447\u0442\u043E \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u043F\u0435\u0440\u0435\u0441\u0435\u0432\u0430\u0442\u044C. \u0412 \u043F\u043E\u043B\u0435
      \u043D\u0435\u0442 \u043B\u0438\u0448\u043D\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u044B:
      \u0435\u0441\u043B\u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0435\u0451
      \u043D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430, \u0437\u0430\u0432\u0442\u0440\u0430
      \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0434\u0435\u043B\u0430\u0442\u044C
      \u0432\u0434\u0432\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000257
    m_Localized: "\u0427\u0442\u043E \u0442\u0440\u0443\u0434\u043D\u0435\u0435 \u0432\u0441\u0435\u0433\u043E
      \u0432 \u043F\u043E\u043B\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000258
    m_Localized: "\u041D\u0435 \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u0442\u044C
      \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435 \u0441 \u0431\u0435\u0437\u0434\u0435\u043B\u044C\u0435\u043C.
      \u0418\u043D\u043E\u0433\u0434\u0430 \u043D\u0430\u0434\u043E \u0436\u0434\u0430\u0442\u044C,
      \u043F\u043E\u043A\u0430 \u0437\u0435\u043C\u043B\u044F \u0432\u043E\u0437\u044C\u043C\u0451\u0442
      \u0432\u043E\u0434\u0443. \u0418\u043D\u043E\u0433\u0434\u0430 \u2014 \u043B\u0435\u0437\u0442\u044C
      \u0432 \u0433\u0440\u044F\u0437\u044C \u0441\u0435\u0439\u0447\u0430\u0441,
      \u0438\u043D\u0430\u0447\u0435 \u0432\u043E\u0434\u0430 \u0437\u0430\u0431\u0435\u0440\u0451\u0442
      \u0432\u0441\u0451. \u0421\u043D\u0430\u0440\u0443\u0436\u0438 \u044D\u0442\u043E
      \u043F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430 \u043E\u0434\u043D\u043E
      \u0438 \u0442\u043E \u0436\u0435: \u0441\u0442\u043E\u0438\u0448\u044C \u0438
      \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000259
    m_Localized: "\u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u0443\u0440\u043E\u0436\u0430\u0439
      \u2014 \u0432\u0441\u0435\u0433\u0434\u0430 \u043B\u043E\u0442\u0435\u0440\u0435\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000260
    m_Localized: "\u041D\u0435\u0442. \u041B\u043E\u0442\u0435\u0440\u0435\u044F
      \u2014 \u043A\u043E\u0433\u0434\u0430 \u0441\u0435\u044E\u0442 \u0447\u0442\u043E
      \u043F\u043E\u043F\u0430\u043B\u043E \u0438 \u043D\u0430\u0434\u0435\u044E\u0442\u0441\u044F
      \u043D\u0430 \u0443\u0434\u0430\u0447\u0443. \u041C\u044B \u043C\u043E\u0436\u0435\u043C
      \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0437\u0435\u043C\u043B\u044E,
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0441\u0435\u043C\u0435\u043D\u0430,
      \u0432\u043E\u0432\u0440\u0435\u043C\u044F \u0443\u0431\u0440\u0430\u0442\u044C
      \u0441\u043E\u0440\u043D\u044F\u043A. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u043D\u0435 \u043D\u0430\u0448\u0435. \u041D\u043E \u0438 \u044D\u0442\u043E\u0433\u043E
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u0441\u0438\u0434\u0435\u0442\u044C \u0441\u043B\u043E\u0436\u0430
      \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000261
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0432\u0441\u0451 \u0440\u0435\u0448\u0430\u0435\u0442
      \u043F\u043E\u0433\u043E\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000262
    m_Localized: "\u041F\u043E\u0433\u043E\u0434\u0430 \u0440\u0435\u0448\u0430\u0435\u0442
      \u043C\u043D\u043E\u0433\u043E. \u041D\u043E \u043F\u043B\u043E\u0445\u0430\u044F
      \u043A\u0430\u043D\u0430\u0432\u043A\u0430, \u0442\u0443\u043F\u0430\u044F
      \u043C\u043E\u0442\u044B\u0433\u0430 \u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0440\u0438\u0448\u0451\u043B
      \u043F\u043E\u0437\u0434\u043D\u043E, \u0440\u0435\u0448\u0430\u044E\u0442
      \u043D\u0435 \u043C\u0435\u043D\u044C\u0448\u0435. \u041D\u0430 \u043D\u0435\u0431\u043E
      \u0443\u0434\u043E\u0431\u043D\u043E \u0441\u0432\u0430\u043B\u0438\u0442\u044C
      \u0432\u0441\u0451. \u0417\u0435\u043C\u043B\u044F \u0442\u0430\u043A\u043E\u0433\u043E
      \u043D\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000263
    m_Localized: "\u041A\u0430\u043A \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438
      \u0440\u0430\u0431\u043E\u0442\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000264
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0441\u0447\u0438\u0442\u0430\u044E\u0442
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u0435\u0448\u043A\u0438,
      \u043D\u043E \u0438 \u0441\u0435\u043C\u0435\u043D\u0430. \u0415\u0441\u043B\u0438
      \u0432\u0435\u0441\u043D\u043E\u0439 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0447\u0435\u043C \u0441\u0435\u044F\u0442\u044C, \u043E\u0441\u0435\u043D\u044C\u044E
      \u043D\u0435\u0447\u0435\u0433\u043E \u0431\u0443\u0434\u0435\u0442 \u043C\u043E\u043B\u043E\u0442\u044C.
      \u041B\u044E\u0434\u0438 \u0432\u0438\u0434\u044F\u0442 \u0435\u0434\u0443
      \u0432 \u0430\u043C\u0431\u0430\u0440\u0435. \u042F \u0432\u0438\u0436\u0443
      \u0435\u0451 \u0435\u0449\u0451 \u0432 \u0433\u043E\u0440\u0441\u0442\u0438,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043D\u0435\u043B\u044C\u0437\u044F
      \u0441\u044A\u0435\u0441\u0442\u044C \u0441\u0435\u0439\u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000265
    m_Localized: "\u0427\u0442\u043E \u0434\u043B\u044F \u043F\u043E\u043B\u0435\u0439
      \u0437\u043D\u0430\u0447\u0438\u0442 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430
      \u0423\u043B\u044C\u0440\u0438\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000266
    m_Localized: "\u0411\u0435\u0437 \u043D\u0435\u0451 \u0437\u0435\u0440\u043D\u043E
      \u2014 \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u044F\u0436\u0451\u043B\u044B\u0435
      \u043C\u0435\u0448\u043A\u0438. \u0423\u043B\u044C\u0440\u0438\u043A \u0443\u043C\u0435\u0435\u0442
      \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0442\u044C \u043D\u0430\u0448
      \u0442\u0440\u0443\u0434 \u0432 \u0445\u043B\u0435\u0431, \u0438 \u0437\u0430
      \u044D\u0442\u043E \u0435\u043C\u0443 \u043C\u043D\u043E\u0433\u043E\u0435
      \u043F\u0440\u043E\u0449\u0430\u043B\u0438. \u041D\u043E \u043A\u043E\u0433\u0434\u0430
      \u0435\u0433\u043E \u0431\u0435\u0434\u0430 \u0441\u0442\u0430\u043B\u0430
      \u0431\u0435\u0434\u043E\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0438,
      \u0432\u0441\u0435\u043C \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C:
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u043D\u0435 \u0441\u0442\u043E\u0438\u0442
      \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E \u043E\u0442 \u043F\u043E\u043B\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000267
    m_Localized: "\u0422\u044B \u0447\u0430\u0441\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C
      \u0441 \u0425\u0430\u0440\u043D\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000268
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0437\u0432\u0435\u0440\u044C \u043B\u0435\u0437\u0435\u0442
      \u043A \u043F\u043E\u0441\u0435\u0432\u0430\u043C \u2014 \u0447\u0430\u0441\u0442\u043E.
      \u041E\u043D \u043D\u0435 \u043E\u0431\u0435\u0449\u0430\u0435\u0442, \u0447\u0442\u043E
      \u043E\u0442\u0432\u0430\u0434\u0438\u0442 \u043A\u0430\u0436\u0434\u043E\u0433\u043E,
      \u043D\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442, \u0433\u0434\u0435
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0448\u0443\u043C\u043A\u0438
      \u0438 \u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
      \u043F\u043E\u043B\u0435 \u0431\u0435\u0437 \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u0430.
      \u0423 \u043D\u0435\u0433\u043E \u0433\u043E\u043B\u043E\u0432\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0442\u0438\u0448\u0435, \u0447\u0435\u043C \u0443 \u043C\u043D\u043E\u0433\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000269
    m_Localized: "\u041C\u0435\u0439\u0440\u0430 \u0431\u044B\u0432\u0430\u0435\u0442
      \u0443 \u0442\u0435\u0431\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000270
    m_Localized: "\u0411\u0435\u0440\u0451\u0442 \u0442\u043E, \u0447\u0442\u043E
      \u043D\u0435 \u0433\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u043C\u0435\u0448\u043E\u043A:
      \u043A\u043E\u0440\u043D\u0438, \u043B\u0438\u0441\u0442\u044C\u044F, \u0446\u0432\u0435\u0442\u044B
      \u043F\u043E \u043A\u0440\u0430\u044E \u043F\u043E\u043B\u044F. \u041D\u043E
      \u0441\u043F\u0435\u0440\u0432\u0430 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442,
      \u0447\u0435\u043C \u044F \u043F\u043E\u043B\u0438\u0432\u0430\u043B \u0438
      \u0433\u0434\u0435 \u0437\u0435\u043C\u043B\u044F \u0431\u043E\u043B\u044C\u043D\u0430\u044F.
      \u0425\u043E\u0440\u043E\u0448\u043E, \u043A\u043E\u0433\u0434\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0437\u043D\u0430\u0435\u0442 \u0446\u0435\u043D\u0443 \u0442\u043E\u043C\u0443,
      \u0447\u0442\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000271
    m_Localized: "\u0410 \u043E\u0442\u0435\u0446 \u041A\u0430\u0434\u043C\u043E\u043D?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000272
    m_Localized: "\u041F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u043E\u0441\u0435\u0432\u043D\u0443\u044E,
      \u043A\u043E\u0433\u0434\u0430 \u0440\u0443\u043A \u043C\u0430\u043B\u043E.
      \u041D\u0435 \u0434\u0435\u043B\u0430\u0435\u0442 \u0432\u0438\u0434, \u0447\u0442\u043E
      \u0443\u043C\u0435\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u043B\u0443\u0447\u0448\u0435 \u043D\u0430\u0441: \u043D\u043E\u0441\u0438\u0442
      \u0432\u043E\u0434\u0443, \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442
      \u043A\u0430\u043C\u043D\u0438, \u0441\u043B\u0443\u0448\u0430\u0435\u0442.
      \u0414\u043B\u044F \u043F\u043E\u043B\u044F \u044D\u0442\u043E \u043F\u043E\u043B\u0435\u0437\u043D\u0435\u0435
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0445 \u0441\u043B\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000273
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000274
    m_Localized: "\u041F\u043E\u0439\u0434\u0443. \u041D\u0435 \u0445\u043E\u0447\u0443
      \u043C\u0435\u0448\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000275
    m_Localized: "\u0421 \u0431\u0435\u043B\u044C\u0451\u043C \u043F\u0440\u0438\u0448\u0451\u043B
      \u2014 \u043A\u043B\u0430\u0434\u0438 \u0432\u043E\u043D \u0442\u0443\u0434\u0430.
      \u0421 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u043E\u043C \u2014
      \u0441\u0442\u043E\u0439 \u0437\u0434\u0435\u0441\u044C, \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435 \u0442\u043E\u043F\u0447\u0438\u0441\u044C \u043F\u043E \u043C\u043E\u043A\u0440\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000276
    m_Localized: "\u0422\u044B \u0437\u0434\u0435\u0441\u044C \u0441\u0442\u0438\u0440\u0430\u0435\u0448\u044C
      \u0438 \u0447\u0438\u043D\u0438\u0448\u044C \u043E\u0434\u0435\u0436\u0434\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000277
    m_Localized: "\u0421\u0442\u0438\u0440\u0430\u044E, \u043B\u0430\u0442\u0430\u044E,
      \u0432\u044B\u0432\u043E\u0436\u0443 \u043F\u044F\u0442\u043D\u0430. \u0414\u0435\u0440\u0436\u0443
      \u043A\u043E\u0440\u044B\u0442\u043E, \u043C\u044B\u043B\u043E, \u0438\u0433\u043B\u0443
      \u0438 \u0447\u0443\u0436\u043E\u0435 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435.
      \u0420\u0430\u0431\u043E\u0442\u0430 \u043D\u0435 \u0433\u0435\u0440\u043E\u0439\u0441\u043A\u0430\u044F,
      \u0437\u0430\u0442\u043E \u043F\u043E\u0441\u043B\u0435 \u043D\u0435\u0451
      \u043B\u044E\u0434\u0438 \u0432\u044B\u0445\u043E\u0434\u044F\u0442 \u043A
      \u0434\u0440\u0443\u0433\u0438\u043C \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E
      \u043D\u0438\u0447\u0435\u0433\u043E \u0441 \u043D\u0438\u043C\u0438 \u043D\u0435
      \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000278
    m_Localized: "\u041F\u043E \u043E\u0434\u0435\u0436\u0434\u0435 \u0438 \u043F\u0440\u0430\u0432\u0434\u0430
      \u043C\u043E\u0436\u043D\u043E \u043C\u043D\u043E\u0433\u043E\u0435 \u043F\u043E\u043D\u044F\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000279
    m_Localized: "\u041C\u043D\u043E\u0433\u043E. \u041D\u043E \u043D\u0435 \u0432\u0441\u0451,
      \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u0443\u0432\u0438\u0434\u0435\u0442\u044C,
      \u0441\u0442\u043E\u0438\u0442 \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C.
      \u0412\u043E\u0442 \u0440\u0443\u0431\u0430\u0445\u0430: \u043D\u0430 \u043B\u043E\u043A\u0442\u0435
      \u0432\u044A\u0435\u043B\u0430\u0441\u044C \u0441\u0430\u0436\u0430, \u043F\u043E\u0434\u043E\u043B
      \u0432 \u0440\u0435\u043F\u044C\u044F\u0445, \u0432\u043E\u0440\u043E\u0442\u043D\u0438\u043A
      \u043D\u0430\u0442\u0451\u0440\u0442 \u0440\u0435\u043C\u043D\u0451\u043C.
      \u0417\u043D\u0430\u0447\u0438\u0442, \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0440\u0430\u0431\u043E\u0442\u0430\u043B, \u0448\u0451\u043B \u0447\u0435\u0440\u0435\u0437
      \u043A\u0443\u0441\u0442\u044B, \u0442\u0430\u0449\u0438\u043B \u043D\u043E\u0448\u0443.
      \u0410 \u043A\u0443\u0434\u0430 \u0438 \u0437\u0430\u0447\u0435\u043C \u2014
      \u044D\u0442\u043E \u0443\u0436\u0435 \u043D\u0435 \u043C\u043E\u044F \u0440\u0430\u0431\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000280
    m_Localized: "\u0412\u044B\u0445\u043E\u0434\u0438\u0442, \u0442\u044B \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u0441\u0443\u0434\u0438\u0448\u044C \u043F\u043E \u0432\u0438\u0434\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000281
    m_Localized: "\u041D\u0435\u0442. \u042F \u0441\u0443\u0434\u0438\u043B\u0430
      \u0431\u044B, \u0435\u0441\u043B\u0438 \u0431 \u0440\u0435\u0448\u0430\u043B\u0430,
      \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u043E\u043D \u0438\u043B\u0438
      \u0434\u0443\u0440\u043D\u043E\u0439. \u0411\u0435\u043B\u044C\u0451 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0441 \u043D\u0438\u043C \u0434\u0435\u043B\u0430\u043B\u0438.
      \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u2014 \u0441\u043E\u0432\u0441\u0435\u043C
      \u0434\u0440\u0443\u0433\u043E\u0435 \u0434\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000282
    m_Localized: "\u0418 \u043B\u044E\u0434\u0438 \u043F\u0440\u0430\u0432\u0434\u0430
      \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u043A \u0442\u0435\u0431\u0435
      \u0441 \u0442\u0430\u0439\u043D\u0430\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000283
    m_Localized: "\u0421 \u0442\u0430\u0439\u043D\u0430\u043C\u0438 \u2014 \u043D\u0435\u0442.
      \u0421 \u0433\u0440\u044F\u0437\u044C\u044E \u2014 \u0434\u0430. \u0422\u0430\u0439\u043D\u0430
      \u043E\u0431\u044B\u0447\u043D\u043E \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0435 \u0432 \u0442\u043A\u0430\u043D\u0438, \u0430 \u0432 \u0442\u043E\u043C,
      \u0447\u0442\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441\u0430\u043C
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0442\u044C,
      \u0445\u043E\u0442\u044F \u0435\u0433\u043E \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000284
    m_Localized: "\u0427\u0442\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438
      \u0443 \u0442\u0435\u0431\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000285
    m_Localized: "\u0420\u0430\u043D\u044C\u0448\u0435 \u0441 \u0442\u0440\u0430\u043A\u0442\u0430
      \u0442\u0430\u0449\u0438\u043B\u0438 \u043F\u044B\u043B\u044C, \u043A\u0440\u043E\u0432\u044C,
      \u0432\u0438\u043D\u043E \u0438 \u0447\u0435\u0440\u043D\u0438\u043B\u0430.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0447\u0438\u043D\u044F\u0442 \u0441\u0442\u0430\u0440\u043E\u0435,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043D\u0430\u0434\u0435\u0442\u044C
      \u043D\u043E\u0432\u043E\u0435, \u0438 \u043F\u043E \u0434\u0432\u0430 \u0440\u0430\u0437\u0430
      \u0434\u0443\u043C\u0430\u044E\u0442, \u043F\u0443\u0441\u043A\u0430\u0442\u044C
      \u043B\u0438 \u043A\u0443\u0441\u043E\u043A \u043C\u044B\u043B\u0430 \u043D\u0430
      \u0432\u043E\u0440\u043E\u0442\u043D\u0438\u043A. \u0411\u0435\u0434\u0430
      \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u0445\u043E\u0434\u0438\u0442
      \u0441 \u043A\u0440\u0438\u043A\u043E\u043C. \u0418\u043D\u043E\u0433\u0434\u0430
      \u043E\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442
      \u0442\u043A\u0430\u043D\u044C \u0442\u043E\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000286
    m_Localized: "\u0425\u0430\u043B\u044C\u0432\u0430\u0440 \u043E\u0442\u0434\u0430\u0451\u0442
      \u0431\u0435\u043B\u044C\u0451 \u0442\u0435\u0431\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000287
    m_Localized: "\u041E\u0442\u0434\u0430\u0451\u0442. \u0418 \u0437\u043D\u0430\u0435\u0442,
      \u0447\u0442\u043E \u044F \u043D\u0435 \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u044E,
      \u043A\u0442\u043E \u0432 \u043A\u0430\u043A\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u0435
      \u043D\u043E\u0447\u0435\u0432\u0430\u043B. \u0421\u0435\u0439\u0447\u0430\u0441
      \u043F\u043E\u0441\u0442\u0435\u043B\u0435\u0439 \u0441\u0442\u0430\u043B\u043E
      \u043C\u0435\u043D\u044C\u0448\u0435, \u0430 \u0442\u0440\u0435\u0432\u043E\u0433\u0438
      \u0432 \u043D\u0438\u0445 \u0431\u043E\u043B\u044C\u0448\u0435. \u041F\u0443\u0441\u0442\u0430\u044F
      \u043A\u043E\u043C\u043D\u0430\u0442\u0430 \u0442\u043E\u0436\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0441\u043B\u0435\u0434 \u2014 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u0445\u043E\u0437\u044F\u0438\u043D\u0443 \u0442\u0430\u0432\u0435\u0440\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000288
    m_Localized: "\u0427\u0442\u043E \u0434\u043B\u044F \u0442\u0435\u0431\u044F
      \u0437\u043D\u0430\u0447\u0438\u0442 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430
      \u0423\u043B\u044C\u0440\u0438\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000289
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u043A\u043E\u043B\u0435\u0441\u043E
      \u0432\u0441\u0442\u0430\u043B\u043E, \u0432 \u043A\u0430\u0436\u0434\u043E\u0439
      \u043A\u043E\u0440\u0437\u0438\u043D\u0435 \u0432\u0434\u0440\u0443\u0433 \u0441\u0442\u0430\u043B\u043E
      \u043C\u0435\u043D\u044C\u0448\u0435 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u0438.
      \u041C\u0443\u043A\u0443 \u043E\u0442\u0441\u0442\u0438\u0440\u0430\u0442\u044C
      \u043B\u0435\u0433\u043A\u043E. \u0413\u043E\u0440\u0430\u0437\u0434\u043E
      \u0445\u0443\u0436\u0435, \u043A\u043E\u0433\u0434\u0430 \u043B\u044E\u0434\u0438
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0434\u0435\u043B\u0438\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043C\u0435\u0448\u043E\u043A
      \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E \u043E\u043D \u0443\u0436\u0435
      \u043D\u0435 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000290
    m_Localized: "\u041C\u0435\u0439\u0440\u0430 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043A \u0442\u0435\u0431\u0435 \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000291
    m_Localized: "\u041F\u0440\u043E\u0441\u0438\u0442 \u0441\u0442\u0430\u0440\u043E\u0435
      \u0447\u0438\u0441\u0442\u043E\u0435 \u043F\u043E\u043B\u043E\u0442\u043D\u043E
      \u043D\u0430 \u043F\u043E\u0432\u044F\u0437\u043A\u0438 \u0438 \u0438\u043D\u043E\u0433\u0434\u0430
      \u0443\u0447\u0438\u0442, \u043A\u0430\u043A \u0435\u0433\u043E \u043A\u0438\u043F\u044F\u0442\u0438\u0442\u044C,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043D\u0430\u0432\u0440\u0435\u0434\u0438\u0442\u044C
      \u0440\u0430\u043D\u0435\u043D\u043E\u043C\u0443. \u041E\u043D\u0430 \u043D\u0435
      \u043B\u0430\u0441\u043A\u043E\u0432\u0430\u044F. \u0417\u0430\u0442\u043E,
      \u043A\u043E\u0433\u0434\u0430 \u0434\u0435\u043B\u043E \u0434\u043E\u0445\u043E\u0434\u0438\u0442
      \u0434\u043E \u043A\u0440\u043E\u0432\u0438, \u043E\u0442 \u0435\u0451 \u0440\u0443\u043A
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u043E\u043B\u043A\u0443, \u0447\u0435\u043C
      \u043E\u0442 \u043C\u043D\u043E\u0433\u0438\u0445 \u0434\u043E\u0431\u0440\u044B\u0445
      \u0441\u043B\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000292
    m_Localized: "\u041A\u0430\u043A \u0442\u044B \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C
      \u043D\u0430 \u0441\u0442\u0440\u0430\u0436\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000293
    m_Localized: "\u0418\u0445 \u0441\u0430\u043F\u043E\u0433\u0438 \u043F\u0430\u0447\u043A\u0430\u044E\u0442
      \u043F\u043E\u043B \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0443
      \u0434\u0440\u0443\u0433\u0438\u0445. \u041D\u043E \u043D\u0430 \u043D\u0438\u0445
      \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u043F\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u0435\u0435:
      \u0435\u0441\u043B\u0438 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u043C\u0438\u043C\u043E \u0447\u0443\u0436\u043E\u0439 \u0431\u0435\u0434\u044B,
      \u044D\u0442\u043E \u0437\u0430\u043C\u0435\u0447\u0430\u044E\u0442 \u0432\u0441\u0435.
      \u0410 \u0435\u0441\u043B\u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
      \u2014 \u0447\u0430\u0449\u0435 \u043F\u043E\u043C\u043D\u044F\u0442, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0436\u0434\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000294
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000295
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u041F\u043E\u0439\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000296
    m_Localized: "\u041D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000297
    m_Localized: "\u0415\u0441\u043B\u0438 \u0434\u0435\u043B\u043E \u043C\u043E\u0436\u043D\u043E
      \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u0432 \u0434\u0432\u0443\u0445
      \u0444\u0440\u0430\u0437\u0430\u0445 \u2014 \u043D\u0430\u0437\u044B\u0432\u0430\u0439.
      \u0415\u0441\u043B\u0438 \u043D\u0435\u043B\u044C\u0437\u044F, \u0441\u0430\u0434\u0438\u0441\u044C
      \u0438 \u043D\u0430\u0447\u043D\u0438 \u0441 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E
      \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000298
    m_Localized: "\u0427\u0435\u043C \u0442\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F
      \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000299
    m_Localized: "\u041F\u043E\u043A\u0443\u043F\u0430\u044E \u0437\u0430\u043F\u0430\u0441,
      \u043A\u043E\u0433\u0434\u0430 \u0443 \u043A\u043E\u0433\u043E-\u0442\u043E
      \u0438\u0437\u0431\u044B\u0442\u043E\u043A; \u0434\u0430\u044E \u0432 \u0434\u043E\u043B\u0433,
      \u043A\u043E\u0433\u0434\u0430 \u0443 \u043A\u043E\u0433\u043E-\u0442\u043E
      \u043F\u0440\u043E\u0432\u0430\u043B; \u0441\u0432\u043E\u0436\u0443 \u043B\u044E\u0434\u0435\u0439,
      \u043A\u043E\u0433\u0434\u0430 \u0438\u043C \u043D\u0443\u0436\u043D\u043E
      \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0443
      \u0442\u043E, \u043D\u0430 \u0447\u0442\u043E \u0443 \u043D\u0438\u0445 \u043D\u0435\u0442
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438. \u041D\u0435\u043A\u0440\u0430\u0441\u0438\u0432\u043E
      \u0437\u0432\u0443\u0447\u0438\u0442? \u0420\u0430\u0431\u043E\u0442\u0430
      \u0440\u0435\u0434\u043A\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u043A\u0440\u0430\u0441\u0438\u0432\u043E, \u0435\u0441\u043B\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0440\u0430\u0441\u0447\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000300
    m_Localized: "\u0422\u044B \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u0443\u043C\u0430\u0435\u0448\u044C
      \u043E \u0434\u043E\u043B\u0433\u0430\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000301
    m_Localized: "\u0414\u043E\u043B\u0433 \u2014 \u043D\u0435 \u043A\u043B\u0435\u0439\u043C\u043E.
      \u042D\u0442\u043E \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u0435, \u0447\u0442\u043E
      \u043D\u044B\u043D\u0435\u0448\u043D\u044F\u044F \u0431\u0435\u0434\u0430 \u043D\u0435
      \u0441\u0442\u0430\u043D\u0435\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439.
      \u041F\u043B\u043E\u0445\u043E \u043D\u0435 \u0442\u043E, \u0447\u0442\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442;
      \u043F\u043B\u043E\u0445\u043E, \u043A\u043E\u0433\u0434\u0430 \u043E\u043D
      \u0443\u0431\u0435\u0436\u0434\u0430\u0435\u0442 \u0441\u0435\u0431\u044F,
      \u0431\u0443\u0434\u0442\u043E \u0441\u0440\u043E\u043A\u043E\u0432 \u043D\u0435\u0442
      \u0438 \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u043A\u043E\u043C\u0443-\u0442\u043E \u0434\u0440\u0443\u0433\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000302
    m_Localized: "\u0422\u044B \u0441\u0447\u0438\u0442\u0430\u0435\u0448\u044C \u043B\u044E\u0434\u0435\u0439
      \u0446\u0438\u0444\u0440\u0430\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000303
    m_Localized: "\u0415\u0441\u043B\u0438 \u0431\u044B \u0441\u0447\u0438\u0442\u0430\u043B,
      \u043D\u0435 \u0434\u0430\u0432\u0430\u043B \u0431\u044B \u0432 \u0434\u043E\u043B\u0433.
      \u0427\u0438\u0441\u043B\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u0442
      \u043E\u0442\u0441\u0440\u043E\u0447\u043A\u0443, \u043D\u0435 \u0445\u043E\u0440\u043E\u043D\u0438\u0442
      \u0440\u043E\u0434\u043D\u044B\u0445 \u0438 \u043D\u0435 \u043B\u0436\u0451\u0442
      \u0441\u0435\u0431\u0435 \u0438\u0437 \u0441\u0442\u044B\u0434\u0430. \u041D\u043E
      \u0431\u0435\u0437 \u0447\u0438\u0441\u043B\u0430 \u044F \u043D\u0435 \u043F\u043E\u0439\u043C\u0443,
      \u0433\u0434\u0435 \u043F\u043E\u043C\u043E\u0449\u044C \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0443 \u0436\u0438\u0442\u044C
      \u0437\u0430 \u0447\u0443\u0436\u043E\u0439 \u0441\u0447\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000304
    m_Localized: "\u0410 \u043A\u043E\u0433\u0434\u0430 \u0434\u043E\u043B\u0433\u0438
      \u043F\u0440\u043E\u0449\u0430\u044E\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000305
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0432\u0437\u044B\u0441\u043A\u0430\u043D\u0438\u0435
      \u043B\u043E\u043C\u0430\u0435\u0442 \u043E\u0431\u043E\u0438\u0445. \u0411\u0435\u0434\u043D\u044F\u043A
      \u0431\u0435\u0437 \u043A\u0440\u044B\u0448\u0438 \u0443\u0436\u0435 \u043D\u0435
      \u0432\u0435\u0440\u043D\u0451\u0442 \u043D\u0438\u0447\u0435\u0433\u043E;
      \u0441\u043E\u0441\u0435\u0434, \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443
      \u043F\u043E\u043C\u043E\u0433\u043B\u0438 \u043E\u0434\u0438\u043D \u0440\u0430\u0437,
      \u043C\u043E\u0436\u0435\u0442 \u0432\u044B\u0441\u0442\u043E\u044F\u0442\u044C
      \u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0434\u0435\u043D\u044C\u0433\u0438. \u041C\u0438\u043B\u043E\u0441\u0442\u044C
      \u0431\u0435\u0437 \u043F\u0430\u043C\u044F\u0442\u0438 \u2014 \u0433\u043B\u0443\u043F\u043E\u0441\u0442\u044C.
      \u0420\u0430\u0441\u0447\u0451\u0442 \u0431\u0435\u0437 \u043D\u0435\u0451
      \u2014 \u0442\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000306
    m_Localized: "\u041A\u0430\u043A \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438
      \u0442\u0432\u043E\u0451 \u0434\u0435\u043B\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000307
    m_Localized: "\u041A\u0440\u0443\u0433 \u0441\u0443\u0437\u0438\u043B\u0441\u044F.
      \u0422\u043E\u0432\u0430\u0440 \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442,
      \u0434\u0435\u043D\u044C\u0433\u0438 \u043B\u0435\u0436\u0430\u0442 \u0431\u0435\u0437
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F, \u043B\u044E\u0434\u0438
      \u0431\u043E\u044F\u0442\u0441\u044F \u0442\u0440\u0430\u0442\u0438\u0442\u044C
      \u0434\u0430\u0436\u0435 \u043D\u0430 \u043D\u0443\u0436\u043D\u043E\u0435.
      \u0412 \u0442\u0430\u043A\u0438\u0435 \u0434\u043D\u0438 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
      \u043E\u043F\u0430\u0441\u043D\u044B \u0442\u0435, \u043A\u0442\u043E \u043E\u0431\u0435\u0449\u0430\u0435\u0442
      \u0432\u0441\u0435\u043C \u043F\u0440\u0435\u0436\u043D\u044E\u044E \u0436\u0438\u0437\u043D\u044C
      \u0437\u0430 \u043E\u0434\u043D\u0443 \u043F\u0440\u043E\u0441\u0442\u0443\u044E
      \u043F\u043E\u0434\u043F\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000308
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u043E\u0441\u0442\u0430\u0451\u0448\u044C\u0441\u044F
      \u0438\u043C\u0435\u043D\u043D\u043E \u0432 \u044D\u0442\u043E\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000309
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u0432\u043E\u0434\u0430, \u043F\u043E\u043B\u044F,
      \u0440\u0435\u043C\u0435\u0441\u043B\u043E \u0438 \u0434\u043E\u0440\u043E\u0433\u0430
      \u2014 \u043A\u043E\u0433\u0434\u0430 \u0435\u0451 \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442.
      \u041B\u044E\u0434\u0438 \u043B\u044E\u0431\u044F\u0442 \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u0442\u0430\u043A\u0438\u0435 \u043C\u0435\u0441\u0442\u0430 \u0431\u0435\u0434\u043D\u044B\u043C\u0438,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E\u0442,
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u0440\u0443\u0434\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0434\u0438\u043D \u0434\u0432\u043E\u0440.
      \u041C\u043D\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0435\u0435
      \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C\u0441\u044F \u0442\u0430\u043C,
      \u0433\u0434\u0435 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u043C\u043E\u0436\u043D\u043E
      \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0431\u0435\u0437 \u043A\u0430\u0440\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000310
    m_Localized: "\u0427\u0442\u043E \u0442\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C
      \u043E\u0431 \u0423\u043B\u044C\u0440\u0438\u043A\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000311
    m_Localized: "\u041E\u043D \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u043C\u0435\u043B\u044C\u043D\u0438\u043A:
      \u0437\u043D\u0430\u0435\u0442 \u043A\u043E\u043B\u0435\u0441\u043E, \u0432\u043E\u0434\u0443
      \u0438 \u0437\u0435\u0440\u043D\u043E. \u042D\u0442\u043E \u043D\u0435 \u043C\u0430\u043B\u043E\u0441\u0442\u044C.
      \u041D\u043E \u0441\u043B\u0443\u0436\u0431\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0435\u0449\u0451 \u0441\u0440\u043E\u043A\u043E\u0432, \u0431\u0443\u043C\u0430\u0433
      \u0438 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u043E\u0432, \u0430 \u043E\u043D
      \u0441\u0447\u0438\u0442\u0430\u0435\u0442 \u0438\u0445 \u0434\u043E\u0441\u0430\u0434\u043D\u044B\u043C\u0438
      \u043C\u0435\u043B\u043E\u0447\u0430\u043C\u0438. \u0422\u0430\u043A\u0438\u0435
      \u043B\u044E\u0434\u0438 \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442
      \u043E \u0437\u0430\u043A\u043E\u043D\u0435, \u043A\u043E\u0433\u0434\u0430
      \u043E\u043D \u0443\u0436\u0435 \u0441\u0442\u043E\u0438\u0442 \u0443 \u043F\u043E\u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000312
    m_Localized: "\u041A\u0430\u043A \u0442\u044B \u043E\u0442\u043D\u043E\u0441\u0438\u0448\u044C\u0441\u044F
      \u043A \u041C\u0435\u0439\u0440\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000313
    m_Localized: "\u041E\u043D\u0430 \u043F\u0440\u043E\u0434\u0430\u0451\u0442 \u043D\u0435
      \u043D\u0430\u0434\u0435\u0436\u0434\u0443, \u0430 \u0442\u043E, \u0447\u0442\u043E
      \u0443\u043C\u0435\u0435\u0442. \u0418\u043D\u043E\u0433\u0434\u0430 \u043E\u0448\u0438\u0431\u0430\u0435\u0442\u0441\u044F,
      \u043D\u043E \u043D\u0435 \u043F\u0440\u044F\u0447\u0435\u0442 \u044D\u0442\u043E
      \u0437\u0430 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438.
      \u0414\u043B\u044F \u0441\u0434\u0435\u043B\u043A\u0438 \u044D\u0442\u043E
      \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E.
      \u0414\u043B\u044F \u0434\u0440\u0443\u0436\u0431\u044B \u2014 \u043D\u0435
      \u0437\u043D\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000314
    m_Localized: "\u0422\u044B \u0434\u043E\u0432\u0435\u0440\u044F\u0435\u0448\u044C
      \u0441\u0442\u0440\u0430\u0436\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000315
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u044E\u0442
      \u0442\u043E, \u0447\u0442\u043E \u043D\u0435\u043B\u044C\u0437\u044F \u0440\u0435\u0448\u0438\u0442\u044C
      \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u043E\u0439. \u041D\u043E
      \u0436\u0434\u0430\u0442\u044C \u0435\u0451 \u0432\u043C\u0435\u0441\u0442\u043E
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u044F
      \u2014 \u0434\u043E\u0440\u043E\u0433\u043E\u0435 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435.
      \u041E\u043D\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442, \u043A\u043E\u0433\u0434\u0430
      \u043C\u043E\u0436\u0435\u0442; \u0441\u0447\u0451\u0442 \u0437\u0430 \u043F\u0440\u043E\u043C\u0435\u0434\u043B\u0435\u043D\u0438\u0435
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043F\u043B\u0430\u0442\u0438\u0442
      \u0434\u0435\u0440\u0435\u0432\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000316
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000317
    m_Localized: "\u041D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0445\u0432\u0430\u0442\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000318
    m_Localized: "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000319
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C \u0431\u0443\u043C\u0430\u0433\u0438
      \u0423\u043B\u044C\u0440\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000320
    m_Localized: "\u0411\u0443\u043C\u0430\u0433\u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u044B
      \u0437\u0430\u043A\u043E\u043D\u043D\u043E\u043C\u0443 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0443.
      \u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0443 \u0423\u043B\u044C\u0440\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000321
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0434\u0435\u043B\u043A\u0443
      \u041A\u043E\u0440\u0432\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000322
    m_Localized: "\u0421\u043F\u043E\u0440 \u043E \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435
      \u0437\u0430\u043A\u0440\u044B\u0442 \u0441\u0434\u0435\u043B\u043A\u043E\u0439.
      \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F
      \u0443 \u041A\u043E\u0440\u0432\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000323
    m_Localized: "\u0411\u0443\u043C\u0430\u0433\u0438 \u0443 \u0442\u0435\u0431\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000324
    m_Localized: "\u0423 \u043C\u0435\u043D\u044F. \u0412 \u044F\u0449\u0438\u043A\u0435
      \u043F\u043E\u0434 \u0437\u0430\u043C\u043A\u043E\u043C, \u043A\u0430\u043A
      \u0438 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u043E \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E
      \u0434\u043D\u044F. \u0421\u0442\u0440\u0430\u043D\u043D\u043E \u0440\u0430\u0434\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043A\u043B\u043E\u0447\u043A\u0443 \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E,
      \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0432\u043E\u0434\u0430 \u043F\u043E\u0448\u043B\u0430 \u043D\u0430 \u043A\u043E\u043B\u0435\u0441\u043E,
      \u044F \u043C\u043E\u0433\u0443 \u0434\u0443\u043C\u0430\u0442\u044C \u043E
      \u043C\u0443\u043A\u0435, \u0430 \u043D\u0435 \u043E \u0442\u043E\u043C, \u043A\u0442\u043E
      \u043F\u0440\u0438\u0434\u0451\u0442 \u0441 \u0447\u0443\u0436\u043E\u0439
      \u043F\u043E\u0434\u043F\u0438\u0441\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000325
    m_Localized: "\u0427\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0431\u0443\u0434\u0435\u0442
      \u0441 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000326
    m_Localized: "\u041A\u043E\u043B\u0435\u0441\u043E \u043A\u0440\u0443\u0442\u0438\u0442\u0441\u044F
      \u2014 \u043F\u043E\u043A\u0430 \u044D\u0442\u043E \u0433\u043B\u0430\u0432\u043D\u043E\u0435.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0431\u0443\u043C\u0430\u0433\u0438 \u0432\u0441\u0451
      \u0440\u0430\u0432\u043D\u043E \u043D\u0435 \u0443 \u043C\u0435\u043D\u044F.
      \u041A\u043E\u0440\u0432\u0438\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0447\u0442\u043E \u0434\u043E\u0433\u043E\u0432\u043E\u0440 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0434\u0435\u043B\u043E; \u044F \u0432\u0438\u0434\u0435\u043B, \u043A\u0430\u043A
      \u0442\u0430\u043A\u0438\u0435 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u044B
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443 \u043D\u0443\u0436\u043D\u043E
      \u043F\u0440\u0438\u0436\u0430\u0442\u044C \u0434\u0440\u0443\u0433\u043E\u0433\u043E.
      \u0411\u0443\u0434\u0443 \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0441\u0447\u0451\u0442
      \u0440\u043E\u0432\u043D\u043E \u0438 \u043D\u0435 \u0434\u0430\u0432\u0430\u0442\u044C
      \u0435\u043C\u0443 \u043F\u043E\u0432\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000327
    m_Localized: "\u041A\u0430\u043A \u043F\u043E\u043B\u044F \u043F\u0435\u0440\u0435\u0436\u0438\u043B\u0438
      \u0438\u0441\u0442\u043E\u0440\u0438\u044E \u0441 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0435\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000328
    m_Localized: "\u041B\u044E\u0434\u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438
      \u043F\u0440\u044F\u0442\u0430\u0442\u044C \u0437\u0435\u0440\u043D\u043E \u043F\u043E
      \u0441\u0443\u043D\u0434\u0443\u043A\u0430\u043C. \u0417\u043D\u0430\u044E\u0442:
      \u043E\u0442\u0432\u0435\u0437\u0443\u0442 \u2014 \u0441\u043C\u0435\u043B\u044E\u0442.
      \u041E\u0434\u043D\u043E\u0439 \u0431\u0443\u043C\u0430\u0433\u0438 \u0445\u043B\u0435\u0431\u0430
      \u043D\u0435 \u043F\u0440\u0438\u0431\u0430\u0432\u0438\u043B\u043E\u0441\u044C,
      \u043D\u043E \u0431\u0435\u0437 \u043D\u0435\u0451 \u043A\u0430\u0436\u0434\u044B\u0439
      \u043D\u0430\u0447\u0430\u043B \u0431\u044B \u0441\u043F\u0430\u0441\u0430\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0432\u043E\u0439 \u043C\u0435\u0448\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000329
    m_Localized: "\u0427\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u044F\u0442 \u043E
      \u0441\u0434\u0435\u043B\u043A\u0435 \u0441 \u041A\u043E\u0440\u0432\u0438\u043D\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000330
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u044F\u0442 \u0432\u043F\u043E\u043B\u0433\u043E\u043B\u043E\u0441\u0430.
      \u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442,
      \u0438 \u0437\u0430 \u044D\u0442\u043E \u0432\u0441\u0435 \u0440\u0430\u0434\u044B.
      \u041D\u043E \u0442\u0435\u043F\u0435\u0440\u044C, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0432\u0435\u0437\u0442\u0438 \u0437\u0435\u0440\u043D\u043E,
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0434\u0443\u043C\u0430\u0435\u0442,
      \u043A\u043E\u043C\u0443 \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435
      \u043E\u0431\u0435\u0449\u0430\u0435\u0442 \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443.
      \u041E\u0442 \u0442\u0430\u043A\u043E\u0439 \u043C\u044B\u0441\u043B\u0438
      \u043F\u043E\u043B\u0435 \u043D\u0435 \u0441\u043E\u0445\u043D\u0435\u0442,
      \u043D\u043E \u0440\u0443\u043A\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
      \u0442\u044F\u0436\u0435\u043B\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000331
    m_Localized: "\u0421\u0442\u0430\u043B\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435
      \u043F\u043E\u0441\u043B\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
      \u0431\u0443\u043C\u0430\u0433?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000332
    m_Localized: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435. \u041B\u044E\u0434\u0438
      \u0441\u043D\u043E\u0432\u0430 \u043D\u0435\u0441\u0443\u0442 \u0431\u0435\u043B\u044C\u0451
      \u043A \u0440\u0435\u043A\u0435 \u0438 \u0441\u043F\u043E\u0440\u044F\u0442
      \u043E \u043F\u044F\u0442\u043D\u0430\u0445, \u0430 \u043D\u0435 \u043E \u0442\u043E\u043C,
      \u043A\u043E\u043C\u0443 \u0434\u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043C\u0435\u0448\u043E\u043A
      \u043C\u0443\u043A\u0438. \u042F \u0437\u043D\u0430\u044E: \u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0435
      \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u043D\u0430\u0447\u0438\u0442
      \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u044C.
      \u041D\u043E \u0437\u0434\u0435\u0441\u044C \u0445\u043E\u0442\u044F \u0431\u044B
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438 \u0436\u0434\u0430\u0442\u044C
      \u043D\u043E\u0432\u043E\u0433\u043E \u0443\u0434\u0430\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000333
    m_Localized: "\u0427\u0442\u043E \u043B\u044E\u0434\u0438 \u0434\u0443\u043C\u0430\u044E\u0442
      \u043E \u0441\u0434\u0435\u043B\u043A\u0435 \u0441 \u041A\u043E\u0440\u0432\u0438\u043D\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000334
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0434\u0443\u043C\u0430\u0435\u0442
      \u0441\u0432\u043E\u0451 \u0438 \u0434\u0435\u043B\u0430\u0435\u0442 \u0432\u0438\u0434,
      \u0447\u0442\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0437\u043D\u0430\u0435\u0442.
      \u0423\u043B\u044C\u0440\u0438\u043A \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F,
      \u041A\u043E\u0440\u0432\u0438\u043D \u0432\u0435\u0436\u043B\u0438\u0432,
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u0448\u0443\u043C\u0438\u0442.
      \u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E \u043E\u0434\u0435\u0436\u0434\u0435
      \u0432\u0438\u0434\u043D\u043E: \u043B\u044E\u0434\u0438 \u0447\u0430\u0449\u0435
      \u0441\u0442\u0430\u043B\u0438 \u043F\u0440\u044F\u0442\u0430\u0442\u044C \u043A\u043E\u0448\u0435\u043B\u0438
      \u043F\u043E\u0434 \u0440\u0443\u0431\u0430\u0445\u043E\u0439. \u0417\u043D\u0430\u0447\u0438\u0442,
      \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u0438\u043B\u0438, \u0447\u0442\u043E
      \u0434\u0435\u043B\u043E \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000335
    m_Localized: "\u0422\u044B \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043E\u0442 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000336
    m_Localized: "\u042F \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043E\u0442
      \u0431\u0443\u043C\u0430\u0433\u0438, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043D\u0435\u0447\u0438\u0441\u0442\u043E.
      \u041D\u0435 \u043D\u0430\u0434\u043E \u043F\u0440\u0438\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C
      \u043C\u043D\u0435 \u0440\u0430\u0441\u043A\u0430\u044F\u043D\u0438\u0435:
      \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C
      \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E
      \u043D\u0430 \u0442\u0430\u043A\u043E\u0439 \u043E\u043F\u043E\u0440\u0435.
      \u0423\u043B\u044C\u0440\u0438\u043A \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0448\u0430\u043D\u0441. \u0427\u0442\u043E \u043E\u043D \u0441 \u043D\u0438\u043C
      \u0441\u0434\u0435\u043B\u0430\u0435\u0442 \u2014 \u0443\u0436\u0435 \u0435\u0433\u043E
      \u0441\u0447\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000337
    m_Localized: "\u0422\u044B \u0434\u043E\u0432\u043E\u043B\u0435\u043D \u0441\u0434\u0435\u043B\u043A\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000338
    m_Localized: "\u0414\u043E\u0432\u043E\u043B\u0435\u043D \u2014 \u043F\u043B\u043E\u0445\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E. \u041C\u044B \u043D\u0430\u0448\u043B\u0438
      \u0446\u0435\u043D\u0443, \u043F\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u0442\u044B \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B \u0442\u044F\u043D\u0443\u0442\u044C
      \u0434\u0435\u043B\u043E \u0434\u0430\u043B\u044C\u0448\u0435, \u0430 \u0423\u043B\u044C\u0440\u0438\u043A
      \u043D\u0435 \u043B\u0438\u0448\u0438\u043B\u0441\u044F \u0440\u0430\u0431\u043E\u0442\u044B.
      \u0411\u0443\u043C\u0430\u0433\u0438 \u043E\u0441\u0442\u0430\u043D\u0443\u0442\u0441\u044F
      \u0443 \u043C\u0435\u043D\u044F \u0434\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F
      \u0433\u043E\u0440\u043E\u0434\u0430; \u043F\u043E\u0442\u043E\u043C \u044F
      \u0440\u0435\u0448\u0443, \u043A\u0430\u043A \u043E\u0444\u043E\u0440\u043C\u0438\u0442\u044C
      \u0432\u0441\u0451 \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0435\u0433\u043E
      \u0448\u0443\u043C\u0430. \u0414\u043B\u044F \u0434\u0435\u0440\u0435\u0432\u043D\u0438
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0432\u0430\u0436\u043D\u0435\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043A\u043E\u043B\u0435\u0441\u043E \u043A\u0440\u0443\u0442\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000339
    m_Localized: "\u0422\u0430\u0432\u0435\u0440\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
      \u0431\u044B\u043B\u0430 \u0442\u0430\u043A\u043E\u0439 \u043F\u043E\u043B\u043D\u043E\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000340
    m_Localized: "\u041D\u0435\u0442. \u041F\u043E\u043B\u043D\u0430\u044F \u0442\u0430\u0432\u0435\u0440\u043D\u0430
      \u2014 \u044D\u0442\u043E \u043A\u043E\u0433\u0434\u0430 \u043B\u044E\u0434\u0438
      \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0438 \u0432\u0435\u0447\u0435\u0440\u043E\u043C,
      \u043F\u043E\u0435\u043B\u0438, \u0443\u0442\u0440\u043E\u043C \u043F\u043E\u0434\u043D\u044F\u043B\u0438
      \u043F\u044B\u043B\u044C \u0438 \u0443\u0448\u043B\u0438. \u0410 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0441\u0447\u0438\u0442\u0430\u044E\u0442 \u043C\u0435\u0434\u044F\u043A\u0438,
      \u043F\u0440\u043E\u0441\u044F\u0442 \u0435\u0449\u0451 \u043D\u043E\u0447\u044C
      \u0432 \u0434\u043E\u043B\u0433 \u0438 \u0441\u043B\u0443\u0448\u0430\u044E\u0442
      \u0434\u0432\u0435\u0440\u044C, \u0431\u0443\u0434\u0442\u043E \u0437\u0430
      \u043D\u0435\u0439 \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u0434\u043E\u0440\u043E\u0433\u0430.
      \u0413\u043E\u0441\u0442\u044C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0442, \u043A\u043E\u0433\u0434\u0430
      \u0443\u0435\u0434\u0435\u0442, \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043F\u043E\u0447\u0442\u0438 \u0441\u043E\u0441\u0435\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000341
    m_Localized: "\u0418 \u0442\u044B \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435
      \u0432\u044B\u0433\u043E\u043D\u0438\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000342
    m_Localized: "\u041F\u043E\u043A\u0430 \u043C\u043E\u0433\u0443 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043C\u0438\u0441\u043A\u0443 \u2014 \u043D\u0435 \u0432\u044B\u0433\u043E\u043D\u044E.
      \u041D\u043E \u0436\u0430\u043B\u043E\u0441\u0442\u044C \u0442\u043E\u0436\u0435
      \u043D\u0430\u0434\u043E \u0443\u043C\u0435\u0442\u044C \u0441\u0447\u0438\u0442\u0430\u0442\u044C:
      \u0435\u0441\u043B\u0438 \u0440\u0430\u0437\u0434\u0430\u0442\u044C \u0432\u0441\u0451
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F, \u0437\u0430\u0432\u0442\u0440\u0430
      \u0437\u0430 \u044D\u0442\u043E\u0439 \u0441\u0442\u043E\u0439\u043A\u043E\u0439
      \u0431\u0443\u0434\u0435\u0442 \u0445\u043E\u043B\u043E\u0434\u043D\u043E \u0432\u0441\u0435\u043C.
      \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u0440\u0435\u0436\u0443
      \u0445\u043B\u0435\u0431 \u0442\u043E\u043D\u044C\u0448\u0435 \u0438 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u044E
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u043E\u043B\u0433. \u041D\u0438\u0447\u0435\u0433\u043E
      \u0431\u043B\u0430\u0433\u043E\u0440\u043E\u0434\u043D\u043E\u0433\u043E, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0442\u0430\u043A \u0434\u043E\u043B\u044C\u0448\u0435 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000343
    m_Localized: "\u041A\u0430\u043A \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438
      \u0442\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000344
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0438\u0441\u0447\u0435\u0437\u043B\u0438
      \u043D\u043E\u0432\u044B\u0435 \u0431\u043E\u0447\u043A\u0438, \u043F\u043E\u0442\u043E\u043C
      \u0441\u043E\u043B\u044C, \u043F\u043E\u0442\u043E\u043C \u043B\u044E\u0434\u0438
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438 \u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u0432\u0442\u043E\u0440\u0443\u044E \u043A\u0440\u0443\u0436\u043A\u0443.
      \u0422\u0435\u043F\u0435\u0440\u044C \u0441\u0443\u043F \u0433\u0443\u0449\u0435
      \u043D\u0435 \u043E\u0442 \u043C\u044F\u0441\u0430, \u0430 \u043E\u0442 \u0442\u043E\u0433\u043E,
      \u0447\u0442\u043E \u044F \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F
      \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0442\u044C
      \u043D\u0438\u0447\u0435\u0433\u043E \u0441\u044A\u0435\u0434\u043E\u0431\u043D\u043E\u0433\u043E.
      \u0412\u043E\u0440\u043E\u0442\u0430 \u0437\u0430\u043A\u0440\u044B\u043B\u0438
      \u043D\u0435 \u0434\u043E\u0440\u043E\u0433\u0443 \u2014 \u043E\u043D\u0438
      \u0437\u0430\u043A\u0440\u044B\u043B\u0438 \u0437\u0430\u0432\u0442\u0440\u0430\u0448\u043D\u044E\u044E
      \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000345
    m_Localized: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C
      \u0432 \u0434\u043E\u043B\u0433?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000346
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430. \u041D\u043E \u044F \u043D\u0435
      \u0434\u0430\u044E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443 \u0437\u0430\u0431\u044B\u0442\u044C,
      \u0447\u0442\u043E \u044D\u0442\u043E \u0434\u043E\u043B\u0433. \u0417\u0430\u0432\u0442\u0440\u0430
      \u0435\u043C\u0443 \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u043D\u0435 \u043A\u0440\u0443\u0436\u043A\u0430, \u0430 \u043C\u0435\u0441\u0442\u043E
      \u0443 \u043E\u0447\u0430\u0433\u0430. \u041B\u0443\u0447\u0448\u0435 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u043F\u0440\u044F\u043C\u043E \u0441\u0435\u0439\u0447\u0430\u0441, \u0447\u0435\u043C
      \u043F\u043E\u0442\u043E\u043C \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C,
      \u043A\u0430\u043A \u043E\u043D \u043F\u0440\u044F\u0447\u0435\u0442 \u0433\u043B\u0430\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000347
    m_Localized: "\u0427\u0442\u043E \u0437\u0430 \u043B\u044E\u0434\u0438 \u0441\u0435\u0439\u0447\u0430\u0441
      \u0436\u0438\u0432\u0443\u0442 \u0443 \u0442\u0435\u0431\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000348
    m_Localized: "\u0422\u0430\u043A\u0438\u0435 \u0436\u0435, \u043A\u0430\u043A
      \u0432\u0435\u0437\u0434\u0435: \u043E\u0434\u0438\u043D \u0436\u0434\u0451\u0442
      \u0434\u043E\u0431\u0440\u043E\u0439 \u0432\u0435\u0441\u0442\u0438, \u0434\u0440\u0443\u0433\u043E\u0439
      \u2014 \u0443\u0434\u043E\u0431\u043D\u043E\u0433\u043E \u0441\u043B\u0443\u0447\u0430\u044F.
      \u041C\u0430\u0440\u0442\u0430 \u0434\u0435\u0440\u0436\u0438\u0442 \u0432\u0435\u0449\u0438
      \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u043C\u0438, \u0431\u0443\u0434\u0442\u043E
      \u0432\u044B\u0435\u0437\u0434 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435. \u042D\u0434\u0440\u0438\u043A
      \u0441\u043F\u043E\u0440\u0438\u0442 \u0441\u043E \u0441\u043B\u0443\u0445\u0430\u043C\u0438,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0443\u0441\u0442\u0430\u043D\u0435\u0442
      \u0441\u0430\u043C. \u0420\u0443\u043D\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442.
      \u0410 \u0422\u0430\u0440\u0435\u043A\u2026 \u0422\u0430\u0440\u0435\u043A
      \u043F\u043B\u0430\u0442\u0438\u0442 \u0432\u043E\u0432\u0440\u0435\u043C\u044F
      \u0438 \u0441\u0442\u0430\u0440\u0430\u0435\u0442\u0441\u044F, \u0447\u0442\u043E\u0431\u044B
      \u0435\u0433\u043E \u043D\u0435 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000349
    m_Localized: "\u041A\u0442\u043E \u0438\u0437 \u043D\u0438\u0445 \u0442\u0435\u0431\u044F
      \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000350
    m_Localized: "\u0422\u043E\u0442, \u043A\u0442\u043E \u0443\u0432\u0435\u0440\u0435\u043D,
      \u0447\u0442\u043E \u0431\u0435\u0434\u0430 \u0441\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438.
      \u0422\u0430\u043A\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u0435\u0440\u0432\u044B\u043C
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0448\u0443\u043C \u0438
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C \u0431\u0435\u0440\u0451\u0442
      \u0432\u0435\u0434\u0440\u043E, \u043A\u043E\u0433\u0434\u0430 \u0433\u043E\u0440\u0438\u0442
      \u043A\u0440\u044B\u0448\u0430. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0445\u043E\u0442\u044F \u0431\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u044E\u0442,
      \u0447\u0442\u043E \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000351
    m_Localized: "\u041B\u0438\u0432\u0438\u043E \u0442\u0435\u0431\u0435 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000352
    m_Localized: "\u041E\u043D \u0443\u043C\u0435\u0435\u0442 \u043D\u0430\u0439\u0442\u0438
      \u0446\u0435\u043D\u0443 \u0432\u0435\u0449\u0438, \u043A\u043E\u0433\u0434\u0430
      \u0445\u043E\u0437\u044F\u0438\u043D \u0443\u0436\u0435 \u0433\u043E\u0442\u043E\u0432
      \u043E\u0442\u0434\u0430\u0442\u044C \u0435\u0451 \u0437\u0430 \u043C\u0438\u0441\u043A\u0443
      \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0438. \u0418\u043D\u043E\u0433\u0434\u0430
      \u044D\u0442\u043E \u0441\u043F\u0430\u0441\u0430\u0435\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u0438\u043D\u043E\u0433\u0434\u0430 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0435\u0433\u043E \u0431\u0435\u0437 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E.
      \u042F \u043D\u0435 \u0437\u043E\u0432\u0443 \u044D\u0442\u043E \u043F\u043E\u043C\u043E\u0449\u044C\u044E,
      \u043D\u043E \u041B\u0438\u0432\u0438\u043E \u043D\u0435 \u043B\u0435\u0437\u0435\u0442
      \u0432 \u043C\u043E\u0438 \u0431\u043E\u0447\u043A\u0438 \u0438 \u043F\u043B\u0430\u0442\u0438\u0442
      \u0437\u0430 \u0441\u0442\u043E\u043B. \u0423\u0436\u0435 \u043D\u0435\u043C\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000353
    m_Localized: "\u0422\u044B \u0435\u043C\u0443 \u0434\u043E\u0432\u0435\u0440\u044F\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000354
    m_Localized: "\u042F \u0434\u043E\u0432\u0435\u0440\u044F\u044E \u0435\u043C\u0443
      \u0441\u0447\u0438\u0442\u0430\u0442\u044C. \u0412\u0441\u0451 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E \u0441\u0430\u043C. \u042D\u0442\u043E
      \u043D\u0435 \u043E\u0431\u0438\u0434\u0430, \u0442\u0430\u043A \u0441 \u043B\u044E\u0434\u044C\u043C\u0438
      \u0435\u0433\u043E \u0440\u0435\u043C\u0435\u0441\u043B\u0430 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435
      \u0438 \u0438\u043C, \u0438 \u0442\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000355
    m_Localized: "\u0414\u0430\u0432\u043D\u043E \u0437\u043D\u0430\u0435\u0448\u044C
      \u0423\u043B\u044C\u0440\u0438\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000356
    m_Localized: "\u0414\u0430\u0432\u043D\u043E. \u041E\u043D \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B
      \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u043C\u043E\u043B\u0430, \u0441\u0430\u0434\u0438\u043B\u0441\u044F
      \u0443 \u0441\u0442\u0435\u043D\u044B \u0438 \u0441\u043F\u0435\u0440\u0432\u0430
      \u0441\u043B\u0443\u0448\u0430\u043B, \u043A\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u0434\u0440\u0443\u0433\u0438\u0435. \u041F\u043E\u0442\u043E\u043C \u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u043B
      \u0435\u0434\u0443 \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432
      \u2014 \u043D\u0435 \u0434\u043B\u044F \u0441\u0435\u0431\u044F \u043E\u0434\u043D\u043E\u0433\u043E.
      \u0423\u043B\u044C\u0440\u0438\u043A \u0443\u043F\u0440\u044F\u043C\u044B\u0439
      \u0438 \u0441 \u0431\u0443\u043C\u0430\u0433\u0430\u043C\u0438 \u043D\u0435
      \u0434\u0440\u0443\u0436\u0438\u0442, \u0437\u0430\u0442\u043E \u043F\u043E\u043C\u043D\u0438\u0442,
      \u0447\u0435\u0439 \u043C\u0435\u0448\u043E\u043A \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043B
      \u0438 \u043A\u043E\u043C\u0443 \u043D\u0430\u0434\u043E \u043E\u0442\u0434\u0430\u0442\u044C
      \u043C\u0443\u043A\u0443 \u0440\u0430\u043D\u044C\u0448\u0435. \u0414\u043B\u044F
      \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0430 \u044D\u0442\u043E \u0432\u0430\u0436\u043D\u0435\u0435
      \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0439 \u0440\u0435\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000357
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000358
    m_Localized: "\u041D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0445\u0432\u0430\u0442\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000359
    m_Localized: "\u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u2014 \u0433\u043E\u0432\u043E\u0440\u0438 \u0441\u043E \u043C\u043D\u043E\u0439.
      \u0411\u0440\u0430\u0442\u0430 \u043E\u0441\u0442\u0430\u0432\u044C \u0432
      \u043F\u043E\u043A\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000360
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u042D\u0434\u0440\u0438\u043A
      \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000361
    m_Localized: "\u041E\u043D \u0443\u043C\u0435\u0435\u0442 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.
      \u041F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u0431\u0443\u0434\u0435\u0442.
      \u0421 \u0447\u0443\u0436\u0438\u043C\u0438 \u2014 \u0442\u043E\u0447\u043D\u043E.
      \u041D\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0439 \u043D\u0430
      \u0441\u0432\u043E\u0439 \u0441\u0447\u0451\u0442: \u043E\u043D \u0442\u0430\u043A
      \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
      \u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u043D\u043E\u0433\u043E \u043B\u044E\u0434\u0435\u0439 \u0438 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432.
      \u042F \u0435\u0433\u043E \u0441\u0435\u0441\u0442\u0440\u0430, \u0420\u0443\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000362
    m_Localized: "\u0421 \u043D\u0438\u043C \u0447\u0442\u043E-\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000363
    m_Localized: "\u0421 \u043D\u0430\u043C\u0438 \u043E\u0431\u043E\u0438\u043C\u0438.
      \u041D\u0430\u0441 \u0437\u0430\u0431\u0440\u0430\u043B\u0438 \u0434\u0435\u0442\u044C\u043C\u0438
      \u2014 \u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0443
      \u043F\u043E\u0441\u043B\u0435 \u041A\u0440\u0430\u0441\u043D\u043E\u0439 \u041B\u0443\u043D\u044B.
      \u0412 \u0437\u0430\u043F\u0438\u0441\u044F\u0445 \u043D\u0430\u0441 \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0438
      \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438.
      \u041C\u0430\u0433\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u043B\u0438,
      \u0447\u0442\u043E \u0441 \u043D\u0430\u043C\u0438 \u0434\u0435\u043B\u0430\u0435\u0442
      \u0435\u0451 \u0441\u0432\u0435\u0442, \u0438 \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0438
      \u044D\u0442\u043E \u043B\u0435\u0447\u0435\u043D\u0438\u0435\u043C. \u041F\u043E\u0441\u043B\u0435
      \u043E\u0434\u043D\u043E\u0439 \u0442\u0430\u043A\u043E\u0439 \u043D\u043E\u0447\u0438
      \u042D\u0434\u0440\u0438\u043A \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B
      \u0438\u0445 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F.
      \u041E\u043D\u0438 \u0437\u0430\u043F\u0438\u0441\u0430\u043B\u0438: \u2018\u043F\u043E\u0434\u043E\u043F\u044B\u0442\u043D\u044B\u0439
      \u043D\u0435 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u0435\u0442\u2019.
      \u0411\u043E\u043B\u044C\u0448\u0435 \u043E\u043D \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000364
    m_Localized: "\u041A\u0442\u043E \u044D\u0442\u043E \u0434\u0435\u043B\u0430\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000365
    m_Localized: "\u041B\u044E\u0434\u0438 \u0432 \u0447\u0438\u0441\u0442\u044B\u0445
      \u0440\u0443\u043A\u0430\u0432\u0430\u0445. \u041E\u0434\u043D\u0438 \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0438
      \u0434\u0435\u0442\u0435\u0439 \u043F\u043E \u043D\u043E\u043C\u0435\u0440\u0430\u043C,
      \u0434\u0440\u0443\u0433\u0438\u0435 \u2014 \u043F\u043E \u0438\u043C\u0435\u043D\u0430\u043C.
      \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0438\u0441\u0447\u0435\u0437\u043B\u043E,
      \u043A\u043E\u0433\u0434\u0430 \u0434\u0435\u043B\u043E \u0441\u0442\u0430\u043B\u043E
      \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E. \u041D\u043E \u043E\u0434\u043D\u043E
      \u0438\u043C\u044F \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0432
      \u0431\u0443\u043C\u0430\u0433\u0430\u0445 \u0438 \u0432 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0445
      \u0442\u0435\u0445, \u043A\u0442\u043E \u0432\u044B\u0436\u0438\u043B: \u042D\u0440\u0434\u044D\u043D
      \u0412\u0435\u043B\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000366
    m_Localized: "\u0412\u044B \u0438\u0449\u0435\u0442\u0435 \u042D\u0440\u0434\u044D\u043D\u0430
      \u0412\u0435\u043B\u043B\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000367
    m_Localized: "\u0418\u0449\u0435\u043C. \u041C\u044B \u0448\u043B\u0438 \u043F\u043E
      \u0441\u0442\u0430\u0440\u044B\u043C \u043F\u0438\u0441\u044C\u043C\u0430\u043C
      \u0438 \u0447\u0443\u0436\u0438\u043C \u043E\u0431\u0440\u044B\u0432\u043A\u0430\u043C,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438
      \u043F\u0440\u043E \u043C\u0430\u0433\u0430 \u0432 \u0431\u0430\u0448\u043D\u0435.
      \u041D\u0435 \u0437\u043D\u0430\u044E, \u0436\u0434\u0451\u0442 \u043B\u0438
      \u0442\u0430\u043C \u0438\u043C\u0435\u043D\u043D\u043E \u043E\u043D. \u041D\u043E
      \u0435\u0441\u043B\u0438 \u044D\u0442\u043E \u042D\u0440\u0434\u044D\u043D,
      \u043E\u043D \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0442 \u0441\u043A\u0430\u0437\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043D\u0435 \u043F\u043E\u043C\u043D\u0438\u0442 \u043D\u0430\u0441:
      \u0443 \u043D\u0435\u0433\u043E \u0431\u044B\u043B\u0438 \u043D\u0430\u0448\u0438
      \u0438\u043C\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000368
    m_Localized: "\u0427\u0442\u043E \u0432\u044B \u0441\u0434\u0435\u043B\u0430\u0435\u0442\u0435,
      \u0435\u0441\u043B\u0438 \u043D\u0430\u0439\u0434\u0451\u0442\u0435 \u0435\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000369
    m_Localized: "\u041D\u0435 \u0431\u0443\u0434\u0443 \u043E\u0431\u0435\u0449\u0430\u0442\u044C
      \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0433\u043E \u043E\u0442\u0432\u0435\u0442\u0430.
      \u042D\u0434\u0440\u0438\u043A \u0445\u043E\u0447\u0435\u0442 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0435\u043C\u0443 \u0432 \u043B\u0438\u0446\u043E. \u042F \u0445\u043E\u0447\u0443,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043D \u043D\u0430\u0437\u0432\u0430\u043B
      \u0442\u043E, \u0447\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B, \u0441\u0432\u043E\u0438\u043C\u0438
      \u0441\u043B\u043E\u0432\u0430\u043C\u0438 \u2014 \u043D\u0435 \u2018\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435\u2019,
      \u043D\u0435 \u2018\u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C\u2019.
      \u0410 \u0434\u0430\u043B\u044C\u0448\u0435\u2026 \u0434\u0430\u043B\u044C\u0448\u0435
      \u043C\u044B \u0443\u0437\u043D\u0430\u0435\u043C, \u043A\u0442\u043E \u0438\u0437
      \u043D\u0430\u0441 \u0435\u0449\u0451 \u0443\u043C\u0435\u0435\u0442 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000370
    m_Localized: "\u0427\u0442\u043E \u0441 \u0432\u0430\u043C\u0438 \u0434\u0435\u043B\u0430\u043B\u0430
      \u041A\u0440\u0430\u0441\u043D\u0430\u044F \u041B\u0443\u043D\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000371
    m_Localized: "\u0414\u043B\u044F \u043C\u0430\u0433\u043E\u0432 \u043E\u043D\u0430
      \u0431\u044B\u043B\u0430 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435\u043C.
      \u0414\u043B\u044F \u043D\u0430\u0441 \u2014 \u0436\u0430\u0440\u043E\u043C
      \u043F\u043E\u0434 \u043A\u043E\u0436\u0435\u0439, \u0431\u0435\u0441\u0441\u043E\u043D\u043D\u0438\u0446\u0435\u0439
      \u0438 \u0441\u043D\u0430\u043C\u0438, \u043F\u043E\u0441\u043B\u0435 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0448\u044C\u0441\u044F \u0438
      \u043D\u0435 \u0443\u0437\u043D\u0430\u0451\u0448\u044C \u043A\u043E\u043C\u043D\u0430\u0442\u0443.
      \u0418\u043D\u043E\u0433\u0434\u0430 \u043E\u0442 \u0441\u0442\u0440\u0430\u0445\u0430
      \u0442\u0440\u0435\u0441\u043A\u0430\u043B\u043E\u0441\u044C \u0441\u0442\u0435\u043A\u043B\u043E,
      \u0438\u043D\u043E\u0433\u0434\u0430 \u043C\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0438
      \u0447\u0443\u0436\u0438\u0435 \u0433\u043E\u043B\u043E\u0441\u0430. \u041E\u043D\u0438
      \u0436\u0434\u0430\u043B\u0438 \u044D\u0442\u0438\u0445 \u0434\u043D\u0435\u0439
      \u043A\u0430\u043A \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000372
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u044B\u0431\u0440\u0430\u043B\u0438
      \u0438\u043C\u0435\u043D\u043D\u043E \u0432\u0430\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000373
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043C\u044B
      \u0440\u0435\u0430\u0433\u0438\u0440\u043E\u0432\u0430\u043B\u0438. \u0423
      \u0434\u0440\u0443\u0433\u0438\u0445 \u0434\u0435\u0442\u0435\u0439 \u041B\u0443\u043D\u0430
      \u0431\u044B\u043B\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0440\u0430\u0441\u043D\u043E\u0439
      \u0442\u043E\u0447\u043A\u043E\u0439 \u043D\u0430\u0434 \u043A\u0440\u044B\u0448\u0435\u0439.
      \u0423 \u043D\u0430\u0441 \u043D\u0430\u0447\u0438\u043D\u0430\u043B\u0430\u0441\u044C
      \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0430. \u041C\u0430\u0433\u0438
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438, \u0447\u0442\u043E \u044D\u0442\u043E
      \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C \u0438 \u0448\u0430\u043D\u0441
      \u043F\u043E\u043D\u044F\u0442\u044C \u0447\u0442\u043E-\u0442\u043E \u0432\u0430\u0436\u043D\u043E\u0435.
      \u0420\u0435\u0434\u043A\u043E\u0441\u0442\u044C \u2014 \u0443\u0434\u043E\u0431\u043D\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E, \u043A\u043E\u0433\u0434\u0430 \u043D\u0435
      \u0445\u043E\u0447\u0435\u0448\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u2018\u0440\u0435\u0431\u0451\u043D\u043E\u043A\u2019."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000374
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u044B \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0435, \u043A\u043E\u0433\u0434\u0430
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0437\u0430\u043A\u0440\u044B\u043B\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000375
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043C\u044B
      \u0431\u044B\u043B\u0438 \u0443\u0436\u0435 \u0437\u0434\u0435\u0441\u044C.
      \u0418 \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u042D\u0434\u0440\u0438\u043A
      \u043D\u0435 \u0445\u043E\u0447\u0435\u0442 \u0443\u0445\u043E\u0434\u0438\u0442\u044C,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442
      \u0431\u0430\u0448\u043D\u044E. \u042F \u043D\u0435 \u0441\u0442\u0430\u043D\u0443
      \u0442\u0430\u0449\u0438\u0442\u044C \u0435\u0433\u043E \u0447\u0435\u0440\u0435\u0437
      \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430,
      \u043A\u0430\u043A \u043C\u0435\u0448\u043E\u043A. \u041C\u044B \u0436\u0434\u0430\u043B\u0438
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0443 \u043F\u043E\u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000376
    m_Localized: "\u0410 \u0435\u0441\u043B\u0438 \u042D\u0440\u0434\u044D\u043D\u0430
      \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000377
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u0439\u0434\u0451\u043C
      \u0434\u0430\u043B\u044C\u0448\u0435. \u042D\u0442\u043E \u043D\u0435 \u043F\u0435\u0440\u0432\u0430\u044F
      \u0434\u0432\u0435\u0440\u044C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0437\u0430\u043A\u0440\u044B\u043B\u0430\u0441\u044C \u043F\u0435\u0440\u0435\u0434
      \u043D\u0430\u043C\u0438. \u041D\u043E \u044F \u0432\u0441\u0451 \u0435\u0449\u0451
      \u043D\u0430\u0434\u0435\u044E\u0441\u044C, \u0447\u0442\u043E \u043E\u043D
      \u0437\u0434\u0435\u0441\u044C. \u041D\u0430\u0434\u0435\u0436\u0434\u0430
      \u2014 \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0445\u043E\u0440\u043E\u0448\u0435\u0435
      \u0447\u0443\u0432\u0441\u0442\u0432\u043E; \u0438\u043D\u043E\u0433\u0434\u0430
      \u043E\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u0434\u0430\u0451\u0442
      \u043B\u0435\u0447\u044C \u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044C
      \u0438\u0441\u043A\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000378
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000379
    m_Localized: "\u042F \u043F\u043E\u0439\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000380
    m_Localized: "\u0415\u0441\u043B\u0438 \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C
      \u0432\u0435\u0449\u044C \u043D\u0430 \u043F\u0440\u043E\u0434\u0430\u0436\u0443
      \u2014 \u043F\u043E\u043A\u0430\u0436\u0438 \u0435\u0451. \u0415\u0441\u043B\u0438
      \u0435\u0441\u0442\u044C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u2014
      \u0433\u043E\u0432\u043E\u0440\u0438 \u043F\u0440\u044F\u043C\u043E. \u0412\u0440\u0435\u043C\u044F
      \u0442\u043E\u0436\u0435 \u0438\u043C\u0435\u0435\u0442 \u0446\u0435\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000381
    m_Localized: "\u0427\u0435\u043C \u0442\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000382
    m_Localized: "\u041F\u043E\u043A\u0443\u043F\u0430\u044E \u0442\u043E, \u0447\u0442\u043E
      \u043E\u0434\u043D\u043E\u043C\u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443
      \u0443\u0436\u0435 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0438\u043B\u0438
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u044F\u0436\u0435\u043B\u043E
      \u043D\u0435\u0441\u0442\u0438, \u0438 \u043D\u0430\u0445\u043E\u0436\u0443
      \u0442\u043E\u0433\u043E, \u043A\u043E\u043C\u0443 \u044D\u0442\u043E \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F.
      \u0418\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442, \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0435,
      \u0434\u043E\u0440\u043E\u0436\u043D\u0430\u044F \u0432\u0435\u0449\u044C \u2014
      \u0443 \u043A\u0430\u0436\u0434\u043E\u0439 \u0435\u0441\u0442\u044C \u0446\u0435\u043D\u0430,
      \u043D\u043E \u043E\u043D\u0430 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u043E\u0442 \u043C\u0435\u0441\u0442\u0430, \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u0438 \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u0433\u043E\u0442\u043E\u0432
      \u0436\u0434\u0430\u0442\u044C. \u041C\u043E\u0451 \u0440\u0435\u043C\u0435\u0441\u043B\u043E
      \u2014 \u043D\u0435 \u043F\u0443\u0442\u0430\u0442\u044C \u0446\u0435\u043D\u0443
      \u0432\u0435\u0449\u0438 \u0441 \u043F\u0430\u043D\u0438\u043A\u043E\u0439
      \u0435\u0451 \u0445\u043E\u0437\u044F\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000383
    m_Localized: "\u041D\u043E \u0442\u044B \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0448\u044C
      \u043D\u0430 \u0447\u0443\u0436\u043E\u0439 \u043D\u0443\u0436\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000384
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0434\u0430\u0436\u0435 \u0447\u0435\u0441\u0442\u043D\u0430\u044F
      \u0446\u0435\u043D\u0430 \u0437\u0432\u0443\u0447\u0438\u0442 \u043E\u0441\u043A\u043E\u0440\u0431\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0435\u0441\u043B\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443 \u043D\u0443\u0436\u043D\u044B
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0434\u043E \u0432\u0435\u0447\u0435\u0440\u0430.
      \u042F \u043D\u0435 \u0441\u043E\u0437\u0434\u0430\u044E \u0435\u0433\u043E
      \u043D\u0443\u0436\u0434\u0443, \u043D\u043E \u043C\u043E\u0433\u0443 \u0440\u0435\u0448\u0438\u0442\u044C,
      \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0435\u044E \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F.
      \u0422\u0451\u043F\u043B\u044B\u0439 \u043F\u043B\u0430\u0449, \u0440\u0430\u0431\u043E\u0447\u0438\u0439
      \u043D\u043E\u0436, \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u0441\u0430\u043F\u043E\u0433\u0438 \u2014 \u0437\u0430 \u0442\u0430\u043A\u043E\u0435
      \u044F \u043D\u0435 \u043F\u043B\u0430\u0447\u0443 \u043A\u043E\u043F\u0435\u0439\u043A\u0438.
      \u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u0435\u0448\u0451\u0432\u0430\u044F
      \u0441\u0434\u0435\u043B\u043A\u0430 \u0447\u0430\u0441\u0442\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043A \u0442\u0435\u0431\u0435 \u0447\u0443\u0436\u043E\u0439 \u0431\u0435\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000385
    m_Localized: "\u041A\u0430\u043A \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438
      \u0442\u0432\u043E\u0451 \u0434\u0435\u043B\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000386
    m_Localized: "\u0420\u044B\u043D\u043E\u043A \u0441\u0442\u0430\u043B \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C
      \u0438 \u043D\u0435\u0440\u0432\u043D\u044B\u043C. \u0412\u0435\u0449\u0438
      \u0435\u0441\u0442\u044C, \u0430 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F
      \u0437\u0430 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438 \u043D\u0435\u0442.
      \u041C\u043E\u043D\u0435\u0442\u044B \u043F\u0440\u044F\u0447\u0443\u0442,
      \u0431\u0443\u0434\u0442\u043E \u0438\u043C\u0438 \u043C\u043E\u0436\u043D\u043E
      \u0441\u043E\u0433\u0440\u0435\u0442\u044C\u0441\u044F; \u043F\u0440\u0438
      \u044D\u0442\u043E\u043C \u043B\u044E\u0431\u043E\u0439 \u0440\u0435\u043C\u0435\u043D\u044C
      \u0438\u043B\u0438 \u043A\u043E\u0442\u0451\u043B, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043D\u0435\u043B\u044C\u0437\u044F \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C,
      \u0432\u0434\u0440\u0443\u0433 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u0430.
      \u0422\u0435\u043F\u0435\u0440\u044C \u044F \u0441\u0447\u0438\u0442\u0430\u044E
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
      \u0432\u0435\u0449\u0438, \u043D\u043E \u0438 \u0442\u043E, \u0441\u043C\u043E\u0436\u0435\u043C
      \u043B\u0438 \u043C\u044B \u043D\u0430\u0439\u0442\u0438 \u0435\u0439 \u0437\u0430\u043C\u0435\u043D\u0443
      \u0447\u0435\u0440\u0435\u0437 \u043C\u0435\u0441\u044F\u0446."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000387
    m_Localized: "\u041A\u0442\u043E \u043E\u0442 \u044D\u0442\u043E\u0433\u043E
      \u0442\u0435\u0440\u044F\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000388
    m_Localized: "\u0422\u043E\u0442, \u043A\u043E\u043C\u0443 \u0434\u0435\u043D\u044C\u0433\u0438
      \u043D\u0443\u0436\u043D\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F,
      \u0430 \u0432\u0435\u0449\u044C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F
      \u0437\u0430\u0432\u0442\u0440\u0430. \u0411\u043E\u0433\u0430\u0442\u044B\u0439
      \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C,
      \u0431\u0435\u0434\u043D\u044B\u0439 \u043F\u0440\u043E\u0434\u0430\u0451\u0442
      \u0442\u043E, \u0431\u0435\u0437 \u0447\u0435\u0433\u043E \u043F\u043E\u0442\u043E\u043C
      \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C.
      \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435 \u0441\u0430\u043C\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430\u044F
      \u0432\u0435\u0449\u044C \u2014 \u043D\u0435 \u0437\u043E\u043B\u043E\u0442\u043E.
      \u0421\u0430\u043C\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430\u044F \u0432\u0435\u0449\u044C
      \u2014 \u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000389
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0441\u0438\u0434\u0438\u0448\u044C
      \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000390
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0437\u0434\u0435\u0441\u044C
      \u0441\u043B\u044B\u0448\u043D\u043E, \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
      \u0440\u0430\u043D\u044C\u0448\u0435, \u0447\u0435\u043C \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438.
      \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u043D\u0435 \u043D\u0435\u0441\u0451\u0442
      \u0432\u0435\u0449\u044C \u043D\u0430 \u043F\u0440\u043E\u0434\u0430\u0436\u0443
      \u043C\u043E\u043B\u0447\u0430: \u0441\u043F\u0435\u0440\u0432\u0430 \u043E\u043D
      \u0436\u0430\u043B\u0443\u0435\u0442\u0441\u044F \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443,
      \u043D\u0430 \u0434\u043E\u043B\u0433, \u043D\u0430 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0439
      \u0437\u0430\u043C\u043E\u043A. \u0422\u0430\u0432\u0435\u0440\u043D\u0430
      \u2014 \u044D\u0442\u043E \u0440\u044B\u043D\u043E\u043A \u0434\u043E \u0442\u043E\u0433\u043E,
      \u043A\u0430\u043A \u0432\u0435\u0449\u044C \u043B\u0435\u0433\u043B\u0430
      \u043D\u0430 \u0441\u0442\u043E\u043B. \u042F \u0441\u043B\u0443\u0448\u0430\u044E,
      \u043D\u043E \u043D\u0435 \u043B\u0435\u0437\u0443 \u0432 \u0447\u0443\u0436\u0438\u0435
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B \u0431\u0435\u0437 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000391
    m_Localized: "\u0425\u0430\u043B\u044C\u0432\u0430\u0440 \u0442\u0435\u0431\u0435
      \u044D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000392
    m_Localized: "\u0425\u0430\u043B\u044C\u0432\u0430\u0440 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u043C\u043D\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C \u0441\u0442\u043E\u043B,
      \u043F\u043E\u043A\u0430 \u044F \u043D\u0435 \u0434\u0435\u043B\u0430\u044E
      \u0438\u0437 \u0435\u0433\u043E \u0434\u043E\u043C\u0430 \u043B\u043E\u0432\u0443\u0448\u043A\u0443
      \u0434\u043B\u044F \u043E\u0442\u0447\u0430\u044F\u0432\u0448\u0438\u0445\u0441\u044F.
      \u0423 \u043D\u0435\u0433\u043E \u0441\u0432\u043E\u0439 \u0441\u0447\u0451\u0442:
      \u043C\u0438\u0441\u043A\u0438, \u0434\u0440\u043E\u0432\u0430, \u043B\u044E\u0434\u0438
      \u043F\u043E\u0434 \u043A\u0440\u044B\u0448\u0435\u0439. \u0423 \u043C\u0435\u043D\u044F
      \u2014 \u0432\u0435\u0449\u0438 \u0438 \u0441\u0440\u043E\u043A\u0438. \u041C\u044B
      \u043D\u0435 \u0434\u0435\u043B\u0438\u043C \u0437\u0430\u043F\u0438\u0441\u0438,
      \u0438 \u043E\u0442\u0442\u043E\u0433\u043E \u043B\u0430\u0434\u0438\u043C
      \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C \u043C\u043D\u043E\u0433\u0438\u0435
      \u0434\u0435\u043B\u043E\u0432\u044B\u0435 \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000393
    m_Localized: "\u041A\u0430\u043A \u0442\u044B \u0441\u0442\u0430\u043B \u0441\u043A\u0443\u043F\u0449\u0438\u043A\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000394
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0431\u0435\u0433\u0430\u043B
      \u043C\u0435\u0436\u0434\u0443 \u043B\u0430\u0432\u043A\u0430\u043C\u0438 \u0441
      \u0447\u0443\u0436\u0438\u043C\u0438 \u0441\u0432\u0451\u0440\u0442\u043A\u0430\u043C\u0438
      \u0438 \u0441\u0447\u0438\u0442\u0430\u043B, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0445\u043E\u0437\u044F\u0438\u043D \u0442\u0435\u0440\u044F\u0435\u0442 \u043D\u0430
      \u043A\u0430\u0436\u0434\u043E\u043C \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u0435.
      \u041F\u043E\u0442\u043E\u043C \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F
      \u043E\u0442\u043B\u0438\u0447\u0430\u0442\u044C \u0445\u043E\u0440\u043E\u0448\u0443\u044E
      \u0441\u0442\u0430\u043B\u044C \u043E\u0442 \u043D\u0430\u0447\u0438\u0449\u0435\u043D\u043D\u043E\u0433\u043E
      \u0445\u043B\u0430\u043C\u0430 \u0438 \u0441\u043B\u0443\u0448\u0430\u0442\u044C,
      \u043A\u043E\u0433\u0434\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441\u0430\u043C
      \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u0432\u043E\u044E \u0432\u0435\u0449\u044C
      \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0439. \u042D\u0442\u043E
      \u0440\u0435\u043C\u0435\u0441\u043B\u043E \u0440\u0435\u0434\u043A\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0441 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u0434\u0435\u043B\u043A\u0438.
      \u041E\u0431\u044B\u0447\u043D\u043E \u2014 \u0441 \u0442\u043E\u0433\u043E,
      \u0447\u0442\u043E \u0442\u0435\u0431\u044F \u043E\u0434\u043D\u0430\u0436\u0434\u044B
      \u043E\u0431\u0441\u0447\u0438\u0442\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000395
    m_Localized: "\u0417\u0430\u0447\u0435\u043C \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C
      \u0442\u0430\u043A\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000396
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0432\u0435\u0449\u044C,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043B\u0435\u0436\u0438\u0442 \u0431\u0435\u0437
      \u0434\u0435\u043B\u0430 \u0443 \u043E\u0434\u043D\u043E\u0433\u043E, \u043C\u043E\u0436\u0435\u0442
      \u043D\u0430\u043A\u043E\u0440\u043C\u0438\u0442\u044C \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u0438\u043B\u0438 \u0434\u043E\u0432\u0435\u0437\u0442\u0438 \u0435\u0433\u043E
      \u0434\u043E \u0434\u043E\u043C\u0430. \u0414\u0435\u043D\u044C\u0433\u0438
      \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u0446\u0435\u043B\u044C, \u0430
      \u0441\u043F\u043E\u0441\u043E\u0431 \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u0442\u044C
      \u0447\u0430\u0441\u0430\u043C\u0438, \u043A\u0442\u043E \u043A\u043E\u043C\u0443
      \u043E\u0431\u044F\u0437\u0430\u043D. \u041A\u043E\u043D\u0435\u0447\u043D\u043E,
      \u043B\u044E\u0434\u0438 \u0443\u043C\u0435\u044E\u0442 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0438\u0437 \u044D\u0442\u043E\u0433\u043E \u0433\u0440\u044F\u0437\u044C.
      \u041D\u043E \u0433\u0440\u044F\u0437\u044C \u043D\u0435 \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442,
      \u0435\u0441\u043B\u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044C
      \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u044C, \u043A\u0430\u043A \u043E\u043D\u0430
      \u043F\u0440\u0438\u043B\u0438\u043F\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000397
    m_Localized: "\u0422\u044B \u0437\u043D\u0430\u0435\u0448\u044C \u041A\u043E\u0440\u0432\u0438\u043D\u0430
      \u0412\u0435\u0439\u0440\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000398
    m_Localized: "\u041C\u044B \u0437\u043D\u0430\u0435\u043C \u0438\u043C\u0435\u043D\u0430
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430, \u044D\u0442\u043E\u0433\u043E
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E. \u041A\u043E\u0440\u0432\u0438\u043D
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0441 \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u044F\u043C\u0438:
      \u0434\u0430\u0451\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443 \u0432\u0440\u0435\u043C\u044F
      \u0438 \u043F\u043E\u0442\u043E\u043C \u0441\u043C\u043E\u0442\u0440\u0438\u0442,
      \u0447\u0435\u043C \u0442\u043E\u0442 \u0437\u0430 \u043D\u0435\u0433\u043E
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442. \u042F \u0440\u0430\u0431\u043E\u0442\u0430\u044E
      \u0441 \u0442\u0435\u043C, \u0447\u0442\u043E \u0443\u0436\u0435 \u043B\u0435\u0436\u0438\u0442
      \u043F\u0435\u0440\u0435\u0434\u043E \u043C\u043D\u043E\u0439. \u041E\u043D
      \u0443\u043C\u0435\u0435\u0442 \u0432\u0438\u0434\u0435\u0442\u044C \u0431\u0443\u0434\u0443\u0449\u0443\u044E
      \u0432\u044B\u0433\u043E\u0434\u0443, \u044F \u2014 \u043D\u044B\u043D\u0435\u0448\u043D\u044E\u044E
      \u0446\u0435\u043D\u0443. \u0418\u043D\u043E\u0433\u0434\u0430 \u044D\u0442\u0438
      \u0432\u0437\u0433\u043B\u044F\u0434\u044B \u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F.
      \u0414\u0440\u0443\u0436\u0431\u043E\u0439 \u044F \u0431\u044B \u044D\u0442\u043E
      \u043D\u0435 \u043D\u0430\u0437\u0432\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000399
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000400
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000401
    m_Localized: "\u041A \u043B\u043E\u0448\u0430\u0434\u044F\u043C \u043B\u0443\u0447\u0448\u0435
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u044C \u0431\u0435\u0437 \u0440\u0435\u0437\u043A\u0438\u0445
      \u0441\u043B\u043E\u0432. \u041E\u043D\u0438 \u0438\u0445 \u0432\u0441\u0451
      \u0440\u0430\u0432\u043D\u043E \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E\u0442,
      \u0430 \u0432\u043E\u0442 \u0440\u0443\u043A\u0443 \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000402
    m_Localized: "\u0422\u044B, \u043F\u043E\u0445\u043E\u0436\u0435, \u0431\u043E\u043B\u044C\u0448\u0435
      \u043E \u043B\u043E\u0448\u0430\u0434\u044F\u0445 \u0434\u0443\u043C\u0430\u0435\u0448\u044C,
      \u0447\u0435\u043C \u043E \u0433\u043E\u0441\u0442\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000403
    m_Localized: "\u0413\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u043D\u043E\u0447\u0443\u0435\u0442
      \u0438 \u0443\u0439\u0434\u0451\u0442. \u041B\u043E\u0448\u0430\u0434\u044C
      \u0443\u0439\u0434\u0451\u0442 \u2014 \u0438 \u0433\u043E\u0441\u0442\u044C
      \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0441 \u0442\u043E\u0431\u043E\u0439,
      \u0437\u043B\u043E\u0439 \u0438 \u043F\u0435\u0448\u0438\u0439. \u0422\u0430\u043A
      \u0447\u0442\u043E \u044F \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0437\u043D\u0430\u044E,
      \u043A\u0442\u043E \u0445\u0440\u043E\u043C\u0430\u0435\u0442, \u043A\u0442\u043E
      \u043D\u0435\u0434\u043E\u043F\u0438\u043B, \u0430 \u0443\u0436\u0435 \u043F\u043E\u0442\u043E\u043C
      \u0441\u043B\u0443\u0448\u0430\u044E, \u043A\u043E\u043C\u0443 \u043D\u0435
      \u0445\u0432\u0430\u0442\u0438\u043B\u043E \u043F\u043E\u0434\u0443\u0448\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000404
    m_Localized: "\u0418 \u044D\u0442\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0430 \u0441\u043B\u0443\u0448\u0430\u043B\u0430\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000405
    m_Localized: "\u041D\u0435\u0442. \u041D\u043E \u043E\u0442 \u043A\u0440\u0438\u043A\u0430
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
      \u0438\u0441\u043F\u0443\u0433\u0430\u043D\u043D\u0430\u044F \u043B\u043E\u0448\u0430\u0434\u044C,
      \u0430 \u0441 \u0438\u0441\u043F\u0443\u0433\u0430\u043D\u043D\u043E\u0439
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u0431\u0435\u0434\u044B
      \u0431\u043E\u043B\u044C\u0448\u0435. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u0434\u0430\u0439 \u0435\u0439 \u043F\u043E\u043D\u044F\u0442\u044C, \u0447\u0442\u043E
      \u0442\u044B \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u0441\u0442\u0440\u0430\u0445.
      \u041F\u043E\u0442\u043E\u043C \u0443\u0436\u0435 \u043F\u0440\u043E\u0441\u0438
      \u0440\u0430\u0431\u043E\u0442\u0443. \u0421 \u043B\u044E\u0434\u044C\u043C\u0438,
      \u043A\u0441\u0442\u0430\u0442\u0438, \u043D\u0435 \u0445\u0443\u0436\u0435
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000406
    m_Localized: "\u0427\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u0437\u0430
      \u0440\u0430\u0431\u043E\u0442\u0430, \u043A\u0440\u043E\u043C\u0435 \u0441\u0442\u043E\u0439\u043B?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000407
    m_Localized: "\u0421\u0442\u043E\u0439\u043B\u043E \u2014 \u044D\u0442\u043E
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u044B.
      \u0415\u0449\u0451 \u043A\u043E\u043F\u044B\u0442\u0430, \u0443\u043F\u0440\u044F\u0436\u044C,
      \u0432\u043E\u0434\u0430, \u043E\u0432\u0451\u0441, \u043D\u0430\u0432\u0435\u0441
      \u043E\u0442 \u0434\u043E\u0436\u0434\u044F. \u041F\u043E\u0442\u043E\u043C
      \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0445\u043E\u0437\u044F\u0438\u043D\u0430:
      \u043E\u043D \u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u043D\u0430\u0435\u0442,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u043B\u043E\u0448\u0430\u0434\u044C \u043D\u0435
      \u0438\u0434\u0451\u0442, \u043F\u043E\u043A\u0430 \u043D\u0435 \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u0441\u044F,
      \u0447\u0442\u043E \u0440\u0435\u043C\u0435\u043D\u044C \u043D\u0430\u0442\u0451\u0440
      \u0435\u0439 \u043F\u043B\u0435\u0447\u043E. \u0425\u043E\u0440\u043E\u0448\u0438\u0439
      \u043A\u043E\u043D\u044E\u0445 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442
      \u044D\u0442\u043E \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000408
    m_Localized: "\u041A\u0430\u043A \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u043A\u043E\u043D\u044E\u0448\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000409
    m_Localized: "\u041B\u044E\u0434\u0438 \u043C\u043E\u0433\u0443\u0442 \u0436\u0434\u0430\u0442\u044C
      \u0438 \u043F\u0440\u0438\u0434\u0443\u043C\u044B\u0432\u0430\u0442\u044C \u0441\u0435\u0431\u0435
      \u043F\u0440\u0438\u0447\u0438\u043D\u044B. \u0416\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u0436\u0434\u0430\u0442\u044C \u043D\u0435 \u0443\u043C\u0435\u0435\u0442:
      \u0435\u043C\u0443 \u043D\u0443\u0436\u0435\u043D \u043A\u043E\u0440\u043C
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F. \u041F\u0443\u0442\u043D\u0438\u043A\u043E\u0432
      \u0441\u0442\u0430\u043B\u043E \u043C\u0435\u043D\u044C\u0448\u0435, \u0430
      \u0447\u0443\u0436\u0438\u0445 \u043B\u043E\u0448\u0430\u0434\u0435\u0439 \u2014
      \u0431\u043E\u043B\u044C\u0448\u0435, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u0442\u0435, \u043A\u0442\u043E \u0437\u0430\u0441\u0442\u0440\u044F\u043B,
      \u043D\u0435 \u0445\u043E\u0442\u044F\u0442 \u0431\u0440\u043E\u0441\u0430\u0442\u044C
      \u0438\u0445 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435. \u041C\u0435\u0441\u0442\u0430
      \u0445\u0432\u0430\u0442\u0430\u0435\u0442. \u041E\u0432\u0451\u0441 \u0441\u0447\u0438\u0442\u0430\u0442\u044C
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000410
    m_Localized: "\u041A\u043E\u0440\u043C\u0430 \u043D\u0430\u0434\u043E\u043B\u0433\u043E
      \u0445\u0432\u0430\u0442\u0438\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000411
    m_Localized: "\u0415\u0441\u043B\u0438 \u043D\u0438\u043A\u0442\u043E \u043D\u0435
      \u043D\u0430\u0447\u043D\u0451\u0442 \u043A\u043E\u0440\u043C\u0438\u0442\u044C
      \u0441\u0432\u043E\u0435\u0433\u043E \u0436\u0435\u0440\u0435\u0431\u0446\u0430
      \u043A\u0430\u043A \u043B\u043E\u0440\u0434\u0430 \u2014 \u043D\u0430 \u0432\u0440\u0435\u043C\u044F
      \u0445\u0432\u0430\u0442\u0438\u0442. \u0425\u0430\u043B\u044C\u0432\u0430\u0440
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0441\u044F \u0441 \u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0430\u043C\u0438
      \u043E \u0441\u0435\u043D\u0435, \u044F \u0440\u0430\u0437\u0432\u0451\u043B
      \u043B\u043E\u0448\u0430\u0434\u0435\u0439 \u043F\u043E \u043D\u043E\u0440\u043C\u0435.
      \u041D\u0435 \u043A\u0440\u0430\u0441\u0438\u0432\u043E, \u0437\u0430\u0442\u043E
      \u0447\u0435\u0441\u0442\u043D\u043E: \u0441\u044B\u0442\u0430\u044F \u043E\u0434\u043D\u0430
      \u043B\u043E\u0448\u0430\u0434\u044C \u043D\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0442\u0440\u0451\u0445 \u0433\u043E\u043B\u043E\u0434\u043D\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000412
    m_Localized: "\u0422\u044B \u0434\u0430\u0432\u043D\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C
      \u043F\u0440\u0438 \u0434\u043E\u0440\u043E\u0433\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000413
    m_Localized: "\u0421 \u043C\u0430\u043B\u044B\u0445 \u043B\u0435\u0442. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u0442\u0430\u0441\u043A\u0430\u043B \u0432\u043E\u0434\u0443 \u0432 \u0447\u0443\u0436\u043E\u0439
      \u0434\u0432\u043E\u0440 \u0437\u0430 \u043C\u0438\u0441\u043A\u0443 \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0438.
      \u041F\u043E\u0442\u043E\u043C \u0441\u0442\u0430\u0440\u044B\u0439 \u043A\u043E\u043D\u044E\u0445
      \u0434\u0430\u043B \u043C\u043D\u0435 \u0449\u0451\u0442\u043A\u0443 \u0438
      \u0432\u0435\u043B\u0435\u043B \u043D\u0435 \u043F\u0443\u0442\u0430\u0442\u044C\u0441\u044F
      \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438. \u0427\u0435\u0440\u0435\u0437
      \u0433\u043E\u0434 \u0434\u043E\u0432\u0435\u0440\u0438\u043B \u043A\u043E\u0431\u044B\u043B\u0443
      \u0441 \u043D\u043E\u0440\u043E\u0432\u043E\u043C. \u042F \u043F\u043E\u043D\u044F\u043B:
      \u0435\u0441\u043B\u0438 \u043E\u043D\u0430 \u043C\u0435\u043D\u044F \u043D\u0435
      \u0441\u0431\u0440\u043E\u0441\u0438\u043B\u0430, \u0442\u043E \u0438 \u043D\u0430
      \u043C\u0435\u0441\u0442\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0443\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000414
    m_Localized: "\u0422\u0435\u0431\u0435 \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F
      \u0441\u0430\u043C\u043E\u043C\u0443 \u0443\u0435\u0445\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000415
    m_Localized: "\u0425\u043E\u0442\u0435\u043B\u043E\u0441\u044C, \u043F\u043E\u043A\u0430
      \u043D\u0435 \u043F\u043E\u0435\u0437\u0434\u0438\u043B \u0441 \u043E\u0431\u043E\u0437\u043E\u043C.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0445\u043E\u0440\u043E\u0448\u0430,
      \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u043D\u0430 \u043D\u0435\u0439
      \u0433\u043E\u0441\u0442\u044C. \u0410 \u043A\u043E\u0433\u0434\u0430 \u0437\u0430
      \u0442\u043E\u0431\u043E\u0439 \u0447\u0435\u0442\u044B\u0440\u0435 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445,
      \u043C\u043E\u043A\u0440\u044B\u0435 \u0442\u044E\u043A\u0438 \u0438 \u0445\u043E\u0437\u044F\u0438\u043D,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0435 \u0443\u043C\u0435\u0435\u0442
      \u0447\u0438\u0442\u0430\u0442\u044C \u043D\u0435\u0431\u043E, \u2014 \u0431\u044B\u0441\u0442\u0440\u043E
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0448\u044C \u0446\u0435\u043D\u0438\u0442\u044C
      \u0441\u0443\u0445\u0443\u044E \u043A\u043E\u043D\u044E\u0448\u043D\u044E.
      \u042F \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432 \u043F\u0443\u0442\u0438.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0437\u043D\u0430\u044E \u0435\u0433\u043E
      \u0446\u0435\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000416
    m_Localized: "\u0422\u044B \u0432\u0435\u0434\u044C \u0432\u0438\u0434\u0438\u0448\u044C
      \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044C\u0446\u0435\u0432 \u0440\u0430\u043D\u044C\u0448\u0435
      \u0434\u0440\u0443\u0433\u0438\u0445. \u0427\u0442\u043E \u043E \u043D\u0438\u0445
      \u0441\u043A\u0430\u0436\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000417
    m_Localized: "\u041F\u043E \u043B\u043E\u0448\u0430\u0434\u0438 \u043C\u043D\u043E\u0433\u043E\u0435
      \u0432\u0438\u0434\u043D\u043E. \u041C\u0430\u0440\u0442\u0430 \u0432\u0441\u0451
      \u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u043C:
      \u0435\u0451 \u0432\u044C\u044E\u043A\u0438 \u0434\u0432\u0430\u0436\u0434\u044B
      \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043D\u044B, \u0431\u0443\u0434\u0442\u043E
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0432\u043E\u0442-\u0432\u043E\u0442
      \u043E\u0442\u043A\u0440\u043E\u044E\u0442. \u0420\u0443\u043D\u0430 \u0441\u0430\u043C\u0430
      \u043F\u043E\u0432\u043E\u0434 \u043D\u0435 \u0431\u0435\u0440\u0451\u0442,
      \u043D\u043E \u0441\u043B\u0435\u0434\u0438\u0442, \u043A\u0430\u043A \u0431\u0440\u0430\u0442
      \u0434\u044B\u0448\u0438\u0442, \u043A\u043E\u0433\u0434\u0430 \u0440\u044F\u0434\u043E\u043C
      \u0448\u0443\u043C\u043D\u043E. \u041B\u0438\u0432\u0438\u043E \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442,
      \u043A\u0442\u043E \u043E\u0442\u043A\u0443\u0434\u0430 \u043F\u0440\u0438\u0435\u0445\u0430\u043B,
      \u0431\u0443\u0434\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0437\u0430\u0432\u043E\u0434\u0438\u0442. \u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0441\u0432\u043E\u0439 \u0441\u043F\u043E\u0441\u043E\u0431 \u0436\u0434\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000418
    m_Localized: "\u0422\u044B \u043D\u0435 \u0431\u043E\u0438\u0448\u044C\u0441\u044F
      \u043B\u0435\u0441\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000419
    m_Localized: "\u0411\u043E\u044E\u0441\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0435\u0441\u0442\u044C \u0437\u0430 \u0447\u0442\u043E. \u0422\u043E\u043B\u044C\u043A\u043E
      \u0441\u0442\u0440\u0430\u0445 \u0432 \u0434\u043E\u0440\u043E\u0433\u0435
      \u043F\u043E\u043B\u0435\u0437\u0435\u043D, \u0435\u0441\u043B\u0438 \u043D\u0435
      \u0434\u0435\u043B\u0430\u0435\u0442 \u0442\u0435\u0431\u044F \u0433\u043B\u0443\u043F\u0435\u0435:
      \u043D\u0435 \u043B\u0435\u0437\u044C \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443,
      \u043D\u0435 \u0433\u043E\u043D\u0438 \u043A\u043E\u043D\u044F \u043F\u043E
      \u043A\u0430\u043C\u043D\u044F\u043C, \u043D\u0435 \u0441\u0443\u0439\u0441\u044F
      \u043C\u0435\u0436\u0434\u0443 \u0447\u0443\u0436\u0438\u043C\u0438 \u043B\u044E\u0434\u044C\u043C\u0438
      \u0438 \u0438\u0445 \u0441\u043F\u043E\u0440\u043E\u043C. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u2014 \u0443\u0436\u0435 \u0443\u0434\u0430\u0447\u0430 \u0438 \u0442\u043E,
      \u043A\u0430\u043A \u0442\u044B \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000420
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000421
    m_Localized: "\u041D\u0435 \u0431\u0443\u0434\u0443 \u043C\u0435\u0448\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000422
    m_Localized: "\u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u2014 \u0433\u043E\u0432\u043E\u0440\u0438. \u0422\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0439 \u0441\u0443\u043C\u043A\u0443:
      \u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u043E
      \u0443\u0447\u0438\u043B\u0430\u0441\u044C \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
      \u0432\u0435\u0449\u0438 \u0431\u0435\u0437 \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000423
    m_Localized: "\u0422\u044B \u0434\u0430\u0432\u043D\u043E \u0436\u0434\u0451\u0448\u044C
      \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F \u0432\u043E\u0440\u043E\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000424
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044C \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C
      \u0441\u0442\u0440\u0430\u0436\u0443 \u043A\u0430\u0436\u0434\u043E\u0435 \u0443\u0442\u0440\u043E.
      \u042F \u0435\u0445\u0430\u043B\u0430 \u0447\u0435\u0440\u0435\u0437 \u044D\u0442\u0443
      \u0434\u0435\u0440\u0435\u0432\u043D\u044E \u043D\u0430 \u0434\u0432\u0435
      \u043D\u043E\u0447\u0438, \u0430 \u0442\u0435\u043F\u0435\u0440\u044C \u0437\u043D\u0430\u044E,
      \u043A\u0430\u043A \u0425\u0430\u043B\u044C\u0432\u0430\u0440 \u0441\u0447\u0438\u0442\u0430\u0435\u0442
      \u0434\u0440\u043E\u0432\u0430 \u0438 \u0432 \u043A\u0430\u043A\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u041E\u0440\u0440\u0435\u043D \u0432\u044B\u0432\u043E\u0434\u0438\u0442
      \u043B\u043E\u0448\u0430\u0434\u0435\u0439 \u043A \u0432\u043E\u0434\u0435.
      \u041D\u0435 \u0442\u043E \u0437\u043D\u0430\u043D\u0438\u0435, \u0440\u0430\u0434\u0438
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C\u0441\u044F
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000425
    m_Localized: "\u0422\u0435\u0431\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0443\u0436\u043D\u043E \u0437\u0430 \u0432\u043E\u0440\u043E\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000426
    m_Localized: "\u041D\u0443\u0436\u043D\u043E. \u042F \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
      \u0440\u0430\u0431\u043E\u0442\u0443 \u0432 \u0434\u0440\u0443\u0433\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435 \u0438 \u043E\u0431\u0435\u0449\u0430\u043B\u0430
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0441\u0440\u043E\u043A\u0443.
      \u041F\u043E\u043A\u0430 \u044F \u0437\u0434\u0435\u0441\u044C, \u0447\u0443\u0436\u0438\u0435
      \u043F\u0438\u0441\u044C\u043C\u0430 \u0438 \u0441\u0447\u0435\u0442\u0430
      \u043B\u0435\u0436\u0430\u0442 \u0431\u0435\u0437 \u043E\u0442\u0432\u0435\u0442\u0430.
      \u041D\u0438\u0447\u0435\u0433\u043E \u0433\u0435\u0440\u043E\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E.
      \u041F\u0440\u043E\u0441\u0442\u043E \u043B\u044E\u0434\u044F\u043C \u043D\u0435
      \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
      \u0438\u0445 \u0432\u0430\u0436\u043D\u044B\u0435 \u0441\u043B\u043E\u0432\u0430
      \u0437\u0430\u0441\u0442\u0440\u0435\u0432\u0430\u044E\u0442 \u0432 \u0447\u0443\u0436\u043E\u0439
      \u0441\u0443\u043C\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000427
    m_Localized: "\u0422\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F
      \u043F\u0438\u0441\u044C\u043C\u0430\u043C\u0438 \u0438 \u0441\u0447\u0435\u0442\u0430\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000428
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u0438\u0441\u044B\u0432\u0430\u044E
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u044B, \u043F\u0438\u0441\u044C\u043C\u0430,
      \u0438\u043D\u043E\u0433\u0434\u0430 \u0432\u0435\u0434\u0443 \u0440\u0430\u0441\u0447\u0451\u0442\u044B
      \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u043E\u043C\u0443 \u043D\u0435\u043A\u043E\u0433\u0434\u0430
      \u0438\u043B\u0438 \u043D\u0435 \u043F\u043E \u0441\u0438\u043B\u0430\u043C.
      \u041D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435 \u043B\u044E\u0434\u0438
      \u043E\u0431\u044B\u0447\u043D\u043E \u0441\u043C\u0435\u043B\u0435\u0435:
      \u043E\u0431\u0435\u0449\u0430\u044E\u0442 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u0431\u044B
      \u0432 \u043B\u0438\u0446\u043E. \u041C\u043E\u044F \u0440\u0430\u0431\u043E\u0442\u0430
      \u2014 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u0442\u043E\u043C \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E
      \u043F\u043E\u043D\u044F\u0442\u044C, \u043A\u0442\u043E \u0447\u0442\u043E
      \u043E\u0431\u0435\u0449\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000429
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u0432\u043E\u0438 \u0432\u0435\u0449\u0438
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043E\u0431\u0440\u0430\u043D\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000430
    m_Localized: "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0443\u0436\u0435 \u043F\u043E\u0440\u0430
      \u0443\u0445\u043E\u0434\u0438\u0442\u044C, \u2014 \u044D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u0441\u043F\u043E\u0441\u043E\u0431 \u0437\u0430\u0431\u044B\u0442\u044C \u043D\u0443\u0436\u043D\u043E\u0435.
      \u042F \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E \u0440\u0435\u043C\u043D\u0438
      \u0432\u0435\u0447\u0435\u0440\u043E\u043C, \u0430 \u043D\u0435 \u043D\u0430
      \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435. \u0415\u0441\u043B\u0438
      \u0432\u043E\u0440\u043E\u0442\u0430 \u043E\u0442\u043A\u0440\u043E\u044E\u0442
      \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E, \u043C\u043D\u0435 \u043D\u0435
      \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C
      \u043C\u0435\u0436\u0434\u0443 \u0441\u0432\u043E\u0438\u043C \u043C\u0435\u0441\u0442\u043E\u043C
      \u0432 \u043E\u0431\u043E\u0437\u0435 \u0438 \u0447\u0435\u0440\u043D\u0438\u043B\u044C\u043D\u0438\u0446\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000431
    m_Localized: "\u0422\u044B \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F
      \u0436\u0434\u0451\u0448\u044C \u0445\u0443\u0434\u0448\u0435\u0433\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000432
    m_Localized: "\u042F \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u044E
      \u043D\u0430 \u0442\u043E, \u0447\u0442\u043E \u043F\u043B\u0430\u043D\u044B
      \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F. \u0425\u0443\u0434\u0448\u0435\u0435
      \u2014 \u044D\u0442\u043E \u0434\u0440\u0443\u0433\u043E\u0435. \u0415\u0433\u043E
      \u043B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0437\u0432\u0430\u0442\u044C
      \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438;
      \u043E\u043D\u043E \u0438 \u0431\u0435\u0437 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F
      \u0437\u043D\u0430\u0435\u0442 \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000433
    m_Localized: "\u0427\u0442\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0441 \u043B\u044E\u0434\u044C\u043C\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000434
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u0441\u0435 \u0441\u0435\u0440\u0434\u0438\u043B\u0438\u0441\u044C.
      \u041F\u043E\u0442\u043E\u043C \u043D\u0430\u0447\u0430\u043B\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0442\u0438\u0448\u0435 \u0438 \u0447\u0430\u0449\u0435 \u0441\u043B\u0443\u0448\u0430\u0442\u044C
      \u0434\u0432\u0435\u0440\u044C. \u041A\u0442\u043E-\u0442\u043E \u0431\u043E\u0438\u0442\u0441\u044F
      \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438,
      \u043A\u0442\u043E-\u0442\u043E \u2014 \u0447\u0442\u043E \u0434\u043E\u043C\u0430
      \u0435\u0433\u043E \u0443\u0436\u0435 \u0436\u0434\u0443\u0442 \u0441 \u043F\u043B\u043E\u0445\u0438\u043C\u0438
      \u043D\u043E\u0432\u043E\u0441\u0442\u044F\u043C\u0438. \u0417\u0430\u0434\u0435\u0440\u0436\u043A\u0430
      \u2014 \u044D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043B\u0438\u0448\u043D\u0438\u0439 \u0434\u0435\u043D\u044C. \u042D\u0442\u043E
      \u0434\u0435\u043D\u044C, \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u043D\u0435\u043B\u044C\u0437\u044F \u043D\u0438\u043A\u043E\u043C\u0443 \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000435
    m_Localized: "\u0422\u044B \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0448\u044C
      \u0432\u0441\u0451, \u0447\u0442\u043E \u0441\u043B\u044B\u0448\u0438\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000436
    m_Localized: "\u041D\u0435\u0442. \u0427\u0443\u0436\u0430\u044F \u0442\u0440\u0435\u0432\u043E\u0433\u0430
      \u2014 \u043D\u0435 \u0447\u0435\u0440\u043D\u043E\u0432\u0438\u043A \u0434\u043B\u044F
      \u043C\u043E\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u044B. \u042F \u0437\u0430\u043C\u0435\u0447\u0430\u044E,
      \u043A\u043E\u0433\u0434\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443
      \u043D\u0443\u0436\u043D\u043E \u0432\u044B\u0441\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F,
      \u0438 \u043A\u043E\u0433\u0434\u0430 \u043B\u0443\u0447\u0448\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0435\u0433\u043E \u0432 \u043F\u043E\u043A\u043E\u0435. \u042D\u0442\u043E
      \u0440\u0430\u0437\u043D\u044B\u0435 \u0443\u043C\u0435\u043D\u0438\u044F.
      \u0412\u0442\u043E\u0440\u043E\u043C\u0443 \u043C\u0435\u043D\u044F \u043D\u0430\u0443\u0447\u0438\u043B\u0438
      \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000437
    m_Localized: "\u041A\u0430\u043A \u0442\u0435\u0431\u0435 \u0436\u0438\u0432\u0451\u0442\u0441\u044F
      \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000438
    m_Localized: "\u0422\u0435\u0441\u043D\u043E, \u0448\u0443\u043C\u043D\u043E,
      \u043D\u043E \u0447\u0435\u0441\u0442\u043D\u043E. \u0425\u0430\u043B\u044C\u0432\u0430\u0440
      \u043D\u0435 \u043E\u0431\u0435\u0449\u0430\u0435\u0442, \u0447\u0442\u043E
      \u0432\u0441\u0435\u043C \u0431\u0443\u0434\u0435\u0442 \u0443\u0434\u043E\u0431\u043D\u043E,
      \u0437\u0430\u0442\u043E \u0443\u0442\u0440\u043E\u043C \u0432\u0441\u0451
      \u0435\u0449\u0451 \u0435\u0441\u0442\u044C \u043E\u0433\u043E\u043D\u044C
      \u0438 \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0430. \u0420\u0443\u043D\u0430
      \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0431\u0440\u0430\u0442\u043E\u043C. \u041B\u0438\u0432\u0438\u043E
      \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0447\u0443\u0436\u0438\u043C\u0438 \u0432\u0435\u0449\u0430\u043C\u0438.
      \u0410 \u044F \u0434\u0435\u0440\u0436\u0443 \u043C\u0435\u0441\u0442\u043E
      \u0443 \u0441\u0442\u0435\u043D\u044B, \u0447\u0442\u043E\u0431\u044B \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0441\u0435\u043B \u043D\u0430 \u043C\u043E\u0438 \u0431\u0443\u043C\u0430\u0433\u0438.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A\u0430\u043A \u0443\u043C\u0435\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000439
    m_Localized: "\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
      \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0434\u043B\u044F
      \u043C\u0435\u043D\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000440
    m_Localized: "\u041C\u043E\u0433\u0443, \u0435\u0441\u043B\u0438 \u044D\u0442\u043E
      \u0442\u0432\u043E\u0451 \u0438 \u0442\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C,
      \u0437\u0430\u0447\u0435\u043C \u0441\u043B\u0443\u0448\u0430\u0435\u0448\u044C.
      \u041D\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0438 \u043C\u0435\u043D\u044F
      \u0447\u0438\u0442\u0430\u0442\u044C \u0447\u0443\u0436\u043E\u0435 \u043F\u0438\u0441\u044C\u043C\u043E
      \u0447\u0435\u0440\u0435\u0437 \u043F\u043B\u0435\u0447\u043E. \u0411\u0443\u043C\u0430\u0433\u0430
      \u0442\u043E\u0436\u0435 \u0443\u043C\u0435\u0435\u0442 \u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u0433\u0440\u0430\u043D\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000441
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000442
    m_Localized: "\u041C\u043D\u0435 \u043F\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000443
    m_Localized: "\u0415\u0441\u043B\u0438 \u0443 \u0442\u0435\u0431\u044F \u0441\u043B\u043E\u043C\u0430\u043B\u0441\u044F
      \u0440\u0435\u043C\u0435\u043D\u044C, \u0437\u0430\u043C\u043E\u043A \u0438\u043B\u0438
      \u043D\u043E\u0436\u043D\u044B \u2014 \u043F\u043E\u043A\u0430\u0436\u0438.
      \u0410 \u0435\u0441\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C,
      \u0441\u0430\u0434\u0438\u0441\u044C. \u042F \u043D\u0435 \u043A\u0443\u0441\u0430\u044E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000444
    m_Localized: "\u0422\u044B \u0441\u0442\u0430\u0440\u0430\u0435\u0448\u044C\u0441\u044F
      \u043D\u0435 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000445
    m_Localized: "\u0421\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u043D\u0435 \u043C\u0435\u0448\u0430\u0442\u044C.
      \u042D\u0442\u043E \u0440\u0430\u0437\u043D\u044B\u0435 \u0432\u0435\u0449\u0438.
      \u0417\u0430\u043F\u043B\u0430\u0442\u0438 \u0432\u043E\u0432\u0440\u0435\u043C\u044F,
      \u043D\u0435 \u043B\u0435\u0437\u044C \u0432 \u0447\u0443\u0436\u0443\u044E
      \u0441\u0441\u043E\u0440\u0443, \u0432\u0435\u0440\u043D\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
      \u0446\u0435\u043B\u044B\u043C \u2014 \u0438 \u043E \u0442\u0435\u0431\u0435
      \u0432\u0441\u043F\u043E\u043C\u043D\u044F\u0442, \u043A\u043E\u0433\u0434\u0430
      \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F. \u041F\u043E-\u043C\u043E\u0435\u043C\u0443,
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000446
    m_Localized: "\u0422\u0435\u0431\u0435 \u043D\u0435 \u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F
      \u043B\u044E\u0434\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000447
    m_Localized: "\u041D\u0440\u0430\u0432\u044F\u0442\u0441\u044F. \u041F\u0440\u043E\u0441\u0442\u043E
      \u044F \u0432\u0438\u0434\u0435\u043B \u043C\u0435\u0441\u0442\u0430, \u0433\u0434\u0435
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C \u0438\u0437-\u0437\u0430
      \u043E\u0434\u043D\u043E\u0433\u043E \u043D\u0435\u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0433\u043E
      \u0441\u043B\u043E\u0432\u0430, \u0430 \u043F\u043E\u0442\u043E\u043C \u0435\u043C\u0443
      \u043D\u0435\u0434\u0435\u043B\u044E \u043F\u0440\u043E\u0434\u0430\u044E\u0442
      \u044D\u0442\u043E \u0441\u043B\u043E\u0432\u043E \u043E\u0431\u0440\u0430\u0442\u043D\u043E.
      \u041D\u0435 \u043B\u044E\u0431\u043B\u044E \u0442\u0430\u043A\u043E\u0439
      \u0442\u043E\u0440\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000448
    m_Localized: "\u0427\u0435\u043C \u0442\u044B \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000449
    m_Localized: "\u0427\u0438\u043D\u044E \u0442\u043E, \u0447\u0442\u043E \u043B\u044E\u0434\u044F\u043C
      \u0436\u0430\u043B\u043A\u043E \u0432\u044B\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0442\u044C:
      \u043F\u0440\u044F\u0436\u043A\u0438, \u043D\u043E\u0436\u043D\u044B, \u0434\u0432\u0435\u0440\u043D\u044B\u0435
      \u043F\u0435\u0442\u043B\u0438, \u0440\u0435\u043C\u043D\u0438, \u043F\u043E\u0445\u043E\u0434\u043D\u044B\u0435
      \u043A\u043E\u0442\u0435\u043B\u043A\u0438. \u0420\u0430\u0431\u043E\u0442\u0430
      \u043C\u0435\u043B\u043A\u0430\u044F, \u043D\u043E \u043E\u043D\u0430 \u0432\u043E\u0432\u0440\u0435\u043C\u044F
      \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442: \u043D\u0435
      \u0432\u0441\u0451 \u043D\u0443\u0436\u043D\u043E\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0434\u043E\u0440\u043E\u0433\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000450
    m_Localized: "\u0413\u0434\u0435 \u0442\u044B \u044D\u0442\u043E\u043C\u0443
      \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000451
    m_Localized: "\u0423 \u043C\u0430\u0441\u0442\u0435\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B: \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438, \u043F\u043E\u0447\u0435\u043C\u0443
      \u0432\u0435\u0449\u044C \u0441\u043B\u043E\u043C\u0430\u043B\u0430\u0441\u044C,
      \u0430 \u043F\u043E\u0442\u043E\u043C \u0443\u0436\u0435 \u0431\u0435\u0440\u0438
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0437\u0430 \u043F\u043E\u0447\u0438\u043D\u043A\u0443.
      \u0418\u043D\u0430\u0447\u0435 \u0437\u0430\u0432\u0442\u0440\u0430 \u043F\u0440\u0438\u043D\u0435\u0441\u0443\u0442
      \u0442\u043E \u0436\u0435 \u0441\u0430\u043C\u043E\u0435, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0437\u043B\u0435\u0435. \u042F \u0443 \u043D\u0435\u0433\u043E \u043D\u0435\u0434\u043E\u043B\u0433\u043E
      \u043F\u0440\u043E\u0431\u044B\u043B, \u043D\u043E \u044D\u0442\u0443 \u043D\u0430\u0443\u043A\u0443
      \u043D\u0435 \u0437\u0430\u0431\u044B\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000452
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      \u0442\u0435\u0431\u0435 \u0441\u0438\u043B\u044C\u043D\u043E \u043C\u0435\u0448\u0430\u044E\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000453
    m_Localized: "\u041C\u0435\u0448\u0430\u044E\u0442 \u0432\u0441\u0435\u043C,
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443.
      \u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u0447\u0438\u043D\u0438\u043B
      \u0432\u0435\u0449\u0438 \u0432 \u043F\u0443\u0442\u0438 \u0438 \u0435\u0445\u0430\u043B
      \u0434\u0430\u043B\u044C\u0448\u0435. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u0435\u0449\u044C \u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F \u0437\u0434\u0435\u0441\u044C,
      \u0430 \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u0435\u0451 \u043D\u0435\u0433\u0434\u0435.
      \u0420\u0430\u0431\u043E\u0442\u044B \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0436\u0435\u043B\u0435\u0437\u0430 \u043C\u0435\u043D\u044C\u0448\u0435.
      \u0422\u0430\u043A\u0430\u044F \u0432\u043E\u0442 \u0430\u0440\u0438\u0444\u043C\u0435\u0442\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000454
    m_Localized: "\u0422\u044B \u0431\u0435\u0440\u0451\u0448\u044C \u0434\u0435\u043D\u044C\u0433\u0438
      \u0437\u0430 \u0440\u0435\u043C\u043E\u043D\u0442 \u0441\u0435\u0439\u0447\u0430\u0441?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000455
    m_Localized: "\u0415\u0441\u043B\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043C\u043E\u0436\u0435\u0442 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u2014 \u0431\u0435\u0440\u0443. \u0415\u0441\u043B\u0438 \u043D\u0435\u0442,
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044E,
      \u0434\u043B\u044F \u0447\u0435\u0433\u043E \u0435\u043C\u0443 \u0432\u0435\u0449\u044C.
      \u0417\u0430 \u0440\u0430\u0431\u043E\u0447\u0438\u0439 \u043D\u043E\u0436
      \u0438\u043B\u0438 \u0440\u0435\u043C\u0435\u043D\u044C \u0443\u043F\u0440\u044F\u0436\u0438
      \u0438\u043D\u043E\u0433\u0434\u0430 \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F.
      \u041D\u0435 \u0438\u0437 \u0432\u0435\u043B\u0438\u043A\u043E\u0434\u0443\u0448\u0438\u044F:
      \u0431\u0435\u0437 \u043D\u0438\u0445 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0431\u044B\u0441\u0442\u0440\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0431\u0435\u0434\u043E\u0439 \u0438 \u0441\u0435\u0431\u0435, \u0438 \u0434\u0440\u0443\u0433\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000456
    m_Localized: "\u0427\u0442\u043E \u0434\u0443\u043C\u0430\u0435\u0448\u044C \u043E
      \u043B\u044E\u0434\u044F\u0445 \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000457
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u0437\u0430 \u0441\u0432\u043E\u0451. \u041C\u0430\u0440\u0442\u0430 \u2014
      \u0437\u0430 \u043F\u043E\u0440\u044F\u0434\u043E\u043A. \u0420\u0443\u043D\u0430
      \u2014 \u0437\u0430 \u0431\u0440\u0430\u0442\u0430. \u0425\u0430\u043B\u044C\u0432\u0430\u0440
      \u2014 \u0437\u0430 \u0434\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043D\u0435 \u0434\u043E\u043B\u0436\u0435\u043D \u0440\u0430\u0437\u0432\u0430\u043B\u0438\u0442\u044C\u0441\u044F.
      \u041B\u0438\u0432\u0438\u043E \u2014 \u0437\u0430 \u0446\u0435\u043D\u0443
      \u0432\u0435\u0449\u0435\u0439. \u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u0432\u0441\u0451
      \u044D\u0442\u043E \u0432\u0438\u0434\u043D\u043E, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u0443\u0439\u0442\u0438 \u043F\u043E\u043A\u0430 \u043D\u0435\u043B\u044C\u0437\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000458
    m_Localized: "\u0422\u044B \u043C\u043D\u043E\u0433\u043E \u0445\u043E\u0434\u0438\u043B
      \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0430\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000459
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443
      \u0441\u0432\u043E\u0431\u043E\u0434\u043E\u0439. \u041E\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043C\u0435\u043D\u044F\u0435\u0442 \u043E\u0434\u043D\u0438 \u0437\u0430\u0431\u043E\u0442\u044B
      \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0435: \u0433\u0434\u0435 \u0441\u043F\u0430\u0442\u044C,
      \u043A\u043E\u043C\u0443 \u0432\u0435\u0440\u0438\u0442\u044C, \u043A\u0430\u043A
      \u043D\u0435 \u043F\u0440\u043E\u043C\u043E\u0447\u0438\u0442\u044C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B.
      \u041D\u043E \u0432 \u0434\u043E\u0440\u043E\u0433\u0435 \u0435\u0441\u0442\u044C
      \u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C: \u0435\u0441\u043B\u0438
      \u0441\u0434\u0435\u043B\u0430\u043B \u0440\u0430\u0431\u043E\u0442\u0443 \u0445\u043E\u0440\u043E\u0448\u043E,
      \u044D\u0442\u043E \u0432\u0438\u0434\u043D\u043E \u0441\u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000460
    m_Localized: "\u0410 \u043B\u0435\u0441\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000461
    m_Localized: "\u042F \u0445\u043E\u0436\u0443 \u0442\u0430\u043C, \u0433\u0434\u0435
      \u0445\u043E\u0434\u044F\u0442 \u043B\u044E\u0434\u0438, \u0438 \u043D\u0435
      \u0438\u0449\u0443 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445 \u043F\u0443\u0442\u0435\u0439
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0443\u0436\u043E\u0435 \u043C\u0435\u0441\u0442\u043E.
      \u041E \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u0445 \u0441\u043B\u044B\u0448\u0430\u043B
      \u0442\u043E \u0436\u0435, \u0447\u0442\u043E \u0432\u0441\u0435. \u041D\u043E
      \u043A\u043E\u0433\u0434\u0430 \u0434\u043E\u0440\u043E\u0433\u0430 \u043F\u0443\u0441\u0442\u0435\u0435\u0442,
      \u043F\u0435\u0440\u0432\u044B\u043C \u0432\u0440\u0443\u0442 \u043D\u0435
      \u0441\u043B\u0443\u0445\u0438 \u2014 \u0441\u043B\u0435\u0434\u044B. \u041D\u0430
      \u043D\u0438\u0445 \u044F \u0441\u043C\u043E\u0442\u0440\u044E \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000462
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000463
    m_Localized: "\u0411\u044B\u0432\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000464
    m_Localized: "\u041E\u0441\u0432\u0438\u043D \u041C\u0430\u0440\u043B\u043E\u0443
      \u043F\u0440\u043E\u0441\u0438\u043B \u0443\u0437\u043D\u0430\u0442\u044C,
      \u0447\u0442\u043E \u0441 \u0442\u043E\u0431\u043E\u0439. \u0413\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0434\u0430\u0432\u043D\u043E \u043D\u0435 \u0431\u044B\u043B\u043E \u0432\u0435\u0441\u0442\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000465
    m_Localized: "\u041E\u0441\u0432\u0438\u043D \u0432\u0441\u0435\u0433\u0434\u0430
      \u0442\u0440\u0435\u0432\u043E\u0436\u0438\u0442\u0441\u044F \u0442\u0430\u043A,
      \u0431\u0443\u0434\u0442\u043E \u0443 \u043D\u0435\u0433\u043E \u0432\u043C\u0435\u0441\u0442\u043E
      \u0441\u0435\u0440\u0434\u0446\u0430 \u043A\u043E\u043B\u043E\u043A\u043E\u043B.
      \u041F\u0435\u0440\u0435\u0434\u0430\u0439: \u0436\u0438\u0432, \u0440\u0430\u0431\u043E\u0442\u0430\u044E,
      \u0432\u0441\u0451 \u0443 \u043C\u0435\u043D\u044F \u0445\u043E\u0440\u043E\u0448\u043E.
      \u0414\u0430\u0436\u0435 \u0443\u0447\u0435\u043D\u0438\u0446\u0443 \u0437\u0430\u0432\u0451\u043B
      \u2014 \u0437\u0430 \u0434\u0432\u0430 \u0433\u043E\u0434\u0430 \u043E\u043D\u0430
      \u0443\u0441\u043F\u0435\u043B\u0430 \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F
      \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043A\u043B\u0435\u0449\u0438 \u0438
      \u0441\u043F\u043E\u0440\u0438\u0442\u044C \u043E \u0436\u0435\u043B\u0435\u0437\u0435.
      \u041C\u044B \u0441 \u041E\u0441\u0432\u0438\u043D\u043E\u043C \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0436\u0435 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0438\u0441\u044C.
      \u041A\u043E\u0433\u0434\u0430 \u0434\u043E\u0440\u043E\u0433\u0438 \u043E\u0442\u043A\u0440\u043E\u044E\u0442,
      \u0441\u0430\u043C \u043A \u043D\u0435\u043C\u0443 \u0437\u0430\u0433\u043B\u044F\u043D\u0443.
      \u0418 \u0441\u043F\u0440\u043E\u0448\u0443, \u043F\u043E\u0447\u0435\u043C\u0443
      \u043E\u043D \u0440\u0435\u0448\u0438\u043B, \u0431\u0443\u0434\u0442\u043E
      \u044F \u043F\u0440\u043E\u043F\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000466
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0432\u0435\u0441\u0442\u044C
      \u041E\u0441\u0432\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000467
    m_Localized: "\u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u043A \u041E\u0441\u0432\u0438\u043D\u0443
      \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0439\u0442\u0435 \u0441\u043B\u043E\u0432\u0430
      \u0413\u0430\u0440\u0432\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000468
    m_Localized: "\u042F \u043D\u0430\u0448\u0451\u043B \u0413\u0430\u0440\u0432\u0435\u043D\u0430.
      \u041E\u043D \u0436\u0438\u0432, \u0443 \u043D\u0435\u0433\u043E \u0432\u0441\u0451
      \u0445\u043E\u0440\u043E\u0448\u043E, \u0438 \u043E\u043D \u043F\u0440\u043E\u0441\u0438\u043B
      \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C: \u0443\u0436\u0435 \u0434\u0432\u0430
      \u0433\u043E\u0434\u0430 \u0434\u0435\u0440\u0436\u0438\u0442 \u043F\u0440\u0438
      \u0441\u0435\u0431\u0435 \u0443\u0447\u0435\u043D\u0438\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000469
    m_Localized: "\u0423\u0447\u0435\u043D\u043D\u0438\u0446\u0443? \u0417\u043D\u0430\u0447\u0438\u0442,
      \u0413\u0430\u0440\u0432\u0435\u043D \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F \u043D\u0435 \u0442\u0430\u0449\u0438\u0442\u044C
      \u0432\u0441\u044E \u0440\u0430\u0431\u043E\u0442\u0443 \u043D\u0430 \u0441\u0435\u0431\u0435.
      \u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0432\u0435\u0441\u0442\u044C.
      \u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0441\u0445\u043E\u0434\u0438\u043B.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F,
      \u043E\u043D \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442
      \u043C\u043D\u0435, \u043F\u043E\u0447\u0435\u043C\u0443 \u0434\u0432\u0430
      \u0433\u043E\u0434\u0430 \u043C\u043E\u043B\u0447\u0430\u043B, \u0430 \u044F
      \u2014 \u0435\u043C\u0443, \u043F\u043E\u0447\u0435\u043C\u0443 \u0432\u0441\u0451
      \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0436\u0434\u0430\u043B
      \u043E\u0442 \u043D\u0435\u0433\u043E \u0432\u0435\u0441\u0442\u043E\u0447\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000470
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u042D\u043B\u0438\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000471
    m_Localized: "\u0425\u0430\u043B\u044C\u0432\u0430\u0440 \u0441\u043A\u0430\u0437\u0430\u043B,
      \u0447\u0442\u043E \u042D\u043B\u0438\u043D\u0430 \u0443 \u0440\u0435\u043A\u0438.
      \u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0435\u0451 \u0438 \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C,
      \u0447\u0442\u043E \u0441 \u043D\u0435\u0439 \u0432\u0441\u0451 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000472
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u042D\u043B\u0438\u043D\u043E\u0439 \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000473
    m_Localized: "\u042D\u043B\u0438\u043D\u0430 \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
      \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0443. \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000474
    m_Localized: "\u0414\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000475
    m_Localized: "\u0427\u0442\u043E \u0442\u0435\u0431\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
      \u0432 \u0440\u0435\u043A\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000476
    m_Localized: "\u041E\u043D\u0430 \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442,
      \u0432\u044B\u043C\u044B\u043B\u0430 \u043B\u0438 \u044F \u043A\u0440\u0443\u0436\u043A\u0438
      \u0438 \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043B\u0430 \u043B\u0438
      \u0431\u0435\u043B\u044C\u0451. \u041F\u043E\u0441\u0438\u0436\u0443 \u0434\u0435\u0441\u044F\u0442\u044C
      \u043C\u0438\u043D\u0443\u0442, \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u044E
      \u0432\u043E\u0434\u0443 \u2014 \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0441\u044C
      \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0443 \u0431\u0435\u0437 \u0436\u0435\u043B\u0430\u043D\u0438\u044F
      \u043A\u043E\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0443\u043A\u0443\u0441\u0438\u0442\u044C.
      \u0423\u0436\u0435 \u043D\u0435\u043C\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000477
    m_Localized: "\u0423 \u0440\u0435\u043A\u0438, \u043F\u043E\u0445\u043E\u0436\u0435,
      \u043D\u0435\u0442 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0438 \u0442\u0430\u0438\u0442\u044C
      \u043E\u0431\u0438\u0434\u0443. \u041F\u043E\u043B\u0435\u0437\u043D\u043E\u0435
      \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000478
    m_Localized: "\u0413\u043B\u0430\u0432\u0430 \u0441\u0442\u0440\u0430\u0436\u0438
      \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B \u0443\u0437\u043D\u0430\u0442\u044C,
      \u0432\u0441\u0451 \u043B\u0438 \u0443 \u0442\u0435\u0431\u044F \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000479
    m_Localized: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B.
      \u0420\u0430\u0441\u0441\u0442\u0451\u0433\u043D\u0443\u0442\u0443\u044E \u043F\u0440\u044F\u0436\u043A\u0443
      \u043E\u043D \u0437\u0430\u043C\u0435\u0442\u0438\u0442 \u0437\u0430 \u0442\u0440\u0438
      \u0443\u043B\u0438\u0446\u044B, \u0430 \u0443 \u043D\u0430\u0448\u0435\u0439
      \u0434\u0432\u0435\u0440\u0438 \u043F\u043E\u0441\u0442\u043E\u0438\u0442 \u0438
      \u0437\u0430\u0431\u0443\u0434\u0435\u0442, \u0437\u0430\u0447\u0435\u043C
      \u043F\u0440\u0438\u0448\u0451\u043B. \u041F\u0435\u0440\u0435\u0434\u0430\u0439,
      \u0447\u0442\u043E \u0441\u043E \u043C\u043D\u043E\u0439 \u0432\u0441\u0451
      \u0445\u043E\u0440\u043E\u0448\u043E. \u041D\u0435\u0442, \u043B\u0443\u0447\u0448\u0435
      \u043F\u043E\u043A\u0430 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0439. \u042F \u0431\u0443\u0434\u0443
      \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435; \u043F\u0443\u0441\u0442\u044C
      \u0441\u0430\u043C \u0443\u0441\u043B\u044B\u0448\u0438\u0442, \u043A\u043E\u0433\u0434\u0430
      \u043D\u0430\u0431\u0435\u0440\u0451\u0442\u0441\u044F \u0441\u043C\u0435\u043B\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000480
    m_Localized: "\u0422\u0432\u043E\u0439 \u043E\u0442\u0435\u0446 \u0432\u043E\u043B\u043D\u0443\u0435\u0442\u0441\u044F.
      \u0413\u043E\u0432\u043E\u0440\u0438\u0442, \u0442\u044B \u0447\u0430\u0441\u0442\u043E
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0448\u044C \u0441\u044E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000481
    m_Localized: "\u041E\u0442\u0435\u0446 \u0432\u043E\u043B\u043D\u0443\u0435\u0442\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u044F \u0432 \u0434\u0432\u0443\u0445 \u0448\u0430\u0433\u0430\u0445
      \u043E\u0442 \u0434\u0432\u0435\u0440\u0438. \u041E\u043D \u043D\u0435 \u043D\u0435\u043F\u0440\u0430\u0432,
      \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u0442\u043E\u043C\u0438\u0442\u0435\u043B\u0435\u043D.
      \u0420\u0430\u0437 \u0443\u0436 \u0442\u044B \u0441 \u043D\u0438\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u043B,
      \u043F\u0435\u0440\u0435\u0434\u0430\u0439: \u0432\u0435\u0440\u043D\u0443\u0441\u044C
      \u043F\u0440\u0435\u0436\u0434\u0435, \u0447\u0435\u043C \u043F\u043E\u0434\u0433\u043E\u0440\u0438\u0442
      \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0430. \u0410 \u0435\u0441\u043B\u0438
      \u0435\u0449\u0451 \u0431\u0443\u0434\u0443\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u044B
      \u2014 \u0437\u0430\u0445\u043E\u0434\u0438 \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000482
    m_Localized: "\u0422\u044F\u0436\u0435\u043B\u043E \u0441\u043D\u043E\u0432\u0430
      \u0441\u0438\u0434\u0435\u0442\u044C \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000483
    m_Localized: "\xAB\u0422\u044F\u0436\u0435\u043B\u043E\xBB \u2014 \u0433\u0440\u043E\u043C\u043A\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E. \u041D\u0430\u0434\u043E \u0432\u044B\u0442\u0435\u0440\u0435\u0442\u044C
      \u043A\u0440\u0443\u0436\u043A\u0438, \u043D\u0430\u043A\u043E\u0440\u043C\u0438\u0442\u044C
      \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432, \u0430 \u043E\u0442\u0435\u0446
      \u0434\u0435\u043B\u0430\u0435\u0442 \u0432\u0438\u0434, \u0431\u0443\u0434\u0442\u043E
      \u043D\u0435 \u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0430\u043B \u0434\u043B\u044F
      \u043C\u0435\u043D\u044F \u0442\u0430\u0431\u0443\u0440\u0435\u0442 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0441\u043E\u0431\u043E\u0439. \u0420\u0430\u0431\u043E\u0442\u0430
      \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0432\u0441\u0451
      \u043F\u043E \u043C\u0435\u0441\u0442\u0430\u043C. \u0418\u043D\u043E\u0433\u0434\u0430
      \u044D\u0442\u043E\u0433\u043E \u0445\u0432\u0430\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000484
    m_Localized: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0442\u044B \u043F\u043E\u0439\u043C\u0430\u043B\u0430
      \u0440\u0438\u0442\u043C \u044D\u0442\u043E\u0433\u043E \u043C\u0435\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000485
    m_Localized: "\u0422\u044B \u0437\u043B\u0438\u0448\u044C\u0441\u044F \u043D\u0430
      \u0433\u043B\u0430\u0432\u0443 \u0441\u0442\u0440\u0430\u0436\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000486
    m_Localized: "\u041D\u0435\u0442. \u0421 \u0433\u043D\u0435\u0432\u043E\u043C
      \u0431\u044B\u043B\u043E \u0431\u044B \u043F\u0440\u043E\u0449\u0435. \u041E\u043D
      \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0438 \u0442\u0430\u043A \u0431\u043E\u0438\u0442\u0441\u044F \u043F\u0435\u0440\u0435\u0441\u0442\u0443\u043F\u0438\u0442\u044C
      \u0447\u0435\u0440\u0442\u0443, \u0447\u0442\u043E \u0438\u043D\u043E\u0433\u0434\u0430
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u0436\u0438\u0437\u043D\u0438. \u041C\u043D\u0435 \u043D\u0435 \u043D\u0443\u0436\u0435\u043D
      \u043C\u0443\u0436\u0447\u0438\u043D\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u0440\u0438\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
      \u0437\u0430 \u043C\u043D\u043E\u0439 \u043E\u0442 \u0432\u043E\u0440\u043E\u0442.
      \u041C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D \u0442\u043E\u0442, \u043A\u0442\u043E
      \u0441\u043A\u0430\u0436\u0435\u0442 \u043F\u0440\u044F\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000487
    m_Localized: "\u0421\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000488
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 \u043E \u0447\u0451\u043C-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0434\u0440\u0443\u0433\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000489
    m_Localized: "\u042F \u0438\u0449\u0443 \u042D\u043B\u0438\u043D\u0443. \u041E\u043D\u0430
      \u0443 \u0440\u0435\u043A\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000490
    m_Localized: "\u0423 \u0440\u0435\u043A\u0438. \u0418\u0434\u0451\u0442 \u0442\u0443\u0434\u0430,
      \u043A\u043E\u0433\u0434\u0430 \u0432 \u044D\u0442\u0438\u0445 \u0441\u0442\u0435\u043D\u0430\u0445
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0442\u0435\u0441\u043D\u043E.
      \u0415\u0441\u043B\u0438 \u0442\u0435\u0431\u044F \u043F\u043E\u0441\u043B\u0430\u043B
      \u0433\u043B\u0430\u0432\u0430 \u0441\u0442\u0440\u0430\u0436\u0438, \u043D\u0435
      \u0433\u043E\u0432\u043E\u0440\u0438 \u0441 \u043D\u0435\u0439 \u043A\u0430\u043A
      \u043D\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0435. \u041E\u043D\u0430
      \u0443\u0441\u043B\u044B\u0448\u0438\u0442 \u0437\u0430\u0431\u043E\u0442\u0443,
      \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0437\u0430\u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u0435\u0451 \u0432 \u043F\u0440\u0438\u043A\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000491
    m_Localized: "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0443\u0437\u043D\u0430\u0442\u044C,
      \u043A\u0430\u043A \u042D\u043B\u0438\u043D\u0430. \u041E\u043D\u0430 \u0434\u043E\u0447\u044C
      \u0425\u0430\u043B\u044C\u0432\u0430\u0440\u0430, \u0445\u043E\u0437\u044F\u0438\u043D\u0430
      \u0442\u0430\u0432\u0435\u0440\u043D\u044B \u0443 \u0442\u0440\u0430\u043A\u0442\u0430.
      \u041F\u043E\u043A\u0430 \u0433\u043E\u0440\u043E\u0434 \u0437\u0430\u043A\u0440\u044B\u0442,
      \u043B\u044E\u0434\u0438 \u043F\u0440\u044F\u0447\u0443\u0442\u0441\u044F \u043A\u0430\u0436\u0434\u044B\u0439
      \u0432 \u0441\u0432\u043E\u0438\u0445 \u0437\u0430\u0431\u043E\u0442\u0430\u0445.
      \u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0435\u0451, \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435
      \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0438\u0442\u0435 \u043C\u043D\u0435
      \u043F\u0440\u0430\u0432\u0434\u0443, \u0430 \u043D\u0435 \u0432\u0435\u0436\u043B\u0438\u0432\u044B\u0439
      \u043E\u0442\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000492
    m_Localized: "\u041D\u0430\u0439\u0434\u0443 \u042D\u043B\u0438\u043D\u0443 \u0438
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u044E \u0441 \u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000493
    m_Localized: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u041E\u0431\u044B\u0447\u043D\u043E
      \u043E\u043D\u0430 \u0431\u044B\u0432\u0430\u0435\u0442 \u0443 \u0440\u0435\u043A\u0438.
      \u041C\u043E\u0436\u0435\u0442\u0435 \u0441\u043F\u0435\u0440\u0432\u0430 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0441 \u0425\u0430\u043B\u044C\u0432\u0430\u0440\u043E\u043C: \u043E\u043D
      \u0437\u043D\u0430\u0435\u0442, \u043A\u043E\u0433\u0434\u0430 \u0443 \u043D\u0435\u0451
      \u0447\u0442\u043E-\u0442\u043E \u043D\u0430 \u0434\u0443\u0448\u0435. \u0418
      \u043D\u0435 \u0434\u043E\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439\u0442\u0435
      \u0435\u0451 \u043A\u0430\u043A \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000494
    m_Localized: "\u0412\u0435\u0441\u0442\u0438 \u043E\u0431 \u042D\u043B\u0438\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000495
    m_Localized: "\u0413\u043B\u0430\u0432\u0430 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
      \u0441\u0442\u0440\u0430\u0436\u0438 \u043F\u0440\u043E\u0441\u0438\u0442 \u0443\u0431\u0435\u0434\u0438\u0442\u044C\u0441\u044F,
      \u0447\u0442\u043E \u0441 \u042D\u043B\u0438\u043D\u043E\u0439, \u0434\u043E\u0447\u0435\u0440\u044C\u044E
      \u0425\u0430\u043B\u044C\u0432\u0430\u0440\u0430, \u0432\u0441\u0451 \u0432
      \u043F\u043E\u0440\u044F\u0434\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000496
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u042D\u043B\u0438\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000497
    m_Localized: "\u042D\u043B\u0438\u043D\u0430 \u043E\u0431\u044B\u0447\u043D\u043E
      \u0431\u044B\u0432\u0430\u0435\u0442 \u0443 \u0440\u0435\u043A\u0438. \u041F\u0435\u0440\u0435\u0434
      \u0432\u0441\u0442\u0440\u0435\u0447\u0435\u0439 \u0441 \u043D\u0435\u0439
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0441 \u0425\u0430\u043B\u044C\u0432\u0430\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000498
    m_Localized: "\u042D\u0442\u043E \u043B\u0438\u0447\u043D\u043E\u0435, \u043D\u043E
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E. \u042D\u043B\u0438\u043D\u0430
      \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u2014 \u0438\u043C\u0435\u043D\u043D\u043E
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0438 \u043D\u0435 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442
      \u043F\u043E\u043C\u043E\u0449\u0438, \u043A\u043E\u0433\u0434\u0430 \u0441\u0442\u043E\u0438\u043B\u043E
      \u0431\u044B. \u041B\u0443\u0447\u0448\u0435 \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C,
      \u0447\u0442\u043E \u0441 \u043D\u0435\u0439 \u0432\u0441\u0451 \u0445\u043E\u0440\u043E\u0448\u043E,
      \u0447\u0435\u043C \u0435\u0449\u0451 \u0434\u0435\u043D\u044C \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
      \u0445\u0443\u0434\u0448\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000499
    m_Localized: "\u041D\u0435 \u0437\u043D\u0430\u0435\u0448\u044C, \u0433\u0434\u0435
      \u0434\u043E\u0441\u0442\u0430\u0442\u044C \u044F\u0431\u043B\u043E\u043A?"
    m_Metadata:
      m_Items: []
  - m_Id: 99200000000000500
    m_Localized: "\u0412\u043E\u043D \u044F\u0431\u043B\u043E\u043D\u044F, \u043F\u0440\u044F\u043C\u043E
      \u043F\u0435\u0440\u0435\u0434 \u043D\u0430\u043C\u0438. \u041C\u043E\u0436\u0435\u0448\u044C
      \u0436\u0434\u0430\u0442\u044C, \u043F\u043E\u043A\u0430 \u044F\u0431\u043B\u043E\u043A\u0438
      \u0441\u0430\u043C\u0438 \u0443\u043F\u0430\u0434\u0443\u0442, \u0430 \u043C\u043E\u0436\u0435\u0448\u044C
      \u043F\u0430\u0440\u0443 \u0440\u0430\u0437 \u0441\u0442\u0443\u043A\u043D\u0443\u0442\u044C
      \u043F\u043E \u0441\u0442\u0432\u043E\u043B\u0443 \u2014 \u0433\u043B\u044F\u0434\u0438\u0448\u044C,
      \u043F\u0430\u0440\u0430 \u0438 \u0441\u0432\u0430\u043B\u0438\u0442\u0441\u044F.
      \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u043A\u043E\u043B\u043E\u0442\u0438
      \u0431\u0435\u0437 \u043C\u0435\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000001
    m_Localized: "\u0412\u044B\u043A\u0443\u043F\u0438\u0442\u044C \u0423\u043B\u044C\u0440\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000002
    m_Localized: "\u0411\u0440\u0430\u043C \u0412\u043E\u0441\u0441 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0434\u0432\u0435 \u0442\u044B\u0441\u044F\u0447\u0438 \u043C\u043E\u043D\u0435\u0442
      \u0437\u0430 \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000003
    m_Localized: "\u0414\u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0432\u044B\u043A\u0443\u043F
      \u0437\u0430 \u0423\u043B\u044C\u0440\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000004
    m_Localized: "\u0411\u0440\u0430\u043C \u0432\u0437\u044F\u043B \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0435\u0449\u0451 \u043F\u044F\u0442\u044C\u0441\u043E\u0442
      \u043C\u043E\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000005
    m_Localized: "\u0423\u043B\u044C\u0440\u0438\u043A \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0451\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000006
    m_Localized: "\u0412\u044B\u043A\u0443\u043F \u0443\u043F\u043B\u0430\u0447\u0435\u043D,
      \u0431\u0430\u043D\u0434\u0438\u0442\u044B \u0443\u0448\u043B\u0438 \u0441
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000007
    m_Localized: "\u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000008
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u0430 \u0432\u044B\u0431\u0438\u043B\u0430
      \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432 \u0441 \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000009
    m_Localized: "\u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000010
    m_Localized: "\u0422\u044B \u0441\u0440\u0430\u0436\u0430\u043B\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441\u043E \u0441\u0442\u0440\u0430\u0436\u0435\u0439 \u0438 \u043F\u043E\u043C\u043E\u0433
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000011
    m_Localized: "\u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000012
    m_Localized: "\u041D\u0430\u0433\u0440\u0430\u0434\u0430 \u043E\u0442 \u0441\u0442\u0440\u0430\u0436\u0438
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000013
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u0430 \u043E\u0442\u0431\u0438\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000014
    m_Localized: "\u0422\u044B \u0441\u0440\u0430\u0436\u0430\u043B\u0441\u044F \u043D\u0430
      \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432
      \u0438 \u043F\u043E\u043C\u043E\u0433 \u0438\u043C \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000015
    m_Localized: "\u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0443 \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000016
    m_Localized: "\u041D\u0430\u0433\u0440\u0430\u0434\u0430 \u043E\u0442 \u0412\u043E\u0440\u0435\u043A\u0430
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000017
    m_Localized: "\u041C\u0435\u043B\u044C\u043D\u0438\u0446\u0430 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0443 \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 99300000000000018
    m_Localized: "\u041D\u0430\u0433\u0440\u0430\u0434\u0430 \u0438\u0437 \u043B\u0430\u0433\u0435\u0440\u044F
      \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99400000000000001
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0442\u0438\u043B. \u0411\u0430\u043D\u0434\u0438\u0442\u044B
      \u0434\u0435\u0440\u0436\u0430\u0442 \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0430.
      \u042F \u0432\u0438\u0434\u0435\u043B, \u0433\u0434\u0435 \u043E\u043D\u0438
      \u0441\u0442\u043E\u044F\u0442 \u0438 \u043A\u0430\u043A \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442
      \u043A \u0437\u0434\u0430\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 99400000000000002
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E. \u041F\u0440\u043E\u0432\u0435\u0434\u0451\u0448\u044C
      \u043D\u0430\u0441 \u0438 \u043F\u043E\u043A\u0430\u0436\u0435\u0448\u044C,
      \u043E\u0442\u043A\u0443\u0434\u0430 \u043B\u0443\u0447\u0448\u0435 \u0432\u043E\u0439\u0442\u0438.
      \u041D\u0430\u043C \u043D\u0430\u0434\u043E \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0430 \u0440\u0430\u043D\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0438\u0437 \u044D\u0442\u0438\u0445 \u043F\u0441\u043E\u0432 \u0441\u043E\u0440\u0432\u0451\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 99400000000000003
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0434\u0443. \u0418 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
      \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0443\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 99400000000000004
    m_Localized: "\u0412\u043E\u0442 \u044D\u0442\u043E \u0438 \u0445\u043E\u0442\u0435\u043B
      \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C. \u0414\u0435\u0440\u0436\u0438\u0441\u044C
      \u0440\u044F\u0434\u043E\u043C \u0441 \u043E\u0442\u0440\u044F\u0434\u043E\u043C,
      \u0441\u043C\u043E\u0442\u0440\u0438 \u0437\u0430 \u0444\u043B\u0430\u043D\u0433\u043E\u043C.
      \u041A\u0430\u043A \u0443\u0432\u0438\u0434\u0438\u043C \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432
      \u2014 \u0440\u0435\u0436\u0435\u043C \u0431\u044B\u0441\u0442\u0440\u043E
      \u0438 \u043D\u0435 \u0434\u0430\u0451\u043C \u0438\u043C \u0442\u0440\u043E\u043D\u0443\u0442\u044C
      \u043C\u0435\u043B\u044C\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 99500000000000001
    m_Localized: "\u0412\u042B \u041F\u041E\u0413\u0418\u0411\u041B\u0418"
