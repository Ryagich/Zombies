  - m_Id: 88000000000000010
    m_Localized: "\u0428\u0438\u0440\u043E\u043A\u0430\u044F \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u0430\u044F
      \u043D\u0430\u043A\u0438\u0434\u043A\u0430 \u043E\u0433\u0438\u0431\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443 \u043F\u043B\u043E\u0442\u043D\u044B\u043C
      \u0432\u043D\u0435\u0448\u043D\u0438\u043C \u043A\u043E\u043D\u0442\u0443\u0440\u043E\u043C
      \u0438 \u0443\u0445\u043E\u0434\u0438\u0442 \u0432\u043D\u0438\u0437 \u043A
      \u0448\u0435\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u043C \u0432\u043E\u0440\u043E\u0442\u043E\u043C.
      \u041B\u0438\u0446\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E
      \u0432 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u043C \u043E\u0432\u0430\u043B\u044C\u043D\u043E\u043C
      \u043F\u0440\u043E\u0451\u043C\u0435; \u043D\u0430\u0434 \u043D\u0438\u043C
      \u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0441\u043A\u043E\u0448\u0435\u043D\u043D\u044B\u0445 \u0433\u0440\u0430\u043D\u0435\u0439,
      \u0430 \u0441\u043D\u0438\u0437\u0443 \u0437\u0430\u043C\u0435\u0442\u043D\u0430
      \u0442\u0451\u043C\u043D\u0430\u044F \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u044F\u044F
      \u043A\u0440\u043E\u043C\u043A\u0430. \u041D\u0438\u0447\u0435\u0433\u043E
      \u043B\u0438\u0448\u043D\u0435\u0433\u043E: \u0444\u043E\u0440\u043C\u0430
      \u0446\u0435\u043B\u0438\u043A\u043E\u043C \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043D\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0439, \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0439
      \u0441\u0438\u043B\u0443\u044D\u0442."
