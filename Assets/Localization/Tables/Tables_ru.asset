  - m_Id: 87000000000000002
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u0430\u044F \u0448\u0430\u043F\u043E\u0447\u043A\u0430
      \u0441\u043B\u043E\u0436\u0435\u043D\u0430 \u0448\u0438\u0440\u043E\u043A\u0438\u043C\u0438
      \u043F\u043E\u043B\u043E\u0441\u0430\u043C\u0438 \u0438 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0447\u0435\u043D\u0430
      \u0443 \u043B\u0431\u0430 \u0442\u0451\u043C\u043D\u044B\u043C \u0434\u0432\u043E\u0439\u043D\u044B\u043C
      \u043E\u0431\u043E\u0434\u043E\u043C. \u041D\u0430\u0434 \u043D\u0438\u043C
      \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u044B \u0430\u043B\u043E\u0435
      \u043F\u0435\u0440\u043E \u0438 \u0433\u0440\u0430\u043D\u0451\u043D\u0430\u044F
      \u0431\u043B\u0435\u0434\u043D\u043E-\u0437\u0435\u043B\u0451\u043D\u0430\u044F
      \u0431\u0440\u043E\u0448\u044C, \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u0432\u043D\u0438\u0437 \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F
      \u0443\u0437\u043A\u0438\u0435 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u044B.
      \u0423\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u044F \u0437\u0430\u043C\u0435\u0442\u043D\u044B,
      \u043D\u043E \u0441\u043E\u0431\u0440\u0430\u043D\u044B \u0432 \u043E\u0434\u0438\u043D
      \u0441\u0442\u0440\u043E\u0433\u0438\u0439 \u0437\u043D\u0430\u043A: \u0432\u0435\u0449\u044C
      \u043D\u0435 \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
      \u0431\u043E\u0433\u0430\u0447\u0435 \u0441\u0432\u043E\u0435\u0433\u043E \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430."
