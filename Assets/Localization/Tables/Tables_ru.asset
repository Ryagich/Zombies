  - m_Id: 86000000000000006
    m_Localized: "\u041D\u0435\u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0441\u0432\u0435\u0442\u043B\u0430\u044F
      \u0448\u0430\u043F\u043E\u0447\u043A\u0430 \u0441 \u043E\u0445\u0440\u0438\u0441\u0442\u043E\u0439
      \u043B\u0435\u043D\u0442\u043E\u0439 \u0438 \u0434\u043B\u0438\u043D\u043D\u044B\u043C
      \u0430\u043B\u044B\u043C \u043F\u0435\u0440\u043E\u043C, \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u044B\u043C
      \u0441\u0431\u043E\u043A\u0443 \u0432 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439
      \u0441\u0432\u0435\u0442\u043B\u043E\u0439 \u043F\u0435\u0442\u043B\u0435.
      \u041C\u044F\u0433\u043A\u0438\u0439 \u043E\u043A\u0440\u0443\u0433\u043B\u044B\u0439
      \u0441\u0438\u043B\u0443\u044D\u0442 \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u0442
      \u0441 \u043F\u0435\u0440\u043E\u043C, \u0430 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0434\u0430\u0451\u0442 \u0435\u043C\u0443 \u043C\u0435\u0441\u0442\u043E.
      \u0423\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0435 \u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0435,
      \u043D\u043E \u043D\u0435 \u043A\u0440\u0438\u0447\u0430\u0449\u0435\u0435:
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043E\u0434\u043D\u043E\u0433\u043E
      \u0432\u0437\u0433\u043B\u044F\u0434\u0430, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u044C \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430
      \u0432 \u0442\u043E\u043B\u043F\u0435."
